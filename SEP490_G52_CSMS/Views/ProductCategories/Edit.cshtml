@model SEP490_G52_CSMS.Models.Sales.ProductCategory

@{
    ViewData["Title"] = "Sửa Danh Mục";
}

<h2>Sửa Danh Mục</h2>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="CategoryId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="CategoryName">Tên danh mục</label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status">Trạng thái</label>
                <select asp-for="Status" class="form-control">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Lưu danh mục" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $('form').on('submit', function(e) {
            if ($(this).data('confirmed')) return true;
            e.preventDefault();
            const form = this;
            showConfirmModal(
                'Xác nhận sửa danh mục',
                'Bạn có chắc chắn muốn lưu cập nhật danh mục sản phẩm này?',
                function() {
                    $(form).data('confirmed', true);
                    form.submit();
                }
            );
        });
    </script>
}

@model SEP490_G52_CSMS.Controllers.WeeklyScheduleViewModel
@{
    ViewData["Title"] = "Quản lý lịch làm việc";
    var dayNames = new[] { "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy", "Chủ Nhật" };
    var nowTime = DateTime.Now.TimeOfDay;
}

<style>
    .employee-entry {
        white-space: nowrap;
    }
    .today-cell {
        background-color: rgba(13, 110, 253, 0.08) !important;
    }
    .today-header {
        background-color: rgba(13, 110, 253, 0.15) !important;
        border-bottom: 3px solid #0d6efd !important;
    }
    .schedule-table td {
        min-height: 100px;
        height: 120px;
        vertical-align: top;
        padding: 12px 10px !important;
    }
</style>

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-calendar3 text-primary me-2"></i>LỊCH LÀM VIỆC CHI NHÁNH
            </h1>
            <p class="text-muted small mb-0">Theo dõi toàn bộ ca trực và nhân viên được phân công trong tuần</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (User.IsInRole("BranchManager") || User.IsInRole("RManager"))
            {
                <a asp-action="Manage" asp-route-weekStart="@Model.WeekStart.ToString("yyyy-MM-dd")" 
                   class="btn btn-primary btn-sm px-3 shadow-sm fw-semibold">
                    <i class="bi bi-pencil-square me-1"></i>Chỉnh sửa lịch tuần này
                </a>
            }
            <a asp-action="ExportExcel" asp-route-weekStart="@Model.WeekStart.ToString("yyyy-MM-dd")" 
               class="btn btn-outline-success btn-sm px-3">
                <i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel
            </a>
            <div class="vr mx-1"></div>
            <div class="btn-group shadow-xs" role="group">
                <a asp-action="Index" asp-route-weekStart="@Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd")" 
                   class="btn btn-outline-secondary btn-sm px-3">
                    <i class="bi bi-chevron-left me-1"></i>Tuần trước
                </a>
                <a asp-action="Index" 
                   class="btn btn-outline-primary btn-sm px-3 fw-semibold">
                    Tuần này
                </a>
                <a asp-action="Index" asp-route-weekStart="@Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd")" 
                   class="btn btn-outline-secondary btn-sm px-3">
                    Tuần sau<i class="bi bi-chevron-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Main Schedule Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <span class="fw-bold text-dark">
                <i class="bi bi-calendar-range text-secondary me-2"></i>
                Tuần từ @Model.WeekStart.ToString("dd/MM/yyyy") đến @Model.WeekEnd.ToString("dd/MM/yyyy")
            </span>
            <span class="badge bg-light text-secondary border px-3 py-2">
                Tổng cộng: @Model.Assignments.Values.Sum(v => v.Count) lượt phân công
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-sm align-middle text-center mb-0 schedule-table" style="table-layout: fixed; min-width: 980px;">
                <thead class="table-light">
                    <tr>
                        <th style="width: 160px;" class="text-start ps-3 py-2">Ca Làm Việc</th>
                        @for (var d = 0; d < 7; d++)
                        {
                            var dayDate = Model.WeekStart.AddDays(d);
                            bool isToday = dayDate.Date == DateTime.Today;

                            <th style="width: 12.14%;" class="py-2 @(isToday ? "today-header" : "")">
                                <div class="fw-bold @(isToday ? "text-primary" : "text-dark")">
                                    @dayNames[d]
                                </div>
                                <div class="small fw-normal @(isToday ? "text-primary fw-bold" : "text-muted")">@dayDate.ToString("dd/MM")</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shift in Model.Shifts)
                    {
                        <tr>
                            <td class="bg-body-tertiary text-start ps-3 py-3">
                                <strong class="text-dark">@(shift.ShiftName ?? "Ca ?")</strong><br />
                                <small class="text-muted">(@shift.StartTime.ToString(@"hh\:mm") - @(shift.EndTime.Hours == 23 && shift.EndTime.Minutes >= 59 ? "24:00" : shift.EndTime.ToString(@"hh\:mm")))</small>
                            </td>
                            @for (var d = 0; d < 7; d++)
                            {
                                var date = Model.WeekStart.AddDays(d);
                                bool isToday = date.Date == DateTime.Today;
                                var key = (shift.ShiftId, date.Date);
                                var hasAssignments = Model.Assignments.TryGetValue(key, out var employees) && employees.Count > 0;

                                bool isCurrentTimeInShift = isToday && (nowTime >= shift.StartTime && nowTime <= shift.EndTime);
                                double progressPct = 0;
                                if (isCurrentTimeInShift)
                                {
                                    double totalMins = (shift.EndTime - shift.StartTime).TotalMinutes;
                                    if (totalMins <= 0) totalMins += 1440;
                                    double elapsedMins = (nowTime - shift.StartTime).TotalMinutes;
                                    progressPct = Math.Clamp((elapsedMins / totalMins) * 100.0, 5.0, 95.0);
                                }

                                <td class="text-start p-2 align-top position-relative @(isToday ? "today-cell" : "")">
                                    @if (isCurrentTimeInShift)
                                    {
                                        <div class="position-absolute w-100" style="top: @(progressPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%; left: 0; right: 0; z-index: 10; pointer-events: none;" title="Thời gian hiện tại: @DateTime.Now.ToString("HH:mm")">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary rounded-circle shadow-sm" style="width: 8px; height: 8px; margin-left: -4px; flex-shrink: 0;"></div>
                                                <div class="bg-primary flex-grow-1" style="height: 2px; opacity: 0.85;"></div>
                                            </div>
                                        </div>
                                    }

                                    @if (hasAssignments)
                                    {
                                            @foreach (var emp in employees!)
                                            {
                                                var roleStr = emp.Role ?? "";
                                                string roleColor = roleStr.Contains("Cashier") || roleStr.Contains("Thu ngân") ? "text-primary" :
                                                                   roleStr.Contains("Bartender") || roleStr.Contains("Barista") || roleStr.Contains("Pha chế") ? "text-success" :
                                                                   roleStr.Contains("Busser") || roleStr.Contains("Vệ sinh") ? "text-warning-emphasis" : "text-dark";

                                                <div class="employee-entry small mb-1 fw-semibold @roleColor" title="@(!string.IsNullOrWhiteSpace(emp.Username) ? $"@{emp.Username}" : "")">
                                                    <i class="bi bi-person-fill me-1"></i>@(emp.FullName ?? $"NV#{emp.EmployeeId}")
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-center text-muted">&mdash;</div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Role Color Legend -->
        <div class="small text-muted px-1 d-flex flex-wrap gap-4 align-items-center">
            <span class="fw-bold text-dark">Phân loại vai trò:</span>
            <span class="text-primary fw-semibold"><i class="bi bi-person-fill me-1"></i>Thu ngân (Cashier)</span>
            <span class="text-success fw-semibold"><i class="bi bi-person-fill me-1"></i>Pha chế (Bartender/Barista)</span>
            <span class="text-warning-emphasis fw-semibold"><i class="bi bi-person-fill me-1"></i>Phục vụ/Vệ sinh (Busser/Staff)</span>
        </div>
</div>

@model SEP490_G52_CSMS.Controllers.WeeklyScheduleViewModel
@{
    ViewData["Title"] = "Quản lý lịch làm việc";
    var dayNames = new[] { "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy", "Chủ Nhật" };
}

<style>
    .employee-entry {
        white-space: nowrap;
    }
    .today-cell {
        background-color: rgba(13, 110, 253, 0.08) !important;
    }
    .today-header {
        background-color: rgba(13, 110, 253, 0.15) !important;
        border-bottom: 3px solid #0d6efd !important;
    }
</style>

<div class="container-fluid mt-3 px-4 pb-5">
    <!-- Header Section -->
    <div class="card bg-body-tertiary border-0 rounded-3 mb-4 shadow-sm">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="text-muted small">Chi nhánh / Lịch làm việc</span>
                <h4 class="fw-bold m-0 text-dark">QUẢN LÝ LỊCH LÀM VIỆC</h4>
            </div>

            @if (User.IsInRole("BranchManager"))
            {
                <div class="d-flex align-items-center gap-2">
                    <a class="btn btn-primary rounded-pill px-3 fw-bold shadow-sm" href="@Url.Action("Manage", new { weekStart = Model.WeekStart.ToString("yyyy-MM-dd") })">
                        <i class="bi bi-plus-lg me-1"></i>Thêm lịch mới
                    </a>
                    <a class="btn btn-outline-secondary rounded-pill px-3 fw-bold" href="@Url.Action("Manage", new { weekStart = Model.WeekStart.ToString("yyyy-MM-dd") })">
                        <i class="bi bi-pencil me-1"></i>Cập nhật lịch làm
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Week Navigation Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="input-group" style="width: auto;">
                <a class="btn btn-outline-secondary"
                   href="@Url.Action("Index", new { weekStart = Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd") })">
                    &lsaquo;
                </a>

                <span class="input-group-text bg-white fw-semibold">
                    Tuần này: @Model.WeekStart.ToString("dd/MM") - @Model.WeekEnd.ToString("dd/MM/yyyy")
                </span>

                <a class="btn btn-outline-secondary"
                   href="@Url.Action("Index", new { weekStart = Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd") })">
                    &rsaquo;
                </a>
            </div>

            @if (Model.Shifts.Count > 0)
            {
                <a class="btn btn-outline-success rounded-pill px-3 fw-bold" href="@Url.Action("ExportExcel", new { weekStart = Model.WeekStart.ToString("yyyy-MM-dd") })">
                    <i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel
                </a>
            }
        </div>
    </div>

    @if (Model.Shifts.Count == 0)
    {
        <div class="alert alert-warning rounded-3 shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Chưa có ca làm việc nào được cấu hình trong hệ thống.
        </div>
    }
    else
    {
        <!-- Weekly Schedule Matrix Grid (Today Highlight + Colored Employee Roles) -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 980px;">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 160px;" class="text-start ps-3 py-2">Ca Làm Việc</th>
                            @for (var d = 0; d < 7; d++)
                            {
                                var dayDate = Model.WeekStart.AddDays(d);
                                bool isToday = dayDate.Date == DateTime.Today;

                                <th style="width: 12.14%;" class="py-2 @(isToday ? "today-header" : "")">
                                    <div class="fw-bold @(isToday ? "text-primary" : "text-dark")">
                                        @dayNames[d]
                                        @* @if (isToday)
                                        {
                                            <span class="badge bg-primary rounded-pill ms-1" style="font-size: 0.65rem;">Hôm nay</span>
                                        } *@
                                    </div>
                                    <div class="small fw-normal @(isToday ? "text-primary fw-bold" : "text-muted")">@dayDate.ToString("dd/MM")</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var shift in Model.Shifts)
                        {
                            <tr>
                                <td class="bg-body-tertiary text-start ps-3 py-3">
                                    <strong class="text-dark">@(shift.ShiftName ?? "Ca ?")</strong><br />
                                    <small class="text-muted">(@shift.StartTime.ToString(@"hh\:mm") - @shift.EndTime.ToString(@"hh\:mm"))</small>
                                </td>
                                @for (var d = 0; d < 7; d++)
                                {
                                    var date = Model.WeekStart.AddDays(d);
                                    bool isToday = date.Date == DateTime.Today;
                                    var key = (shift.ShiftId, date.Date);
                                    var hasAssignments = Model.Assignments.TryGetValue(key, out var employees) && employees.Count > 0;

                                    <td class="text-start p-2 align-top @(isToday ? "today-cell" : "")">
                                        @if (hasAssignments)
                                        {
                                            @foreach (var emp in employees!)
                                            {
                                                var roleStr = emp.Role ?? "";
                                                string roleColor = roleStr.Contains("Cashier") || roleStr.Contains("Thu ngân") ? "text-primary" :
                                                                   roleStr.Contains("Bartender") || roleStr.Contains("Barista") || roleStr.Contains("Pha chế") ? "text-success" :
                                                                   roleStr.Contains("Busser") || roleStr.Contains("Vệ sinh") ? "text-warning-emphasis" : "text-dark";

                                                <div class="employee-entry small mb-1 fw-semibold @roleColor">
                                                    <i class="bi bi-person-fill me-1"></i>@(emp.FullName ?? $"NV#{emp.EmployeeId}")
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-center text-muted">&mdash;</div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Role Color Legend -->
        <div class="small text-muted px-1 d-flex flex-wrap gap-4 align-items-center">
            <span class="fw-bold text-dark">Phân loại vai trò:</span>
            <span class="text-primary fw-semibold"><i class="bi bi-person-fill me-1"></i>Thu ngân (Cashier)</span>
            <span class="text-success fw-semibold"><i class="bi bi-person-fill me-1"></i>Pha chế (Bartender/Barista)</span>
            <span class="text-warning-emphasis fw-semibold"><i class="bi bi-person-fill me-1"></i>Phục vụ/Vệ sinh (Busser/Staff)</span>
        </div>
    }
</div>

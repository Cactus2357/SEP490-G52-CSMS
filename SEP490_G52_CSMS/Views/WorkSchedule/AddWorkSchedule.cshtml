@model SEP490_G52_CSMS.Services.AddWorkScheduleVM
@{
    ViewData["Title"] = "Thêm lịch làm việc theo tuần";
    var dayNames = new[] { "Thứ hai", "Thứ ba", "Thứ tư", "Thứ năm", "Thứ sáu", "Thứ bảy", "Chủ nhật" };
    var weekEnd = Model.WeekStartDate.AddDays(6);

    // Defensive defaults: never let a null collection reach the markup/JS below.
    var shifts = Model.Shifts ?? new List<SEP490_G52_CSMS.Models.Attendance.FixedShift>();
    var cashiers = Model.Cashiers ?? new List<SEP490_G52_CSMS.Models.Employees.Employee>();
    var bartenders = Model.Bartenders ?? new List<SEP490_G52_CSMS.Models.Employees.Employee>();
    var bussers = Model.Bussers ?? new List<SEP490_G52_CSMS.Models.Employees.Employee>();
    var branchId = Model.BranchId ?? string.Empty;
    var existingAssignments = Model.ExistingAssignments ?? new List<SEP490_G52_CSMS.Services.ExistingAssignmentVM>();
}

<h2 class="mb-4">THÊM LỊCH LÀM VIỆC THEO TUẦN</h2>

@if (string.IsNullOrWhiteSpace(branchId))
{
    <div class="alert alert-danger">Không xác định được chi nhánh. Vui lòng chọn chi nhánh trước khi tạo lịch.</div>
}

<!-- Week navigation + scope selection -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-sm btn-outline-secondary"
           href="@Url.Action("AddWorkSchedule", new { weekStart = Model.WeekStartDate.AddDays(-7).ToString("yyyy-MM-dd") })">&lsaquo;</a>
        <span class="fw-semibold">
            Tuần này: @Model.WeekStartDate.ToString("dd/MM") - @weekEnd.ToString("dd/MM/yyyy")
        </span>
        <a class="btn btn-sm btn-outline-secondary"
           href="@Url.Action("AddWorkSchedule", new { weekStart = Model.WeekStartDate.AddDays(7).ToString("yyyy-MM-dd") })">&rsaquo;</a>
    </div>

    <div class="d-flex align-items-center gap-3">
        <div class="form-check">
            <input class="form-check-input" type="radio" name="scope" id="scopeSelected" value="selected" checked>
            <label class="form-check-label" for="scopeSelected">Chỉ áp dụng cho tuần đã chọn</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="scope" id="scopeUpcoming" value="upcoming">
            <label class="form-check-label" for="scopeUpcoming">Áp dụng cho các tuần tiếp theo</label>
        </div>
    </div>
</div>

@if (shifts.Count == 0)
{
    <div class="alert alert-warning">
        Chưa có ca làm việc (Fixed Shift) nào được cấu hình trong hệ thống. Vui lòng thêm ca làm việc trước khi tạo lịch.
    </div>
}
else
{
    <!-- Weekly schedule matrix grid -->
    <div class="table-responsive">
        <table class="table table-bordered align-middle text-center" id="scheduleTable">
            <thead class="table-light">
                <tr>
                    <th style="width:140px;">Ca làm việc</th>
                    @for (var d = 0; d < 7; d++)
                    {
                        <th>
                            @dayNames[d]<br />
                            <small class="text-muted">@Model.WeekStartDate.AddDays(d).ToString("dd/MM")</small>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var shift in shifts)
                {
                    <tr>
                        <td class="table-light text-start">
                            <strong>@(shift.ShiftName ?? "Ca ?")</strong><br />
                            <small class="text-muted">(@shift.StartTime.ToString(@"hh\:mm") - @shift.EndTime.ToString(@"hh\:mm"))</small>
                        </td>
                        @for (var d = 0; d < 7; d++)
                        {
                            <td id="cell_@(d)_@(shift.ShiftId)" class="schedule-cell"></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Legend -->
    <p class="text-muted small">
        Chú thích: <span class="me-3">&#128100; Nhân viên thu ngân</span>
        <span class="me-3">&#128100; Nhân viên pha chế</span>
        <span class="me-3">&#128100; Nhân viên vệ sinh</span>
        <span class="badge bg-secondary">Đã tạo lịch</span> = ca đã có lịch, không thể chỉnh sửa ở màn hình này
    </p>

    @if (cashiers.Count == 0)
    {
        <div class="alert alert-warning">
            Chi nhánh chưa có Nhân viên thu ngân đang hoạt động. Không thể tạo ca làm việc cho đến khi có ít nhất một Cashier (bắt buộc theo BR01).
        </div>
    }

    <!-- Main footer actions -->
    <div class="d-flex justify-content-end gap-2 mb-4">
        <button type="button" class="btn btn-outline-secondary" id="btnCancelAll">Hủy</button>
        <button type="button" class="btn btn-primary" id="btnConfirmAll" @(cashiers.Count == 0 ? "disabled" : "")>Xác nhận</button>
    </div>

    <!-- Staff Assignment Modal -->
    <div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Thứ 7 - Ca 1</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Cashier: mandatory single select (BR01) -->
                    <div class="mb-3">
                        <label class="form-label">&#128100; Nhân viên thu ngân</label>
                        <select class="form-select" id="cashierSelect" @(cashiers.Count == 0 ? "disabled" : "")>
                            <option value="">-- Chọn nhân viên --</option>
                            @foreach (var e in cashiers)
                            {
                                <option value="@e.EmployeeId">@(e.FullName ?? $"NV#{e.EmployeeId}")</option>
                            }
                        </select>
                        @if (cashiers.Count == 0)
                        {
                            <div class="form-text text-danger">Không có nhân viên thu ngân khả dụng.</div>
                        }
                    </div>

                    <!-- Bartender: multi-add list (BR02) -->
                    <div class="mb-3">
                        <label class="form-label">&#128100; Nhân viên pha chế</label>
                        <div class="d-flex gap-2">
                            <select class="form-select" id="bartenderSelect" @(bartenders.Count == 0 ? "disabled" : "")>
                                <option value="">-- Chọn nhân viên --</option>
                                @foreach (var e in bartenders)
                                {
                                    <option value="@e.EmployeeId">@(e.FullName ?? $"NV#{e.EmployeeId}")</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-primary text-nowrap" id="btnAddBartender" @(bartenders.Count == 0 ? "disabled" : "")>Thêm Vào DS</button>
                        </div>
                        @if (bartenders.Count == 0)
                        {
                            <div class="form-text text-muted">Không có nhân viên pha chế khả dụng.</div>
                        }
                        <ul class="list-group mt-2" id="bartenderList"></ul>
                    </div>

                    <!-- Busser: multi-add list (BR02) -->
                    <div class="mb-3">
                        <label class="form-label">&#128100; Nhân viên vệ sinh</label>
                        <div class="d-flex gap-2">
                            <select class="form-select" id="busserSelect" @(bussers.Count == 0 ? "disabled" : "")>
                                <option value="">-- Chọn nhân viên --</option>
                                @foreach (var e in bussers)
                                {
                                    <option value="@e.EmployeeId">@(e.FullName ?? $"NV#{e.EmployeeId}")</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-primary text-nowrap" id="btnAddBusser" @(bussers.Count == 0 ? "disabled" : "")>Thêm Vào DS</button>
                        </div>
                        @if (bussers.Count == 0)
                        {
                            <div class="form-text text-muted">Không có nhân viên vệ sinh khả dụng.</div>
                        }
                        <ul class="list-group mt-2" id="busserList"></ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary" id="btnConfirmCell">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        const branchId = '@branchId';
        const weekStartDate = '@Model.WeekStartDate.ToString("yyyy-MM-dd")';
        const dayNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dayNames));

        // Map of shiftId -> display name (e.g. 1 -> "Ca 1").
        const shiftNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    shifts.ToDictionary(s => s.ShiftId.ToString(), s => s.ShiftName ?? ("Ca " + s.ShiftId))));

    // Raw existing rows from the DB for this branch/week, sent down as-is;
    // grouped into scheduleData below. camelCase so property names line up
    // with the JS below (row.dayOffset, row.employeeId, ...).
    const existingAssignments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                existingAssignments,
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

    // In-memory state for the whole week grid.
    // key = "{dayOffset}_{shiftId}" -> { cashier: {id,name}|null, bartenders: [{id,name}], bussers: [{id,name}] }
    const scheduleData = {};

        // Cells that were already saved when the page loaded. These are
        // rendered read-only (no "+ Thêm nhân viên" link) and are excluded
        // from the final submit, since re-posting them would just trip the
        // repository's "already been created" check.
        const lockedCells = new Set();

        function cellKey(day, shiftId) {
            return day + '_' + shiftId;
        }

        // Build scheduleData + lockedCells from what the server already has.
        (function seedExistingAssignments() {
            (existingAssignments || []).forEach(row => {
                if (!row) return;

                const key = cellKey(row.dayOffset, row.shiftId);
                lockedCells.add(key);

                if (!scheduleData[key]) {
                    scheduleData[key] = { cashier: null, bartenders: [], bussers: [] };
                }

                const entry = { id: row.employeeId, name: row.employeeName || ('NV#' + row.employeeId) };

                if (row.role === 'Cashier') {
                    scheduleData[key].cashier = entry;
                } else if (row.role === 'Bartender') {
                    scheduleData[key].bartenders.push(entry);
                } else if (row.role === 'Busser') {
                    scheduleData[key].bussers.push(entry);
                }
            });
        })();

        let currentDay = null;
        let currentShiftId = null;
        let tempBartenders = [];
        let tempBussers = [];

        const assignModalEl = document.getElementById('assignModal');
        const assignModal = assignModalEl ? new bootstrap.Modal(assignModalEl) : null;

        function formatDateOnly(date) {
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, '0');
            const d = String(date.getDate()).padStart(2, '0');
            return y + '-' + m + '-' + d;
        }

        // Renders one grid cell: assigned staff (if any) + either the
        // "Thêm nhân viên" link (editable) or a "locked" badge (already saved).
        function renderCell(day, shiftId) {
            const cell = document.getElementById('cell_' + day + '_' + shiftId);
            if (!cell) return;

            const key = cellKey(day, shiftId);
            const data = scheduleData[key];
            const isLocked = lockedCells.has(key);

            let html = '<div class="small text-start">';

            if (data) {
                if (data.cashier) {
                    html += '<div>&#128100; ' + data.cashier.name + '</div>';
                }
                (data.bartenders || []).forEach(b => {
                    if (b) html += '<div>&#128100; ' + b.name + '</div>';
                });
                (data.bussers || []).forEach(b => {
                    if (b) html += '<div>&#128100; ' + b.name + '</div>';
                });
            }

            html += '</div>';

            if (isLocked) {
                html += '<span class="badge bg-secondary">Đã tạo lịch</span>';
            } else {
                html += '<button type="button" class="btn btn-link btn-sm p-0 add-employee-link" ' +
                        'data-day="' + day + '" data-shift="' + shiftId + '">+ Thêm nhân viên</button>';
            }

            cell.innerHTML = html;
        }

        function renderSubList(listElId, items, onRemove) {
            const ul = document.getElementById(listElId);
            if (!ul) return;

            ul.innerHTML = '';
            (items || []).forEach((item, index) => {
                if (!item) return;

                const li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between align-items-center py-1';
                li.textContent = item.name || ('NV#' + item.id);

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn btn-sm btn-outline-danger';
                btn.textContent = 'Xóa';
                btn.addEventListener('click', () => onRemove(index));

                li.appendChild(btn);
                ul.appendChild(li);
            });
        }

        function renderTempLists() {
            renderSubList('bartenderList', tempBartenders, (i) => {
                tempBartenders.splice(i, 1);
                renderTempLists();
            });
            renderSubList('busserList', tempBussers, (i) => {
                tempBussers.splice(i, 1);
                renderTempLists();
            });
        }

        // Opens the modal for a given (day, shift) cell. Locked cells never
        // reach here since they have no "+ Thêm nhân viên" link to click.
        function openAssignModal(day, shiftId) {
            if (!assignModal) return;

            currentDay = day;
            currentShiftId = shiftId;

            const shiftName = shiftNames[shiftId] || ('Ca ' + shiftId);
            const titleEl = document.getElementById('modalTitle');
            if (titleEl) titleEl.textContent = (dayNames[day] || ('Ngày ' + day)) + ' - ' + shiftName;

            const existing = scheduleData[cellKey(day, shiftId)];
            const cashierSelect = document.getElementById('cashierSelect');
            if (cashierSelect) {
                cashierSelect.value = existing && existing.cashier ? existing.cashier.id : '';
            }

            tempBartenders = existing && Array.isArray(existing.bartenders) ? existing.bartenders.slice() : [];
            tempBussers = existing && Array.isArray(existing.bussers) ? existing.bussers.slice() : [];
            renderTempLists();

            assignModal.show();
        }

        // Clicking any "+ Thêm nhân viên" link opens the modal for that cell.
        const scheduleTableEl = document.getElementById('scheduleTable');
        if (scheduleTableEl) {
            scheduleTableEl.addEventListener('click', (e) => {
                const link = e.target.closest('.add-employee-link');
                if (!link) return;
                const day = parseInt(link.dataset.day, 10);
                const shiftId = parseInt(link.dataset.shift, 10);
                if (Number.isNaN(day) || Number.isNaN(shiftId)) return;
                openAssignModal(day, shiftId);
            });
        }

        const btnAddBartender = document.getElementById('btnAddBartender');
        if (btnAddBartender) {
            btnAddBartender.addEventListener('click', () => {
                addToTempList(document.getElementById('bartenderSelect'), tempBartenders);
            });
        }

        const btnAddBusser = document.getElementById('btnAddBusser');
        if (btnAddBusser) {
            btnAddBusser.addEventListener('click', () => {
                addToTempList(document.getElementById('busserSelect'), tempBussers);
            });
        }

        function addToTempList(selectEl, list) {
            if (!selectEl || !selectEl.value) return;

            const id = parseInt(selectEl.value, 10);
            if (!id || Number.isNaN(id)) return;

            if (list.some(x => x.id === id)) {
                alert('Nhân viên này đã có trong danh sách.');
                return;
            }

            const selectedOption = selectEl.options[selectEl.selectedIndex];
            const name = selectedOption ? selectedOption.text : ('NV#' + id);
            list.push({ id, name });
            selectEl.value = '';
            renderTempLists();
        }

        // Modal "Xác nhận": BR01 requires a Cashier before saving the cell.
        const btnConfirmCell = document.getElementById('btnConfirmCell');
        if (btnConfirmCell) {
            btnConfirmCell.addEventListener('click', () => {
                const cashierSelect = document.getElementById('cashierSelect');
                const cashierId = cashierSelect ? parseInt(cashierSelect.value, 10) : NaN;

                if (!cashierId || Number.isNaN(cashierId)) {
                    alert('Vui lòng chọn Nhân viên thu ngân cho ca này.');
                    return;
                }

                const cashierName = cashierSelect.options[cashierSelect.selectedIndex].text;

                scheduleData[cellKey(currentDay, currentShiftId)] = {
                    cashier: { id: cashierId, name: cashierName },
                    bartenders: tempBartenders.slice(),
                    bussers: tempBussers.slice()
                };

                renderCell(currentDay, currentShiftId);
                if (assignModal) assignModal.hide();
            });
        }

        // Main "Hủy": discard the whole in-progress week assembly (AT3).
        const btnCancelAll = document.getElementById('btnCancelAll');
        if (btnCancelAll) {
            btnCancelAll.addEventListener('click', () => {
                if (confirm('Bạn có chắc muốn hủy? Toàn bộ dữ liệu chưa lưu sẽ bị mất.')) {
                    window.location.href = '/';
                }
            });
        }

        // Main "Xác nhận": submit every populated, unlocked cell (Step 7-8).
        // Locked cells (already in the DB when the page loaded) are skipped.
        const btnConfirmAll = document.getElementById('btnConfirmAll');
        if (btnConfirmAll) {
            btnConfirmAll.addEventListener('click', async () => {
                if (!branchId) {
                    alert('Không xác định được chi nhánh. Không thể lưu lịch làm việc.');
                    return;
                }

                const cellKeys = Object.keys(scheduleData).filter(k => !lockedCells.has(k));
                if (cellKeys.length === 0) {
                    alert('Chưa có ca làm việc mới nào được phân công.');
                    return;
                }

                const scopeUpcomingEl = document.getElementById('scopeUpcoming');
                const applyUpcoming = !!(scopeUpcomingEl && scopeUpcomingEl.checked);
                const weeksToApply = [new Date(weekStartDate)];

                if (applyUpcoming) {
                    for (let i = 1; i <= 4; i++) {
                        const d = new Date(weekStartDate);
                        d.setDate(d.getDate() + 7 * i);
                        weeksToApply.push(d);
                    }
                }

                const errors = [];

                for (const week of weeksToApply) {
                    for (const key of cellKeys) {
                        const [dayStr, shiftIdStr] = key.split('_');
                        const day = parseInt(dayStr, 10);
                        const shiftId = parseInt(shiftIdStr, 10);
                        const cell = scheduleData[key];

                        if (!cell || !cell.cashier || !cell.cashier.id) {
                            errors.push('Ca (' + (shiftNames[shiftId] || shiftId) + ') thiếu Nhân viên thu ngân, đã bỏ qua.');
                            continue;
                        }

                        const assignmentDate = new Date(week);
                        assignmentDate.setDate(assignmentDate.getDate() + day);

                        const employeeIds = [
                            cell.cashier.id,
                            ...(cell.bartenders || []).map(b => b && b.id).filter(id => !!id),
                            ...(cell.bussers || []).map(b => b && b.id).filter(id => !!id)
                        ];

                        const payload = {
                            branchId: branchId,
                            assignmentDate: formatDateOnly(assignmentDate),
                            shiftId: shiftId,
                            employeeIds: employeeIds
                        };

                        try {
                            const res = await fetch('/WorkSchedule/AddWorkSchedule', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(payload)
                            });

                            if (!res.ok) {
                                const msg = await res.text();
                                errors.push(assignmentDate.toLocaleDateString('vi-VN') + ' - ' + (shiftNames[shiftId] || shiftId) + ': ' + (msg || 'Lỗi không xác định'));
                            }
                        } catch (err) {
                            errors.push(assignmentDate.toLocaleDateString('vi-VN') + ' - ' + (shiftNames[shiftId] || shiftId) + ': ' + err);
                        }
                    }
                }

                if (errors.length > 0) {
                    alert('Một số ca không thể lưu:\n' + errors.join('\n'));
                } else {
                    alert('Thêm lịch làm việc theo tuần thành công!');
                    window.location.reload();
                }
            });
        }

        // Initial render: draws every cell, including locked ones seeded from
        // existingAssignments above.
    @foreach (var shift in shifts)
        {
                for (var d = 0; d < 7; d++)
                {
                        @: renderCell(@d, @shift.ShiftId);
                }
        }
    </script>
}

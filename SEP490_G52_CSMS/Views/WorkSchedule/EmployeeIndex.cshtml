@model SEP490_G52_CSMS.Models.ViewModels.EmployeeScheduleViewModel

@{
    ViewData["Title"] = "Lịch làm việc nhân viên";
}

<div class="container-fluid px-4 pt-3">
    <!-- Tiêu đề -->
    <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
        <h3 class="fw-bold mb-0 text-uppercase text-dark">
            <i class="bi bi-calendar3-event text-primary me-2"></i>Lịch Làm Việc Nhân Viên
        </h3>
    </div>

    <!-- Thông tin nhân viên & Chọn tuần -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="fs-5 text-dark">
                Họ &amp; Tên: <span class="fw-bold text-primary">@Model.FullName</span>
            </div>
            
            <div>
                <form id="weekForm" method="get" asp-action="EmployeeIndex" class="d-flex align-items-center gap-2 m-0">
                    <div class="input-group">
                        <span class="input-group-text bg-light text-secondary"><i class="bi bi-calendar-week"></i></span>
                        <input type="date" name="weekStart" class="form-control" 
                               value="@Model.WeekStart.ToString("yyyy-MM-dd")" 
                               onchange="document.getElementById('weekForm').submit();" style="width: 155px;" />
                        <span class="input-group-text bg-white text-dark fw-semibold">đến @Model.WeekEnd.ToString("dd/MM/yyyy")</span>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bảng lịch làm việc -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-bordered align-middle text-center mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-start ps-3" style="width: 15%;">Ca Làm Việc</th>
                        @foreach (var day in Model.Days)
                        {
                            var dayName = day.DayOfWeek == DayOfWeek.Sunday ? "Chủ nhật" : "Thứ " + ((int)day.DayOfWeek + 1);
                            <th>
                                <div class="fw-bold text-dark">@dayName</div>
                                <div class="small fw-normal text-muted">@day.ToString("dd/MM")</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shift in Model.Shifts)
                    {
                        <tr>
                            <td class="text-start ps-3 bg-light-subtle">
                                <div class="fw-bold text-dark">@shift.ShiftName</div>
                                <div class="small text-muted">(@shift.StartTime.ToString(@"hh\:mm") - @shift.EndTime.ToString(@"hh\:mm"))</div>
                            </td>
                            @foreach (var day in Model.Days)
                            {
                                var hasShift = Model.ScheduleData.TryGetValue((shift.ShiftId, day.Date), out var detail);
                                
                                <td>
                                    @if (hasShift && detail != null && detail.IsAssigned)
                                    {
                                        <div class="fw-semibold text-success mb-1">
                                            <i class="bi bi-check-lg"></i> Có ca làm
                                        </div>
                                        
                                        @if (day.Date.Add(shift.StartTime) > DateTime.Now)
                                        {
                                            <div class="small text-secondary">
                                                (<i class="bi bi-info-circle me-1"></i>Chưa tới giờ)
                                            </div>
                                        }
                                        else if (detail.OverallStatus == "Present")
                                        {
                                            <div class="small text-success fw-bold">
                                                (<i class="bi bi-check-circle-fill me-1"></i>Đã điểm danh)
                                            </div>
                                        }
                                        else if (detail.OverallStatus == "Absent")
                                        {
                                            <div class="small text-danger fw-bold">
                                                (<i class="bi bi-x-circle-fill me-1"></i>Vắng mặt)
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="small text-secondary">
                                                (<i class="bi bi-info-circle me-1"></i>Chưa điểm danh)
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-muted opacity-50">&mdash;</div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Chú thích -->
    <div class="card border-0 shadow-sm" style="max-width: 650px;">
        <div class="card-header bg-light fw-bold text-secondary py-2">
            <i class="bi bi-info-circle-fill me-1"></i>Chú thích lịch làm việc
        </div>
        <div class="card-body p-3">
            <div class="row g-2 small">
                <div class="col-sm-6 text-secondary">
                    <span class="text-muted opacity-50 fw-bold me-2">&mdash;</span> Chưa có dữ liệu lịch làm.
                </div>
                <div class="col-sm-6 text-success">
                    <i class="bi bi-check-lg me-2"></i>Có ca làm việc trong tuần.
                </div>
                <div class="col-sm-6 text-success fw-bold">
                    <i class="bi bi-check-circle-fill me-2"></i>Đã điểm danh/tham gia ca làm việc.
                </div>
                <div class="col-sm-6 text-danger fw-bold">
                    <i class="bi bi-x-circle-fill me-2"></i>Vắng mặt không tham gia ca.
                </div>
                <div class="col-sm-6 text-secondary">
                    <i class="bi bi-info-circle me-2"></i>Chưa tới giờ làm việc.
                </div>
            </div>
        </div>
    </div>
</div>

@model SEP490_G52_CSMS.Models.ViewModels.EmployeeScheduleViewModel

@{
    ViewData["Title"] = "Lịch làm việc nhân viên";
}

<div class="container-fluid mt-3 px-4 pb-5">
    <!-- Header Section -->
    <div class="card bg-body-tertiary border-0 rounded-3 mb-4 shadow-sm">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="text-muted small">Cá nhân / Lịch làm việc</span>
                <h4 class="fw-bold m-0 text-dark">LỊCH LÀM VIỆC CỦA TÔI</h4>
            </div>
            <div class="fs-6 text-dark">
                Nhân viên: <span class="fw-bold text-primary">@Model.FullName</span>
            </div>
        </div>
    </div>

    <!-- Select Week Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form id="weekForm" method="get" asp-action="EmployeeIndex" class="d-flex align-items-center gap-2 m-0">
                <div class="input-group" style="max-width: 380px;">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-calendar-week"></i></span>
                    <input type="date" name="weekStart" class="form-control" 
                           value="@Model.WeekStart.ToString("yyyy-MM-dd")" 
                           onchange="document.getElementById('weekForm').submit();" />
                    <span class="input-group-text bg-white text-dark fw-semibold">đến @Model.WeekEnd.ToString("dd/MM/yyyy")</span>
                </div>
            </form>
        </div>
    </div>

    <!-- Balanced Schedule Matrix Grid -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="table-responsive">
            <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 980px;">
                <thead class="table-light">
                    <tr>
                        <th class="text-start ps-3 py-2" style="width: 160px;">Ca Làm Việc</th>
                        @foreach (var day in Model.Days)
                        {
                            var dayName = day.DayOfWeek == DayOfWeek.Sunday ? "Chủ Nhật" : "Thứ " + ((int)day.DayOfWeek + 1);
                            <th style="width: 12.14%;" class="py-2">
                                <div class="fw-bold text-dark">@dayName</div>
                                <div class="small fw-normal text-muted">@day.ToString("dd/MM")</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shift in Model.Shifts)
                    {
                        <tr>
                            <td class="text-start ps-3 bg-body-tertiary py-3">
                                <div class="fw-bold text-dark">@shift.ShiftName</div>
                                <div class="small text-muted">(@shift.StartTime.ToString(@"hh\:mm") - @shift.EndTime.ToString(@"hh\:mm"))</div>
                            </td>
                            @foreach (var day in Model.Days)
                            {
                                var hasShift = Model.ScheduleData.TryGetValue((shift.ShiftId, day.Date), out var detail);
                                
                                <td class="p-2 align-middle">
                                    @if (hasShift && detail != null && detail.IsAssigned)
                                    {
                                        <div class="fw-bold text-success mb-1 small">
                                            <i class="bi bi-check-circle-fill me-1"></i>Có ca làm
                                        </div>
                                        
                                        @if (day.Date.Add(shift.StartTime) > DateTime.Now)
                                        {
                                            <div class="small text-muted">
                                                (Chưa tới giờ)
                                            </div>
                                        }
                                        else if (detail.OverallStatus == "Present")
                                        {
                                            <div class="small text-success fw-bold">
                                                (Đã điểm danh)
                                            </div>
                                        }
                                        else if (detail.OverallStatus == "Absent")
                                        {
                                            <div class="small text-danger fw-bold">
                                                (Vắng mặt)
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="small text-muted">
                                                (Chưa điểm danh)
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-muted">&mdash;</div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model SEP490_G52_CSMS.Models.ViewModels.OrderDetailViewModel

<div class="mb-4">
    <h4 class="fw-bold mb-4">chi tiết đơn hàng</h4>
    <div class="mb-2"><span class="fw-bold" style="width: 150px; display: inline-block;">Mã đơn hàng :</span> @Model.OrderId</div>
    <div class="mb-2"><span class="fw-bold" style="width: 150px; display: inline-block;">người dùng:</span> @Model.RecipientName</div>
    <div class="mb-2"><span class="fw-bold" style="width: 150px; display: inline-block;">thời gian :</span> @Model.OrderTime.ToString("dd/MM/yyyy HH:mm")</div>
    <div class="mb-4"><span class="fw-bold" style="width: 150px; display: inline-block;">trạng thái :</span> @Model.DisplayStatus</div>

    <h4 class="fw-bold mb-3">danh sách món</h4>
    <table class="table table-bordered border-dark">
        <thead class="table-light border-dark">
            <tr>
                <th>STT</th>
                <th>tên món</th>
                <th>size</th>
                <th>SL</th>
                <th>đơn giá</th>
                <th>thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                var item = Model.Items[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@item.ProductName</td>
                    <td>@item.Size</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("N0")</td>
                    <td>@item.Amount.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <h4 class="fw-bold">tổng tiền :</h4>
        <h4 class="fw-bold">@Model.TotalAmount.ToString("N0") đ</h4>
    </div>
</div>

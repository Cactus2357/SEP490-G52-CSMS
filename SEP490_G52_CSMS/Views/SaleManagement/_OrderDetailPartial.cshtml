@model SEP490_G52_CSMS.Models.ViewModels.SaleOrderDetailViewModel

<div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
    <h5 class="fw-bold mb-0 text-uppercase text-dark">
        <i class="bi bi-receipt me-2 text-primary"></i>Chi Tiết Đơn Hàng
    </h5>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-primary px-2.5 py-1.5 fw-bold">@Model.OrderId</span>
        <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" onclick="printReceiptFromHistory('@Model.OrderId')" title="In hóa đơn / Phiếu order">
            <i class="bi bi-printer me-1"></i>In Phiếu
        </button>
    </div>
</div>
<div class="card-body p-4 d-flex flex-column" style="flex: 1; overflow-y: auto;">
    <!-- Hidden data storage for safe JS consumption -->
    <script type="application/json" id="orderItemsData_@Model.OrderId">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(it => new { 
            variantId = it.VariantId, 
            productName = it.ProductName, 
            size = it.Size, 
            quantity = it.Quantity, 
            unitPrice = it.UnitPrice, 
            amount = it.Amount 
        })))
    </script>
    <input type="hidden" id="missingReasonData_@Model.OrderId" value="@Model.MissingIngredientsDetail" />

    <div class="mb-3 flex-shrink-0">
        <div class="row mb-2">
            <div class="col-4 text-muted small">- Vị trí / Bàn:</div>
            <div class="col-8 fw-bold text-primary">@(!string.IsNullOrWhiteSpace(Model.TableNumber) ? Model.TableNumber : "Mang về")</div>
        </div>
        <div class="row mb-2">
            <div class="col-4 text-muted small">- Khách hàng:</div>
            <div class="col-8 fw-semibold text-dark">@(!string.IsNullOrWhiteSpace(Model.CustomerName) ? Model.CustomerName : "Khách lẻ")</div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.OrderNotes))
        {
            <div class="row mb-2">
                <div class="col-4 text-muted small">- Ghi chú:</div>
                <div class="col-8 fst-italic text-secondary">@Model.OrderNotes</div>
            </div>
        }
        <div class="row mb-2">
            <div class="col-4 text-muted small">- Thời gian:</div>
            <div class="col-8 text-secondary">@Model.OrderTime.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
        <div class="row mb-2">
            <div class="col-4 text-muted small">- Thanh toán:</div>
            <div class="col-8">
                <span class="badge bg-light text-dark border">@Model.PaymentMethod</span>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.BankTransactionCode))
        {
            <div class="row mb-2">
                <div class="col-4 text-muted small">- Mã GD Ngân hàng:</div>
                <div class="col-8">
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle fw-bold">
                        <i class="bi bi-bank me-1"></i>@Model.BankTransactionCode
                    </span>
                </div>
            </div>
        }
        <div class="row mb-2">
            <div class="col-4 text-muted small">- Trạng thái:</div>
            <div class="col-8">
                @if (Model.IsMissingIngredients)
                {
                    <span class="badge bg-danger text-white px-2.5 py-1.5 rounded-pill fw-bold">
                        <i class="bi bi-exclamation-octagon-fill me-1"></i>Thiếu nguyên liệu (Chờ xử lý)
                    </span>
                }
                else if (Model.DisplayStatus == "Hoàn tiền 1 phần" || (Model.RefundAmount > 0 && Model.RefundAmount < Model.TotalAmount))
                {
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1 rounded-pill fw-semibold">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Hoàn tiền 1 phần
                    </span>
                }
                else if (Model.DisplayStatus == "Đã hoàn thành" || Model.DisplayStatus == "đã hoàn thành")
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill fw-semibold">
                        <i class="bi bi-check-circle-fill me-1"></i>Hoàn thành
                    </span>
                }
                else if (Model.DisplayStatus.Contains("Hoàn tiền") || Model.DisplayStatus.Contains("hủy") || Model.PaymentStatus == "Cancelled" || Model.RefundAmount >= Model.TotalAmount)
                {
                    <span class="badge bg-secondary text-white px-2.5 py-1 rounded-pill fw-semibold">
                        <i class="bi bi-x-circle-fill me-1"></i>Đã hủy / Hoàn tiền
                    </span>
                }
                else if (Model.PaymentStatus == "Unpaid" || Model.DisplayStatus == "Chờ thanh toán")
                {
                    <span class="badge bg-secondary text-white px-2.5 py-1.5 rounded-pill fw-semibold">
                        <i class="bi bi-hourglass-split me-1"></i>Chờ thanh toán
                    </span>
                }
                else if (Model.PaymentStatus == "PartiallyPaid" || Model.DisplayStatus == "Thanh toán 1 phần")
                {
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2.5 py-1.5 rounded-pill fw-semibold">
                        <i class="bi bi-pie-chart-fill me-1"></i>Thanh toán 1 phần
                    </span>
                }
                else if (Model.DisplayStatus == "Đang pha chế" || Model.DisplayStatus == "đang trong quá trình pha chế")
                {
                    <span class="badge bg-primary text-white px-2.5 py-1 rounded-pill fw-semibold">
                        <i class="bi bi-cup-hot-fill me-1"></i>Đang pha chế
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark px-2.5 py-1 rounded-pill fw-semibold">
                        <i class="bi bi-clock-history me-1"></i>Đang chờ pha chế
                    </span>
                }
            </div>
        </div>

        @if (Model.PaymentStatus == "PartiallyPaid" || Model.DisplayStatus == "Thanh toán 1 phần")
        {
            <div class="alert alert-info border-info p-3 mt-3 mb-0 rounded-3 shadow-sm">
                <div class="fw-bold fs-6 text-info-emphasis mb-1">
                    <i class="bi bi-info-circle-fill me-1"></i>ĐÃ CHUYỂN KHOẢN 1 PHẦN
                </div>
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small text-secondary">Đã nhận qua ngân hàng:</span>
                    <span class="fw-bold text-primary font-monospace">@Model.BankAmount.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-secondary">Tiền mặt còn thiếu cần thu:</span>
                    <span class="fw-bold text-danger font-monospace">@((Math.Max(0, Model.TotalAmount - Model.BankAmount)).ToString("N0")) đ</span>
                </div>
                <div class="small text-muted fst-italic">
                    * Bấm nút bên dưới để chuyển sang màn hình thu nốt tiền mặt và hoàn tất đơn hàng.
                </div>
            </div>
        }

        @if (Model.IsMissingIngredients)
        {
            <div class="alert alert-danger border-danger p-3 mt-3 mb-0 rounded-3 shadow-sm">
                <div class="fw-bold fs-6 text-danger mb-1">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>BARTENDER BÁO THIẾU NGUYÊN LIỆU
                </div>
                <div class="small text-dark mb-2">
                    @(string.IsNullOrEmpty(Model.MissingIngredientsDetail) ? "Món trong đơn bị thiếu nguyên liệu pha chế." : Model.MissingIngredientsDetail)
                </div>
                <div class="p-2 bg-white rounded border border-danger-subtle d-flex justify-content-between align-items-center">
                    <span class="small fw-semibold text-muted">Số tiền cần hoàn (Cả đơn hàng):</span>
                    <strong class="text-danger fs-6">@Model.TotalAmount.ToString("N0") đ</strong>
                </div>
                <div class="small text-muted mt-2 fst-italic">
                    * Thu ngân thực hiện hủy toàn bộ đơn này và hoàn lại tiền mặt cho khách. Khách có thể tạo lại order mới nếu cần.
                </div>
            </div>
        }

        @if (Model.RefundAmount > 0)
        {
            <div class="alert alert-danger p-2.5 mt-2 mb-0 rounded small">
                <div class="fw-bold mb-1"><i class="bi bi-arrow-return-left me-1"></i>ĐÃ HOÀN TIỀN MẶT: -@Model.RefundAmount.ToString("N0") đ</div>
                <div>- Lý do: <em>@Model.RefundReason</em></div>
                @if (Model.RefundedAt.HasValue)
                {
                    <div>- Thời gian hoàn: @Model.RefundedAt.Value.ToString("HH:mm dd/MM/yyyy")</div>
                }
                <div class="text-muted mt-1">(Số tiền hoàn đã được tự động trừ vào két tiền ca hiện tại)</div>
            </div>
        }
    </div>

    <h6 class="fw-bold mb-2 border-bottom pb-2 flex-shrink-0">Danh Sách Món</h6>
    <div class="table-responsive flex-grow-1" style="max-height: 200px; overflow-y: auto;">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 8%;">STT</th>
                    <th>Tên Món</th>
                    <th style="width: 15%;">Size</th>
                    <th style="width: 12%;">SL</th>
                    <th class="text-end" style="width: 20%;">Đơn Giá</th>
                    <th class="text-end" style="width: 25%;">Thành Tiền</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    var item = Model.Items[i];
                    <tr>
                        <td class="text-secondary">@(i + 1)</td>
                        <td class="fw-semibold text-dark">@item.ProductName</td>
                        <td><span class="badge bg-secondary">@item.Size</span></td>
                        <td>@item.Quantity</td>
                        <td class="text-end text-dark">@item.UnitPrice.ToString("N0") đ</td>
                        <td class="text-end fw-semibold text-dark">@item.Amount.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="bg-light p-3 rounded mt-3 flex-shrink-0 border">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-secondary small">Tạm tính:</span>
            <span class="fw-semibold text-dark font-monospace">@Model.SubtotalAmount.ToString("N0") đ</span>
        </div>
        @if (Model.DiscountAmount > 0)
        {
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-secondary small">Giảm giá:</span>
                <span class="fw-semibold text-danger font-monospace">-@Model.DiscountAmount.ToString("N0") đ</span>
            </div>
        }
        @if (Model.TradeDiscountAmount > 0)
        {
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-secondary small">Chiết khấu:</span>
                <span class="fw-semibold text-danger font-monospace">-@Model.TradeDiscountAmount.ToString("N0") đ</span>
            </div>
        }
        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
            <h6 class="fw-bold text-dark mb-0">TỔNG CỘNG:</h6>
            <h4 class="fw-bold text-success font-monospace mb-0">@Model.TotalAmount.ToString("N0") đ</h4>
        </div>
    </div>

    @{
        bool canRefund = ViewBag.CanRefund ?? true;
        string ineligibleMsg = ViewBag.IneligibleReason ?? "Chỉ thu ngân đang trong ca làm việc chính thức mới được phép thực hiện hoàn tiền / sửa đơn!";
        bool isPartiallyRefunded = (Model.RefundAmount > 0 && Model.RefundAmount < Model.TotalAmount && !Model.IsMissingIngredients);
        bool isFullyCancelledOrRefunded = (Model.RefundAmount >= Model.TotalAmount || Model.DisplayStatus.Contains("hủy") || Model.DisplayStatus.Contains("Hoàn tiền") || Model.PaymentStatus == "Cancelled");
        bool isUnpaid = (Model.PaymentStatus == "Unpaid" || Model.DisplayStatus == "Chờ thanh toán");
        bool isPartiallyPaid = (Model.PaymentStatus == "PartiallyPaid" || Model.DisplayStatus == "Thanh toán 1 phần");
        decimal remainingRefundable = Model.TotalAmount - Model.RefundAmount;
        decimal remainingDue = Math.Max(0, Model.TotalAmount - Model.BankAmount);
    }

    @if (Model.IsMissingIngredients)
    {
        <div class="mt-3 flex-shrink-0">
            @if (canRefund)
            {
                <button type="button" class="btn btn-danger fw-bold py-2.5 w-100 shadow-sm" onclick="triggerRefundForOrder('@Model.OrderId', @Model.TotalAmount)">
                    <i class="bi bi-x-circle-fill me-1.5"></i> Hủy toàn bộ đơn hàng &amp; Hoàn tiền mặt (@Model.TotalAmount.ToString("N0") đ)
                </button>
            }
            else
            {
                <span class="d-inline-block w-100" tabindex="0" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-placement="top" data-bs-title="<i class='bi bi-lock-fill me-1'></i> Không thể hủy đơn" data-bs-content="Chỉ thu ngân đang trong ca làm việc chính thức mới được phép hủy đơn / hoàn tiền mặt.<br><small class='text-muted'>Lý do: @ineligibleMsg</small>">
                    <button type="button" class="btn btn-outline-secondary btn-sm w-100 fw-semibold opacity-75" disabled style="pointer-events: none;">
                        <i class="bi bi-lock-fill me-1"></i>Hủy đơn thiếu nguyên liệu (Chưa trong ca trực)
                    </button>
                </span>
            }
        </div>
    }
    else if (isPartiallyRefunded)
    {
        <div class="mt-3 flex-shrink-0">
            @if (canRefund)
            {
                <button type="button" class="btn btn-outline-danger btn-sm w-100 fw-semibold py-2 shadow-sm" onclick="triggerRefundForOrder('@Model.OrderId', @remainingRefundable)">
                    <i class="bi bi-cash-stack me-1"></i>Hoàn tiền phần còn lại (@remainingRefundable.ToString("N0") đ)
                </button>
            }
            else
            {
                <span class="d-inline-block w-100" tabindex="0" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-placement="top" data-bs-title="<i class='bi bi-lock-fill me-1'></i> Không thể hoàn tiền" data-bs-content="Chỉ thu ngân đang trong ca làm việc chính thức mới được phép hoàn tiền mặt.<br><small class='text-muted'>Lý do: @ineligibleMsg</small>">
                    <button type="button" class="btn btn-outline-secondary btn-sm w-100 fw-semibold opacity-75" disabled style="pointer-events: none;">
                        <i class="bi bi-lock-fill me-1"></i>Hoàn tiền phần còn lại (Chưa trong ca trực)
                    </button>
                </span>
            }
        </div>
    }
    else if (isUnpaid)
    {
        <div class="mt-3 flex-shrink-0 d-flex flex-column gap-2">
            <a href="@Url.Action("BankTransferPayment", "SaleManagement", new { orderId = Model.OrderId })" class="btn btn-primary fw-bold py-2 w-100 shadow-sm">
                <i class="bi bi-qr-code-scan me-1"></i>Tiếp tục thanh toán (QR / Tiền mặt)
            </a>
            <button type="button" class="btn btn-outline-danger btn-sm w-100 fw-semibold py-2" onclick="cancelUnpaidOrder('@Model.OrderId')">
                <i class="bi bi-x-circle me-1"></i>Hủy đơn chưa thanh toán
            </button>
        </div>
    }
    else if (isPartiallyPaid)
    {
        <div class="mt-3 flex-shrink-0">
            <a href="@Url.Action("BankTransferPayment", "SaleManagement", new { orderId = Model.OrderId })" class="btn btn-warning fw-bold py-2 w-100 shadow-sm text-dark">
                <i class="bi bi-cash-coin me-1"></i>Thu nốt tiền mặt (@remainingDue.ToString("N0") đ) &amp; Hoàn tất đơn
            </a>
        </div>
    }
    else if (!isFullyCancelledOrRefunded)
    {
        <div class="mt-3 flex-shrink-0">
            @if (canRefund)
            {
                <button type="button" class="btn btn-outline-danger btn-sm w-100 fw-semibold py-2 shadow-sm" onclick="triggerRefundForOrder('@Model.OrderId', @Model.TotalAmount)">
                    <i class="bi bi-x-circle me-1"></i>Hủy đơn hàng &amp; Hoàn tiền mặt (@Model.TotalAmount.ToString("N0") đ)
                </button>
            }
            else
            {
                <span class="d-inline-block w-100" tabindex="0" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-placement="top" data-bs-title="<i class='bi bi-lock-fill me-1'></i> Không thể hủy đơn" data-bs-content="Chỉ thu ngân đang trong ca làm việc chính thức mới được phép hủy đơn / hoàn tiền mặt.<br><small class='text-muted'>Lý do: @ineligibleMsg</small>">
                    <button type="button" class="btn btn-outline-secondary btn-sm w-100 fw-semibold opacity-75" disabled style="pointer-events: none;">
                        <i class="bi bi-lock-fill me-1"></i>Hủy đơn hàng (Không đủ điều kiện ca làm)
                    </button>
                </span>
            }
        </div>
    }
    else
    {
        <div class="mt-3 flex-shrink-0">
            <span class="d-inline-block w-100" tabindex="0" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-placement="top" data-bs-title="<i class='bi bi-info-circle-fill text-warning me-1'></i> Đã hoàn tất" data-bs-content="Đơn hàng này đã được thực hiện hoàn tiền / hủy món thành công.">
                <button type="button" class="btn btn-outline-secondary btn-sm w-100 fw-semibold opacity-50" disabled style="pointer-events: none;">
                    <i class="bi bi-check-circle-fill me-1"></i>Đã hủy đơn / Hoàn tiền mặt toàn bộ
                </button>
            </span>
        </div>
    }
</div>

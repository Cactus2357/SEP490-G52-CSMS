@model SEP490_G52_CSMS.Models.ViewModels.CreateOrderViewModel

@{
    ViewData["Title"] = "Tạo đơn hàng";
}

<style>
    .create-order-container { display: flex; flex-direction: column; height: calc(100vh - 124px); overflow: hidden; }
    .create-order-row { display: flex; flex: 1; overflow: hidden; gap: 20px; }
    .catalog-column { flex: 0 0 58%; display: flex; flex-direction: column; overflow: hidden; }
    .cart-column { flex: 0 0 40%; display: flex; flex-direction: column; overflow: hidden; }
    .catalog-grid-wrapper { flex: 1; overflow-y: auto; padding-right: 5px; }
    .cart-card { display: flex; flex-direction: column; height: 100%; border: 1px solid var(--border-color); border-radius: 8px; box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075); background: var(--bg-card); }
    .cart-card-header { padding: 1rem; border-bottom: 1px solid var(--border-color); }
    .cart-card-body { flex: 1; display: flex; flex-direction: column; padding: 1rem; overflow: hidden; }
    .cart-items-wrapper { flex: 1; overflow-y: auto; }
    .cart-card-footer { padding-top: 1rem; border-top: 1px solid var(--border-color); }
</style>

<div class="create-order-container pt-2">
    @if (ViewBag.NotInShift == true)
    {
        <!-- Large Blocking Modal with Static Backdrop preventing screen interaction -->
        <div class="modal fade show d-block" id="notInShiftModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="false" style="background-color: rgba(0,0,0,0.7); z-index: 10550;">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="modal-header bg-danger text-white py-3 border-0">
                        <h4 class="modal-title fw-bold">
                            <i class="bi bi-exclamation-octagon-fill me-2"></i>BẠN HỆN KHÔNG TRONG CA LÀM VIỆC
                        </h4>
                    </div>
                    <div class="modal-body p-4 p-md-5 text-center">
                        <div class="mb-4">
                            <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle p-4 mb-3" style="width: 100px; height: 100px;">
                                <i class="bi bi-clock-history display-4"></i>
                            </div>
                            <h4 class="fw-bold text-dark mb-2">Chưa Đến Ca Làm Hoặc Chưa Mở Ca</h4>
                            <p class="text-muted fs-5 mb-0">
                                @ViewBag.NotInShiftMessage
                            </p>
                        </div>

                        <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-dark py-3 px-4 rounded-3 text-start small mb-4">
                            <i class="bi bi-info-circle-fill me-2 text-warning"></i>
                            <strong>Lưu ý:</strong> Để đảm bảo tính chính xác về doanh thu và kiểm kê két tiền hàng ca, hệ thống yêu cầu nhân viên thu ngân phải ở trong ca làm việc được phân công hoặc hoàn tất mở bàn giao ca trước khi thực hiện bán hàng.
                        </div>

                        <div class="d-flex justify-content-center gap-3 flex-wrap">
                            <a href="/CashHandover/Handover" class="btn btn-danger btn-lg px-4 py-2.5 rounded-pill fw-bold shadow-sm">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Mở Ca / Bàn Giao Ca Ngay
                            </a>
                            <a href="/Home/Index" class="btn btn-outline-secondary btn-lg px-4 py-2.5 rounded-pill fw-semibold">
                                <i class="bi bi-house me-2"></i>Về Trang Chủ
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <!-- Main Two Columns -->
    <div class="create-order-row">
        <!-- Left Column: Product Catalog -->
        <div class="catalog-column">
            <div class="catalog-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 border-bottom pb-2">
                <h3 class="fw-bold text-dark mb-0">Tạo đơn hàng</h3>
                <button type="button" class="btn btn-outline-primary btn-sm fw-semibold shadow-sm" onclick="openCustomerMonitor()">
                    <i class="bi bi-display me-1"></i> Mở màn hình phụ (Khách)
                </button>
            </div>
            
            <div class="catalog-search-bar d-flex align-items-center gap-2 mb-3 w-100">
                <div class="position-relative flex-grow-1">
                    <i class="bi bi-search position-absolute" style="left: 12px; top: 10px; color: #6c757d;"></i>
                    <input type="text" id="productSearch" class="form-control ps-5" placeholder="Tìm kiếm sản phẩm..." onkeyup="filterProducts()">
                </div>
                <div style="width: 160px; flex-shrink: 0;">
                    <select id="categoryFilter" class="form-select fw-semibold" onchange="filterProducts()">
                        <option value="">Tất cả loại</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.CategoryId">@cat.CategoryName</option>
                        }
                    </select>
                </div>
            </div>

            <div class="catalog-grid-wrapper">
                <div class="row g-2" id="productGrid">
                    @foreach (var product in Model.MenuProducts)
                    {
                        <div class="col-xl-6 col-12 product-card" data-category="@product.CategoryId" data-name="@product.ProductName.ToLower()">
                            <div class="card border shadow-sm p-2 d-flex flex-row align-items-center bg-white" style="min-height: 90px; height: auto;">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.ProductName"
                                         class="border rounded me-3"
                                         style="width: 50px !important; height: 50px !important; object-fit: cover; flex-shrink: 0; display: block;" />
                                }
                                else
                                {
                                    <div class="border rounded bg-light me-3 d-flex justify-content-center align-items-center text-muted" style="width: 50px; height: 50px; font-size: 1.5rem; flex-shrink: 0;">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                                <div class="flex-grow-1 min-width-0 me-2">
                                    <div class="fw-bold text-dark text-truncate small" title="@product.ProductName">@product.ProductName</div>
                                    <div class="text-secondary small mt-1">@product.DefaultPrice.ToString("N0") đ</div>
                                </div>
                                <div style="flex-shrink: 0;">
                                    <button type="button" class="btn btn-primary btn-sm fw-semibold px-2.5 py-1 shadow-sm"
                                        onclick='addToCart(@product.ProductId, "@product.ProductName", @Html.Raw(Json.Serialize(product.Variants)))'>Thêm</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div id="noProductsMsg" class="d-none text-center mt-5 text-muted py-4">
                    <i class="bi bi-search display-6 d-block mb-3 opacity-50"></i>
                    Không tìm thấy sản phẩm phù hợp.
                </div>
            </div>
        </div>

        <!-- Right Column: Cart & Checkout -->
        <div class="cart-column">
            <div class="cart-card">
                <div class="cart-card-header">
                    <h5 class="fw-bold mb-0 text-uppercase text-dark">
                        <i class="bi bi-cart3 me-2 text-primary"></i>Giỏ Hàng
                    </h5>
                </div>
                <div class="cart-card-body">
                    <div class="cart-items-wrapper">
                        <table class="table align-middle" id="cartTable">
                            <thead>
                                <tr class="border-bottom text-muted small">
                                    <th>Tên</th>
                                    <th>Đơn Giá</th>
                                    <th class="text-end">Thành Tiền</th>
                                    <th class="text-end">Hành Động</th>
                                </tr>
                            </thead>
                            <tbody id="cartBody">
                                <!-- Cart items rendered by JS -->
                            </tbody>
                        </table>
                    </div>

                    <div class="cart-card-footer">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-semibold mb-0 text-secondary">Tổng tiền:</h5>
                            <h3 class="fw-bold text-success mb-0" id="totalAmount">0 đ</h3>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary small">Người nhận:</label>
                            <input type="text" id="recipientName" class="form-control" placeholder="Nhập tên người nhận (Tùy chọn)...">
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary w-50 fw-semibold" onclick="cancelOrder()">Hủy</button>
                            <button type="button" class="btn btn-primary w-50 fw-semibold" onclick="showPaymentModal()">Thanh toán</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: Payment Method Selection -->
<div class="modal fade" id="paymentMethodModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom py-3 bg-light">
                <h4 class="modal-title fw-extrabold text-dark fs-4"><i class="bi bi-credit-card me-2 text-primary"></i>Xác nhận phương thức thanh toán</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="table-responsive mb-3" style="max-height: 280px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0" id="reviewCartTable">
                        <thead class="table-light">
                            <tr>
                                <th class="fs-5 fw-bold">Tên sản phẩm</th>
                                <th class="fs-5 fw-bold">Size</th>
                                <th class="text-center fs-5 fw-bold">Số lượng</th>
                                <th class="text-end fs-5 fw-bold">Đơn giá</th>
                                <th class="text-end pe-3 fs-5 fw-bold">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody id="reviewCartBody" class="fs-5">
                            <!-- Filled by JS -->
                        </tbody>
                    </table>
                </div>

                <div class="d-flex align-items-center justify-content-between bg-light-subtle p-3 rounded-3 mb-4 border">
                    <h5 class="fw-bold mb-0 text-secondary fs-4">TỔNG TIỀN ĐƠN HÀNG:</h5>
                    <div class="fs-2 fw-bold text-success mb-0" id="reviewTotalAmount">0 đ</div>
                </div>

                <!-- Cash Payment Details Section (Hidden until "Tiền mặt" is clicked) -->
                <div id="cashPaymentSection" class="d-none border border-primary border-2 rounded-3 p-4 bg-white mb-4 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                        <h5 class="fw-bold text-primary mb-0 fs-4"><i class="bi bi-cash-stack me-2"></i>Chi tiết thanh toán tiền mặt</h5>
                        <button type="button" class="btn btn-outline-primary btn-sm fs-6 fw-bold px-3" id="btnShowTransferAgain" onclick="resetCashPaymentMode()">
                            <i class="bi bi-arrow-left-right me-1"></i>Đổi sang Chuyển khoản
                        </button>
                    </div>
                    <div class="row g-3 align-items-center mb-3">
                        <div class="col-md-6">
                            <label for="customerCashInput" class="form-label fw-bold text-dark fs-5">Tiền khách đưa (VNĐ): <span class="text-danger">*</span></label>
                            <input type="number" id="customerCashInput" class="form-control form-control-lg fs-3 fw-bold text-primary py-2" placeholder="Nhập số tiền..." oninput="calculateCashChange()" step="1000" min="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark fs-5">Tiền thừa trả khách:</label>
                            <div class="form-control form-control-lg fs-3 fw-bold bg-light py-2" id="changeAmountDisplay">0 đ</div>
                        </div>
                    </div>

                    <!-- Quick Cash Entry Shortcuts -->
                    <div class="d-flex flex-wrap gap-2 align-items-center pt-2">
                        <span class="fs-6 fw-bold text-muted me-2">Gợi ý nhanh:</span>
                        <button type="button" class="btn btn-outline-secondary fs-5 fw-semibold rounded-pill px-3 py-1" onclick="setQuickCash('exact')">Vừa đủ</button>
                        <button type="button" class="btn btn-outline-secondary fs-5 fw-semibold rounded-pill px-3 py-1" onclick="setQuickCash(50000)">50.000đ</button>
                        <button type="button" class="btn btn-outline-secondary fs-5 fw-semibold rounded-pill px-3 py-1" onclick="setQuickCash(100000)">100.000đ</button>
                        <button type="button" class="btn btn-outline-secondary fs-5 fw-semibold rounded-pill px-3 py-1" onclick="setQuickCash(200000)">200.000đ</button>
                        <button type="button" class="btn btn-outline-secondary fs-5 fw-semibold rounded-pill px-3 py-1" onclick="setQuickCash(500000)">500.000đ</button>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center border-top pt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 py-2 fs-5 fw-bold" data-bs-dismiss="modal">Quay lại</button>
                    <div class="d-flex gap-2" id="paymentOptionsContainer">
                        <button type="button" class="btn btn-success px-4 py-2 fs-4 fw-bold shadow-sm" id="btnChooseCash" onclick="selectCashPaymentMode()">
                            <i class="bi bi-cash me-2"></i>Tiền mặt
                        </button>
                        <button type="button" class="btn btn-primary px-4 py-2 fs-4 fw-bold shadow-sm" id="btnChooseBankTransfer" onclick="initiateBankTransfer()">
                            <i class="bi bi-qr-code-scan me-2"></i>Chuyển khoản
                        </button>
                        <button type="button" class="btn btn-success px-4 py-2 fs-4 fw-bold shadow-sm d-none" id="btnConfirmCashSubmit" onclick="confirmCashPaymentSubmit()">
                            <i class="bi bi-check-circle me-2"></i>Xác nhận thanh toán tiền mặt
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    <div id="statusToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2">
                <i id="toastIcon" class="bi text-white fs-5"></i>
                <span id="toastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var cart = []; 
        var currentOrderId = null;

        // Load cart from localStorage on init
        try {
            var savedCart = localStorage.getItem('csms_cart');
            if (savedCart) {
                cart = JSON.parse(savedCart);
            }
        } catch (e) {
            console.error("Failed to load cart from localStorage", e);
        }

        document.addEventListener("DOMContentLoaded", function() {
            var urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('showCheckout') === 'true') {
                currentOrderId = urlParams.get('orderId');
                renderCart();
                renderReviewCarts();
                var modal = new bootstrap.Modal(document.getElementById('paymentMethodModal'));
                modal.show();
                // Clean URL query parameters
                window.history.replaceState({}, document.title, window.location.pathname);
            } else {
                renderCart();
            }
        });

        function openCustomerMonitor() {
            window.open('@Url.Action("CustomerMonitor", "SaleManagement")', 'customerMonitorWindow', 'width=1024,height=768');
        }

        function showToast(message, isError = false) {
            const toastEl = document.getElementById('statusToast');
            const toastIcon = document.getElementById('toastIcon');
            const toastMessage = document.getElementById('toastMessage');

            if (isError) {
                toastEl.className = 'toast align-items-center text-white bg-danger border-0';
                toastIcon.className = 'bi bi-exclamation-triangle-fill';
            } else {
                toastEl.className = 'toast align-items-center text-white bg-success border-0';
                toastIcon.className = 'bi bi-check-circle-fill';
            }

            toastMessage.textContent = message;

            const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
            toast.show();
        }

        function filterProducts() {
            var search = document.getElementById("productSearch").value.toLowerCase();
            var cat = document.getElementById("categoryFilter").value;
            var cards = document.querySelectorAll('.product-card');
            var visibleCount = 0;

            cards.forEach(card => {
                var cName = card.getAttribute('data-name');
                var cCat = card.getAttribute('data-category');
                
                var matchSearch = cName.includes(search);
                var matchCat = cat === "" || cCat === cat;

                if (matchSearch && matchCat) {
                    card.classList.remove('d-none');
                    visibleCount++;
                } else {
                    card.classList.add('d-none');
                }
            });

            if (visibleCount === 0) {
                document.getElementById("noProductsMsg").classList.remove("d-none");
            } else {
                document.getElementById("noProductsMsg").classList.add("d-none");
            }
        }

        function addToCart(pId, pName, variants) {
            if (@(ViewBag.NotInShift == true ? "true" : "false")) {
                showToast("Bạn hiện không ở trong ca làm việc nên không thể bán hàng.", "warning");
                return;
            }

            var defVariant = variants.find(v => v.sizeVariant === "S") || variants[0];
            var cartId = Date.now().toString(); 
            cart.push({
                cartId: cartId,
                productId: pId,
                name: pName,
                variants: variants,
                selectedVariantId: defVariant.variantId,
                quantity: 1,
                unitPrice: defVariant.sellingPrice
            });
            renderCart();
        }

        function renderCart() {
            var tbody = document.getElementById("cartBody");
            var html = '';
            var total = 0;

            cart.forEach((item, index) => {
                var itemTotal = item.quantity * item.unitPrice;
                total += itemTotal;

                // Toggle badges for sizes
                var sizeOptions = item.variants.map(v => 
                    `<span class="badge ${v.variantId == item.selectedVariantId ? 'bg-primary' : 'bg-light text-dark border'} mx-0.5" style="cursor:pointer;" 
                        onclick="changeSize('${item.cartId}', ${v.variantId}, ${v.sellingPrice})">${v.sizeVariant}</span>`
                ).join('');

                html += `
                    <tr>
                        <td class="align-middle border-0 py-3 fw-semibold text-dark">${item.name}</td>
                        <td class="align-middle border-0 py-3 text-secondary text-nowrap">${item.unitPrice.toLocaleString('vi-VN')} đ</td>
                        <td class="align-middle border-0 py-3 text-end fw-bold text-success text-nowrap">${itemTotal.toLocaleString('vi-VN')} đ</td>
                        <td class="align-middle border-0 py-3 text-end">
                            <div class="d-flex align-items-center justify-content-end flex-wrap gap-2">
                                <div>${sizeOptions}</div>
                                <div>
                                    <input type="number" class="form-control form-control-sm text-center" style="width: 70px;" value="${item.quantity}" min="1" onchange="updateQuantity('${item.cartId}', this.value)">
                                </div>
                                <button class="btn btn-sm btn-outline-danger px-2" onclick="removeFromCart('${item.cartId}')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            tbody.innerHTML = html;
            document.getElementById("totalAmount").innerText = total.toLocaleString('vi-VN') + " đ";
            localStorage.setItem('csms_cart', JSON.stringify(cart));

            // Sync with Customer Monitor if open
            try {
                localStorage.setItem('customer_display_state', JSON.stringify({
                    mode: 'Cart',
                    cart: cart,
                    total: total
                }));
            } catch (e) {
                console.error(e);
            }
        }

        function changeSize(cartId, variantId, newPrice) {
            var item = cart.find(i => i.cartId === cartId);
            if (item) {
                item.selectedVariantId = variantId;
                item.unitPrice = newPrice;
                renderCart();
            }
        }

        function updateQuantity(cartId, newQuantity) {
            var item = cart.find(i => i.cartId === cartId);
            if (item) {
                var q = parseInt(newQuantity);
                if (isNaN(q) || q < 1) q = 1;
                item.quantity = q;
                renderCart();
            }
        }

        function removeFromCart(cartId) {
            cart = cart.filter(i => i.cartId !== cartId);
            renderCart();
        }

        function cancelOrder() {
            if (cart.length > 0) {
                showConfirmModal(
                    'Hủy đơn hàng',
                    'Bạn có chắc muốn hủy đơn hàng này không?',
                    function() {
                        cart = [];
                        document.getElementById("recipientName").value = "";
                        renderCart();
                        localStorage.removeItem('csms_cart');
                    }
                );
            }
        }

        var cartIdempotencyKey = null;

        function generateIdempotencyKey() {
            return 'IDEM-' + Date.now() + '-' + Math.random().toString(36).substring(2, 9);
        }

        function syncCustomerMonitor(mode = 'Cart', extraData = {}) {
            var total = cart.reduce((sum, item) => sum + item.quantity * item.unitPrice, 0);
            var payload = {
                mode: mode,
                cart: cart,
                total: total,
                timestamp: new Date().getTime(),
                ...extraData
            };
            localStorage.setItem('customer_display_state', JSON.stringify(payload));
        }

        function showPaymentModal() {
            if (@(ViewBag.NotInShift == true ? "true" : "false")) {
                showToast("Bạn hiện không ở trong ca làm việc nên không thể bán hàng.", "warning");
                return;
            }

            if (cart.length === 0) {
                showToast("Vui lòng thêm ít nhất 1 sản phẩm vào đơn hàng.", true);
                return;
            }
            var recipient = document.getElementById("recipientName").value.trim();

            // Gộp các sản phẩm trùng lặp (cùng selectedVariantId)
            var mergedCart = [];
            cart.forEach(item => {
                var existing = mergedCart.find(m => m.selectedVariantId === item.selectedVariantId);
                if (existing) {
                    existing.quantity += item.quantity;
                } else {
                    mergedCart.push(item);
                }
            });
            cart = mergedCart;
            renderCart(); // Cập nhật lại giao diện giỏ hàng ngoài màn hình chính

            if (!cartIdempotencyKey) {
                cartIdempotencyKey = generateIdempotencyKey();
            }

            var orderData = {
                recipientName: recipient,
                idempotencyKey: cartIdempotencyKey,
                items: cart.map(i => ({ variantId: i.selectedVariantId, quantity: i.quantity, unitPrice: i.unitPrice }))
            };

            fetch('@Url.Action("SubmitOrder", "SaleManagement")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(orderData)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    currentOrderId = data.orderId;
                    renderReviewCarts();
                    var modal = new bootstrap.Modal(document.getElementById('paymentMethodModal'));
                    modal.show();
                } else {
                    showToast("Lỗi khi tạo đơn hàng: " + data.message, true);
                }
            });
        }

        var currentOrderTotalAmount = 0;

        function renderReviewCarts() {
            var html = '';
            var total = 0;
            cart.forEach((item) => {
                var itemTotal = item.quantity * item.unitPrice;
                total += itemTotal;
                var selectedSize = item.variants.find(v => v.variantId === item.selectedVariantId).sizeVariant;

                html += `
                    <tr>
                        <td class="fw-bold text-dark fs-4">${item.name}</td>
                        <td><span class="badge bg-secondary-subtle text-dark fs-5">${selectedSize}</span></td>
                        <td class="text-center fw-bold fs-4">${item.quantity}</td>
                        <td class="text-end fs-4">${item.unitPrice.toLocaleString('vi-VN')} đ</td>
                        <td class="text-end pe-3 fw-bold text-success fs-4">${itemTotal.toLocaleString('vi-VN')} đ</td>
                    </tr>
                `;
            });
            currentOrderTotalAmount = total;
            document.getElementById("reviewCartBody").innerHTML = html;
            
            var tStr = total.toLocaleString('vi-VN') + " đ";
            document.getElementById("reviewTotalAmount").innerText = tStr;

            // Reset cash payment mode options
            resetCashPaymentMode();
        }

        function resetCashPaymentMode() {
            $('#cashPaymentSection').addClass('d-none');
            $('#btnChooseBankTransfer').removeClass('d-none');
            $('#btnChooseCash').removeClass('d-none');
            $('#btnConfirmCashSubmit').addClass('d-none');
            $('#customerCashInput').val('');
            $('#changeAmountDisplay').text('0 đ').removeClass('text-danger text-success').addClass('text-dark');
        }

        function selectCashPaymentMode() {
            // Hide transfer button and show cash input section
            $('#btnChooseBankTransfer').addClass('d-none');
            $('#btnChooseCash').addClass('d-none');
            $('#cashPaymentSection').removeClass('d-none');
            $('#btnConfirmCashSubmit').removeClass('d-none');
            $('#customerCashInput').focus();
            calculateCashChange();
        }

        function setQuickCash(val) {
            if (val === 'exact') {
                $('#customerCashInput').val(currentOrderTotalAmount);
            } else {
                $('#customerCashInput').val(val);
            }
            calculateCashChange();
        }

        function calculateCashChange() {
            var given = parseFloat($('#customerCashInput').val()) || 0;
            var change = given - currentOrderTotalAmount;
            var changeEl = $('#changeAmountDisplay');

            if (given <= 0) {
                changeEl.text('0 đ').removeClass('text-danger text-success').addClass('text-dark');
            } else if (change < 0) {
                changeEl.text('Còn thiếu ' + Math.abs(change).toLocaleString('vi-VN') + ' đ')
                        .removeClass('text-dark text-success').addClass('text-danger');
            } else {
                changeEl.text(change.toLocaleString('vi-VN') + ' đ')
                        .removeClass('text-dark text-danger').addClass('text-success');
            }
        }

        function confirmCashPaymentSubmit() {
            var given = parseFloat($('#customerCashInput').val()) || 0;
            if (given < currentOrderTotalAmount) {
                var missing = currentOrderTotalAmount - given;
                showToast('Tiền khách đưa chưa đủ để thanh toán (còn thiếu ' + missing.toLocaleString('vi-VN') + ' đ)!', 'warning');
                $('#customerCashInput').focus();
                return;
            }

            showConfirmModal(
                'Xác nhận thanh toán tiền mặt',
                'Xác nhận khách hàng đã thanh toán ' + given.toLocaleString('vi-VN') + ' đ bằng tiền mặt?',
                function() {
                    processPayment('Cash');
                }
            );
        }

        function initiateBankTransfer() {
            if (!currentOrderId) {
                showToast("Không tìm thấy thông tin đơn hàng.", true);
                return;
            }
            
            var formData = new URLSearchParams();
            formData.append('orderId', currentOrderId);
            
            fetch('@Url.Action("SelectBankTransfer", "SaleManagement")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    var modal = bootstrap.Modal.getInstance(document.getElementById('paymentMethodModal'));
                    if (modal) modal.hide();
                    window.location.href = '@Url.Action("BankTransferPayment", "SaleManagement")?orderId=' + currentOrderId;
                } else {
                    showToast("Lỗi ghi nhận phương thức thanh toán chuyển khoản.", true);
                }
            })
            .catch(err => {
                console.error(err);
                showToast("Lỗi kết nối hệ thống.", true);
            });
        }

        function processPayment(method) {
            var formData = new URLSearchParams();
            formData.append('orderId', currentOrderId);
            formData.append('paymentMethod', method);

            if (method === 'Cash') {
                var given = parseFloat($('#customerCashInput').val()) || 0;
                var change = Math.max(0, given - currentOrderTotalAmount);
                formData.append('customerCash', given);
                formData.append('changeAmount', change);
            }

            fetch('@Url.Action("ProcessPayment", "SaleManagement")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    var m1 = bootstrap.Modal.getInstance(document.getElementById('paymentMethodModal'));
                    if (m1) m1.hide();
                    
                    showToast("Thanh toán thành công! Đơn hàng đã được chuyển xuống bộ phận Pha chế.");
                    
                    syncCustomerMonitor('PaidSuccess');

                    cart = [];
                    cartIdempotencyKey = null;
                    document.getElementById("recipientName").value = "";
                    currentOrderId = null;
                    localStorage.removeItem('csms_cart');
                    renderCart();
                } else {
                    showToast("Lỗi thanh toán: " + data.message, true);
                }
            });
        }
    </script>
}

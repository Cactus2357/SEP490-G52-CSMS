@model SEP490_G52_CSMS.Models.ViewModels.OrderHistoryViewModel

@{
    ViewData["Title"] = "Lịch sử đơn đặt hàng";
}

<div class="container-fluid mt-4">
    <h2 class="fw-bold mb-4">CHI TIẾT ĐƠN HÀNG</h2>
    <div class="row">
        <!-- Left Panel: List -->
        <div class="col-md-7 border-end border-dark">
            <h4 class="fw-bold mb-3">Danh sách đơn hàng</h4>
            
            <form method="get" asp-action="OrderHistory" id="filterForm">
                <div class="row mb-3 g-2 align-items-center">
                    <div class="col-auto">
                        <label class="col-form-label">trạng thái:</label>
                    </div>
                    <div class="col-auto">
                        <select name="status" class="form-select border-dark rounded-0" onchange="document.getElementById('filterForm').submit()">
                            <option value="Tất cả" selected="@(Model.StatusFilter == "Tất cả")">tất cả</option>
                            <option value="Đang xử lý" selected="@(Model.StatusFilter == "Đang xử lý")">đang xử lý</option>
                            <option value="Đã hoàn thành" selected="@(Model.StatusFilter == "Đã hoàn thành")">đã hoàn thành</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <label class="col-form-label">từ ngày</label>
                    </div>
                    <div class="col-auto">
                        <input type="date" name="fromDate" class="form-control border-dark rounded-0" value="@Model.FromDate?.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="col-auto">
                        <label class="col-form-label">đến ngày</label>
                    </div>
                    <div class="col-auto">
                        <input type="date" name="toDate" class="form-control border-dark rounded-0" value="@Model.ToDate?.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-outline-dark rounded-0"><i class="bi bi-calendar"></i></button>
                    </div>
                </div>

                <div class="position-relative mb-3">
                    <i class="bi bi-search position-absolute" style="left: 10px; top: 8px;"></i>
                    <input type="text" name="search" class="form-control border-dark rounded-0 ps-5" placeholder="Search" value="@Model.SearchKeyword">
                </div>
            </form>

            <table class="table table-bordered border-dark">
                <thead class="table-light border-dark">
                    <tr>
                        <th>STT</th>
                        <th>mã đơn hàng</th>
                        <th>tên</th>
                        <th>thời gian</th>
                        <th>trạng thái</th>
                        <th>hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Orders.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center">Không có đơn hàng nào</td>
                        </tr>
                    }
                    else
                    {
                        for (int i = 0; i < Model.Orders.Count; i++)
                        {
                            var o = Model.Orders[i];
                            var stt = (Model.CurrentPage - 1) * 10 + i + 1;
                            <tr>
                                <td>@stt</td>
                                <td>@o.OrderId</td>
                                <td>@o.RecipientName</td>
                                <td>@o.OrderTime.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@o.DisplayStatus</td>
                                <td><a href="#" class="text-primary text-decoration-none" onclick="loadOrderDetails('@o.OrderId')">xem</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-center">
                    <ul class="pagination">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link border-0 text-dark" href="?page=@(Model.CurrentPage-1)&status=@Model.StatusFilter&fromDate=@Model.FromDate?.ToString("yyyy-MM-dd")&toDate=@Model.ToDate?.ToString("yyyy-MM-dd")&search=@Model.SearchKeyword">&lt; Trước,</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link border-0 text-dark @(p == Model.CurrentPage ? "fw-bold" : "")" href="?page=@p&status=@Model.StatusFilter&fromDate=@Model.FromDate?.ToString("yyyy-MM-dd")&toDate=@Model.ToDate?.ToString("yyyy-MM-dd")&search=@Model.SearchKeyword">@p,</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link border-0 text-dark" href="?page=@(Model.CurrentPage+1)&status=@Model.StatusFilter&fromDate=@Model.FromDate?.ToString("yyyy-MM-dd")&toDate=@Model.ToDate?.ToString("yyyy-MM-dd")&search=@Model.SearchKeyword">Sau &gt;</a>
                        </li>
                    </ul>
                </div>
            }
        </div>

        <!-- Right Panel: Order Details -->
        <div class="col-md-5" id="orderDetailsPanel">
            <h4 class="fw-bold text-muted mt-3">Chọn một đơn hàng để xem chi tiết</h4>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadOrderDetails(orderId) {
            fetch('@Url.Action("GetOrderDetails", "SaleManagement")?orderId=' + orderId)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('orderDetailsPanel').innerHTML = html;
                });
        }
    </script>
}

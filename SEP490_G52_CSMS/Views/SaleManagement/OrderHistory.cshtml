@model SEP490_G52_CSMS.Models.ViewModels.OrderHistoryViewModel

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<style>
    .order-history-container { display: flex; flex-direction: column; height: calc(100vh - 124px); overflow: hidden; }
    .order-history-row { display: flex; flex: 1; overflow: hidden; gap: 20px; }
    .history-list-column { flex: 0 0 58%; display: flex; flex-direction: column; overflow: hidden; }
    .history-filter-card { flex-shrink: 0; }
    .history-table-wrapper { flex: 1; overflow-y: auto; background: white; border: 1px solid var(--border-color); border-radius: 8px; }
    .history-pagination-wrapper { flex-shrink: 0; margin-top: 10px; }
    .history-detail-column { flex: 0 0 40%; display: flex; flex-direction: column; overflow: hidden; }
    .history-detail-card { display: flex; flex-direction: column; height: 100%; border: 1px solid var(--border-color); border-radius: 8px; box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075); background: var(--bg-card); overflow: hidden; }
    .exchange-menu-card { max-height: 320px; overflow-y: auto; }
    .exchange-item-row { transition: background-color 0.2s; }
    .exchange-item-row:hover { background-color: #f8f9fa; }
    .history-order-row { cursor: pointer; transition: all 0.15s ease-in-out; }
    .history-order-row.selected-order { background-color: #e8f0fe !important; outline: 2px solid var(--bs-primary); }

    @@media print {
        body * {
            visibility: hidden !important;
        }
        #k80ReceiptContainer, #k80ReceiptContainer * {
            visibility: visible !important;
        }
        #k80ReceiptContainer {
            position: fixed !important;
            left: 0 !important;
            top: 0 !important;
            width: 76mm !important;
            margin: 0 !important;
            padding: 2mm 3mm !important;
            border: none !important;
            box-shadow: none !important;
            background: #fff !important;
            font-family: 'Courier New', Courier, monospace !important;
            font-size: 13px !important;
            line-height: 1.35 !important;
            color: #000 !important;
            z-index: 999999 !important;
        }
        @@page {
            size: 80mm auto;
            margin: 0;
        }
    }
</style>

<div class="order-history-container px-4 pt-3">
    <!-- Tiêu đề -->
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2 flex-shrink: 0;">
        <h3 class="fw-bold mb-0 text-uppercase text-dark">
            <i class="bi bi-clock-history text-primary me-2"></i>Lịch sử đơn hàng
        </h3>
    </div>

    <div class="order-history-row">
        <!-- Left Panel: List -->
        <div class="history-list-column">
            <!-- Filter & Search Card -->
            <div class="card border shadow-sm mb-3 history-filter-card">
                <div class="card-body py-2.5 px-3">
                    <form method="get" asp-action="OrderHistory" id="filterForm" class="row g-2 align-items-end">
                        <div class="col-sm-4">
                            <label class="form-label fw-semibold text-secondary small mb-1">Trạng thái</label>
                            <select name="status" class="form-select form-select-sm" onchange="document.getElementById('filterForm').submit()">
                                <option value="Tất cả" selected="@(Model.StatusFilter == "Tất cả")">Tất cả</option>
                                <option value="Đang chờ pha chế" selected="@(Model.StatusFilter == "Đang chờ pha chế")">Đang chờ pha chế</option>
                                <option value="Đang pha chế" selected="@(Model.StatusFilter == "Đang pha chế")">Đang pha chế</option>
                                <option value="Đã pha chế xong" selected="@(Model.StatusFilter == "Đã pha chế xong")">Đã pha chế xong</option>
                                <option value="Đã giao hàng" selected="@(Model.StatusFilter == "Đã giao hàng" || Model.StatusFilter == "Đã hoàn thành" || Model.StatusFilter == "Hoàn thành")">Đã giao hàng</option>
                                <option value="Chờ thanh toán" selected="@(Model.StatusFilter == "Chờ thanh toán")">Chờ thanh toán</option>
                                <option value="Thanh toán 1 phần" selected="@(Model.StatusFilter == "Thanh toán 1 phần")">Thanh toán 1 phần</option>
                                <option value="Thiếu nguyên liệu" selected="@(Model.StatusFilter == "Thiếu nguyên liệu" || Model.StatusFilter == "Thiếu nguyên liệu / Chờ xử lý")">Thiếu nguyên liệu</option>
                                <option value="Đã hủy" selected="@(Model.StatusFilter == "Đã hủy" || Model.StatusFilter == "Đã hủy / Hoàn tiền")">Đã hủy</option>
                            </select>
                        </div>
                        
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold text-secondary small mb-1">Khoảng thời gian</label>
                            <div class="d-flex align-items-center">
                                <input type="date" name="fromDate" class="form-control form-control-sm" value="@Model.FromDate?.ToString("yyyy-MM-dd")">
                                <span class="text-muted small px-3">đến</span>
                                <input type="date" name="toDate" class="form-control form-control-sm" value="@Model.ToDate?.ToString("yyyy-MM-dd")">
                            </div>
                        </div>

                        <div class="col-sm-2">
                            <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
                                <i class="bi bi-filter me-1"></i>Lọc
                            </button>
                        </div>

                        <div class="col-12 mt-2">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-secondary"><i class="bi bi-search"></i></span>
                                <input type="text" name="search" class="form-control" placeholder="Tìm theo mã đơn hàng hoặc tên khách hàng..." value="@Model.SearchKeyword">
                            </div>
                        </div>

                        <!-- Quick Filter Buttons -->
                        <div class="col-12 mt-2 pt-2 border-top d-flex align-items-center flex-wrap gap-2">
                            <button type="button" class="btn btn-sm rounded-pill px-2.5 py-0.5 fw-semibold @(Model.StatusFilter == "Tất cả" ? "btn-dark text-white shadow-sm" : "btn-outline-secondary")" style="font-size: 0.78rem;" onclick="quickFilterStatus('Tất cả')">
                                Tất cả
                            </button>
                            <button type="button" class="btn btn-sm rounded-pill px-2.5 py-0.5 fw-semibold @(Model.StatusFilter == "Đang chờ pha chế" ? "btn-warning text-dark shadow-sm" : "btn-outline-warning text-dark")" style="font-size: 0.78rem;" onclick="quickFilterStatus('Đang chờ pha chế')">
                                <i class="bi bi-clock-history me-1"></i>Chờ pha chế
                            </button>
                            <button type="button" class="btn btn-sm rounded-pill px-2.5 py-0.5 fw-semibold @(Model.StatusFilter == "Đang pha chế" ? "btn-primary text-white shadow-sm" : "btn-outline-primary")" style="font-size: 0.78rem;" onclick="quickFilterStatus('Đang pha chế')">
                                <i class="bi bi-cup-hot me-1"></i>Đang pha chế
                            </button>
                            <button type="button" class="btn btn-sm rounded-pill px-2.5 py-0.5 fw-semibold @(Model.StatusFilter == "Đã pha chế xong" ? "btn-info text-white shadow-sm" : "btn-outline-info text-dark")" style="font-size: 0.78rem;" onclick="quickFilterStatus('Đã pha chế xong')">
                                <i class="bi bi-check2-circle me-1"></i>Đã pha xong
                            </button>
                            <button type="button" class="btn btn-sm rounded-pill px-2.5 py-0.5 fw-semibold @(Model.StatusFilter == "Đã giao hàng" || Model.StatusFilter == "Đã hoàn thành" || Model.StatusFilter == "Hoàn thành" ? "btn-success text-white shadow-sm" : "btn-outline-success")" style="font-size: 0.78rem;" onclick="quickFilterStatus('Đã giao hàng')">
                                <i class="bi bi-box-seam me-1"></i>Đã giao hàng
                            </button>
                            <button type="button" class="btn btn-sm rounded-pill px-2.5 py-0.5 fw-semibold @(Model.StatusFilter == "Thiếu nguyên liệu" || Model.StatusFilter == "Thiếu nguyên liệu / Chờ xử lý" ? "btn-danger text-white shadow-sm" : "btn-outline-danger")" style="font-size: 0.78rem;" onclick="quickFilterStatus('Thiếu nguyên liệu')">
                                <i class="bi bi-exclamation-octagon me-1"></i>Thiếu NL
                            </button>
                        </div>
                    </form>
                </div>
            </div>
 
            <!-- Orders Table Card -->
            <div class="history-table-wrapper card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width: 8%;">STT</th>
                                <th style="width: 22%;">Mã Đơn Hàng</th>
                                <th style="width: 25%;">Khách Hàng</th>
                                <th style="width: 20%;">Thời Gian</th>
                                <th style="width: 15%;">Trạng Thái</th>
                                <th style="width: 10%;" class="text-center">Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Orders.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                        Không có đơn hàng nào
                                    </td>
                                </tr>
                            }
                            else
                            {
                                for (int i = 0; i < Model.Orders.Count; i++)
                                {
                                    var o = Model.Orders[i];
                                    var stt = (Model.CurrentPage - 1) * Model.PageSize + i + 1;
                                    bool isMissing = o.IsMissingIngredients || o.BrewingStatus == "Missing Ingredients";
                                    bool isCancelled = (!isMissing && (o.DisplayStatus.Contains("hủy") || o.BrewingStatus == "Cancelled" || o.BrewingStatus == "Cancelled / Refunded" || o.PaymentStatus == "Cancelled"));
                                    bool isDelivered = (!isCancelled && !isMissing && (o.BrewingStatus == "Delivered" || o.DisplayStatus == "Đã giao hàng"));
                                    bool isDone = !isCancelled && !isMissing && !isDelivered && (o.DisplayStatus.ToLower() == "đã pha chế xong" || o.DisplayStatus.ToLower() == "đã hoàn thành" || o.BrewingStatus == "Completed" || o.BrewingStatus == "Done");
                                    bool isUnpaid = !isCancelled && !isMissing && !isDone && !isDelivered && (o.PaymentStatus == "Unpaid" || o.DisplayStatus == "Chờ thanh toán");
                                    bool isPartiallyPaid = !isCancelled && !isMissing && !isDone && !isDelivered && (o.PaymentStatus == "PartiallyPaid" || o.DisplayStatus == "Thanh toán 1 phần");
                                    bool isBrewing = !isCancelled && !isMissing && !isDone && !isDelivered && !isUnpaid && !isPartiallyPaid && (o.BrewingStatus == "Brewing in Progress" || o.BrewingStatus == "Brewing" || o.DisplayStatus == "Đang pha chế");

                                    string rowStyle = isMissing ? "table-danger fw-semibold" : 
                                                     (isCancelled ? "table-light text-muted" : 
                                                     (isDelivered ? "table-success" : 
                                                     (isDone ? "table-primary" : 
                                                     (isUnpaid ? "table-secondary" :
                                                     (isPartiallyPaid ? "table-info" : "table-light")))));

                                    <tr class="history-order-row @rowStyle" data-order-id="@o.OrderId" onclick="loadOrderDetails('@o.OrderId')">
                                        <td class="ps-3 text-secondary">@stt</td>
                                        <td class="fw-bold text-primary">@o.OrderId</td>
                                        <td class="text-dark">@(string.IsNullOrEmpty(o.RecipientName) ? "Khách vãng lai" : o.RecipientName)</td>
                                        <td class="small text-muted">@o.OrderTime.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (isMissing)
                                            {
                                                <span class="badge bg-danger text-white px-2 py-1 rounded-pill">
                                                    <i class="bi bi-exclamation-octagon-fill me-1"></i>Thiếu nguyên liệu
                                                </span>
                                            }
                                            else if (isCancelled)
                                            {
                                                <span class="badge bg-secondary text-white px-2 py-1 rounded-pill">
                                                    <i class="bi bi-x-circle-fill me-1"></i>Đã hủy
                                                </span>
                                            }
                                            else if (isDelivered)
                                            {
                                                <span class="badge bg-success text-white px-2.5 py-1 rounded-pill">
                                                    <i class="bi bi-box-seam me-1"></i>Đã giao hàng
                                                </span>
                                            }
                                            else if (isDone)
                                            {
                                                <span class="badge bg-primary text-white px-2.5 py-1 rounded-pill">
                                                    <i class="bi bi-check2-circle me-1"></i>Đã pha chế xong
                                                </span>
                                            }
                                            else if (isUnpaid)
                                            {
                                                <span class="badge bg-secondary text-white px-2.5 py-1 rounded-pill">
                                                    <i class="bi bi-hourglass-split me-1"></i>Chờ thanh toán
                                                </span>
                                            }
                                            else if (isPartiallyPaid)
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2.5 py-1 rounded-pill fw-semibold">
                                                    <i class="bi bi-pie-chart-fill me-1"></i>Thanh toán 1 phần
                                                </span>
                                            }
                                            else if (isBrewing)
                                            {
                                                <span class="badge bg-primary text-white px-2.5 py-1 rounded-pill">
                                                    <i class="bi bi-cup-hot-fill me-1"></i>Đang pha chế
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark px-2.5 py-1 rounded-pill">
                                                    <i class="bi bi-clock-history me-1"></i>Đang chờ pha chế
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-link text-primary text-decoration-none fw-bold p-0" onclick="event.stopPropagation(); loadOrderDetails('@o.OrderId')">
                                                Chi tiết
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
 
            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="history-pagination-wrapper">
                    <nav>
                        <ul class="pagination pagination-sm justify-content-center m-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="?page=@(Model.CurrentPage-1)&status=@Model.StatusFilter&fromDate=@Model.FromDate?.ToString("yyyy-MM-dd")&toDate=@Model.ToDate?.ToString("yyyy-MM-dd")&search=@Model.SearchKeyword">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link @(p == Model.CurrentPage ? "fw-bold" : "")" href="?page=@p&status=@Model.StatusFilter&fromDate=@Model.FromDate?.ToString("yyyy-MM-dd")&toDate=@Model.ToDate?.ToString("yyyy-MM-dd")&search=@Model.SearchKeyword">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="?page=@(Model.CurrentPage+1)&status=@Model.StatusFilter&fromDate=@Model.FromDate?.ToString("yyyy-MM-dd")&toDate=@Model.ToDate?.ToString("yyyy-MM-dd")&search=@Model.SearchKeyword">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
 
        <!-- Right Panel: Order Details -->
        <div class="history-detail-column">
            <div class="history-detail-card" id="orderDetailsPanel">
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-muted py-5">
                    <i class="bi bi-receipt fs-1 mb-3 text-secondary opacity-50"></i>
                    <h5 class="fw-semibold">Chi tiết đơn hàng</h5>
                    <p class="small text-center px-4">Chọn một đơn hàng từ danh sách bên trái để xem thông tin chi tiết hóa đơn.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Preview & In Hóa Đơn K80 -->
<div class="modal fade" id="receiptPrintModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header py-2 bg-light border-bottom d-flex justify-content-between align-items-center">
                <h6 class="modal-title fw-bold text-dark mb-0">
                    <i class="bi bi-printer me-1 text-primary"></i>Hóa Đơn / Phiếu Order (K80)
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 bg-light d-flex justify-content-center">
                <!-- Printable K80 Receipt Container -->
                <div id="k80ReceiptContainer" class="bg-white p-3 shadow-sm border border-secondary border-opacity-25" style="width: 320px; font-family: 'Courier New', Courier, monospace; font-size: 13px; line-height: 1.35; color: #000;">
                    <!-- Store Header -->
                    <div class="text-center pb-2 mb-2 border-bottom border-dark">
                        <div class="fw-bold text-uppercase fs-6">CSMS COFFEE</div>
                        <div>Chi nhánh: <span id="recBranchName">Hà Đông</span></div>
                        <div class="small">Địa chỉ: <span id="recBranchAddress">123 Nguyễn Trãi, Thanh Xuân, Hà Nội</span></div>
                        <div class="small">SĐT: <span id="recBranchPhone">0988.888.888</span></div>
                    </div>

                    <!-- Order Info -->
                    <div class="pb-2 mb-2 border-bottom border-dark">
                        <div class="d-flex justify-content-between">
                            <span>Mã đơn: <strong id="recOrderId">MH260903-001</strong></span>
                            <span id="recOrderTime">03/09/2026 10:30</span>
                        </div>
                        <div class="mt-1">
                            <strong>Vị trí / Bàn: <span id="recTableNumber" class="text-uppercase">Bàn 05</span></strong>
                        </div>
                        <div>Khách hàng: <span id="recCustomerName">Anh Tuấn</span></div>
                        <div id="recNotesRow" class="d-none">
                            Ghi chú: <em id="recOrderNotes">Ít ngọt</em>
                        </div>
                    </div>

                    <!-- Items Table -->
                    <table class="w-100 mb-2 border-bottom border-dark" style="font-size: 12px;">
                        <thead>
                            <tr class="border-bottom border-dark">
                                <th class="text-center py-1" style="width: 25px;">STT</th>
                                <th class="text-start py-1">Món</th>
                                <th class="text-center py-1" style="width: 28px;">SL</th>
                                <th class="text-end py-1" style="width: 58px;">Đ.Giá</th>
                                <th class="text-end py-1" style="width: 68px;">T.Tiền</th>
                            </tr>
                        </thead>
                        <tbody id="recItemsBody">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>

                    <!-- Financial Summary (4 mục rõ ràng) -->
                    <div class="pb-2 mb-2 border-bottom border-dark">
                        <div class="d-flex justify-content-between">
                            <span>Tạm tính:</span>
                            <span id="recSubtotal" class="font-monospace">140.000 đ</span>
                        </div>
                        <div class="d-flex justify-content-between text-danger d-none" id="recDiscountRow">
                            <span id="recDiscountLabel">Giảm giá:</span>
                            <span id="recDiscount" class="font-monospace">-0 đ</span>
                        </div>
                        <div class="d-flex justify-content-between text-danger d-none" id="recTradeDiscountRow">
                            <span>Chiết khấu:</span>
                            <span id="recTradeDiscount" class="font-monospace">-0 đ</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold fs-6 mt-1 pt-1 border-top border-dark">
                            <span>TỔNG CỘNG:</span>
                            <span id="recTotal" class="font-monospace">140.000 đ</span>
                        </div>
                    </div>

                    <!-- Payment details in receipt -->
                    <div class="pb-2 mb-2 border-bottom border-dark" id="recPaymentSection" style="font-size: 12px;">
                        <div class="d-flex justify-content-between">
                            <span>Hình thức TT:</span>
                            <span id="recPaymentMethod" class="fw-semibold">Tiền mặt</span>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="text-center pt-1">
                        <div>Cảm ơn quý khách &amp; Hẹn gặp lại!</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2 bg-light d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary btn-sm px-3 fw-bold" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i>In hóa đơn (Print)
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Đổi Món / Sửa Đơn Hàng -->
<div class="modal fade" id="exchangeOrderModal" tabindex="-1" aria-labelledby="exchangeOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="exchangeOrderModalLabel">
                    <i class="bi bi-arrow-repeat me-2"></i>ĐỔI MÓN / SỬA ĐƠN HÀNG - <span id="exchangeOrderIdDisplay"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 bg-light">
                <div class="row g-3">
                    <!-- Left: Current order items -->
                    <div class="col-lg-6">
                        <div class="card h-100 border shadow-sm">
                            <div class="card-header bg-white py-2.5 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-cart3 text-primary me-2"></i>Danh sách món mới</h6>
                                <span class="badge bg-secondary-subtle text-dark" id="exchangeItemCountBadge">0 món</span>
                            </div>
                            <div class="card-body p-0 d-flex flex-column" style="min-height: 280px; max-height: 380px; overflow-y: auto;">
                                <table class="table table-hover table-sm align-middle mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th style="width: 45%;">Tên món</th>
                                            <th style="width: 15%;" class="text-center">Size</th>
                                            <th style="width: 20%;" class="text-center">Số lượng</th>
                                            <th style="width: 20%;" class="text-end pe-3">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody id="exchangeItemsTableBody">
                                        <!-- Rendered via JS -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Menu Product Selector -->
                    <div class="col-lg-6">
                        <div class="card h-100 border shadow-sm">
                            <div class="card-header bg-white py-2">
                                <div class="row g-2 align-items-center">
                                    <div class="col-6">
                                        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-cup-straw text-primary me-2"></i>Thực đơn đổi món</h6>
                                    </div>
                                    <div class="col-6">
                                        <input type="text" id="exchangeMenuSearch" class="form-control form-control-sm" placeholder="Tìm tên món..." onkeyup="filterExchangeMenu()">
                                    </div>
                                </div>
                            </div>
                            <div class="card-body p-2 exchange-menu-card" id="exchangeMenuContainer">
                                <div class="text-center text-muted py-5">
                                    <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
                                    <div>Đang tải thực đơn...</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bottom Summary Box -->
                <div class="card border-0 shadow-sm mt-3 bg-white">
                    <div class="card-body p-3">
                        <div class="row align-items-center g-3">
                            <div class="col-md-3 border-end">
                                <div class="text-muted small">Tổng tiền đơn gốc:</div>
                                <div class="fw-bold fs-5 text-secondary" id="exchangeOldTotalDisplay">0 đ</div>
                            </div>
                            <div class="col-md-3 border-end">
                                <div class="text-muted small">Tổng tiền đơn mới:</div>
                                <div class="fw-bold fs-5 text-primary" id="exchangeNewTotalDisplay">0 đ</div>
                            </div>
                            <div class="col-md-6">
                                <div id="exchangeDifferenceBox">
                                    <!-- Dynamic calculation box rendered by JS -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2.5">
                <button type="button" class="btn btn-secondary fw-semibold px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" id="btnSubmitExchange" class="btn btn-primary fw-bold px-4 shadow-sm" onclick="submitExchangeOrder()">
                    <i class="bi bi-check-circle-fill me-1"></i> Xác nhận sửa đơn & Đẩy lại pha chế
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadOrderDetails(orderId) {
            // Highlight selected row in table
            $('.history-order-row').removeClass('selected-order');
            $(`.history-order-row[data-order-id="${orderId}"]`).addClass('selected-order');

            document.getElementById('orderDetailsPanel').innerHTML = `
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-primary py-5">
                    <div class="spinner-border spinner-border-sm mb-3" role="status"></div>
                    <div class="fw-semibold small">Đang tải chi tiết đơn hàng...</div>
                </div>
            `;
            
            fetch('@Url.Action("GetOrderDetails", "SaleManagement")?orderId=' + orderId)
                .then(res => {
                    if (!res.ok) throw new Error('Không tìm thấy chi tiết đơn hàng');
                    return res.text();
                })
                .then(html => {
                    document.getElementById('orderDetailsPanel').innerHTML = html;
                })
                .catch(err => {
                    document.getElementById('orderDetailsPanel').innerHTML = `
                        <div class="card-body d-flex flex-column align-items-center justify-content-center text-danger py-5">
                            <i class="bi bi-exclamation-triangle fs-1 mb-3"></i>
                            <div class="fw-semibold">${err.message}</div>
                        </div>
                    `;
                });
        }
        function cancelUnpaidOrder(orderId) {
            if (!orderId) return;

            var confirmMsg = `Bạn có chắc chắn muốn <strong>hủy đơn hàng ${orderId}</strong>?<br><br><span class="text-muted small"><i class="bi bi-info-circle me-1"></i>Đơn hàng chưa thanh toán nên sẽ không phát sinh tiền hoàn trả.</span>`;

            showConfirmModal(
                'Xác nhận hủy đơn chưa thanh toán',
                confirmMsg,
                function() {
                    fetch('@Url.Action("CancelUnpaidOrder", "SaleManagement")?orderId=' + encodeURIComponent(orderId), {
                        method: 'POST'
                    })
                    .then(res => res.json().then(data => ({ status: res.status, body: data })))
                    .then(res => {
                        if (res.body.success) {
                            showToast(res.body.message || 'Đã hủy đơn hàng thành công!', 'success');
                            setTimeout(() => {
                                window.location.reload();
                            }, 600);
                        } else {
                            showToast(res.body.message || 'Thất bại khi hủy đơn hàng.', 'danger');
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        showToast('Lỗi khi gửi yêu cầu hủy đơn hàng.', 'danger');
                    });
                }
            );
        }

        // ======================= EXCHANGE ORDER (ĐỔI MÓN) LOGIC =======================
        let exchangeModalInstance = null;
        let currentExchangeOrderId = '';
        let exchangeOriginalTotal = 0;
        let exchangeCurrentItems = [];
        let cachedExchangeMenu = null;

        function openExchangeModal(orderId) {
            currentExchangeOrderId = orderId;
            $('#exchangeOrderIdDisplay').text(orderId);

            var dataElem = document.getElementById('orderItemsData_' + orderId);
            var itemsJson = [];
            if (dataElem && dataElem.textContent) {
                try {
                    itemsJson = JSON.parse(dataElem.textContent);
                } catch (e) {
                    console.error('Failed to parse order items JSON', e);
                }
            }

            // Copy items to working array
            exchangeCurrentItems = itemsJson.map(it => ({
                variantId: it.variantId,
                productName: it.productName,
                size: it.size,
                quantity: it.quantity,
                unitPrice: it.unitPrice
            }));

            exchangeOriginalTotal = exchangeCurrentItems.reduce((sum, it) => sum + (it.quantity * it.unitPrice), 0);
            $('#exchangeOldTotalDisplay').text(exchangeOriginalTotal.toLocaleString('vi-VN') + ' đ');

            renderExchangeItems();
            loadExchangeMenu();

            if (!exchangeModalInstance) {
                exchangeModalInstance = new bootstrap.Modal(document.getElementById('exchangeOrderModal'));
            }
            exchangeModalInstance.show();
        }

        function renderExchangeItems() {
            let tbody = $('#exchangeItemsTableBody');
            tbody.empty();

            if (exchangeCurrentItems.length === 0) {
                tbody.html('<tr><td colspan="4" class="text-center text-muted py-4">Chưa có món nào. Hãy chọn món từ thực đơn bên phải.</td></tr>');
            } else {
                exchangeCurrentItems.forEach((it, idx) => {
                    let amount = it.quantity * it.unitPrice;
                    let row = `
                        <tr class="exchange-item-row">
                            <td class="ps-2">
                                <div class="fw-bold text-dark">${it.productName}</div>
                                <div class="small text-muted">${it.unitPrice.toLocaleString('vi-VN')} đ/ly</div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary-subtle text-dark border">Size ${it.size}</span>
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex align-items-center border rounded bg-white">
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0 px-2" onclick="changeExchangeItemQty(${idx}, -1)">
                                        <i class="bi bi-dash-lg"></i>
                                    </button>
                                    <span class="fw-bold px-1">${it.quantity}</span>
                                    <button type="button" class="btn btn-sm btn-link text-success p-0 px-2" onclick="changeExchangeItemQty(${idx}, 1)">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                            </td>
                            <td class="text-end pe-3">
                                <span class="fw-bold text-primary">${amount.toLocaleString('vi-VN')} đ</span>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2" onclick="removeExchangeItem(${idx})" title="Xóa món">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });
            }

            $('#exchangeItemCountBadge').text(exchangeCurrentItems.length + ' món');
            recalculateExchangeTotals();
        }

        function changeExchangeItemQty(index, delta) {
            if (index >= 0 && index < exchangeCurrentItems.length) {
                exchangeCurrentItems[index].quantity += delta;
                if (exchangeCurrentItems[index].quantity <= 0) {
                    exchangeCurrentItems.splice(index, 1);
                }
                renderExchangeItems();
            }
        }

        function removeExchangeItem(index) {
            if (index >= 0 && index < exchangeCurrentItems.length) {
                exchangeCurrentItems.splice(index, 1);
                renderExchangeItems();
            }
        }

        function recalculateExchangeTotals() {
            let newTotal = exchangeCurrentItems.reduce((sum, it) => sum + (it.quantity * it.unitPrice), 0);
            $('#exchangeNewTotalDisplay').text(newTotal.toLocaleString('vi-VN') + ' đ');

            let diff = newTotal - exchangeOriginalTotal;
            let diffBox = $('#exchangeDifferenceBox');

            if (diff < 0) {
                let shortage = Math.abs(diff);
                diffBox.html(`
                    <div class="alert alert-danger border-danger py-2 px-3 m-0">
                        <div class="fw-bold text-danger mb-1">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>GIÁ TRỊ ĐƠN MỚI THẤP HƠN ĐƠN GỐC (-${shortage.toLocaleString('vi-VN')} đ)
                        </div>
                        <div class="small text-muted">Hệ thống không áp dụng chính sách hoàn tiền khi đổi món. Vui lòng chọn thêm món hoặc món có giá trị bằng hoặc lớn hơn tổng tiền ban đầu (${exchangeOriginalTotal.toLocaleString('vi-VN')} đ).</div>
                    </div>
                `);
                $('#btnSubmitExchange').prop('disabled', true);
            } else if (diff > 0) {
                $('#btnSubmitExchange').prop('disabled', false);
                diffBox.html(`
                    <div class="alert alert-warning border-warning py-2 px-3 m-0">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-dark"><i class="bi bi-arrow-up-circle-fill text-warning me-1"></i>KHÁCH CẦN THANH TOÁN THÊM:</span>
                            <h4 class="fw-bold text-danger mb-0">+${diff.toLocaleString('vi-VN')} đ</h4>
                        </div>
                        <div class="d-flex align-items-center gap-3 mt-1">
                            <label class="small fw-semibold text-secondary">Hình thức thu thêm:</label>
                            <div class="form-check form-check-inline m-0">
                                <input class="form-check-input" type="radio" name="addPayMethod" id="addPayCash" value="Cash" checked>
                                <label class="form-check-label small" for="addPayCash">Tiền mặt</label>
                            </div>
                            <div class="form-check form-check-inline m-0">
                                <input class="form-check-input" type="radio" name="addPayMethod" id="addPayBank" value="Bank Transfer">
                                <label class="form-check-label small" for="addPayBank">Chuyển khoản</label>
                            </div>
                        </div>
                    </div>
                `);
            } else {
                $('#btnSubmitExchange').prop('disabled', false);
                diffBox.html(`
                    <div class="alert alert-info border-info py-2 px-3 m-0 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-bold text-info"><i class="bi bi-check-circle-fill me-1"></i>TỔNG TIỀN BẰNG ĐƠN GỐC</span>
                            <div class="small text-muted">Không phát sinh thanh toán thêm.</div>
                        </div>
                        <h4 class="fw-bold text-info mb-0">0 đ</h4>
                    </div>
                `);
            }
        }

        function loadExchangeMenu() {
            if (cachedExchangeMenu) {
                renderExchangeMenu(cachedExchangeMenu);
                return;
            }

            fetch('@Url.Action("GetMenuForExchange", "SaleManagement")')
                .then(res => res.json())
                .then(data => {
                    cachedExchangeMenu = data;
                    renderExchangeMenu(data);
                })
                .catch(err => {
                    console.error(err);
                    $('#exchangeMenuContainer').html('<div class="text-danger p-3">Không thể tải danh sách thực đơn.</div>');
                });
        }

        function renderExchangeMenu(data) {
            let container = $('#exchangeMenuContainer');
            container.empty();

            if (!data || !data.products || data.products.length === 0) {
                container.html('<div class="text-muted p-3 text-center">Không có món nào trong thực đơn.</div>');
                return;
            }

            let html = '<div class="row g-2">';
            data.products.forEach(p => {
                html += `
                    <div class="col-12 exchange-product-card" data-name="${p.productName.toLowerCase()}">
                        <div class="p-2 border rounded bg-white d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold text-dark">${p.productName}</span>
                                <div class="d-flex gap-1 mt-1">
                                    ${p.variants.map(v => `
                                        <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 small rounded-pill" onclick="addVariantToExchange(${v.variantId}, '${p.productName.replace("'", "\\'")}', '${v.size}', ${v.price})">
                                            Size ${v.size}: <strong>${v.price.toLocaleString('vi-VN')}đ</strong> <i class="bi bi-plus"></i>
                                        </button>
                                    `).join('')}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            container.html(html);
        }

        function filterExchangeMenu() {
            let kw = ($('#exchangeMenuSearch').val() || '').trim();
            $('.exchange-product-card').each(function() {
                let name = $(this).data('name') || '';
                if (!kw || (window.CSMSSearch ? window.CSMSSearch.fuzzyMatch(name, kw) : name.toLowerCase().includes(kw.toLowerCase()))) {
                    $(this).removeClass('d-none');
                } else {
                    $(this).addClass('d-none');
                }
            });
        }

        function addVariantToExchange(variantId, productName, size, unitPrice) {
            let existing = exchangeCurrentItems.find(it => it.variantId === variantId);
            if (existing) {
                existing.quantity += 1;
            } else {
                exchangeCurrentItems.push({
                    variantId: variantId,
                    productName: productName,
                    size: size,
                    quantity: 1,
                    unitPrice: unitPrice
                });
            }
            renderExchangeItems();
        }

        function submitExchangeOrder() {
            if (exchangeCurrentItems.length === 0) {
                showToast('Đơn hàng mới không được để trống món!', 'warning');
                return;
            }

            let newTotal = exchangeCurrentItems.reduce((sum, it) => sum + (it.quantity * it.unitPrice), 0);
            let diff = newTotal - exchangeOriginalTotal;

            if (diff < 0) {
                showToast('Hệ thống không áp dụng chính sách hoàn tiền khi đổi món có giá trị thấp hơn đơn gốc. Vui lòng chọn món có giá trị bằng hoặc lớn hơn!', 'warning');
                return;
            }

            let addPayMethod = $('input[name="addPayMethod"]:checked').val() || 'Cash';

            let diffText = '';
            if (diff > 0) {
                diffText = `<span class="text-danger fw-bold">Thu thêm từ khách: ${diff.toLocaleString('vi-VN')} đ</span> qua hình thức <strong>${addPayMethod === 'Cash' ? 'Tiền mặt' : 'Chuyển khoản'}</strong>`;
            } else {
                diffText = `<span class="text-info fw-bold">Tổng tiền không đổi (0 đ)</span>`;
            }

            let confirmMsg = `
                Xác nhận lưu thay đổi đơn hàng <strong>${currentExchangeOrderId}</strong>?<br><br>
                - Tổng đơn cũ: <strong>${exchangeOriginalTotal.toLocaleString('vi-VN')} đ</strong><br>
                - Tổng đơn mới: <strong>${newTotal.toLocaleString('vi-VN')} đ</strong><br>
                - Chênh lệch: ${diffText}<br><br>
                <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Đơn hàng sẽ được chuyển lại hàng đợi pha chế cho Bartender.</small>
            `;

            showConfirmModal(
                'Xác nhận sửa đổi đơn hàng',
                confirmMsg,
                function() {
                    fetch('@Url.Action("ExchangeOrder", "SaleManagement")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            orderId: currentExchangeOrderId,
                            items: exchangeCurrentItems.map(it => ({
                                variantId: it.variantId,
                                productName: it.productName,
                                size: it.size,
                                quantity: it.quantity,
                                unitPrice: it.unitPrice
                            })),
                            additionalPaymentMethod: addPayMethod,
                            reason: 'Đổi món do Bartender báo thiếu nguyên liệu'
                        })
                    })
                    .then(res => res.json().then(data => ({ status: res.status, body: data })))
                    .then(res => {
                        if (res.body.success) {
                            if (exchangeModalInstance) exchangeModalInstance.hide();
                            showToast(res.body.message || 'Đã sửa đơn thành công!', 'success');
                            loadOrderDetails(currentExchangeOrderId);
                        } else {
                            showToast(res.body.message || 'Thất bại', 'danger');
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        showToast('Lỗi khi gửi yêu cầu đổi món.', 'danger');
                    });
                }
            );
        }

        function printReceiptFromHistory(orderId) {
            if (!orderId) return;

            fetch('@Url.Action("GetReceiptData", "SaleManagement")?orderId=' + encodeURIComponent(orderId))
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        showToast("Không thể tải thông tin hóa đơn: " + data.message, "danger");
                        return;
                    }

                    document.getElementById('recBranchName').innerText = data.branchName || 'CSMS';
                    document.getElementById('recBranchAddress').innerText = data.branchAddress || '';
                    document.getElementById('recBranchPhone').innerText = data.branchPhone || '';
                    document.getElementById('recOrderId').innerText = data.orderId;
                    document.getElementById('recOrderTime').innerText = data.orderTime;
                    if (document.getElementById('recCashierName')) {
                        document.getElementById('recCashierName').innerText = data.cashierName;
                    }
                    document.getElementById('recTableNumber').innerText = data.tableNumber || 'Mang về';
                    document.getElementById('recCustomerName').innerText = data.customerName || 'Khách lẻ';

                    var notesRow = document.getElementById('recNotesRow');
                    if (data.orderNotes && data.orderNotes.trim() !== '') {
                        notesRow.classList.remove('d-none');
                        document.getElementById('recOrderNotes').innerText = data.orderNotes;
                    } else {
                        notesRow.classList.add('d-none');
                    }

                    var itemsHtml = '';
                    (data.items || []).forEach((item, idx) => {
                        itemsHtml += `
                            <tr>
                                <td class="text-center py-1 text-muted font-monospace">${idx + 1}</td>
                                <td class="py-1">
                                    <div class="fw-semibold">${item.productName}</div>
                                    <div class="small text-muted">Size: ${item.size}</div>
                                </td>
                                <td class="text-center py-1 font-monospace">${item.quantity}</td>
                                <td class="text-end py-1 font-monospace">${item.unitPrice.toLocaleString('vi-VN')}</td>
                                <td class="text-end py-1 font-monospace">${item.amount.toLocaleString('vi-VN')}</td>
                            </tr>
                        `;
                    });
                    document.getElementById('recItemsBody').innerHTML = itemsHtml;

                    document.getElementById('recSubtotal').innerText = data.subtotalAmount.toLocaleString('vi-VN') + ' đ';

                    var discRow = document.getElementById('recDiscountRow');
                    if (data.discountAmount > 0) {
                        discRow.classList.remove('d-none');
                        var labelEl = document.getElementById('recDiscountLabel');
                        if (labelEl) {
                            labelEl.innerText = data.voucherCode ? `Giảm giá (${data.voucherCode}):` : 'Giảm giá:';
                        }
                        document.getElementById('recDiscount').innerText = '-' + data.discountAmount.toLocaleString('vi-VN') + ' đ';
                    } else {
                        discRow.classList.add('d-none');
                    }

                    var tradeDiscRow = document.getElementById('recTradeDiscountRow');
                    if (data.tradeDiscountAmount > 0) {
                        tradeDiscRow.classList.remove('d-none');
                        document.getElementById('recTradeDiscount').innerText = '-' + data.tradeDiscountAmount.toLocaleString('vi-VN') + ' đ';
                    } else {
                        tradeDiscRow.classList.add('d-none');
                    }

                    document.getElementById('recTotal').innerText = data.totalAmount.toLocaleString('vi-VN') + ' đ';

                    // Payment Method (Tiền mặt, CK hoặc CK + Tiền mặt)
                    var payMethodEl = document.getElementById('recPaymentMethod');
                    if (payMethodEl) {
                        var pMethod = (data.paymentMethod || '').trim();
                        if (pMethod === 'Split' || (data.cashAmount > 0 && data.bankAmount > 0) || pMethod.indexOf('Thu thêm') !== -1 || pMethod.indexOf('+') !== -1) {
                            payMethodEl.innerText = 'CK + Tiền mặt';
                        } else if (pMethod === 'Bank Transfer' || pMethod === 'BankTransfer' || pMethod === 'Transfer' || pMethod === 'CK') {
                            payMethodEl.innerText = 'CK';
                        } else {
                            payMethodEl.innerText = 'Tiền mặt';
                        }
                    }

                    var modal = new bootstrap.Modal(document.getElementById('receiptPrintModal'));
                    modal.show();
                })
                .catch(err => {
                    console.error(err);
                    showToast("Lỗi khi tải dữ liệu hóa đơn.", "danger");
                });
        }

        function markDeliveredOrder(orderId) {
            if (!orderId) return;

            showConfirmModal(
                'Xác nhận đã giao hàng',
                'Bạn có chắc chắn muốn xác nhận đã giao đồ uống / đơn hàng <strong>#' + orderId + '</strong> cho khách hàng không?',
                function() {
                    const formData = new FormData();
                    formData.append('orderId', orderId);

                    fetch('@Url.Action("MarkOrderAsDelivered", "SaleManagement")', {
                        method: 'POST',
                        body: formData
                    })
                    .then(res => res.json().then(data => ({ ok: res.ok, status: res.status, body: data })))
                    .then(res => {
                        if (res.ok && res.body.success) {
                            showToast(res.body.message || 'Đã xác nhận giao hàng thành công!', 'success');
                            loadOrderDetails(orderId);
                            setTimeout(() => {
                                window.location.reload();
                            }, 1000);
                        } else {
                            showToast(res.body.message || 'Không thể cập nhật trạng thái đơn hàng.', 'danger');
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        showToast('Lỗi kết nối khi cập nhật trạng thái đơn hàng.', 'danger');
                    });
                }
            );
        }

        function quickFilterStatus(status) {
            const select = document.querySelector('select[name="status"]');
            if (select) {
                select.value = status;
                document.getElementById('filterForm').submit();
            }
        }
    </script>
}

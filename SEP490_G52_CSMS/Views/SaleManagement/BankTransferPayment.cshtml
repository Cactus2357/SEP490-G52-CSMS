@section Scripts {
    <script>
        // Hàm định dạng số tiền chuẩn VNĐ (vd: 12500 -> "12.500")
        function formatCurrency(amount) {
            if (amount === null || amount === undefined || isNaN(amount)) return '0';
            return new Intl.NumberFormat('vi-VN').format(Math.round(amount));
        }

        // Hàm định dạng số tiền kèm ký hiệu đ (vd: 12500 -> "12.500 đ")
        function formatMoney(amount) {
            return formatCurrency(amount) + ' đ';
        }

        var orderId = '@Model.OrderId';
        var totalAmount = @Model.TotalAmount;
        var recipientName = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.RecipientName))';
        var orderItems = @Html.Raw(itemsJson);
        var qrCodeUrl = document.getElementById('qrCodeImg').src;
        var currentBankTxCode = '';

        var currentBankAmount = 0;
        var currentRemainingAmount = totalAmount;

        // Sync order details and QR code with Customer Monitor immediately on load
        try {
            localStorage.setItem('customer_display_state', JSON.stringify({
                mode: 'BankTransfer',
                orderId: orderId,
                recipientName: recipientName,
                total: totalAmount,
                items: orderItems,
                qrCodeUrl: qrCodeUrl
            }));
        } catch (e) {
            console.error("Failed to sync state to Customer Monitor:", e);
        }

        // Start polling payment status every 2 seconds
        var pollInterval = setInterval(function() {
            fetch('@Url.Action("CheckPaymentStatus", "SaleManagement")?orderId=' + orderId)
                .then(res => res.json())
                .then(data => {
                    if (!data.success) return;

                    if (data.paymentStatus === 'TransferSuccessPending') {
                        clearInterval(pollInterval);
                        
                        var recAmount = data.receivedAmount || totalAmount;
                        var formattedAmount = formatMoney(recAmount);
                        document.getElementById('receivedAmountDisplay').innerText = formattedAmount;

                        currentBankTxCode = data.bankTransactionCode || ('MBB-' + Date.now().toString().slice(-6));
                        document.getElementById('bankTxCodeDisplay').innerText = currentBankTxCode;

                        // Hide partial payment alert if previously shown
                        var partialEl = document.getElementById('partialPaymentAlert');
                        if (partialEl) partialEl.classList.add('d-none');

                        // Sync paid status and received amount to Customer Monitor
                        localStorage.setItem('customer_display_state', JSON.stringify({
                            mode: 'PaidSuccess',
                            orderId: orderId,
                            receivedAmount: formattedAmount,
                            bankTransactionCode: currentBankTxCode
                        }));

                        // Show cashier modal
                        var successModal = new bootstrap.Modal(document.getElementById('transferSuccessModal'));
                        successModal.show();
                    } else if (data.paymentStatus === 'PartiallyPaid') {
                        currentBankAmount = data.bankAmount || 0;
                        currentRemainingAmount = data.remainingAmount || Math.max(0, totalAmount - currentBankAmount);
                        currentBankTxCode = data.bankTransactionCode || '';

                        // Show Partial Payment Alert
                        var alertEl = document.getElementById('partialPaymentAlert');
                        if (alertEl) {
                            alertEl.classList.remove('d-none');
                            document.getElementById('partialReceivedBankDisplay').innerText = formatMoney(currentBankAmount);
                            document.getElementById('partialRemainingDisplay').innerText = formatMoney(currentRemainingAmount);
                            document.getElementById('btnRemainingAmountText').innerText = formatMoney(currentRemainingAmount);
                            if (currentBankTxCode) {
                                document.getElementById('partialTxCodeDisplay').innerText = currentBankTxCode;
                            }
                        }

                        // Update dynamic QR Code image for the remaining amount
                        if (currentRemainingAmount > 0) {
                            var newQrUrl = 'https://qr.sepay.vn/img?acc=@accountNumber&bank=@bankCode&amount=' + Math.round(currentRemainingAmount) + '&des=' + encodeURIComponent('@transferContent');
                            document.getElementById('qrCodeImg').src = newQrUrl;
                        }

                        // Sync remaining amount to Customer Monitor
                        try {
                            localStorage.setItem('customer_display_state', JSON.stringify({
                                mode: 'BankTransfer',
                                orderId: orderId,
                                recipientName: recipientName,
                                total: currentRemainingAmount,
                                items: orderItems,
                                qrCodeUrl: document.getElementById('qrCodeImg').src,
                                note: 'Đã nhận CK: ' + formatMoney(currentBankAmount)
                            }));
                        } catch(e) {}
                    }
                })
                .catch(err => console.error("Error polling payment status:", err));
        }, 2000);

        // Auto focus input when modal is shown
        document.addEventListener('DOMContentLoaded', function() {
            var splitModalEl = document.getElementById('collectRemainingCashModal');
            if (splitModalEl) {
                splitModalEl.addEventListener('shown.bs.modal', function () {
                    var inp = document.getElementById('splitCustomerCashInput');
                    if (inp) {
                        inp.focus();
                        inp.select();
                    }
                });
            }
        });

        function getSplitCustomerCashValue() {
            var valStr = (document.getElementById('splitCustomerCashInput').value || '').replace(/\D/g, '');
            return parseFloat(valStr) || 0;
        }

        function onSplitCustomerCashInput(el) {
            var raw = el.value.replace(/\D/g, '');
            if (raw === '') {
                el.value = '';
            } else {
                var num = parseInt(raw, 10);
                el.value = formatCurrency(num);
            }
            calculateSplitChange();
        }

        function openCollectRemainingCashModal() {
            document.getElementById('modalReceivedBank').innerText = formatMoney(currentBankAmount);
            document.getElementById('modalRemainingCash').innerText = formatMoney(currentRemainingAmount);

            var cashInput = document.getElementById('splitCustomerCashInput');
            cashInput.value = formatCurrency(currentRemainingAmount);

            // Generate quick cash buttons (bỏ dấu đ)
            var quickContainer = document.getElementById('quickCashButtons');
            quickContainer.innerHTML = '';
            var suggestions = [currentRemainingAmount];
            [20000, 50000, 100000, 200000, 500000].forEach(val => {
                if (val > currentRemainingAmount && !suggestions.includes(val)) suggestions.push(val);
            });
            suggestions.sort((a, b) => a - b).forEach(val => {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn btn-sm btn-outline-secondary font-monospace';
                btn.innerText = formatCurrency(val);
                btn.onclick = function() {
                    cashInput.value = formatCurrency(val);
                    calculateSplitChange();
                };
                quickContainer.appendChild(btn);
            });

            calculateSplitChange();
            var m = new bootstrap.Modal(document.getElementById('collectRemainingCashModal'));
            m.show();
        }

        function calculateSplitChange() {
            var cash = getSplitCustomerCashValue();
            var change = Math.max(0, cash - currentRemainingAmount);
            document.getElementById('splitChangeAmountDisplay').innerText = formatMoney(change);

            var errEl = document.getElementById('splitCashError');
            var btnSubmit = document.getElementById('btnSubmitSplitPayment');
            if (cash < currentRemainingAmount) {
                errEl.classList.remove('d-none');
                btnSubmit.disabled = true;
            } else {
                errEl.classList.add('d-none');
                btnSubmit.disabled = false;
            }
        }

        function confirmAndSubmitSplitPayment() {
            var cash = getSplitCustomerCashValue();
            if (cash < currentRemainingAmount) {
                showToast("Tiền khách đưa chưa đủ!", "danger");
                return;
            }

            showConfirmModal(
                'Xác nhận thu tiền mặt',
                'Xác nhận đã thu ' + formatMoney(currentRemainingAmount) + ' tiền mặt từ khách hàng và hoàn tất đơn hàng?',
                function() {
                    submitSplitPayment();
                },
                'Xác nhận',
                'Hủy'
            );
        }

        function submitSplitPayment() {
            var cash = getSplitCustomerCashValue();
            if (cash < currentRemainingAmount) {
                showToast("Tiền khách đưa chưa đủ!", "danger");
                return;
            }
            var change = Math.max(0, cash - currentRemainingAmount);

            var payload = {
                orderId: orderId,
                cashAmount: currentRemainingAmount,
                bankAmount: currentBankAmount,
                customerCash: cash,
                changeAmount: change,
                bankTransactionCode: currentBankTxCode
            };

            fetch('@Url.Action("CompleteSplitPayment", "SaleManagement")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    clearInterval(pollInterval);
                    var m = bootstrap.Modal.getInstance(document.getElementById('collectRemainingCashModal'));
                    if (m) m.hide();

                    showToast("Thanh toán kết hợp thành công! Đã chuyển đơn hàng sang Pha chế.", "success");
                    localStorage.removeItem('csms_cart');

                    // Reset Customer Monitor
                    try {
                        localStorage.setItem('customer_display_state', JSON.stringify({
                            mode: 'PaidSuccess',
                            orderId: orderId,
                            receivedAmount: formatMoney(totalAmount),
                            bankTransactionCode: currentBankTxCode
                        }));
                    } catch(e) {}

                    setTimeout(() => {
                        window.location.href = '@Url.Action("CreateOrder", "SaleManagement")';
                    }, 1000);
                } else {
                    showToast("Lỗi: " + data.message, "danger");
                }
            })
            .catch(err => {
                console.error(err);
                showToast("Lỗi kết nối máy chủ.", "danger");
            });
        }

        function simulatePartialTransferTest() {
            var partialAmount = Math.round(totalAmount / 2);
            fetch('@Url.Action("SimulatePartialTransfer", "SaleManagement")?orderId=' + orderId + '&amount=' + partialAmount, {
                method: 'POST'
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast("Đã giả lập nhận chuyển khoản 1 phần: " + formatMoney(partialAmount), "info");
                } else {
                    showToast("Lỗi: " + data.message, "danger");
                }
            })
            .catch(err => console.error(err));
        }

        function confirmManualBankTransfer() {
            showConfirmModal(
                'Xác nhận đã nhận tiền chuyển khoản',
                'Xác nhận khách hàng đã chuyển khoản thành công (trường hợp SePay bị chậm hoặc chuyển thủ công)?',
                function() {
                    fetch('@Url.Action("SimulateBankTransferSuccess", "SaleManagement")?orderId=' + orderId, {
                        method: 'POST'
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success) {
                            showToast("Lỗi xác nhận: " + data.message, "danger");
                        }
                    })
                    .catch(err => {
                        console.error("Failed to request bank simulation:", err);
                        showToast("Lỗi khi gửi yêu cầu xác nhận.", "danger");
                    });
                },
                'Xác nhận nhận tiền',
                'Hủy'
            );
        }

        function cancelPayment() {
            if (currentBankAmount > 0) {
                showToast("Đơn hàng đã nhận " + formatMoney(currentBankAmount) + " chuyển khoản từ khách. Vui lòng thu nốt tiền mặt hoặc thực hiện hoàn tiền!", "warning");
                return;
            }

            showConfirmModal(
                'Hủy giao dịch',
                'Xác nhận hủy giao dịch chuyển khoản này và quay lại màn hình chọn phương thức thanh toán?',
                function() {
                    clearInterval(pollInterval);
                    fetch('@Url.Action("CancelBankTransfer", "SaleManagement")?orderId=' + orderId, {
                        method: 'POST'
                    })
                    .then(() => {
                        // Reset Customer Monitor
                        localStorage.setItem('customer_display_state', JSON.stringify({
                            mode: 'Idle'
                        }));
                        window.location.href = '@Url.Action("CreateOrder", "SaleManagement")?orderId=' + orderId + '&showCheckout=true';
                    })
                    .catch(err => {
                        console.error(err);
                        window.location.href = '@Url.Action("CreateOrder", "SaleManagement")?orderId=' + orderId + '&showCheckout=true';
                    });
                }
            );
        }

        function confirmPaymentReceived() {
            var formData = new URLSearchParams();
            formData.append('orderId', orderId);
            formData.append('paymentMethod', 'Bank Transfer');
            formData.append('bankTransactionCode', currentBankTxCode);

            fetch('@Url.Action("ProcessPayment", "SaleManagement")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    var successModal = bootstrap.Modal.getInstance(document.getElementById('transferSuccessModal'));
                    if (successModal) successModal.hide();
                    
                    localStorage.removeItem('csms_cart');
                    
                    // Redirect back to main POS
                    window.location.href = '@Url.Action("CreateOrder", "SaleManagement")';
                } else {
                    showToast("Lỗi hoàn tất thanh toán: " + data.message, "danger");
                }
            })
            .catch(err => {
                console.error("Failed to complete payment receipt:", err);
                showToast("Lỗi kết nối máy chủ.", "danger");
            });
        }

        function printReceiptFromTransfer() {
            fetch('@Url.Action("GetReceiptData", "SaleManagement")?orderId=' + encodeURIComponent(orderId))
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        showToast("Không thể tải thông tin hóa đơn: " + data.message, "danger");
                        return;
                    }

                    document.getElementById('recBranchName').innerText = data.branchName || 'CSMS';
                    document.getElementById('recBranchAddress').innerText = data.branchAddress || '';
                    document.getElementById('recBranchPhone').innerText = data.branchPhone || '';
                    document.getElementById('recOrderId').innerText = data.orderId;
                    document.getElementById('recOrderTime').innerText = data.orderTime;
                    document.getElementById('recCashierName').innerText = data.cashierName;
                    document.getElementById('recTableNumber').innerText = data.tableNumber || 'Mang về';
                    document.getElementById('recCustomerName').innerText = data.customerName || 'Khách lẻ';

                    var notesRow = document.getElementById('recNotesRow');
                    if (data.orderNotes && data.orderNotes.trim() !== '') {
                        notesRow.classList.remove('d-none');
                        document.getElementById('recOrderNotes').innerText = data.orderNotes;
                    } else {
                        notesRow.classList.add('d-none');
                    }

                    var itemsHtml = '';
                    (data.items || []).forEach(item => {
                        itemsHtml += `
                            <tr>
                                <td class="py-1">
                                    <div class="fw-semibold">${item.productName}</div>
                                    <div class="small text-muted">Size: ${item.size}</div>
                                </td>
                                <td class="text-center py-1 font-monospace">${item.quantity}</td>
                                <td class="text-end py-1 font-monospace">${item.unitPrice.toLocaleString('vi-VN')}</td>
                                <td class="text-end py-1 font-monospace">${item.amount.toLocaleString('vi-VN')}</td>
                            </tr>
                        `;
                    });
                    document.getElementById('recItemsBody').innerHTML = itemsHtml;

                    document.getElementById('recSubtotal').innerText = data.subtotalAmount.toLocaleString('vi-VN') + ' đ';

                    var discRow = document.getElementById('recDiscountRow');
                    if (data.discountAmount > 0) {
                        discRow.classList.remove('d-none');
                        document.getElementById('recDiscount').innerText = '-' + data.discountAmount.toLocaleString('vi-VN') + ' đ';
                    } else {
                        discRow.classList.add('d-none');
                    }

                    var tradeDiscRow = document.getElementById('recTradeDiscountRow');
                    if (data.tradeDiscountAmount > 0) {
                        tradeDiscRow.classList.remove('d-none');
                        document.getElementById('recTradeDiscount').innerText = '-' + data.tradeDiscountAmount.toLocaleString('vi-VN') + ' đ';
                    } else {
                        tradeDiscRow.classList.add('d-none');
                    }

                    document.getElementById('recTotal').innerText = data.totalAmount.toLocaleString('vi-VN') + ' đ';

                    var modal = new bootstrap.Modal(document.getElementById('receiptPrintModal'));
                    modal.show();
                })
                .catch(err => {
                    console.error(err);
                    showToast("Lỗi khi tải dữ liệu hóa đơn.", "danger");
                });
        }
    </script>
}

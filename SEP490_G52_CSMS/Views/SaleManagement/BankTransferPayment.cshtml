@{
    ViewData["Title"] = "Thanh toán Chuyển khoản";
    var branchSetting = ViewBag.BranchSetting as SEP490_G52_CSMS.Models.Core.BranchSetting ?? new SEP490_G52_CSMS.Models.Core.BranchSetting();
    string bankCode = branchSetting.BankCode ?? "MBBank";
    string accountNumber = branchSetting.AccountNumber ?? "0333333333";
    string accountName = branchSetting.AccountName ?? "CSMS CAFE";
    string prefix = string.IsNullOrWhiteSpace(branchSetting.TransferPrefix) ? "CSMS" : branchSetting.TransferPrefix;
    string transferContent = $"{prefix} {Model.OrderId}";

    decimal initialCashPaid = Model.CashAmount;
    decimal remainingTransfer = Math.Max(0, Model.TotalAmount - initialCashPaid);
    if (remainingTransfer <= 0) remainingTransfer = Model.TotalAmount;

    string qrUrl = $"https://qr.sepay.vn/img?acc={accountNumber}&bank={bankCode}&amount={(int)remainingTransfer}&des={Uri.EscapeDataString(transferContent)}";

    var itemList = new List<object>();
    if (Model?.Items != null)
    {
        foreach (var item in Model.Items)
        {
            itemList.Add(new { 
                name = item.ProductName, 
                size = item.Size, 
                quantity = item.Quantity, 
                amount = item.Quantity * item.UnitPrice 
            });
        }
    }
    var itemsJson = System.Text.Json.JsonSerializer.Serialize(itemList);
}

<style>
    @@media print {
        body * {
            visibility: hidden !important;
        }
        #k80ReceiptContainer, #k80ReceiptContainer * {
            visibility: visible !important;
        }
        #k80ReceiptContainer {
            position: fixed !important;
            left: 0 !important;
            top: 0 !important;
            width: 76mm !important;
            margin: 0 !important;
            padding: 2mm 3mm !important;
            border: none !important;
            box-shadow: none !important;
            background: #fff !important;
            font-family: 'Courier New', Courier, monospace !important;
            font-size: 13px !important;
            line-height: 1.35 !important;
            color: #000 !important;
            z-index: 999999 !important;
        }
        @@page {
            size: 80mm auto;
            margin: 0;
        }
    }
</style>

@if (ViewBag.NotInShift == true)
{
    <div class="container py-4 my-auto" style="min-height: calc(100vh - 120px); display: flex; align-items: center; justify-content: center;">
        <div class="row justify-content-center w-100">
            <div class="col-12 col-md-10 col-lg-8 col-xl-7">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden my-3">
                    <div class="card-header bg-danger text-white py-3 px-4 border-0">
                        <h4 class="card-title fw-bold mb-0">
                            <i class="bi bi-exclamation-octagon-fill me-2"></i>CHƯA ĐỦ ĐIỀU KIỆN MỞ BÁN HÀNG
                        </h4>
                    </div>
                    <div class="card-body p-4 p-md-5 text-center">
                        <div class="mb-4">
                            <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle p-4 mb-3" style="width: 100px; height: 100px;">
                                <i class="bi bi-clock-history display-4"></i>
                            </div>
                            <h4 class="fw-bold text-dark mb-2">
                                @(ViewBag.ReasonCode == "OutsideOperatingHours" ? "Ngoài Khung Giờ Bán Hàng (06:00 - 24:00)" :
                                 (ViewBag.ReasonCode == "NotScheduled" ? "Chưa Có Lịch Ca Trực Hiện Tại" : 
                                 (ViewBag.ReasonCode == "NotCheckedIn" ? "Chưa Điểm Danh Chấm Công Vào Ca" : 
                                 (ViewBag.ReasonCode == "FirstShiftNotOpened" ? "Ca Đầu Ngày Chưa Được Mở Ca" : 
                                 (ViewBag.ReasonCode == "ShiftClosed" ? "Ca Làm Việc Đã Được Đóng / Khóa Sổ" : 
                                 (ViewBag.ReasonCode == "ShiftEnded" ? "Ca Làm Việc Đã Kết Thúc (Đã Ra Ca)" : "Chưa Nhận Bàn Giao Ca"))))))
                            </h4>
                            <p class="text-muted fs-5 mb-0">
                                @ViewBag.NotInShiftMessage
                            </p>
                        </div>

                        <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-dark py-3 px-4 rounded-3 text-start small mb-4">
                            <i class="bi bi-info-circle-fill me-2 text-warning"></i>
                            <strong>Quy định bán hàng cho Thu ngân:</strong> Bạn chỉ được phép mở màn hình bán hàng và thanh toán khi thỏa mãn:
                            <ul class="mb-0 mt-1">
                                <li>Trong khung giờ mở bán chính thức của hệ thống (<strong>06:00 – 24:00 hàng ngày</strong>).</li>
                                <li>Có ca làm việc trong lịch phân công tại thời điểm hiện tại.</li>
                                <li>Đã <strong>điểm danh chấm công (Check-in)</strong> vào ca làm việc.</li>
                                <li>Đã thực hiện <strong>Mở ca đầu ngày</strong> (nếu ca 1) hoặc <strong>Nhận bàn giao ca</strong> (nếu ca 2, 3...).</li>
                            </ul>
                        </div>

                        <div class="d-flex justify-content-center gap-3 flex-wrap">
                            @if (ViewBag.IsLogoutRequired == true || ViewBag.ReasonCode == "NotCheckedIn")
                            {
                                <a href="@Url.Action("Logout", "Auth")" class="btn btn-danger btn-lg px-4 py-2.5 rounded-pill fw-bold shadow-sm">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất để Chấm công Face Login
                                </a>
                                <a asp-action="EmployeeIndex" asp-controller="WorkSchedule" class="btn btn-outline-primary btn-lg px-4 py-2.5 rounded-pill fw-semibold shadow-sm">
                                    <i class="bi bi-calendar-check me-2"></i>Xem lịch làm việc
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(ViewBag.RedirectAction))
                            {
                                <a asp-action="@ViewBag.RedirectAction" asp-controller="@ViewBag.RedirectController" class="btn btn-danger btn-lg px-4 py-2.5 rounded-pill fw-bold shadow-sm">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>@ViewBag.RedirectButtonText
                                </a>
                            }
                            <a href="/Home/Index" class="btn btn-outline-secondary btn-lg px-4 py-2.5 rounded-pill fw-semibold">
                                <i class="bi bi-house me-2"></i>Về Trang Chủ
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
<div class="container-fluid mt-3 pb-5">
    <div class="row g-4">
        <!-- Left Column: Order Review -->
        <div class="col-md-7 border-end pe-4">
            <div class="d-flex align-items-center mb-2">
                <h3 class="fw-bold text-dark mb-0">ĐƠN HÀNG BẠN ĐÃ CHỌN</h3>
                <span class="badge bg-secondary ms-3 px-2.5 py-1.5 fw-semibold text-white">Mã Đơn: @Model.OrderId</span>
            </div>
            
            <div class="d-flex flex-wrap gap-3 align-items-center mb-2 text-secondary small">
                <span><i class="bi bi-geo-alt me-1 text-primary"></i><strong>Vị trí / Bàn:</strong> @Model.TableNumber</span>
                <span><i class="bi bi-person me-1 text-primary"></i><strong>Khách hàng:</strong> @Model.CustomerName</span>
                @if (!string.IsNullOrWhiteSpace(Model.OrderNotes))
                {
                    <span><i class="bi bi-chat-left-text me-1 text-primary"></i><strong>Ghi chú:</strong> @Model.OrderNotes</span>
                }
            </div>

            <p class="text-muted small">Nhân viên &amp; Khách hàng vui lòng kiểm tra danh sách sản phẩm bên dưới trước khi thực hiện chuyển khoản.</p>

            <div class="card border shadow-sm mt-3">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="orderItemsTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Tên Sản Phẩm</th>
                                    <th>Size</th>
                                    <th class="text-end">Đơn Giá</th>
                                    <th class="text-center">Số Lượng</th>
                                    <th class="text-end pe-4">Thành Tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    var itemTotal = item.Quantity * item.UnitPrice;
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@item.ProductName</td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-2 py-1">@item.Size</span>
                                        </td>
                                        <td class="text-end fw-medium text-secondary font-monospace">@item.UnitPrice.ToString("N0") đ</td>
                                        <td class="text-center fw-semibold">@item.Quantity</td>
                                        <td class="text-end pe-4 fw-semibold text-secondary font-monospace">@itemTotal.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="border-top">
                                <tr>
                                    <td colspan="4" class="ps-4 text-secondary fw-semibold">Tạm tính:</td>
                                    <td class="text-end pe-4 fw-bold text-dark font-monospace">@Model.SubtotalAmount.ToString("N0") đ</td>
                                </tr>
                                @if (Model.DiscountAmount > 0)
                                {
                                    <tr>
                                        <td colspan="4" class="ps-4 text-secondary fw-semibold">
                                            Giảm giá @(!string.IsNullOrEmpty(Model.VoucherCode) ? $"({Model.VoucherCode})" : ""):
                                        </td>
                                        <td class="text-end pe-4 fw-bold text-danger font-monospace">-@Model.DiscountAmount.ToString("N0") đ</td>
                                    </tr>
                                }
                                @if (Model.TradeDiscountAmount > 0)
                                {
                                    <tr>
                                        <td colspan="4" class="ps-4 text-secondary fw-semibold">Chiết khấu:</td>
                                        <td class="text-end pe-4 fw-bold text-danger font-monospace">-@Model.TradeDiscountAmount.ToString("N0") đ</td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="4" class="ps-4 fw-bold text-dark">Tổng đơn hàng:</td>
                                    <td class="text-end pe-4 fw-bold text-dark font-monospace">@Model.TotalAmount.ToString("N0") đ</td>
                                </tr>
                                @if (initialCashPaid > 0)
                                {
                                    <tr class="text-primary">
                                        <td colspan="4" class="ps-4 fw-semibold">Đã nhận tiền mặt:</td>
                                        <td class="text-end pe-4 fw-bold font-monospace">-@initialCashPaid.ToString("N0") đ</td>
                                    </tr>
                                    <tr class="table-light">
                                        <td colspan="4" class="ps-4 fw-bold fs-5 text-dark">TIỀN CHUYỂN KHOẢN NỐT:</td>
                                        <td class="text-end pe-4 fw-bold fs-4 text-success font-monospace">@remainingTransfer.ToString("N0") đ</td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="table-light">
                                        <td colspan="4" class="ps-4 fw-bold fs-5 text-dark">TỔNG TIỀN CẦN THANH TOÁN:</td>
                                        <td class="text-end pe-4 fw-bold fs-4 text-success font-monospace">@Model.TotalAmount.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: QR and Payment Controls -->
        <div class="col-md-5 ps-4">
            <div class="card border shadow-sm bg-white">
                <div class="card-body p-4 text-center">
                    <!-- Section QR Code chiếm chiều cao tối đa -->
                    <div class="d-flex flex-column align-items-center justify-content-center border rounded p-3 mb-3 bg-light shadow-sm" style="min-height: 310px;">
                        <img id="qrCodeImg" 
                             src="@qrUrl" 
                             alt="Mã QR Chuyển khoản Ngân hàng (SePay)" 
                             class="img-fluid"
                             style="max-height: 290px; width: auto; object-fit: contain; border-radius: 6px;" />
                    </div>

                    <!-- SePay Bank Transfer Info Card -->
                    <div class="bg-light p-3 rounded border mb-3 text-start small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Ngân hàng:</span>
                            <strong class="text-dark">@bankCode</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Số tài khoản:</span>
                            <strong class="text-primary fs-6">@accountNumber</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Chủ tài khoản:</span>
                            <strong class="text-dark">@accountName</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Số tiền cần chuyển:</span>
                            <strong class="text-success fs-6 font-monospace">@remainingTransfer.ToString("N0") đ</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Nội dung CK:</span>
                            <strong class="text-danger fs-6">@transferContent</strong>
                        </div>
                    </div>

                    <div class="alert alert-info py-2 px-3 small border-0 bg-info bg-opacity-10 text-info text-start mb-3">
                        <i class="bi bi-info-circle-fill me-2"></i>Tự động xác nhận qua cổng <strong>SePay</strong> khi tài khoản nhận đủ tiền.
                    </div>

                    <!-- Partial Payment Alert (Hidden by default, shown when customer paid partially) -->
                    <div id="partialPaymentAlert" class="alert alert-warning border-warning d-none text-start mb-3 p-3 shadow-sm rounded-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-exclamation-triangle-fill text-warning fs-3 me-2"></i>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">KHÁCH ĐÃ CHUYỂN KHOẢN 1 PHẦN</h6>
                                <small class="text-secondary">Chưa nhận đủ tổng giá trị đơn hàng</small>
                            </div>
                        </div>
                        <div class="bg-white p-2 rounded border mb-2 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Đã nhận chuyển khoản:</span>
                                <strong class="text-success" id="partialReceivedBankDisplay">0 đ</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Còn thiếu cần thu:</span>
                                <strong class="text-danger fs-6" id="partialRemainingDisplay">0 đ</strong>
                            </div>
                            <div class="d-flex justify-content-between" id="partialTxCodeRow">
                                <span class="text-muted">Mã GD SePay:</span>
                                <strong class="text-dark" id="partialTxCodeDisplay">-</strong>
                            </div>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-warning fw-bold text-dark py-2 shadow-sm" onclick="openCollectRemainingCashModal()">
                                <i class="bi bi-cash-stack me-1"></i>Thu tiền mặt phần còn thiếu (<span id="btnRemainingAmountText">0 đ</span>)
                            </button>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        @if (initialCashPaid > 0)
                        {
                            <button type="button" class="btn btn-warning fw-bold text-dark py-2.5 shadow-sm" onclick="openCollectRemainingCashModal()">
                                <i class="bi bi-cash-stack me-1"></i>Thu nốt tiền mặt (@remainingTransfer.ToString("N0") đ) &amp; Hoàn tất đơn
                            </button>
                        }

                        <button type="button" class="btn btn-success fw-bold py-2.5 shadow-sm" onclick="confirmManualBankTransfer()">
                            <i class="bi bi-qr-code-scan me-2"></i>Xác nhận đã nhận chuyển khoản
                        </button>
                        
                        <button type="button" class="btn btn-outline-danger fw-semibold py-2 mt-1" onclick="cancelPayment()">
                            <i class="bi bi-x-circle me-2"></i>Hủy giao dịch
                        </button>

                        <button type="button" class="visually-hidden-focusable btn btn-sm btn-outline-warning mt-1" onclick="simulatePartialTransferTest()" title="Dành cho kiểm thử / demo">
                            <i class="bi bi-lightning-charge me-1"></i>[Test] Giả lập khách chuyển khoản 1 phần (50%)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Thu tiền mặt phần còn thiếu (Split Payment) -->
<div class="modal fade" id="collectRemainingCashModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 720px;">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-cash-coin me-2"></i>Tiền Mặt Còn Thiếu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-light border mb-3">
                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                        <span class="text-muted">Tổng giá trị đơn hàng:</span>
                        <strong class="text-dark font-monospace text-end">@Model.TotalAmount.ToString("N0") đ</strong>
                    </div>
                    @if (initialCashPaid > 0)
                    {
                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                            <span class="text-muted">Đã thu tiền mặt trước:</span>
                            <strong class="text-primary font-monospace text-end">@initialCashPaid.ToString("N0") đ</strong>
                        </div>
                    }
                    <div class="d-flex justify-content-between align-items-baseline mb-1" id="modalBankReceivedRow">
                        <span class="text-muted">Đã nhận chuyển khoản:</span>
                        <strong class="text-success font-monospace text-end" id="modalReceivedBank">0 đ</strong>
                    </div>
                    <hr class="my-1" />
                    <div class="d-flex justify-content-between align-items-baseline fs-5">
                        <span class="fw-bold text-danger">Tiền mặt cần thu nốt:</span>
                        <strong class="fw-bold text-danger font-monospace text-end" id="modalRemainingCash">0 đ</strong>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Tiền khách đưa:</label>
                    <div class="input-group input-group-lg">
                        <input type="text" id="splitCustomerCashInput" class="form-control fw-bold text-primary font-monospace" placeholder="0" oninput="onSplitCustomerCashInput(this)" />
                        <span class="input-group-text">đ</span>
                    </div>
                    <div class="d-flex gap-1 mt-2 flex-wrap" id="quickCashButtons">
                        <!-- Fast cash buttons generated dynamically -->
                    </div>
                </div>

                <div class="bg-light p-3 rounded border text-start mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-secondary">Tiền thối lại cho khách:</span>
                        <span class="fs-4 fw-bold text-success font-monospace text-end" id="splitChangeAmountDisplay">0 đ</span>
                    </div>
                </div>

                <div id="splitCashError" class="alert alert-danger py-2 small d-none">
                    <i class="bi bi-exclamation-circle me-1"></i>Tiền khách đưa chưa đủ số tiền cần thu!
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary px-4 fw-bold" id="btnSubmitSplitPayment" onclick="confirmAndSubmitSplitPayment()">
                    <i class="bi bi-check2-circle me-1"></i>Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Transfer Success Popup (Displaying Exact Received Amount) -->
<div class="modal fade" id="transferSuccessModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow text-center p-4">
            <div class="mb-3">
                <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 rounded-circle" style="width: 80px; height: 80px;">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>
                </div>
            </div>
            <h3 class="mb-2 fw-bold text-dark">KHÁCH HÀNG ĐÃ CHUYỂN TIỀN THÀNH CÔNG</h3>
            <div class="alert alert-success border-0 py-3 px-4 mb-3 d-inline-block rounded-3 shadow-sm text-start">
                <div class="mb-2">
                    <span class="text-uppercase text-secondary small d-block fw-bold">MÃ GIAO DỊCH NGÂN HÀNG (ĐỐI SOÁT):</span>
                    <strong class="text-primary fs-4" id="bankTxCodeDisplay">MBB-000000</strong>
                </div>
                <hr class="my-2" />
                <div>
                    <span class="text-uppercase text-secondary small d-block fw-bold">SỐ TIỀN THỰC NHẬN:</span>
                    <h1 class="fw-bold text-success mb-0 fs-2" id="receivedAmountDisplay">@Model.TotalAmount.ToString("N0") đ</h1>
                    <div id="transferSuccessSplitBreakdown" class="small text-muted mt-1 @(initialCashPaid > 0 ? "" : "d-none")">
                        (Tiền mặt: <span id="successCashPart">@initialCashPaid.ToString("N0") đ</span> + Chuyển khoản: <span id="successBankPart">@remainingTransfer.ToString("N0") đ</span>)
                    </div>
                </div>
            </div>
            <p class="text-secondary mb-4 fs-5">Hệ thống đã ghi nhận mã giao dịch ngân hàng để đối soát. Vui lòng bấm bên dưới để hoàn tất.</p>
            <div class="d-grid gap-2 col-10 mx-auto">
                <button type="button" class="btn btn-outline-primary py-2.5 fs-5 fw-bold shadow-sm" onclick="printReceiptFromTransfer()">
                    <i class="bi bi-printer me-2"></i>IN HÓA ĐƠN / PHIẾU ORDER
                </button>
                <button type="button" class="btn btn-success py-2.5 fs-5 fw-bold shadow-sm" onclick="confirmPaymentReceived()">
                    <i class="bi bi-check2-circle me-2"></i>HOÀN TẤT ĐƠN &amp; QUAY VỀ POS
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Preview & In Hóa Đơn K80 -->
<div class="modal fade" id="receiptPrintModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header py-2 bg-light border-bottom d-flex justify-content-between align-items-center">
                <h6 class="modal-title fw-bold text-dark mb-0">
                    <i class="bi bi-printer me-1 text-primary"></i>Hóa Đơn / Phiếu Đặt Đồ (K80)
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 bg-light d-flex flex-column align-items-center">
                <!-- Dual Mode Toggle -->
                <div class="btn-group btn-group-sm mb-3 w-100 shadow-sm" role="group">
                    <button type="button" class="btn btn-primary fw-semibold" id="btnModeReceipt" onclick="switchReceiptMode('receipt')">
                        <i class="bi bi-receipt me-1"></i>Hóa đơn thanh toán
                    </button>
                    <button type="button" class="btn btn-outline-primary fw-semibold" id="btnModeDelivery" onclick="switchReceiptMode('delivery')">
                        <i class="bi bi-ticket-detailed me-1"></i>Phiếu đặt đồ (kẹp khay)
                    </button>
                </div>

                <!-- Printable K80 Receipt Container -->
                <div id="k80ReceiptContainer" class="bg-white p-3 shadow-sm border border-secondary border-opacity-25" style="width: 320px; font-family: 'Courier New', Courier, monospace; font-size: 13px; line-height: 1.35; color: #000;">
                    <!-- Store Header -->
                    <div class="text-center pb-2 mb-2 border-bottom border-dark">
                        <div class="fw-bold text-uppercase fs-6">CSMS COFFEE</div>
                        <div id="recDocTitle" class="fw-bold text-uppercase mt-1" style="font-size: 14px; letter-spacing: 0.5px;">HÓA ĐƠN THANH TOÁN</div>
                        <div class="small mt-1">Chi nhánh: <span id="recBranchName">Hà Đông</span></div>
                        <div class="small">Địa chỉ: <span id="recBranchAddress">123 Nguyễn Trãi, Thanh Xuân, Hà Nội</span></div>
                        <div class="small">SĐT: <span id="recBranchPhone">0988.888.888</span></div>
                    </div>

                    <!-- Delivery Box (prominent for delivery slip mode) -->
                    <div id="recDeliveryBadgeBox" class="p-2 mb-2 text-center border border-2 border-dark rounded d-none" style="background-color: #f8f9fa;">
                        <div class="small text-uppercase fw-bold text-secondary" style="font-size: 11px;">VỊ TRÍ PHỤC VỤ</div>
                        <div id="recDeliveryTableBadge" class="fs-4 fw-bolder text-uppercase text-dark my-1">BÀN 05</div>
                        <div class="small text-muted" id="recDeliveryCustomerBadge">Khách: Anh Tuấn</div>
                    </div>

                    <!-- Order Info -->
                    <div class="pb-2 mb-2 border-bottom border-dark">
                        <div class="d-flex justify-content-between">
                            <span>Mã đơn: <strong id="recOrderId">MH260903-001</strong></span>
                            <span id="recOrderTime">03/09/2026 10:30</span>
                        </div>
                        <div class="mt-1" id="recStandardTableRow">
                            <strong>Vị trí / Bàn: <span id="recTableNumber" class="text-uppercase">Bàn 05</span></strong>
                        </div>
                        <div id="recStandardCustRow">Khách hàng: <span id="recCustomerName">Anh Tuấn</span></div>
                        <div id="recNotesRow" class="d-none mt-1 p-1 border border-secondary border-opacity-50 rounded" style="background: #fff8e1;">
                            <strong>Ghi chú:</strong> <em id="recOrderNotes">Ít ngọt</em>
                        </div>
                    </div>

                    <!-- Items Table -->
                    <table class="w-100 mb-2 border-bottom border-dark" style="font-size: 12px;">
                        <thead>
                            <tr class="border-bottom border-dark">
                                <th class="text-center py-1" style="width: 25px;">STT</th>
                                <th class="text-start py-1">Món</th>
                                <th class="text-center py-1" style="width: 32px;">SL</th>
                                <th class="text-end py-1 rec-price-col" style="width: 58px;">Đ.Giá</th>
                                <th class="text-end py-1 rec-price-col" style="width: 68px;">T.Tiền</th>
                            </tr>
                        </thead>
                        <tbody id="recItemsBody">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>

                    <!-- Financial Summary (Hidden in Delivery Mode) -->
                    <div class="pb-2 mb-2 border-bottom border-dark" id="recFinancialSection">
                        <div class="d-flex justify-content-between">
                            <span>Tạm tính:</span>
                            <span id="recSubtotal" class="font-monospace">140.000 đ</span>
                        </div>
                        <div class="d-flex justify-content-between text-danger d-none" id="recDiscountRow">
                            <span id="recDiscountLabel">Giảm giá:</span>
                            <span id="recDiscount" class="font-monospace">-0 đ</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold fs-6 mt-1 pt-1 border-top border-dark">
                            <span>TỔNG CỘNG:</span>
                            <span id="recTotal" class="font-monospace">140.000 đ</span>
                        </div>
                    </div>

                    <!-- Delivery Summary (Shown only in Delivery Mode) -->
                    <div id="recDeliveryTotalItemsBox" class="pb-2 mb-2 border-bottom border-dark d-none">
                        <div class="d-flex justify-content-between fw-bold">
                            <span>Tổng số món:</span>
                            <span id="recTotalItemsCount">0 món</span>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="text-center pt-1" id="recFooterText">
                        <div>Cảm ơn quý khách &amp; Hẹn gặp lại!</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2 bg-light d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-dark btn-sm fw-semibold" onclick="switchReceiptMode(currentReceiptMode === 'receipt' ? 'delivery' : 'receipt')">
                        <i class="bi bi-arrow-repeat me-1"></i><span id="btnToggleModeLabel">Đổi sang Phiếu đặt đồ</span>
                    </button>
                    <button type="button" class="btn btn-primary btn-sm px-3 fw-bold" onclick="window.print()">
                        <i class="bi bi-printer me-1"></i>In ngay (Print)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
@if (ViewBag.NotInShift != true)
{
    <script>
        // Hàm định dạng số tiền chuẩn VNĐ (vd: 12500 -> "12.500")
        function formatCurrency(amount) {
            if (amount === null || amount === undefined || isNaN(amount)) return '0';
            return new Intl.NumberFormat('vi-VN').format(Math.round(amount));
        }

        // Hàm định dạng số tiền kèm ký hiệu đ (vd: 12500 -> "12.500 đ")
        function formatMoney(amount) {
            return formatCurrency(amount) + ' đ';
        }

        var orderId = '@Model.OrderId';
        var totalAmount = @Model.TotalAmount;
        var initialCashPaid = @initialCashPaid;
        var remainingTransfer = @remainingTransfer;
        var recipientName = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.RecipientName))';
        var orderItems = @Html.Raw(itemsJson);
        var qrCodeUrl = document.getElementById('qrCodeImg').src;
        var currentBankTxCode = '';

        var currentBankAmount = 0;
        var currentRemainingAmount = remainingTransfer;

        // Sync order details and QR code with Customer Monitor immediately on load
        try {
            localStorage.setItem('customer_display_state', JSON.stringify({
                mode: 'BankTransfer',
                orderId: orderId,
                recipientName: recipientName,
                total: remainingTransfer,
                items: orderItems,
                qrCodeUrl: qrCodeUrl,
                note: initialCashPaid > 0 ? ('Đã thu TM: ' + formatMoney(initialCashPaid)) : null
            }));
        } catch (e) {
            console.error("Failed to sync state to Customer Monitor:", e);
        }

        // Start polling payment status every 2 seconds
        var pollInterval = setInterval(function() {
            fetch('@Url.Action("CheckPaymentStatus", "SaleManagement")?orderId=' + orderId)
                .then(res => res.json())
                .then(data => {
                    if (!data.success) return;

                    if (data.paymentStatus === 'TransferSuccessPending') {
                        clearInterval(pollInterval);
                        
                        var recAmount = data.receivedAmount || totalAmount;
                        var formattedAmount = formatMoney(recAmount);
                        document.getElementById('receivedAmountDisplay').innerText = formattedAmount;

                        var cashAmount = data.cashAmount || initialCashPaid;
                        var bankAmount = data.bankAmount || remainingTransfer;
                        if (cashAmount > 0) {
                            var breakdownEl = document.getElementById('transferSuccessSplitBreakdown');
                            if (breakdownEl) breakdownEl.classList.remove('d-none');
                            var cashPartEl = document.getElementById('successCashPart');
                            if (cashPartEl) cashPartEl.innerText = formatMoney(cashAmount);
                            var bankPartEl = document.getElementById('successBankPart');
                            if (bankPartEl) bankPartEl.innerText = formatMoney(bankAmount);
                        }

                        currentBankTxCode = data.bankTransactionCode || ('MBB-' + Date.now().toString().slice(-6));
                        document.getElementById('bankTxCodeDisplay').innerText = currentBankTxCode;

                        // Hide partial payment alert if previously shown
                        var partialEl = document.getElementById('partialPaymentAlert');
                        if (partialEl) partialEl.classList.add('d-none');

                        // Sync paid status and received amount to Customer Monitor
                        localStorage.setItem('customer_display_state', JSON.stringify({
                            mode: 'PaidSuccess',
                            orderId: orderId,
                            receivedAmount: formattedAmount,
                            bankTransactionCode: currentBankTxCode
                        }));

                        // Show cashier modal
                        var successModal = new bootstrap.Modal(document.getElementById('transferSuccessModal'));
                        successModal.show();
                    } else if (data.paymentStatus === 'PartiallyPaid') {
                        currentBankAmount = data.bankAmount || 0;
                        currentRemainingAmount = data.remainingAmount || Math.max(0, totalAmount - currentBankAmount);
                        currentBankTxCode = data.bankTransactionCode || '';

                        // Show Partial Payment Alert only when customer has actually transferred a partial bank amount
                        var alertEl = document.getElementById('partialPaymentAlert');
                        if (alertEl) {
                            if (currentBankAmount > 0 && currentRemainingAmount > 0) {
                                alertEl.classList.remove('d-none');
                                document.getElementById('partialReceivedBankDisplay').innerText = formatMoney(currentBankAmount);
                                document.getElementById('partialRemainingDisplay').innerText = formatMoney(currentRemainingAmount);
                                document.getElementById('btnRemainingAmountText').innerText = formatMoney(currentRemainingAmount);
                                if (currentBankTxCode) {
                                    document.getElementById('partialTxCodeDisplay').innerText = currentBankTxCode;
                                }
                            } else {
                                alertEl.classList.add('d-none');
                            }
                        }

                        // Update dynamic QR Code image for the remaining amount
                        if (currentRemainingAmount > 0) {
                            var newQrUrl = 'https://qr.sepay.vn/img?acc=@accountNumber&bank=@bankCode&amount=' + Math.round(currentRemainingAmount) + '&des=' + encodeURIComponent('@transferContent');
                            document.getElementById('qrCodeImg').src = newQrUrl;
                        }

                        // Sync remaining amount to Customer Monitor
                        try {
                            localStorage.setItem('customer_display_state', JSON.stringify({
                                mode: 'BankTransfer',
                                orderId: orderId,
                                recipientName: recipientName,
                                total: currentRemainingAmount,
                                items: orderItems,
                                qrCodeUrl: document.getElementById('qrCodeImg').src,
                                note: 'Đã nhận CK: ' + formatMoney(currentBankAmount)
                            }));
                        } catch(e) {}
                    }
                })
                .catch(err => console.error("Error polling payment status:", err));
        }, 2000);

        // Auto focus input when modal is shown
        document.addEventListener('DOMContentLoaded', function() {
            var splitModalEl = document.getElementById('collectRemainingCashModal');
            if (splitModalEl) {
                splitModalEl.addEventListener('shown.bs.modal', function () {
                    var inp = document.getElementById('splitCustomerCashInput');
                    if (inp) {
                        inp.focus();
                        inp.select();
                    }
                });
            }
        });

        function getSplitCustomerCashValue() {
            var valStr = (document.getElementById('splitCustomerCashInput').value || '').replace(/\D/g, '');
            return parseFloat(valStr) || 0;
        }

        function onSplitCustomerCashInput(el) {
            var raw = el.value.replace(/\D/g, '');
            if (raw === '') {
                el.value = '';
            } else {
                var num = parseInt(raw, 10);
                el.value = formatCurrency(num);
            }
            calculateSplitChange();
        }

        function openCollectRemainingCashModal() {
            var bankRow = document.getElementById('modalBankReceivedRow');
            if (bankRow) {
                if (currentBankAmount > 0) {
                    bankRow.classList.remove('d-none');
                    document.getElementById('modalReceivedBank').innerText = formatMoney(currentBankAmount);
                } else if (initialCashPaid > 0) {
                    bankRow.classList.add('d-none');
                } else {
                    document.getElementById('modalReceivedBank').innerText = '0 đ';
                }
            }
            document.getElementById('modalRemainingCash').innerText = formatMoney(currentRemainingAmount);

            var cashInput = document.getElementById('splitCustomerCashInput');
            cashInput.value = formatCurrency(currentRemainingAmount);

            // Generate quick cash buttons (bỏ dấu đ)
            var quickContainer = document.getElementById('quickCashButtons');
            quickContainer.innerHTML = '';
            var suggestions = [currentRemainingAmount];
            [20000, 50000, 100000, 200000, 500000].forEach(val => {
                if (val > currentRemainingAmount && !suggestions.includes(val)) suggestions.push(val);
            });
            suggestions.sort((a, b) => a - b).forEach(val => {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn btn-sm btn-outline-secondary font-monospace';
                btn.innerText = formatCurrency(val);
                btn.onclick = function() {
                    cashInput.value = formatCurrency(val);
                    calculateSplitChange();
                };
                quickContainer.appendChild(btn);
            });

            calculateSplitChange();
            var m = new bootstrap.Modal(document.getElementById('collectRemainingCashModal'));
            m.show();
        }

        function calculateSplitChange() {
            var cash = getSplitCustomerCashValue();
            var change = Math.max(0, cash - currentRemainingAmount);
            document.getElementById('splitChangeAmountDisplay').innerText = formatMoney(change);

            var errEl = document.getElementById('splitCashError');
            var btnSubmit = document.getElementById('btnSubmitSplitPayment');
            if (cash < currentRemainingAmount) {
                errEl.classList.remove('d-none');
                btnSubmit.disabled = true;
            } else {
                errEl.classList.add('d-none');
                btnSubmit.disabled = false;
            }
        }

        function confirmAndSubmitSplitPayment() {
            var cash = getSplitCustomerCashValue();
            if (cash < currentRemainingAmount) {
                showToast("Tiền khách đưa chưa đủ!", "danger");
                return;
            }

            showConfirmModal(
                'Xác nhận thu tiền mặt',
                'Xác nhận đã thu ' + formatMoney(currentRemainingAmount) + ' tiền mặt từ khách hàng và hoàn tất đơn hàng?',
                function() {
                    submitSplitPayment();
                },
                'Xác nhận',
                'Hủy'
            );
        }

        function submitSplitPayment() {
            var cash = getSplitCustomerCashValue();
            if (cash < currentRemainingAmount) {
                showToast("Tiền khách đưa chưa đủ!", "danger");
                return;
            }
            var change = Math.max(0, cash - currentRemainingAmount);
            var totalCashForOrder = initialCashPaid > 0 ? (initialCashPaid + currentRemainingAmount) : currentRemainingAmount;

            var payload = {
                orderId: orderId,
                cashAmount: totalCashForOrder,
                bankAmount: currentBankAmount,
                customerCash: cash,
                changeAmount: change,
                bankTransactionCode: currentBankTxCode
            };

            fetch('@Url.Action("CompleteSplitPayment", "SaleManagement")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    clearInterval(pollInterval);
                    var m = bootstrap.Modal.getInstance(document.getElementById('collectRemainingCashModal'));
                    if (m) m.hide();

                    showToast("Thanh toán kết hợp thành công! Đã chuyển đơn hàng sang Pha chế.", "success");
                    localStorage.removeItem('csms_cart');

                    // Reset Customer Monitor
                    try {
                        localStorage.setItem('customer_display_state', JSON.stringify({
                            mode: 'PaidSuccess',
                            orderId: orderId,
                            receivedAmount: formatMoney(totalAmount),
                            bankTransactionCode: currentBankTxCode
                        }));
                    } catch(e) {}

                    setTimeout(() => {
                        window.location.href = '@Url.Action("CreateOrder", "SaleManagement")';
                    }, 1000);
                } else {
                    showToast("Lỗi: " + data.message, "danger");
                }
            })
            .catch(err => {
                console.error(err);
                showToast("Lỗi kết nối máy chủ.", "danger");
            });
        }

        function simulatePartialTransferTest() {
            var partialAmount = Math.round(totalAmount / 2);
            fetch('@Url.Action("SimulatePartialTransfer", "SaleManagement")?orderId=' + orderId + '&amount=' + partialAmount, {
                method: 'POST'
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast("Đã giả lập nhận chuyển khoản 1 phần: " + formatMoney(partialAmount), "info");
                } else {
                    showToast("Lỗi: " + data.message, "danger");
                }
            })
            .catch(err => console.error(err));
        }

        function confirmManualBankTransfer() {
            showConfirmModal(
                'Xác nhận đã nhận tiền chuyển khoản',
                'Xác nhận khách hàng đã chuyển khoản thành công (trường hợp SePay bị chậm hoặc chuyển thủ công)?',
                function() {
                    fetch('@Url.Action("SimulateBankTransferSuccess", "SaleManagement")?orderId=' + orderId, {
                        method: 'POST'
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success) {
                            showToast("Lỗi xác nhận: " + data.message, "danger");
                        }
                    })
                    .catch(err => {
                        console.error("Failed to request bank simulation:", err);
                        showToast("Lỗi khi gửi yêu cầu xác nhận.", "danger");
                    });
                },
                'Xác nhận nhận tiền',
                'Hủy'
            );
        }

        function cancelPayment() {
            if (currentBankAmount > 0) {
                showToast("Đơn hàng đã nhận tiền chuyển khoản (" + formatMoney(currentBankAmount) + "). Vui lòng thu nốt tiền mặt phần còn thiếu để hoàn tất đơn!", "warning");
                return;
            }

            var confirmTitle = initialCashPaid > 0 ? 'Hủy giao dịch & Hoàn tiền mặt' : 'Hủy giao dịch';
            var confirmMsg = initialCashPaid > 0 
                ? 'Đơn hàng đã thu trước ' + formatMoney(initialCashPaid) + ' tiền mặt. Bạn có chắc chắn muốn hủy giao dịch chuyển khoản này, hoàn trả lại ' + formatMoney(initialCashPaid) + ' tiền mặt cho khách và quay lại màn hình chọn phương thức thanh toán?'
                : 'Xác nhận hủy giao dịch chuyển khoản này và quay lại màn hình chọn phương thức thanh toán?';
            var confirmBtnText = initialCashPaid > 0 ? 'Xác nhận hủy & Trả lại tiền' : 'Xác nhận hủy';

            showConfirmModal(
                confirmTitle,
                confirmMsg,
                function() {
                    clearInterval(pollInterval);
                    fetch('@Url.Action("CancelBankTransfer", "SaleManagement")?orderId=' + orderId, {
                        method: 'POST'
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data && !data.success) {
                            showToast(data.message || "Không thể hủy giao dịch.", "danger");
                            return;
                        }

                        // Reset Customer Monitor
                        try {
                            localStorage.setItem('customer_display_state', JSON.stringify({
                                mode: 'Idle'
                            }));
                        } catch(e) {}

                        window.location.href = '@Url.Action("CreateOrder", "SaleManagement")?orderId=' + orderId + '&showCheckout=true';
                    })
                    .catch(err => {
                        console.error(err);
                        window.location.href = '@Url.Action("CreateOrder", "SaleManagement")?orderId=' + orderId + '&showCheckout=true';
                    });
                },
                confirmBtnText,
                'Quay lại'
            );
        }

        function confirmPaymentReceived() {
            var formData = new URLSearchParams();
            formData.append('orderId', orderId);
            formData.append('paymentMethod', 'Bank Transfer');
            formData.append('bankTransactionCode', currentBankTxCode);

            fetch('@Url.Action("ProcessPayment", "SaleManagement")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    var successModal = bootstrap.Modal.getInstance(document.getElementById('transferSuccessModal'));
                    if (successModal) successModal.hide();
                    
                    localStorage.removeItem('csms_cart');
                    
                    // Redirect back to main POS
                    window.location.href = '@Url.Action("CreateOrder", "SaleManagement")';
                } else {
                    showToast("Lỗi hoàn tất thanh toán: " + data.message, "danger");
                }
            })
            .catch(err => {
                console.error("Failed to complete payment receipt:", err);
                showToast("Lỗi kết nối máy chủ.", "danger");
            });
        }

        var currentReceiptMode = 'receipt';
        function switchReceiptMode(mode) {
            currentReceiptMode = mode;
            var btnRec = document.getElementById('btnModeReceipt');
            var btnDel = document.getElementById('btnModeDelivery');
            var toggleLabel = document.getElementById('btnToggleModeLabel');
            var docTitle = document.getElementById('recDocTitle');
            var badgeBox = document.getElementById('recDeliveryBadgeBox');
            var stdTableRow = document.getElementById('recStandardTableRow');
            var stdCustRow = document.getElementById('recStandardCustRow');
            var finSec = document.getElementById('recFinancialSection');
            var paySec = document.getElementById('recPaymentSection');
            var delTotalBox = document.getElementById('recDeliveryTotalItemsBox');
            var footerText = document.getElementById('recFooterText');
            var priceCols = document.querySelectorAll('.rec-price-col');

            if (mode === 'delivery') {
                if (btnRec) { btnRec.className = 'btn btn-outline-primary fw-semibold'; }
                if (btnDel) { btnDel.className = 'btn btn-primary fw-semibold'; }
                if (toggleLabel) { toggleLabel.innerText = 'Đổi sang Hóa đơn'; }
                if (docTitle) { docTitle.innerText = 'PHIẾU ĐẶT ĐỒ'; }
                if (badgeBox) { badgeBox.classList.remove('d-none'); }
                if (stdTableRow) { stdTableRow.classList.add('d-none'); }
                if (stdCustRow) { stdCustRow.classList.add('d-none'); }
                if (finSec) { finSec.classList.add('d-none'); }
                if (paySec) { paySec.classList.add('d-none'); }
                if (delTotalBox) { delTotalBox.classList.remove('d-none'); }
                if (footerText) { footerText.innerHTML = '<div>Powered by CSMS.vn</div>'; }
                priceCols.forEach(el => el.classList.add('d-none'));
            } else {
                if (btnRec) { btnRec.className = 'btn btn-primary fw-semibold'; }
                if (btnDel) { btnDel.className = 'btn btn-outline-primary fw-semibold'; }
                if (toggleLabel) { toggleLabel.innerText = 'Đổi sang Phiếu đặt đồ'; }
                if (docTitle) { docTitle.innerText = 'HÓA ĐƠN THANH TOÁN'; }
                if (badgeBox) { badgeBox.classList.add('d-none'); }
                if (stdTableRow) { stdTableRow.classList.remove('d-none'); }
                if (stdCustRow) { stdCustRow.classList.remove('d-none'); }
                if (finSec) { finSec.classList.remove('d-none'); }
                if (paySec) { paySec.classList.remove('d-none'); }
                if (delTotalBox) { delTotalBox.classList.add('d-none'); }
                if (footerText) { footerText.innerHTML = '<div>Cảm ơn quý khách &amp; Hẹn gặp lại!</div>'; }
                priceCols.forEach(el => el.classList.remove('d-none'));
            }
        }

        function printReceiptFromTransfer() {
            fetch('@Url.Action("GetReceiptData", "SaleManagement")?orderId=' + encodeURIComponent(orderId))
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        showToast("Không thể tải thông tin hóa đơn: " + data.message, "danger");
                        return;
                    }

                    document.getElementById('recBranchName').innerText = data.branchName || 'CSMS';
                    document.getElementById('recBranchAddress').innerText = data.branchAddress || '';
                    document.getElementById('recBranchPhone').innerText = data.branchPhone || '';
                    document.getElementById('recOrderId').innerText = data.orderId;
                    document.getElementById('recOrderTime').innerText = data.orderTime;
                    if (document.getElementById('recCashierName')) {
                        document.getElementById('recCashierName').innerText = data.cashierName;
                    }
                    document.getElementById('recTableNumber').innerText = data.tableNumber || 'Mang về';
                    document.getElementById('recCustomerName').innerText = data.customerName || 'Khách lẻ';

                    // Update Delivery ticket specific info
                    var delTableBadge = document.getElementById('recDeliveryTableBadge');
                    if (delTableBadge) {
                        delTableBadge.innerText = (data.tableNumber && data.tableNumber.trim() !== '') ? data.tableNumber : 'MANG VỀ';
                    }
                    var delCustBadge = document.getElementById('recDeliveryCustomerBadge');
                    if (delCustBadge) {
                        delCustBadge.innerText = 'Khách: ' + (data.customerName || 'Khách lẻ');
                    }

                    var notesRow = document.getElementById('recNotesRow');
                    if (data.orderNotes && data.orderNotes.trim() !== '') {
                        notesRow.classList.remove('d-none');
                        document.getElementById('recOrderNotes').innerText = data.orderNotes;
                    } else {
                        notesRow.classList.add('d-none');
                    }

                    var itemsHtml = '';
                    var totalItemsCount = 0;
                    (data.items || []).forEach((item, idx) => {
                        totalItemsCount += (item.quantity || 1);
                        itemsHtml += `
                            <tr>
                                <td class="text-center py-1 text-muted font-monospace">${idx + 1}</td>
                                <td class="py-1">
                                    <div class="fw-semibold">${item.productName}</div>
                                    <div class="small text-muted">Size: ${item.size}</div>
                                </td>
                                <td class="text-center py-1 font-monospace fw-bold">${item.quantity}</td>
                                <td class="text-end py-1 font-monospace rec-price-col">${item.unitPrice.toLocaleString('vi-VN')}</td>
                                <td class="text-end py-1 font-monospace rec-price-col">${item.amount.toLocaleString('vi-VN')}</td>
                            </tr>
                        `;
                    });
                    document.getElementById('recItemsBody').innerHTML = itemsHtml;

                    var totalItemsEl = document.getElementById('recTotalItemsCount');
                    if (totalItemsEl) {
                        totalItemsEl.innerText = totalItemsCount + ' món';
                    }

                    document.getElementById('recSubtotal').innerText = data.subtotalAmount.toLocaleString('vi-VN') + ' đ';

                    var discRow = document.getElementById('recDiscountRow');
                    if (data.discountAmount > 0) {
                        discRow.classList.remove('d-none');
                        var labelEl = document.getElementById('recDiscountLabel');
                        if (labelEl) {
                            labelEl.innerText = data.voucherCode ? `Giảm giá (${data.voucherCode}):` : 'Giảm giá:';
                        }
                        document.getElementById('recDiscount').innerText = '-' + data.discountAmount.toLocaleString('vi-VN') + ' đ';
                    } else {
                        discRow.classList.add('d-none');
                    }

                    document.getElementById('recTotal').innerText = data.totalAmount.toLocaleString('vi-VN') + ' đ';

                    // Payment Method (Tiền mặt, CK hoặc CK + Tiền mặt)
                    var payMethodEl = document.getElementById('recPaymentMethod');
                    if (payMethodEl) {
                        var pMethod = (data.paymentMethod || '').trim();
                        if (pMethod === 'Split' || (data.cashAmount > 0 && data.bankAmount > 0) || pMethod.indexOf('Thu thêm') !== -1 || pMethod.indexOf('+') !== -1) {
                            payMethodEl.innerText = 'CK + Tiền mặt';
                        } else if (pMethod === 'Bank Transfer' || pMethod === 'BankTransfer' || pMethod === 'Transfer' || pMethod === 'CK') {
                            payMethodEl.innerText = 'CK';
                        } else {
                            payMethodEl.innerText = 'Tiền mặt';
                        }
                    }

                    switchReceiptMode('receipt');

                    var modalEl = document.getElementById('receiptPrintModal');
                    if (modalEl) {
                        var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                        modal.show();
                    }
                })
                .catch(err => {
                    console.error(err);
                    showToast("Lỗi khi tải dữ liệu hóa đơn.", "danger");
                });
        }
    </script>
}
}


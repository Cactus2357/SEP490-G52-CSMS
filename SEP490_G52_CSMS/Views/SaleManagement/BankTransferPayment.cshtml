@{
    ViewData["Title"] = "Thanh toán Chuyển khoản";
    var branchSetting = ViewBag.BranchSetting as SEP490_G52_CSMS.Models.Core.BranchSetting ?? new SEP490_G52_CSMS.Models.Core.BranchSetting();
    string bankCode = branchSetting.BankCode ?? "MBBank";
    string accountNumber = branchSetting.AccountNumber ?? "0333333333";
    string accountName = branchSetting.AccountName ?? "CSMS CAFE";
    string prefix = string.IsNullOrWhiteSpace(branchSetting.TransferPrefix) ? "CSMS" : branchSetting.TransferPrefix;
    string transferContent = $"{prefix} {Model.OrderId}";
    string qrUrl = $"https://qr.sepay.vn/img?acc={accountNumber}&bank={bankCode}&amount={(int)Model.TotalAmount}&des={Uri.EscapeDataString(transferContent)}";

    var itemList = new List<object>();
    if (Model?.Items != null)
    {
        foreach (var item in Model.Items)
        {
            itemList.Add(new { 
                name = item.ProductName, 
                size = item.Size, 
                quantity = item.Quantity, 
                amount = item.Quantity * item.UnitPrice 
            });
        }
    }
    var itemsJson = System.Text.Json.JsonSerializer.Serialize(itemList);
}

<div class="container-fluid mt-3 pb-5">
    <div class="row g-4">
        <!-- Left Column: Order Review -->
        <div class="col-md-7 border-end pe-4">
            <div class="d-flex align-items-center mb-3">
                <h3 class="fw-bold text-dark mb-0">ĐƠN HÀNG BẠN ĐÃ CHỌN</h3>
                <span class="badge bg-secondary ms-3 px-2.5 py-1.5 fw-semibold text-white">Mã Đơn: @Model.OrderId</span>
            </div>
            
            <p class="text-muted">Nhân viên & Khách hàng vui lòng kiểm tra danh sách sản phẩm bên dưới trước khi thực hiện chuyển khoản.</p>

            <div class="card border shadow-sm mt-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="orderItemsTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Tên Sản Phẩm</th>
                                    <th>Size</th>
                                    <th>Số Lượng</th>
                                    <th class="text-end pe-4">Thành Tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    var itemTotal = item.Quantity * item.UnitPrice;
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@item.ProductName</td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-2 py-1">@item.Size</span>
                                        </td>
                                        <td class="fw-semibold">@item.Quantity</td>
                                        <td class="text-end pe-4 fw-semibold text-secondary">@itemTotal.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: QR and Payment Controls -->
        <div class="col-md-5 ps-4">
            <div class="card border shadow-sm bg-white">
                <div class="card-body p-4 text-center">
                    <h6 class="text-uppercase text-secondary fw-bold mb-2">TỔNG TIỀN CẦN THANH TOÁN</h6>
                    <h2 class="fw-bold text-success mb-3">@Model.TotalAmount.ToString("N0") đ</h2>
                    
                    <div class="border rounded d-inline-block p-3 mb-3 bg-light shadow-sm">
                        <img id="qrCodeImg" 
                             src="@qrUrl" 
                             alt="Mã QR Chuyển khoản Ngân hàng (SePay)" 
                             style="width: 240px; height: 240px; object-fit: contain; border-radius: 4px;" />
                    </div>

                    <!-- SePay Bank Transfer Info Card -->
                    <div class="bg-light p-3 rounded border mb-3 text-start small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Ngân hàng:</span>
                            <strong class="text-dark">@bankCode</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Số tài khoản:</span>
                            <strong class="text-primary fs-6">@accountNumber</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Chủ tài khoản:</span>
                            <strong class="text-dark">@accountName</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Nội dung CK:</span>
                            <strong class="text-danger fs-6">@transferContent</strong>
                        </div>
                    </div>

                    <div class="alert alert-info py-2 px-3 small border-0 bg-info bg-opacity-10 text-info text-start mb-3">
                        <i class="bi bi-info-circle-fill me-2"></i>Tự động xác nhận qua cổng <strong>SePay</strong> khi tài khoản nhận đủ tiền.
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm py-1.5" onclick="simulateSuccess()">
                            <i class="bi bi-patch-check me-1"></i>[Giả lập Khách chuyển khoản thành công]
                        </button>
                        
                        <button type="button" class="btn btn-outline-danger fw-semibold py-2 mt-1" onclick="cancelPayment()">
                            <i class="bi bi-x-circle me-2"></i>Hủy giao dịch / Quay lại
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Transfer Success Popup (Displaying Exact Received Amount) -->
<div class="modal fade" id="transferSuccessModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow text-center p-4">
            <div class="mb-3">
                <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 rounded-circle" style="width: 80px; height: 80px;">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>
                </div>
            </div>
            <h3 class="mb-2 fw-bold text-dark">KHÁCH HÀNG ĐÃ CHUYỂN TIỀN THÀNH CÔNG</h3>
            <div class="alert alert-success border-0 py-3 px-4 mb-3 d-inline-block rounded-3 shadow-sm">
                <span class="text-uppercase text-secondary d-block small mb-1 fw-bold">SỐ TIỀN THỰC NHẬN TỪ SEPAY / NGÂN HÀNG:</span>
                <h1 class="fw-bold text-success mb-0 fs-1" id="receivedAmountDisplay">@Model.TotalAmount.ToString("N0") đ</h1>
            </div>
            <p class="text-secondary mb-4 fs-5">Hệ thống đã tự động nhận diện và xác nhận số tiền từ cổng SePay. Vui lòng bấm bên dưới để hoàn tất.</p>
            <div class="d-grid gap-2 col-8 mx-auto">
                <button type="button" class="btn btn-success py-3 fs-4 fw-bold shadow-sm" onclick="confirmPaymentReceived()">XÁC NHẬN ĐÃ NHẬN TIỀN</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var orderId = '@Model.OrderId';
        var totalAmount = @Model.TotalAmount;
        var recipientName = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.RecipientName))';
        var orderItems = @Html.Raw(itemsJson);
        var qrCodeUrl = document.getElementById('qrCodeImg').src;

        // Sync order details and QR code with Customer Monitor immediately on load
        try {
            localStorage.setItem('customer_display_state', JSON.stringify({
                mode: 'BankTransfer',
                orderId: orderId,
                recipientName: recipientName,
                total: totalAmount,
                items: orderItems,
                qrCodeUrl: qrCodeUrl
            }));
        } catch (e) {
            console.error("Failed to sync state to Customer Monitor:", e);
        }

        // Start polling payment status every 2 seconds
        var pollInterval = setInterval(function() {
            fetch('@Url.Action("CheckPaymentStatus", "SaleManagement")?orderId=' + orderId)
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.paymentStatus === 'TransferSuccessPending') {
                        clearInterval(pollInterval);
                        
                        var recAmount = data.receivedAmount || totalAmount;
                        var formattedAmount = new Intl.NumberFormat('vi-VN').format(recAmount) + ' đ';
                        document.getElementById('receivedAmountDisplay').innerText = formattedAmount;

                        // Sync paid status and received amount to Customer Monitor
                        localStorage.setItem('customer_display_state', JSON.stringify({
                            mode: 'PaidSuccess',
                            orderId: orderId,
                            receivedAmount: formattedAmount
                        }));

                        // Show cashier modal
                        var successModal = new bootstrap.Modal(document.getElementById('transferSuccessModal'));
                        successModal.show();
                    }
                })
                .catch(err => console.error("Error polling payment status:", err));
        }, 2000);

        function simulateSuccess() {
            fetch('@Url.Action("SimulateBankTransferSuccess", "SaleManagement")?orderId=' + orderId, {
                method: 'POST'
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    showToast("Giả lập lỗi: " + data.message, "danger");
                }
            })
            .catch(err => console.error("Failed to request bank simulation:", err));
        }

        function cancelPayment() {
            showConfirmModal(
                'Hủy giao dịch',
                'Xác nhận hủy giao dịch chuyển khoản này và quay lại màn hình chọn phương thức thanh toán?',
                function() {
                    clearInterval(pollInterval);
                    fetch('@Url.Action("CancelBankTransfer", "SaleManagement")?orderId=' + orderId, {
                        method: 'POST'
                    })
                    .then(() => {
                        // Reset Customer Monitor
                        localStorage.setItem('customer_display_state', JSON.stringify({
                            mode: 'Idle'
                        }));
                        window.location.href = '@Url.Action("CreateOrder", "SaleManagement")?orderId=' + orderId + '&showCheckout=true';
                    })
                    .catch(err => {
                        console.error(err);
                        window.location.href = '@Url.Action("CreateOrder", "SaleManagement")?orderId=' + orderId + '&showCheckout=true';
                    });
                }
            );
        }

        function confirmPaymentReceived() {
            var formData = new URLSearchParams();
            formData.append('orderId', orderId);
            formData.append('paymentMethod', 'Bank Transfer');

            fetch('@Url.Action("ProcessPayment", "SaleManagement")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    var successModal = bootstrap.Modal.getInstance(document.getElementById('transferSuccessModal'));
                    if (successModal) successModal.hide();
                    
                    localStorage.removeItem('csms_cart');
                    
                    // Redirect back to main POS
                    window.location.href = '@Url.Action("CreateOrder", "SaleManagement")';
                } else {
                    showToast("Lỗi hoàn tất thanh toán: " + data.message, "danger");
                }
            })
            .catch(err => {
                console.error("Failed to complete payment receipt:", err);
                showToast("Lỗi kết nối máy chủ.", "danger");
            });
        }
    </script>
}

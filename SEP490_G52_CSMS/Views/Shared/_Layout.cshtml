@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction     = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Returns "active" when the current request matches the given controller (and optionally action).
    string ActiveIf(string controller, string action = "")
    {
        bool controllerMatch = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        bool actionMatch     = string.IsNullOrEmpty(action) ||
                               string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return (controllerMatch && actionMatch) ? "active" : "";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CSMS</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const icon = document.getElementById('toggleIcon');
            const isCollapsed = sidebar.classList.toggle('collapsed');

            icon.className = isCollapsed ? 'bi bi-chevron-right' : 'bi bi-chevron-left';
            localStorage.setItem('sidebar-collapsed', isCollapsed ? 'true' : 'false');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            if (sidebar) {
                // Remove the no-transition class to allow smooth hover/toggle animations after page load
                setTimeout(() => {
                    sidebar.classList.remove('no-transition');
                }, 50);
            }
        });
    </script>
</head>

<body>

    <div class="app-layout">
        <div class="sidebar no-transition" id="sidebar">
            <div class="sidebar-logo">
                <span class="logo-text">CSMS</span>
                <button class="toggle-sidebar-btn" onclick="toggleSidebar()" title="Thu gọn / Mở rộng sidebar">
                    <i class="bi bi-chevron-left" id="toggleIcon"></i>
                </button>
            </div>
            <ul class="sidebar-menu">
                @* ✅ Linked: DAT_Employee → Index *@
                <li class="menu-item">
                    <a asp-controller="DAT_Employee" asp-action="Index"
                       class="menu-link @ActiveIf("DAT_Employee", "Index")">
                        <i class="bi bi-people-fill"></i>
                        <span>Quản lý nhân viên</span>
                    </a>
                </li>

                @* ✅ Linked: WorkSchedule → AddWorkSchedule *@
                <li class="menu-item">
                    <a asp-controller="WorkSchedule" asp-action="AddWorkSchedule"
                       class="menu-link @ActiveIf("WorkSchedule", "AddWorkSchedule")">
                        <i class="bi bi-calendar3"></i>
                        <span>Quản lý lịch làm việc</span>
                    </a>
                </li>

                @* ⏳ Not yet implemented — kept for visual completeness *@
                <li class="menu-item">
                    <a href="#" class="menu-link disabled-link" title="Chức năng đang phát triển">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>Quản lý đổi ca</span>
                    </a>
                </li>
                <li class="menu-item">
                    <a href="#" class="menu-link disabled-link" title="Chức năng đang phát triển">
                        <i class="bi bi-clock-history"></i>
                        <span>Lịch sử giao ca</span>
                    </a>
                </li>
                <li class="menu-item">
                    <a href="#" class="menu-link disabled-link" title="Chức năng đang phát triển">
                        <i class="bi bi-journal-text"></i>
                        <span>Quản lý thực đơn</span>
                    </a>
                </li>
                <li class="menu-item">
                    <a href="#" class="menu-link disabled-link" title="Chức năng đang phát triển">
                        <i class="bi bi-calendar-x"></i>
                        <span>Quản lý nghỉ phép</span>
                    </a>
                </li>
                <li class="menu-item">
                    <a href="#" class="menu-link disabled-link" title="Chức năng đang phát triển">
                        <i class="bi bi-cart3"></i>
                        <span>Quản lý đơn đặt hàng</span>
                    </a>
                </li>
            </ul>
            <script>
                (function () {
                    const savedCollapsed = localStorage.getItem('sidebar-collapsed');
                    if (savedCollapsed === 'true') {
                        document.getElementById('sidebar').classList.add('collapsed');
                        const icon = document.getElementById('toggleIcon');
                        if (icon) icon.className = 'bi bi-chevron-right';
                    }
                })();
            </script>
        </div>

        <div class="main-wrapper">
            <header class="top-header">
                <div class="header-left">
                    <input type="text" class="header-search" placeholder="search">
                </div>
                <div class="header-branch">
                    <span>Chi nhánh Quận 1</span>
                </div>
                <div class="header-right">
                    <button class="header-icon-btn">
                        <i class="bi bi-bell"></i>
                    </button>
                    <div class="dropdown">
                        <button class="btn user-avatar-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar-img @(User.Identity?.IsAuthenticated == true ? "" : "unauthenticated")">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Auth" asp-action="Profile">
                                        <i class="bi bi-person-circle me-2"></i> Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                    </button>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Auth" asp-action="Login">
                                        <i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </header>

            <main class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="modal fade" id="logoutConfirmModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="logoutConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 560px;">
            <div class="modal-content" style="border-radius: 4px;">
                <div class="modal-header border-0 justify-content-center pt-4 pb-0">
                    <h5 class="modal-title fw-bold text-uppercase" id="logoutConfirmModalLabel" style="letter-spacing: 0.5px;">
                        Đăng xuất tài khoản
                    </h5>
                </div>
                <div class="modal-body text-center px-5 py-4">
                    <p class="mb-0" style="font-size: 0.95rem; line-height: 1.6;">
                        Bạn có chắc chắn muốn đăng xuất khỏi hệ thống không? Lưu ý: Hãy đảm bảo
                        bạn đã bàn giao ca và kết ca thành công trước khi rời máy.
                    </p>
                </div>
                <div class="border-top">
                    <form method="post" asp-controller="Auth" asp-action="Logout" class="d-flex">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn rounded-0 w-50 py-2 border-0 border-end">Xác nhận</button>
                        <button type="button" class="btn rounded-0 w-50 py-2 border-0" data-bs-dismiss="modal">Huỷ bỏ</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
@inject SEP490_G52_CSMS.Models.CSMSAppDbContext DbContext
@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Returns "active" when the current request matches the given controller (and optionally action).
    string ActiveIf(string controller, string action = "")
    {
        bool controllerMatch = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        bool actionMatch = string.IsNullOrEmpty(action) ||
                               string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return (controllerMatch && actionMatch) ? "active" : "";
    }

    var branchId = User.FindFirst("BranchId")?.Value;
    var branchName = "Tổng công ty";
    if (!string.IsNullOrEmpty(branchId))
    {
        var branch = DbContext.Branches.FirstOrDefault(b => b.BranchId == branchId);
        if (branch != null)
        {
            branchName = branch.BranchName;
        }
    }

    int unreadCount = 0;
    List<Notification> notificationsList = new();
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        int userId = 0;
        int.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out userId);
        var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

        notificationsList = DbContext.Notifications
            .Where(n => !n.IsRead && (n.RecipientUserId == null || n.RecipientUserId == userId || n.RecipientRole == userRole))
            .OrderByDescending(n => n.CreatedTime)
            .Take(5)
            .ToList();

        unreadCount = DbContext.Notifications
            .Count(n => !n.IsRead && (n.RecipientUserId == null || n.RecipientUserId == userId || n.RecipientRole == userRole));
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CSMS</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <script>
        // Persist and restore user theme selection early to prevent color flashing
        (function () {
            const savedTheme = localStorage.getItem('user-theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
            document.addEventListener('DOMContentLoaded', () => {
                document.body.setAttribute('data-theme', savedTheme);
                
                // Sync toggle switch state on load
                const toggleSwitch = document.getElementById('themeToggleSwitch');
                if (toggleSwitch) {
                    toggleSwitch.checked = (savedTheme === 'dark');
                }
            });
        })();

        function toggleTheme() {
            const currentTheme = document.body.getAttribute('data-theme') || 'light';
            const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', nextTheme);
            document.body.setAttribute('data-theme', nextTheme);
            localStorage.setItem('user-theme', nextTheme);
            
            const toggleSwitch = document.getElementById('themeToggleSwitch');
            if (toggleSwitch) {
                toggleSwitch.checked = (nextTheme === 'dark');
            }
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const icon = document.getElementById('toggleIcon');
            const isCollapsed = sidebar.classList.toggle('collapsed');

            icon.className = isCollapsed ? 'bi bi-chevron-right' : 'bi bi-chevron-left';
            localStorage.setItem('sidebar-collapsed', isCollapsed ? 'true' : 'false');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            if (sidebar) {
                // Remove the no-transition class to allow smooth hover/toggle animations after page load
                setTimeout(() => {
                    sidebar.classList.remove('no-transition');
                }, 50);
            }
        });
    </script>
</head>

<body>

    <div class="app-layout">
        <div class="sidebar no-transition" id="sidebar">
            <div class="sidebar-logo">
                <span class="logo-text">CSMS</span>
                <button class="toggle-sidebar-btn" onclick="toggleSidebar()" title="Thu gọn / Mở rộng sidebar">
                    <i class="bi bi-chevron-left" id="toggleIcon"></i>
                </button>
            </div>
            <ul class="sidebar-menu">
                @if (User.IsInRole("RManager"))
                {
                    <partial name="_Sidebar.RManager" />
                }
                else if (User.IsInRole("WarehouseManager"))
                {
                    <partial name="_Sidebar.WarehouseManager" />
                }
                else if (User.IsInRole("BranchManager"))
                {
                    <partial name="_Sidebar.BranchManager" />
                }
                else if (User.IsInRole("Cashier"))
                {
                    <partial name="_Sidebar.Cashier" />
                }
                else if (User.IsInRole("Bartender") || User.IsInRole("Barista"))
                {
                    <partial name="_Sidebar.Bartender" />
                }
                else if (User.IsInRole("Busser"))
                {
                    <partial name="_Sidebar.Busser" />
                }
            </ul>
            <script>
                (function () {
                    const savedCollapsed = localStorage.getItem('sidebar-collapsed');
                    if (savedCollapsed === 'true') {
                        document.getElementById('sidebar').classList.add('collapsed');
                        const icon = document.getElementById('toggleIcon');
                        if (icon) icon.className = 'bi bi-chevron-right';
                    }
                })();
            </script>
        </div>

        <div class="main-wrapper">
            <header class="top-header">
                <div class="header-left">
                    <input type="text" class="header-search" placeholder="search">
                </div>
                <div class="header-branch">
                    <span>@branchName</span>
                </div>
                <div class="header-right">
                    <div class="dropdown me-2">
                        <button class="btn btn-link text-dark position-relative p-1 header-icon-btn border-0 text-decoration-none dropdown-toggle no-caret" type="button" data-bs-toggle="dropdown" aria-expanded="false" onclick="markAllNotificationsAsRead()">
                            <i class="bi bi-bell fs-5 text-secondary"></i>
                            @if (unreadCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notificationBadgeCount" style="font-size: 0.65rem; padding: 0.25em 0.45em; margin-top: -3px; margin-left: -3px;">
                                    @unreadCount
                                </span>
                            }
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end p-0 shadow border-0 rounded-3" style="width: 320px; max-height: 400px; overflow-y: auto; z-index: 1060;">
                            <li class="dropdown-header bg-dark text-white rounded-top-3 py-2 fw-bold text-uppercase small d-flex justify-content-between align-items-center">
                                <span>Thông báo mới</span>
                                <span class="badge bg-secondary">@unreadCount mới</span>
                            </li>
                            @if (notificationsList != null && notificationsList.Any())
                            {
                                foreach (var n in notificationsList)
                                {
                                    <li class="p-3 border-bottom hover-bg-light" style="cursor: default;">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <strong class="text-dark small" style="font-size: 0.85rem;">@n.Title</strong>
                                            <small class="text-muted" style="font-size: 0.7rem;">@n.CreatedTime.ToString("HH:mm dd/MM")</small>
                                        </div>
                                        <p class="m-0 mt-1 text-secondary small text-wrap" style="font-size: 0.8rem; line-height: 1.3;">@n.Message</p>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="p-4 text-center text-muted small">Không có thông báo mới nào.</li>
                            }
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button class="btn user-avatar-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar-img @(User.Identity?.IsAuthenticated == true ? "" : "unauthenticated")">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li class="dropdown-header text-dark">
                                    <div class="fw-bold">@User.Identity.Name</div>
                                    <small class="text-muted">Vai trò: @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Auth" asp-action="Profile">
                                        <i class="bi bi-person-circle me-2"></i> Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <div class="px-3 py-2 d-flex align-items-center justify-content-between">
                                        <div class="small text-muted fw-semibold m-0"><i class="bi bi-moon-stars me-1.5"></i>Giao diện</div>
                                        <div class="form-check form-switch m-0">
                                            <input class="form-check-input" type="checkbox" role="switch" id="themeToggleSwitch" onclick="toggleTheme()" style="cursor: pointer;">
                                        </div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                    </button>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Auth" asp-action="Login">
                                        <i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </header>

            <main class="content-area">
                <div class="container-fluid px-4">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["InfoMessage"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i>@TempData["InfoMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                </div>
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_LogoutModal" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Floating Toast Container -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
        <div id="appToast" class="toast align-items-center text-white border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i id="toastIcon" class="bi"></i>
                    <span id="toastMessage" class="fw-semibold"></span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <style>
        .no-caret::after {
            display: none !important;
        }
        .hover-bg-light:hover {
            background-color: #f8f9fa;
        }
    </style>

    <script>
        function showToast(message, type = 'success') {
            const toastEl = document.getElementById('appToast');
            if (!toastEl) return;

            toastEl.className = 'toast align-items-center text-white border-0 shadow';
            const iconEl = document.getElementById('toastIcon');
            const closeBtn = toastEl.querySelector('.btn-close');

            if (type === 'success') {
                toastEl.classList.add('bg-success');
                iconEl.className = 'bi bi-check-circle-fill fs-5 text-white';
                closeBtn.classList.add('btn-close-white');
            } else if (type === 'warning') {
                toastEl.classList.add('bg-warning', 'text-dark');
                iconEl.className = 'bi bi-exclamation-triangle-fill fs-5 text-dark';
                closeBtn.classList.remove('btn-close-white');
            } else {
                toastEl.classList.add('bg-danger');
                iconEl.className = 'bi bi-x-circle-fill fs-5 text-white';
                closeBtn.classList.add('btn-close-white');
            }

            document.getElementById('toastMessage').textContent = message;

            const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
            toast.show();
        }

        function markAllNotificationsAsRead() {
            setTimeout(function() {
                $.ajax({
                    url: '/Notification/MarkRead',
                    type: 'POST',
                    success: function (res) {
                        if (res.success) {
                            $('#notificationBadgeCount').fadeOut();
                        }
                    }
                });
            }, 1000);
        }
    </script>
</body>
</html>

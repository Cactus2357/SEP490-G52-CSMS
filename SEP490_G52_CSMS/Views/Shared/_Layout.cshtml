        let selectedSuggestionIndex = -1;
        let filteredSuggestions = [];

        function handleNavbarSearch(val) {
            const listEl = document.getElementById('navbarSearchSuggestions');
            if (!val.trim()) {
                listEl.classList.add('d-none');
                listEl.innerHTML = '';
                filteredSuggestions = [];
                selectedSuggestionIndex = -1;
                return;
            }

            const cleanVal = removeVietnameseDiacritics(val);
            const pages = rolePages[currentUserRole] || [];
            
            filteredSuggestions = pages.filter(p => 
                removeVietnameseDiacritics(p.name).includes(cleanVal) || 
                removeVietnameseDiacritics(p.url).includes(cleanVal)
            );

            if (filteredSuggestions.length === 0) {
                listEl.classList.add('d-none');
                listEl.innerHTML = '';
                selectedSuggestionIndex = -1;
                return;
            }

            let itemsHtml = "";
            filteredSuggestions.forEach((item, index) => {
                itemsHtml += `
                    <a href="${item.url}" class="list-group-item list-group-item-action py-2 px-3 small border-0 d-flex justify-content-between align-items-center" id="nav-sugg-${index}">
                        <span class="fw-semibold text-dark">${item.name}</span>
                        <span class="text-muted" style="font-size: 0.75rem;">${item.url}</span>
                    </a>
                `;
            });

            listEl.innerHTML = itemsHtml;
            listEl.classList.remove('d-none');
            selectedSuggestionIndex = -1;
        }

        // Close on clicking outside
        $(document).on('click', function(e) {
            if (!$(e.target).closest('#navbarSearchInput, #navbarSearchSuggestions').length) {
                $('#navbarSearchSuggestions').addClass('d-none');
            }
        });

        // Key navigation (arrow keys + Enter)
        $(document).on('keydown', '#navbarSearchInput', function(e) {
            const listEl = $('#navbarSearchSuggestions');
            if (listEl.hasClass('d-none') || filteredSuggestions.length === 0) return;

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                selectedSuggestionIndex = (selectedSuggestionIndex + 1) % filteredSuggestions.length;
                highlightSuggestion();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                selectedSuggestionIndex = (selectedSuggestionIndex - 1 + filteredSuggestions.length) % filteredSuggestions.length;
                highlightSuggestion();
            } else if (e.key === 'Enter') {
                e.preventDefault();
                if (selectedSuggestionIndex >= 0 && selectedSuggestionIndex < filteredSuggestions.length) {
                    window.location.href = filteredSuggestions[selectedSuggestionIndex].url;
                } else if (filteredSuggestions.length > 0) {
                    window.location.href = filteredSuggestions[0].url;
                }
            }
        });

        function highlightSuggestion() {
            $('#navbarSearchSuggestions a').removeClass('active bg-light text-primary');
            if (selectedSuggestionIndex >= 0) {
                const activeItem = $(`#nav-sugg-${selectedSuggestionIndex}`);
                activeItem.addClass('active bg-light text-primary');
                // Auto-fill input text with suggestion name
                $('#navbarSearchInput').val(filteredSuggestions[selectedSuggestionIndex].name);

                // Auto-scroll parent container to keep highlighted item visible
                if (activeItem.length) {
                    activeItem[0].scrollIntoView({ block: 'nearest' });
                }
            }
        }
    </script>


@inject SEP490_G52_CSMS.Models.CSMSAppDbContext DbContext
@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Returns "active" when the current request matches the given controller (and optionally action).
    string ActiveIf(string controller, string action = "")
    {
        bool controllerMatch = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        bool actionMatch = string.IsNullOrEmpty(action) ||
                               string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return (controllerMatch && actionMatch) ? "active" : "";
    }

    var displayTitle = "Khách";
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        if (userRole == "RManager")
        {
            displayTitle = "Tổng công ty";
        }
        else if (userRole == "WarehouseManager")
        {
            displayTitle = "Kho tổng";
        }
        else if (userRole == "BranchManager")
        {
            var branchId = User.FindFirst("BranchId")?.Value;
            var branch = !string.IsNullOrEmpty(branchId) ? DbContext.Branches.FirstOrDefault(b => b.BranchId == branchId) : null;
            displayTitle = branch?.BranchName ?? "Chi nhánh";
        }
        else
        {
            displayTitle = userRole ?? "Nhân viên";
        }
    }

    int unreadCount = 0;
    List<Notification> notificationsList = new();
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        int userId = 0;
        int.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out userId);
        var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

        notificationsList = DbContext.Notifications
            .Where(n => !n.IsRead && (n.RecipientUserId == userId || (n.RecipientUserId == null && n.RecipientRole == userRole) || (n.RecipientUserId == null && n.RecipientRole == null)))
            .OrderByDescending(n => n.CreatedTime)
            .Take(5)
            .ToList();

        unreadCount = DbContext.Notifications
            .Count(n => !n.IsRead && (n.RecipientUserId == userId || (n.RecipientUserId == null && n.RecipientRole == userRole) || (n.RecipientUserId == null && n.RecipientRole == null)));
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CSMS</title>

    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <script>
        // Persist and restore user theme selection early to prevent color flashing
        (function () {
            const savedTheme = localStorage.getItem('user-theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
            document.addEventListener('DOMContentLoaded', () => {
                document.body.setAttribute('data-theme', savedTheme);
                
                // Sync toggle switch state on load
                const toggleSwitch = document.getElementById('themeToggleSwitch');
                if (toggleSwitch) {
                    toggleSwitch.checked = (savedTheme === 'dark');
                }
            });
        })();

        function toggleTheme() {
            const currentTheme = document.body.getAttribute('data-theme') || 'light';
            const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', nextTheme);
            document.body.setAttribute('data-theme', nextTheme);
            localStorage.setItem('user-theme', nextTheme);
            
            const toggleSwitch = document.getElementById('themeToggleSwitch');
            if (toggleSwitch) {
                toggleSwitch.checked = (nextTheme === 'dark');
            }
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const icon = document.getElementById('toggleIcon');
            const isCollapsed = sidebar.classList.toggle('collapsed');

            icon.className = isCollapsed ? 'bi bi-chevron-right' : 'bi bi-chevron-left';
            localStorage.setItem('sidebar-collapsed', isCollapsed ? 'true' : 'false');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            if (sidebar) {
                // Remove the no-transition class to allow smooth hover/toggle animations after page load
                setTimeout(() => {
                    sidebar.classList.remove('no-transition');
                }, 50);
            }
        });
    </script>
</head>

<body>

    <div class="app-layout">
        <div class="sidebar no-transition" id="sidebar">
            <div class="sidebar-logo">
                <span class="logo-text">CSMS</span>
                <button class="toggle-sidebar-btn" onclick="toggleSidebar()" title="Thu gọn / Mở rộng sidebar">
                    <i class="bi bi-chevron-left" id="toggleIcon"></i>
                </button>
            </div>
            <ul class="sidebar-menu">
                @if (User.IsInRole("RManager"))
                {
                    <partial name="_Sidebar.RManager" />
                }
                else if (User.IsInRole("WarehouseManager"))
                {
                    <partial name="_Sidebar.WarehouseManager" />
                }
                else if (User.IsInRole("BranchManager"))
                {
                    <partial name="_Sidebar.BranchManager" />
                }
                else if (User.IsInRole("Cashier"))
                {
                    <partial name="_Sidebar.Cashier" />
                }
                else if (User.IsInRole("Bartender") || User.IsInRole("Barista"))
                {
                    <partial name="_Sidebar.Bartender" />
                }
                else if (User.IsInRole("Busser"))
                {
                    <partial name="_Sidebar.Busser" />
                }
            </ul>
            <script>
                (function () {
                    const savedCollapsed = localStorage.getItem('sidebar-collapsed');
                    if (savedCollapsed === 'true') {
                        document.getElementById('sidebar').classList.add('collapsed');
                        const icon = document.getElementById('toggleIcon');
                        if (icon) icon.className = 'bi bi-chevron-right';
                    }
                })();
            </script>
        </div>

        <div class="main-wrapper">
            <header class="top-header">
                <div class="header-left position-relative" style="width: 320px;">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 rounded-start-pill text-secondary py-1.5 px-3">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="navbarSearchInput" class="form-control bg-light border-start-0 rounded-end-pill py-1.5" placeholder="Tìm kiếm trang..." autocomplete="off" oninput="handleNavbarSearch(this.value)" style="font-size: 0.9rem;">
                    </div>
                    <div id="navbarSearchSuggestions" class="list-group position-absolute w-100 mt-1 shadow-lg d-none" style="top: 100%; left: 0; z-index: 2000; max-height: 250px; overflow-y: auto; border-radius: 8px;">
                        <!-- Suggestions will render here -->
                    </div>
                </div>
                <div class="header-branch">
                    <span class="h5 fw-bold text-dark mb-0">@displayTitle</span>
                </div>
                <div class="header-right">
                    <!-- =========================================================
                         NOTIFICATION BELL DROPDOWN
                    ========================================================== -->
                    <div class="dropdown me-2" id="notificationDropdownWrapper">
                        <button class="btn btn-link text-dark position-relative p-0 header-icon-btn border-0 text-decoration-none dropdown-toggle no-caret rounded-circle d-flex align-items-center justify-content-center"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false" id="notificationBellBtn"
                                style="width: 40px; height: 40px; background-color: #f8f9fa;">
                            <i class="bi bi-bell fs-5 text-secondary"></i>
                            @if (unreadCount > 0)
                            {
                                <span class="position-absolute badge rounded-pill bg-danger"
                                      id="notificationBadgeCount"
                                      style="font-size: 0.62rem; padding: 0.25em 0.4em; top: -2px; right: -2px; line-height: 1;">
                                    @unreadCount
                                </span>
                            }
                        </button>

                        <div class="dropdown-menu dropdown-menu-end p-0 shadow border-0 rounded-3"
                             style="width: 390px; z-index: 1060;"
                             id="notificationDropdownMenu">

                            <!-- Header -->
                            <div class="bg-dark text-white rounded-top-3 px-3 py-2 d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-uppercase small">Thông báo</span>
                                <span class="badge bg-secondary" id="notifHeaderCount">@unreadCount mới</span>
                            </div>

                            <!-- Notification list (scrollable) -->
                            <ul class="list-unstyled m-0" id="notificationListContainer"
                                style="max-height: 480px; overflow-y: auto;">
                                @if (notificationsList != null && notificationsList.Any())
                                {
                                    foreach (var n in notificationsList)
                                    {
                                        <li class="notif-item border-bottom px-3 py-2 @(n.IsRead ? "" : "notif-unread")"
                                            data-id="@n.NotificationId"
                                            data-url="@n.ResourceUrl"
                                            role="button"
                                            style="cursor: pointer; transition: background 0.15s;">
                                            <div class="d-flex justify-content-between align-items-start gap-2">
                                                <div class="flex-grow-1">
                                                    <div class="d-flex align-items-center gap-2">
                                                        @if (!n.IsRead)
                                                        {
                                                            <span class="d-inline-block rounded-circle bg-primary flex-shrink-0"
                                                                  style="width: 8px; height: 8px;"></span>
                                                        }
                                                        <strong class="text-dark" style="font-size: 0.82rem;">@n.Title</strong>
                                                    </div>
                                                    <p class="m-0 mt-1 text-secondary text-wrap" style="font-size: 0.78rem; line-height: 1.35;">@n.Message</p>
                                                    @if (!string.IsNullOrEmpty(n.ResourceUrl))
                                                    {
                                                        <span class="small text-primary fw-bold text-decoration-none" style="font-size: 0.72rem;">
                                                            <i class="bi bi-box-arrow-up-right me-1"></i>Chi tiết
                                                        </span>
                                                    }
                                                </div>
                                                <small class="text-muted flex-shrink-0" style="font-size: 0.7rem; white-space: nowrap;">@n.CreatedTime.ToString("HH:mm dd/MM")</small>
                                            </div>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li class="p-4 text-center text-muted small" id="notifEmptyMsg">Không có thông báo mới nào.</li>
                                }
                            </ul>

                            <!-- Footer -->
                            <div class="border-top px-3 py-2 d-flex justify-content-between align-items-center bg-light rounded-bottom-3">
                                <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-primary"
                                        onclick="openAllNotificationsModal(); event.stopPropagation();">
                                    <i class="bi bi-list-ul me-1"></i>Xem tất cả
                                </button>
                                <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-danger"
                                        onclick="clearAllNotifications(); event.stopPropagation();">
                                    <i class="bi bi-check2-all me-1"></i>Đánh dấu tất cả đã đọc
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="dropdown">
                        <button class="btn user-avatar-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar-img rounded-circle d-flex align-items-center justify-content-center @(User.Identity?.IsAuthenticated == true ? "" : "unauthenticated")"
                                 style="width: 40px; height: 40px; overflow: hidden;">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li class="dropdown-header text-dark">
                                    <div class="fw-bold">@User.Identity.Name</div>
                                    <small class="text-muted">Vai trò: @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Auth" asp-action="Profile">
                                        <i class="bi bi-person-circle me-2"></i> Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <div class="px-3 py-2 d-flex align-items-center justify-content-between">
                                        <div class="small text-muted fw-semibold m-0"><i class="bi bi-moon-stars me-1.5"></i>Giao diện</div>
                                        <div class="form-check form-switch m-0">
                                            <input class="form-check-input" type="checkbox" role="switch" id="themeToggleSwitch" onclick="toggleTheme()" style="cursor: pointer;">
                                        </div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                    </button>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Auth" asp-action="Login">
                                        <i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </header>

            <main class="content-area">
                <div class="container-fluid px-4">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["InfoMessage"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i>@TempData["InfoMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                </div>
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_LogoutModal" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Toast Containers -->
    <!-- Bottom Right Container (for Success) -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
        <div id="appToastBottom" class="toast align-items-center text-white border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i id="toastIconBottom" class="bi"></i>
                    <span id="toastMessageBottom" class="fw-semibold"></span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Top Center Container (for Warning and Danger) -->
    <div class="position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 1100; margin-top: 60px;">
        <div id="appToastTop" class="toast align-items-center text-white border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i id="toastIconTop" class="bi"></i>
                    <span id="toastMessageTop" class="fw-semibold"></span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <style>
        .no-caret::after {
            display: none !important;
        }
        .hover-bg-light:hover {
            background-color: #f8f9fa;
        }
    </style>

    <script>
        function showToast(message, type = 'success') {
            const isTop = (type === 'warning' || type === 'danger' || type === 'error');
            const toastEl = document.getElementById(isTop ? 'appToastTop' : 'appToastBottom');
            if (!toastEl) return;

            toastEl.className = 'toast align-items-center border-0 shadow';
            const iconEl = document.getElementById(isTop ? 'toastIconTop' : 'toastIconBottom');
            const msgEl = document.getElementById(isTop ? 'toastMessageTop' : 'toastMessageBottom');
            const closeBtn = toastEl.querySelector('.btn-close');

            toastEl.classList.remove('text-white', 'text-dark', 'bg-success', 'bg-warning', 'bg-danger');

            if (type === 'success') {
                toastEl.classList.add('bg-success', 'text-white');
                iconEl.className = 'bi bi-check-circle-fill fs-5 text-white';
                closeBtn.classList.add('btn-close-white');
            } else if (type === 'warning') {
                toastEl.classList.add('bg-warning', 'text-dark');
                iconEl.className = 'bi bi-exclamation-triangle-fill fs-5 text-dark';
                closeBtn.classList.remove('btn-close-white');
            } else {
                toastEl.classList.add('bg-danger', 'text-white');
                iconEl.className = 'bi bi-x-circle-fill fs-5 text-white';
                closeBtn.classList.add('btn-close-white');
            }

            msgEl.textContent = message;

            const toast = new bootstrap.Toast(toastEl, { delay: 7000 });
            toast.show();
        }

        // ── Notification: click item to mark read ────────────────────────────
        $(document).on('click', '.notif-item', function (e) {
            e.stopPropagation();
            const $item = $(this);
            const id = $item.data('id');
            const url = $item.data('url');

            $.post('/Notification/MarkRead/' + id, function (res) {
                if (res.success) {
                    // Remove unread dot & styling
                    $item.removeClass('notif-unread');
                    $item.find('.bg-primary.rounded-circle').remove();

                    // Decrement badge
                    var $badge = $('#notificationBadgeCount');
                    var current = parseInt($badge.text()) || 0;
                    var next = Math.max(0, current - 1);
                    if (next === 0) {
                        $badge.fadeOut();
                        $('#notifHeaderCount').text('0 mới');
                    } else {
                        $badge.text(next);
                        $('#notifHeaderCount').text(next + ' mới');
                    }
                }
            });

            // Navigate to resource URL if present
            if (url && url.trim() !== '') {
                setTimeout(function () { window.location.href = url; }, 250);
            }
        });

        // ── Notification: clear all ──────────────────────────────────────────
        function clearAllNotifications() {
            $.post('/Notification/ClearAll', function (res) {
                if (res.success) {
                    $('#notificationBadgeCount').fadeOut();
                    $('#notifHeaderCount').text('0 mới');
                    // Remove unread dots
                    $('#notificationListContainer .notif-unread').removeClass('notif-unread');
                    $('#notificationListContainer .bg-primary.rounded-circle').remove();
                    showToast('Đã đánh dấu tất cả thông báo là đã đọc.', 'success');
                }
            });
        }

        // ── Notification: open full history modal ────────────────────────────
        function openAllNotificationsModal() {
            var dropdownEl = document.getElementById('notificationBellBtn');
            var dd = dropdownEl ? bootstrap.Dropdown.getInstance(dropdownEl) : null;

            function loadNotifications() {
                $('#allNotificationsModalBody').html('<div class="text-center py-5 text-muted"><div class="spinner-border spinner-border-sm me-2"></div> Đang tải...</div>');
                $.getJSON('/Notification/All', function (data) {
                    if (!data || data.length === 0) {
                        $('#allNotificationsModalBody').html('<div class="p-5 text-center text-muted"><i class="bi bi-bell-slash fs-2 d-block mb-2"></i>Chưa có thông báo nào.</div>');
                        return;
                    }
                    var html = '<ul class="list-unstyled m-0">';
                    data.forEach(function (n) {
                        var unreadDot = !n.isRead
                            ? '<span class="d-inline-block rounded-circle bg-primary flex-shrink-0 me-2" style="width:8px;height:8px;"></span>'
                            : '<span class="d-inline-block flex-shrink-0 me-2" style="width:8px;height:8px;"></span>';
                        var linkBtn = n.resourceUrl
                            ? '<a href="' + n.resourceUrl + '" class="small text-primary text-decoration-none"><i class="bi bi-box-arrow-up-right me-1"></i>Xem chi tiết</a>'
                            : '';
                        var readCls = n.isRead ? 'opacity-65' : 'fw-semibold';
                        html += '<li class="border-bottom px-4 py-3 ' + (n.isRead ? '' : 'bg-primary bg-opacity-10') + '">';
                        html += '<div class="d-flex align-items-start gap-2">';
                        html += unreadDot;
                        html += '<div class="flex-grow-1">';
                        html += '<div class="d-flex justify-content-between align-items-center">';
                        html += '<strong class="' + readCls + '" style="font-size:0.85rem;">' + n.title + '</strong>';
                        html += '<small class="text-muted ms-2" style="font-size:0.72rem;white-space:nowrap;">' + n.createdTime + '</small>';
                        html += '</div>';
                        html += '<p class="mb-1 mt-1 text-secondary" style="font-size:0.8rem;line-height:1.35;">' + n.message + '</p>';
                        html += linkBtn;
                        html += '</div></div></li>';
                    });
                    html += '</ul>';
                    $('#allNotificationsModalBody').html(html);
                }).fail(function () {
                    $('#allNotificationsModalBody').html('<div class="p-4 text-danger text-center">Không thể tải thông báo.</div>');
                });
            }

            function showModal() {
                var modalEl = document.getElementById('allNotificationsModal');
                var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
                loadNotifications();
            }

            if (dd) {
                // Wait until dropdown finishes hiding to avoid backdrop z-index conflict
                var wrapper = document.getElementById('notificationDropdownWrapper');
                function onHidden() {
                    wrapper.removeEventListener('hidden.bs.dropdown', onHidden);
                    showModal();
                }
                wrapper.addEventListener('hidden.bs.dropdown', onHidden);
                dd.hide();
            } else {
                showModal();
            }
        }

        // Accent-insensitive diacritics removal for Javascript client-side search
        function removeVietnameseDiacritics(str) {
            if (!str) return '';
            return str.normalize('NFD')
                      .replace(/[\u0300-\u036f]/g, '')
                      .replace(/đ/g, 'd')
                      .replace(/Đ/g, 'D')
                      .toLowerCase();
        }

        const currentUserRole = '@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "")';
        const rolePages = {
            "RManager": [
                { name: "Quản lý - quản lý chi nhánh", url: "/BranchManager" },
                { name: "Quản lý chi nhánh", url: "/Branch" },
                { name: "Quản lý danh mục", url: "/ProductCategories" },
                { name: "Quản lý sản phẩm", url: "/Product" },
                { name: "Báo cáo doanh thu", url: "/Reporting/Revenue" },
                { name: "Xuất file báo cáo", url: "/Reporting/Export" },
                { name: "Hồ sơ cá nhân", url: "/Auth/Profile" }
            ],
            "WManager": [
                { name: "Quản lý nguyên liệu", url: "/Warehouse/Index" },
                { name: "Quản lý nhập kho", url: "/Warehouse/ImportHistory" },
                { name: "Quản lý xuất kho", url: "/Warehouse/ExportRequests" },
                { name: "Hồ sơ cá nhân", url: "/Auth/Profile" }
            ],
            "WarehouseManager": [
                { name: "Quản lý nguyên liệu", url: "/Warehouse/Index" },
                { name: "Quản lý nhập kho", url: "/Warehouse/ImportHistory" },
                { name: "Quản lý xuất kho", url: "/Warehouse/ExportRequests" },
                { name: "Hồ sơ cá nhân", url: "/Auth/Profile" }
            ],

@inject SEP490_G52_CSMS.Models.CSMSAppDbContext DbContext
@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Returns "active" when the current request matches the given controller (and optionally action).
    string ActiveIf(string controller, string action = "")
    {
        bool controllerMatch = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        bool actionMatch = string.IsNullOrEmpty(action) ||
                               string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return (controllerMatch && actionMatch) ? "active" : "";
    }

    var branchId = User.FindFirst("BranchId")?.Value;
    var branchName = "Tổng công ty";
    if (!string.IsNullOrEmpty(branchId))
    {
        var branch = DbContext.Branches.FirstOrDefault(b => b.BranchId == branchId);
        if (branch != null)
        {
            branchName = branch.BranchName;
        }
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CSMS</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const icon = document.getElementById('toggleIcon');
            const isCollapsed = sidebar.classList.toggle('collapsed');

            icon.className = isCollapsed ? 'bi bi-chevron-right' : 'bi bi-chevron-left';
            localStorage.setItem('sidebar-collapsed', isCollapsed ? 'true' : 'false');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            if (sidebar) {
                // Remove the no-transition class to allow smooth hover/toggle animations after page load
                setTimeout(() => {
                    sidebar.classList.remove('no-transition');
                }, 50);
            }
        });
    </script>
</head>

<body>

    <div class="app-layout">
        <div class="sidebar no-transition" id="sidebar">
            <div class="sidebar-logo">
                <span class="logo-text">CSMS</span>
                <button class="toggle-sidebar-btn" onclick="toggleSidebar()" title="Thu gọn / Mở rộng sidebar">
                    <i class="bi bi-chevron-left" id="toggleIcon"></i>
                </button>
            </div>
            <ul class="sidebar-menu">
                @if (User.IsInRole("Admin"))
                {
                    <partial name="_Sidebar.Admin" />
                }
                else if (User.IsInRole("BranchManager"))
                {
                    <partial name="_Sidebar.BranchManager" />
                }
                else if (User.IsInRole("Cashier"))
                {
                    <partial name="_Sidebar.Cashier" />
                }
                else if (User.IsInRole("Bartender"))
                {
                    <partial name="_Sidebar.Bartender" />
                }
                else if (User.IsInRole("Busser"))
                {
                    <partial name="_Sidebar.Busser" />
                }
            </ul>
            <script>
                (function () {
                    const savedCollapsed = localStorage.getItem('sidebar-collapsed');
                    if (savedCollapsed === 'true') {
                        document.getElementById('sidebar').classList.add('collapsed');
                        const icon = document.getElementById('toggleIcon');
                        if (icon) icon.className = 'bi bi-chevron-right';
                    }
                })();
            </script>
        </div>

        <div class="main-wrapper">
            <header class="top-header">
                <div class="header-left">
                    <input type="text" class="header-search" placeholder="search">
                </div>
                <div class="header-branch">
                    <span>@branchName</span>
                </div>
                <div class="header-right">
                    <button class="header-icon-btn">
                        <i class="bi bi-bell"></i>
                    </button>
                    <div class="dropdown">
                        <button class="btn user-avatar-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar-img @(User.Identity?.IsAuthenticated == true ? "" : "unauthenticated")">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li class="dropdown-header text-dark">
                                    <div class="fw-bold">@User.Identity.Name</div>
                                    <small class="text-muted">Vai trò: @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Auth" asp-action="Profile">
                                        <i class="bi bi-person-circle me-2"></i> Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                    </button>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Auth" asp-action="Login">
                                        <i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </header>

            <main class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_LogoutModal" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

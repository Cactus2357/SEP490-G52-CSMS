@model SEP490_G52_CSMS.Models.Employees.Employee
@{
    ViewData["Title"] = "Đăng ký Khuôn mặt";
}

@section Styles {
    <style>
        .scanning-card {
            background: white;
            border-radius: 12px;
            border: 1.5px solid #d1d5db;
            overflow: hidden;
        }

        .card-header-custom {
            border-bottom: 1.5px solid #d1d5db;
            padding: 24px;
            background-color: #ffffff;
        }

        .card-title-custom {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
            text-transform: uppercase;
        }

        .instruction-box {
            background-color: #ffffff;
            border-radius: 8px;
            border: 1px solid #cccccc;
            padding: 24px;
        }

        .camera-frame {
            position: relative;
            background-color: #111827;
            border-radius: 8px;
            aspect-ratio: 4/3;
            overflow: hidden;
            border: 2px solid #111827;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .webcam-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scaleX(-1); /* Mirror view */
        }

        .camera-placeholder {
            color: #9ca3af;
            text-align: center;
            z-index: 2;
        }

        /* Face scanning guide overlay */
        .scan-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            pointer-events: none;
            border: 2px solid rgba(255,255,255,0.05);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 5;
        }

        .scan-circle {
            width: 60%;
            height: 75%;
            border: 2.5px dashed rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            position: relative;
            box-shadow: 0 0 0 9999px rgba(0,0,0,0.6);
            transition: all 0.3s ease;
        }

        .scanning-active .scan-circle {
            border-color: #10b981;
            border-style: solid;
            box-shadow: 0 0 0 9999px rgba(0,0,0,0.45);
        }

        .scan-line {
            position: absolute;
            width: 100%;
            height: 3px;
            background: linear-gradient(to right, transparent, #3b82f6, transparent);
            top: 0;
            animation: scanMove 2.2s infinite linear;
            display: none;
        }

        .scanning-active .scan-line {
            display: block;
            background: linear-gradient(to right, transparent, #10b981, transparent);
        }

        @@keyframes scanMove {
            0% { top: 0%; }
            50% { top: 100%; }
            100% { top: 0%; }
        }

        /* Status indicator */
        .status-bar {
            background-color: #f3f4f6;
            border-radius: 4px;
            border: 1px solid #cccccc;
            font-weight: 600;
            padding: 8px 16px;
            font-size: 0.9rem;
            color: #1f2937;
        }

        .status-ready { color: #1e3a8a; background-color: #dbeafe; }
        .status-scanning { color: #78350f; background-color: #fef3c7; }
        .status-success { color: #064e3b; background-color: #d1fae5; }
        .status-error { color: #7f1d1d; background-color: #fee2e2; }

        .btn-mockup-action-primary {
            background-color: #ffffff;
            color: #333333;
            border: 1.5px solid #111827;
            padding: 10px 24px;
            border-radius: 4px;
            font-weight: 600;
            font-size: 0.9rem;
            box-shadow: 2px 2px 0px #000000;
            transition: all 0.1s ease;
        }

        .btn-mockup-action-primary:hover {
            background-color: #f3f4f6;
            transform: translate(1px, 1px);
            box-shadow: 1px 1px 0px #000000;
        }

        .btn-mockup-action-primary:active {
            transform: translate(2px, 2px);
            box-shadow: none;
        }

        .btn-mockup-action-primary:disabled {
            background-color: #e5e7eb;
            color: #9ca3af;
            border-color: #d1d5db;
            box-shadow: none;
            transform: none;
            cursor: not-allowed;
        }

        .btn-mockup-action-secondary {
            background-color: #ffffff;
            color: #4b5563;
            border: 1px solid #cccccc;
            padding: 8px 24px;
            border-radius: 4px;
            font-weight: 500;
            font-size: 0.9rem;
            text-decoration: none;
            text-align: center;
            transition: all 0.2s ease;
        }

        .btn-mockup-action-secondary:hover {
            background-color: #f3f4f6;
            color: #111827;
        }
    </style>
}

<div class="mb-4">
    <a href="/Employee" class="text-decoration-none text-secondary" style="font-size: 0.95rem;">
        <i class="bi bi-arrow-left-circle me-1"></i> Quay lại Danh sách nhân viên
    </a>
</div>

<div class="card scanning-card">
    <div class="card-header-custom">
        <h3 class="card-title-custom">ĐĂNG KÝ DỮ LIỆU KHUÔN MẶT (FACE ID)</h3>
        <div class="text-muted mt-1" style="font-size: 0.9rem;">
            Nhân viên: <strong>@Model.FullName</strong> &bull; Username: <code>@Model.Username</code>
        </div>
    </div>
    <div class="card-body p-4">

        <div class="row g-4">
            <!-- Left Panel: Instructions -->
            <div class="col-lg-5">
                <div class="instruction-box h-100 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-3" style="font-size: 1.1rem; border-bottom: 1.5px solid #d1d5db; padding-bottom: 8px;">Hướng dẫn chụp ảnh</h5>
                        <ul class="ps-3 text-secondary mb-4" style="line-height: 1.8; font-size: 0.9rem;">
                            <li class="mb-2">Nhìn thẳng trực tiếp vào camera.</li>
                            <li class="mb-2">Đảm bảo đủ ánh sáng, không đeo kính râm hoặc khẩu trang.</li>
                            <li>Giữ camera ngang tầm mắt và di chuyển khuôn mặt vào đường viền tròn.</li>
                        </ul>
                    </div>

                    <div>
                        <div class="form-check mb-4">
                            <input class="form-check-input border-dark" type="checkbox" id="chkAgreement" onchange="toggleScanButton()">
                            <label class="form-check-label fw-semibold text-dark" for="chkAgreement" style="cursor: pointer; font-size: 0.9rem;">
                                Tôi đã đọc kỹ hướng dẫn
                            </label>
                        </div>

                        <div class="d-grid gap-2">
                            <button id="btnStartScan" class="btn-mockup-action-primary" onclick="startBiometricScan()" disabled>
                                Bắt đầu quét
                            </button>
                            <a href="/Employee" class="btn-mockup-action-secondary">
                                Hủy bỏ
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Panel: Camera View & Scan Area -->
            <div class="col-lg-7">
                <div class="camera-frame" id="cameraFrame">
                    <!-- Webcam Stream Element -->
                    <video id="webcamView" class="webcam-video d-none" autoplay playsinline muted></video>

                    <!-- Initial Placeholder -->
                    <div id="cameraPlaceholder" class="camera-placeholder">
                        <i class="bi bi-camera-fill display-4 mb-2 d-block"></i>
                        <p class="mb-0 fw-semibold">Vui lòng tích chọn "Tôi đã đọc kỹ hướng dẫn" để bật camera</p>
                    </div>

                    <!-- Scanning Overlay Ellipse Guide -->
                    <div class="scan-overlay">
                        <div class="scan-circle">
                            <div class="scan-line"></div>
                        </div>
                    </div>
                </div>

                <!-- Progress Bar Section -->
                <div id="scanProgressContainer" class="mt-3 d-none">
                    <div class="progress" style="height: 10px; border-radius: 5px; background-color: #e5e7eb;">
                        <div id="scanProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: 0%;"></div>
                    </div>
                    <small id="scanProgressText" class="text-muted d-block text-center mt-1 fw-semibold">Đang phân tích các đặc điểm khuôn mặt (0%)...</small>
                </div>

                <!-- Real-time Status Message -->
                <div class="mt-3">
                    <div id="statusMessage" class="w-100 text-center status-bar status-ready">
                        Trạng thái: Chờ kích hoạt camera...
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Modal: Confirm Captured Face -->
<div class="modal fade" id="confirmFaceModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="confirmFaceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold" id="confirmFaceModalLabel">
                    <i class="bi bi-person-bounding-box text-primary me-2"></i> Xác nhận Đăng ký Khuôn mặt
                </h5>
                <button type="button" class="btn-close" onclick="rescanFace()" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="mb-3 d-inline-block border rounded p-2 bg-light shadow-sm">
                    <img id="capturedFaceImg" src="" alt="Khuôn mặt đã quét" style="max-width: 100%; height: auto; display: block; max-height: 280px; object-fit: contain;">
                </div>
                <p class="text-muted mb-0" style="font-size: 0.85rem;">
                    Vui lòng xác nhận ảnh chụp rõ nét, đầy đủ đặc điểm khuôn mặt trước khi lưu.
                </p>
            </div>
            <div class="modal-footer justify-content-between border-0 p-3">
                <button type="button" class="btn btn-outline-secondary px-4 fw-semibold" onclick="rescanFace()">
                    <i class="bi bi-arrow-repeat me-1"></i> Quét lại
                </button>
                <button type="button" class="btn btn-dark px-4 fw-semibold" onclick="confirmAndSaveFace()">
                    <i class="bi bi-check2-circle me-1"></i> Xác nhận lấy Face ID
                </button>
            </div>
        </div>
    </div>
</div>

<!-- face-api.js Library loaded locally -->
<script src="/lib/face-api/face-api.min.js"></script>
<script src="~/js/faceid.js" asp-append-version="true"></script>

@section Scripts {
<script>
    const employeeId = @Model.EmployeeId;
    const employeeEmail = '@Model.Email';
    const employeeUsername = '@Model.Username';
    let webcamStream = null;
    let isScanning = false;
    let scanInterval = null;
    let capturedImageBase64 = null;
    let savedFacialId = null;

    function notify(message, type = 'success') {
        if (typeof showToast === 'function') {
            showToast(message, type);
        }
    }

    function toggleScanButton() {
        const agreed = document.getElementById('chkAgreement').checked;
        const btnScan = document.getElementById('btnStartScan');
        btnScan.disabled = !agreed;

        if (agreed) {
            initWebcam();
        } else {
            stopWebcam();
        }
    }

    async function initWebcam() {
        const video = document.getElementById('webcamView');
        const placeholder = document.getElementById('cameraPlaceholder');
        const statusMsg = document.getElementById('statusMessage');

        if (webcamStream) return;

        try {
            webcamStream = await navigator.mediaDevices.getUserMedia({
                video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } }
            });
            video.srcObject = webcamStream;
            video.classList.remove('d-none');
            placeholder.classList.add('d-none');

            statusMsg.textContent = "Trạng thái: Camera hoạt động. Sẵn sàng quét.";
            statusMsg.className = "w-100 text-center status-bar status-ready";
            notify("Camera đã được kết nối và sẵn sàng quét.", "success");
        } catch (err) {
            console.error("Lỗi mở camera:", err);
            statusMsg.textContent = "Lỗi: Không thể truy cập camera. Vui lòng kiểm tra quyền camera.";
            statusMsg.className = "w-100 text-center status-bar status-error";
            notify("Không thể truy cập camera. Vui lòng kiểm tra quyền webcam trên trình duyệt.", "danger");
        }
    }

    function stopWebcam() {
        const video = document.getElementById('webcamView');
        const placeholder = document.getElementById('cameraPlaceholder');

        if (webcamStream) {
            webcamStream.getTracks().forEach(track => track.stop());
            webcamStream = null;
        }
        video.srcObject = null;
        video.classList.add('d-none');
        placeholder.classList.remove('d-none');
        
        if (scanInterval) {
            clearInterval(scanInterval);
            scanInterval = null;
        }
    }

    window.addEventListener('beforeunload', () => {
        stopWebcam();
    });

    function startBiometricScan() {
        if (isScanning) return;
        runRealScan();
    }

    async function runRealScan() {
        isScanning = true;
        const btnScan = document.getElementById('btnStartScan');
        const chkAgreement = document.getElementById('chkAgreement');
        const cameraFrame = document.getElementById('cameraFrame');
        const progressContainer = document.getElementById('scanProgressContainer');
        const progressBar = document.getElementById('scanProgressBar');
        const progressText = document.getElementById('scanProgressText');
        const statusMsg = document.getElementById('statusMessage');
        const video = document.getElementById('webcamView');

        btnScan.disabled = true;
        chkAgreement.disabled = true;
        cameraFrame.classList.add('scanning-active');
        progressContainer.classList.remove('d-none');
        
        statusMsg.textContent = "Trạng thái: Đang tải mô hình AI nhận diện...";
        statusMsg.className = "w-100 text-center status-bar status-scanning";

        try {
            await CSMSFaceAPI.loadModels();
        } catch (err) {
            statusMsg.textContent = "Lỗi: Không thể tải mô hình AI nhận diện khuôn mặt.";
            statusMsg.className = "w-100 text-center status-bar status-error";
            notify("Không thể tải mô hình AI nhận diện khuôn mặt.", "danger");
            resetUI();
            return;
        }

        statusMsg.textContent = "Trạng thái: Đang phân tích khuôn mặt... Hãy nhìn thẳng vào camera.";
        statusMsg.className = "w-100 text-center status-bar status-scanning";
        notify("Bắt đầu quét khuôn mặt. Vui lòng nhìn thẳng vào camera...", "warning");

        let percent = 0;
        progressBar.style.width = `0%`;
        let lastDescriptor = null;

        scanInterval = setInterval(async () => {
            if (!isScanning) {
                clearInterval(scanInterval);
                return;
            }

            if (video.readyState === video.HAVE_ENOUGH_DATA) {
                try {
                    const detection = await CSMSFaceAPI.detectFace(video);
                    const validation = CSMSFaceAPI.validatePosition(detection, video);

                    statusMsg.textContent = "Trạng thái: " + validation.message;

                    if (validation.valid) {
                        percent += 10;
                        if (percent > 100) percent = 100;

                        progressBar.style.width = `${percent}%`;
                        progressText.textContent = `Đang phân tích đặc điểm khuôn mặt (${percent}%)...`;
                        statusMsg.className = "w-100 text-center status-bar status-scanning text-success fw-bold";
                        
                        lastDescriptor = Array.from(detection.descriptor);

                        if (percent >= 100) {
                            clearInterval(scanInterval);
                            isScanning = false;

                            cameraFrame.classList.remove('scanning-active');
                            statusMsg.textContent = "Trạng thái: Nhận diện thành công! Vui lòng xác nhận...";
                            statusMsg.className = "w-100 text-center status-bar status-success";
                            notify("Phân tích khuôn mặt hoàn tất! Vui lòng kiểm tra ảnh chụp và bấm xác nhận.", "success");

                            capturedImageBase64 = CSMSFaceAPI.captureSnapshot(video);
                            document.getElementById('capturedFaceImg').src = capturedImageBase64;
                            savedFacialId = JSON.stringify(lastDescriptor);

                            const modalEl = document.getElementById('confirmFaceModal');
                            const confirmModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                            confirmModal.show();
                        }
                    } else {
                        percent = Math.max(0, percent - 5);
                        progressBar.style.width = `${percent}%`;
                        progressText.textContent = `Đang phân tích đặc điểm khuôn mặt (${percent}%)...`;
                        statusMsg.className = "w-100 text-center status-bar status-error text-danger fw-bold";
                    }
                } catch (detectErr) {
                    console.error("Lỗi nhận diện khuôn mặt:", detectErr);
                }
            }
        }, 180);
    }

    async function confirmAndSaveFace() {
        const modalEl = document.getElementById('confirmFaceModal');
        const modalInstance = bootstrap.Modal.getInstance(modalEl);
        if (modalInstance) {
            modalInstance.hide();
        }
        cleanupModalBackdrop();

        if (savedFacialId) {
            await saveFaceDataToServer(savedFacialId);
        }
    }

    function rescanFace() {
        const modalEl = document.getElementById('confirmFaceModal');
        const modalInstance = bootstrap.Modal.getInstance(modalEl);
        if (modalInstance) {
            modalInstance.hide();
        }
        cleanupModalBackdrop();

        resetUI();
        initWebcam().then(() => {
            startBiometricScan();
        });
    }

    function cleanupModalBackdrop() {
        setTimeout(() => {
            document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
            document.body.classList.remove('modal-open');
            document.body.style = '';
        }, 200);
    }

    async function saveFaceDataToServer(facialId) {
        const statusMsg = document.getElementById('statusMessage');
        statusMsg.textContent = "Trạng thái: Đang lưu dữ liệu khuôn mặt...";
        statusMsg.className = "w-100 text-center status-bar status-scanning";

        try {
            const response = await fetch('/Employee/SaveFaceData', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    employeeId: employeeId,
                    faceData: facialId
                })
            });

            const result = await response.json();
            if (response.ok && result.success) {
                statusMsg.textContent = "Đăng ký khuôn mặt thành công! Đang tự động chuyển hướng...";
                statusMsg.className = "w-100 text-center status-bar status-success";
                notify("Đăng ký FaceID thành công cho nhân viên! Đang tự động chuyển hướng...", "success");
                
                setTimeout(() => {
                    window.location.href = '/Employee';
                }, 1200);
            } else {
                var errText = result.errorMessage || "Không thể cập nhật CSDL.";
                statusMsg.textContent = "Lỗi lưu dữ liệu: " + errText;
                statusMsg.className = "w-100 text-center status-bar status-error";
                notify("Đăng ký thất bại: " + errText, "danger");
                resetUI();
            }
        } catch (err) {
            console.error("Lỗi kết nối lưu dữ liệu:", err);
            statusMsg.textContent = "Lỗi: Không kết nối được với máy chủ để cập nhật dữ liệu.";
            statusMsg.className = "w-100 text-center status-bar status-error";
            notify("Lỗi kết nối máy chủ khi lưu dữ liệu khuôn mặt.", "danger");
            resetUI();
        }
    }

    function resetUI() {
        isScanning = false;
        if (scanInterval) {
            clearInterval(scanInterval);
            scanInterval = null;
        }
        cleanupModalBackdrop();

        const chk = document.getElementById('chkAgreement');
        const btn = document.getElementById('btnStartScan');

        chk.disabled = false;
        btn.disabled = !chk.checked;

        document.getElementById('scanProgressContainer').classList.add('d-none');
        document.getElementById('scanProgressBar').style.width = '0%';
        document.getElementById('scanProgressText').textContent = 'Đang phân tích các đặc điểm khuôn mặt (0%)...';
        document.getElementById('cameraFrame').classList.remove('scanning-active');

        if (webcamStream) {
            document.getElementById('statusMessage').textContent = "Trạng thái: Camera hoạt động. Sẵn sàng quét.";
            document.getElementById('statusMessage').className = "w-100 text-center status-bar status-ready";
        }
    }
</script>
}

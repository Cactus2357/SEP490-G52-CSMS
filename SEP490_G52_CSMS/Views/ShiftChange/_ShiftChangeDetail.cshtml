@using SEP490_G52_CSMS.Commons
@model SEP490_G52_CSMS.Models.Attendance.ShiftChangeRequest
@{
    var employeeName = Model.RequestingEmployee?.FullName ?? $"NV#{Model.RequestingEmployeeId}";
    var isPending = Model.Status == "Submitted";
}

<!-- Warehouse Template: Dark Header -->
<div class="modal-header bg-dark text-white">
    <h5 class="modal-title fw-bold">
        <i class="bi bi-arrow-left-right me-2"></i>ĐƠN XIN ĐỔI CA - @employeeName.ToUpper()
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body p-4">
    <!-- Employee Info Card -->
    <div class="card border border-secondary-subtle rounded-3 p-3 mb-3 bg-white shadow-sm">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-dark text-white fw-bold d-flex align-items-center justify-content-center shadow-sm flex-shrink-0"
                     style="width: 48px; height: 48px; font-size: 1.1rem; border: 2px solid #212529;">
                    @(Model.RequestingEmployee?.FullName?.Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault()?[0].ToString().ToUpper() ?? "NV")
                </div>
                <div>
                    <div class="fw-bold text-dark fs-6">@employeeName</div>
                    <div class="text-muted small">
                        @(Model.RequestingEmployee?.Role ?? "Nhân viên") · Mã: NV#@Model.RequestingEmployeeId
                        @if (!string.IsNullOrEmpty(Model.RequestingEmployee?.PhoneNumber))
                        {
                            <span> · SĐT: @Model.RequestingEmployee.PhoneNumber</span>
                        }
                    </div>
                </div>
            </div>
            <span class="badge @(Model.Status == "Submitted" ? "bg-warning text-dark" : Model.Status == "Approved" ? "bg-success text-white" : "bg-danger text-white") rounded-pill px-3 py-1.5 fw-bold">
                @(Model.Status == "Submitted" ? "Chờ duyệt" : Model.Status == "Approved" ? "Đã duyệt" : Model.Status == "Rejected" ? "Từ chối" : Model.Status)
            </span>
        </div>
    </div>

    <!-- Request Details Block (dashed border) -->
    <div class="card border border-secondary-subtle rounded-3 p-3 mb-3 bg-light shadow-sm" style="border-style: dashed !important; border-width: 2px !important;">
        <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary-subtle">
            <span class="text-muted fw-semibold small">Thời gian gửi</span>
            <span class="fw-bold text-dark">
                @Model.SubmittedAt.ToVietnamTimeString("dd/MM/yyyy HH:mm")
                <span class="badge bg-white text-muted border ms-1 fw-normal">
                    <i class="bi bi-clock-history me-1"></i>@Model.SubmittedAt.ToRelativeTimeString()
                </span>
            </span>
        </div>
        <div class="d-flex justify-content-between align-items-start py-2 border-bottom border-secondary-subtle">
            <span class="text-muted fw-semibold small me-3">Nguyện vọng đổi ca</span>
            <span class="fw-bold text-dark text-end">@Model.Aspiration</span>
        </div>
        <div class="d-flex justify-content-between align-items-start py-2">
            <span class="text-muted fw-semibold small me-3">Lý do</span>
            <span class="fw-normal text-dark text-end">@Model.Reason</span>
        </div>
    </div>

    @if (!isPending)
    {
        <div class="alert @(Model.Status == "Approved" ? "alert-success" : "alert-danger") rounded-3 py-2 px-3 mb-0 d-flex align-items-center gap-2">
            <i class="bi @(Model.Status == "Approved" ? "bi-check-circle-fill" : "bi-x-circle-fill") fs-5"></i>
            <div>
                Yêu cầu này đã được xử lý (trạng thái hiện tại: <strong>@(Model.Status == "Approved" ? "Đã duyệt" : "Từ chối")</strong>).
            </div>
        </div>
    }
</div>

<div class="modal-footer bg-light px-4 py-3">
    <button type="button" class="btn btn-secondary fw-bold px-3" data-bs-dismiss="modal">Đóng</button>
    @if (isPending)
    {
        <button type="button" class="btn btn-danger fw-bold px-4 btn-shift-reject" data-request-id="@Model.RequestId">
            <i class="bi bi-x-circle me-1"></i>Không chấp nhận
        </button>
        <button type="button" class="btn btn-success fw-bold px-4 btn-shift-approve" data-request-id="@Model.RequestId">
            <i class="bi bi-check-circle me-1"></i>Chấp nhận
        </button>
    }
</div>

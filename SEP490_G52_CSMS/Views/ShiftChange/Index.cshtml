@model SEP490_G52_CSMS.Controllers.ManagerShiftChangeListViewModel
@{
    ViewData["Title"] = "Yêu cầu đổi ca";

    string GetStatusLabel(string? status) => status switch
    {
        "Submitted" => "Chờ duyệt",
        "Approved" => "Đã duyệt",
        "Rejected" => "Từ chối",
        _ => status ?? "-"
    };

    string GetStatusBadgeClass(string? status) => status switch
    {
        "Submitted" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1.5",
        "Approved" => "bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5",
        "Rejected" => "bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5",
        _ => "bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1.5"
    };
}

<div class="page-header">
    <h1 class="page-title">YÊU CẦU ĐỔI CA</h1>
</div>

<div class="card-container">
    <!-- Filter bar -->
    <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <select name="employeeId" class="form-select" style="max-width:220px;">
            <option value="">Chọn nhân viên</option>
            @foreach (var emp in Model.EmployeeOptions)
            {
                <option value="@emp.EmployeeId" selected="@(Model.SelectedEmployeeId == emp.EmployeeId)">
                    @(emp.FullName ?? $"NV#{emp.EmployeeId}")
                </option>
            }
        </select>

        <select name="status" class="form-select" style="max-width:220px;">
            <option value="">Chọn trạng thái đơn</option>
            <option value="Submitted" selected="@(Model.SelectedStatus == "Submitted")">Chờ duyệt</option>
            <option value="Approved" selected="@(Model.SelectedStatus == "Approved")">Đã duyệt</option>
            <option value="Rejected" selected="@(Model.SelectedStatus == "Rejected")">Từ chối</option>
        </select>

        <button type="submit" class="btn btn-primary">Xác nhận</button>
    </form>

    <!-- Shift change requests table -->
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tên Nhân Viên</th>
                    <th>Tiêu Đề Yêu Cầu</th>
                    <th>Ngày Gửi</th>
                    <th>Trạng Thái</th>
                    <th>Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Requests.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            Không tìm thấy yêu cầu đổi ca nào phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var req in Model.Requests)
                    {
                        string rowStyle = req.Status == "Pending" ? "table-warning" :
                                           req.Status == "Approved" ? "table-success" :
                                           req.Status == "Rejected" ? "table-danger" : "table-secondary";

                        <tr class="@rowStyle">
                            <td class="fw-semibold">@(req.RequestingEmployee?.FullName ?? $"NV#{req.RequestingEmployeeId}")</td>
                            <td>Đơn xin đổi ca làm</td>
                            <td>@req.SubmittedAt.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge @GetStatusBadgeClass(req.Status) rounded-pill px-3 py-1.5">@GetStatusLabel(req.Status)</span></td>
                            <td>
                                <button type="button" class="btn btn-sm btn-link text-primary fw-bold p-0 text-decoration-none" onclick="showShiftChangeDetail(@req.RequestId)">
                                    [Xem chi tiết]
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex justify-content-end">
            <ul class="pagination">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    @if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.CurrentPage) <= 1)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("Index", new { employeeId = Model.SelectedEmployeeId, status = Model.SelectedStatus, page = p })">
                                @p
                            </a>
                        </li>
                    }
                    else if (p == 2 || p == Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }
            </ul>
        </nav>
    }
</div>

<!-- Shift Change Detail Modal (content injected via AJAX) -->
<div class="modal fade" id="shiftDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="shiftDetailModalContent">
            <!-- populated by /ShiftChange/DetailPartial/{id} -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const shiftDetailModalEl = document.getElementById('shiftDetailModal');
        const shiftDetailModal = shiftDetailModalEl ? new bootstrap.Modal(shiftDetailModalEl) : null;

        function showShiftChangeDetail(requestId) {
            fetch(`/ShiftChange/DetailPartial/${requestId}`)
                .then(res => {
                    if (!res.ok) throw new Error('Không thể tải chi tiết yêu cầu.');
                    return res.text();
                })
                .then(html => {
                    document.getElementById('shiftDetailModalContent').innerHTML = html;
                    if (shiftDetailModal) shiftDetailModal.show();
                })
                .catch(err => {
                    console.error(err);
                    alert('Mất kết nối với hệ thống. Vui lòng tải lại trang hoặc thử lại sau!');
                });
        }

        // Event delegation: Approve / Reject / Cancel buttons live inside the
        // AJAX-injected partial, so we bind on the (static) modal container instead.
        document.getElementById('shiftDetailModalContent').addEventListener('click', async (e) => {
            const approveBtn = e.target.closest('.btn-shift-approve');
            const rejectBtn = e.target.closest('.btn-shift-reject');

            if (approveBtn) {
                const requestId = parseInt(approveBtn.dataset.requestId, 10);
                showConfirmModal('Xác nhận phê duyệt', 'Xác nhận phê duyệt đơn đổi ca này?', async function() {
                    await submitDecision('/ShiftChange/Approve', requestId, 'Phê duyệt đơn đổi ca thành công!');
                });
            } else if (rejectBtn) {
                const requestId = parseInt(rejectBtn.dataset.requestId, 10);
                showConfirmModal('Xác nhận từ chối', 'Xác nhận từ chối đơn đổi ca này?', async function() {
                    await submitDecision('/ShiftChange/Reject', requestId, 'Đã từ chối đơn đổi ca.');
                });
            }
        });

        async function submitDecision(url, requestId, successMessage) {
            try {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ requestId })
                });
                const result = await res.json();

                if (!result.success) {
                    showToast(result.errorMessage || 'Đã xảy ra lỗi. Vui lòng thử lại.', 'danger');
                    return;
                }

                if (shiftDetailModal) shiftDetailModal.hide();
                showToast(successMessage, 'success');
                setTimeout(() => window.location.reload(), 1000);
            } catch (err) {
                console.error(err);
                showToast('Mất kết nối với hệ thống. Vui lòng thử lại!', 'danger');
            }
        }
    </script>
}

@model SEP490_G52_CSMS.Controllers.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<h4 class="fw-bold text-uppercase mb-4">Đổi mật khẩu</h4>

@if (TempData["ChangePasswordSuccess"] != null)
{
    <div class="alert alert-success">@TempData["ChangePasswordSuccess"]</div>
}

<div class="row">
    <div class="col-lg-7">
        <form asp-controller="Auth" asp-action="ChangePassword" method="post" novalidate>
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null)
            {
                <div class="alert alert-danger py-2 px-3 small">
                    @Html.ValidationSummary(true, "")
                </div>
            }

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <input asp-for="CurrentPassword" type="password" class="form-control toggle-password-input" maxlength="50" />
                    <button type="button" class="btn btn-outline-secondary toggle-password-btn" tabindex="-1" title="Hiện/ẩn mật khẩu">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                <input asp-for="NewPassword" type="password" class="form-control" maxlength="50" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmNewPassword" class="form-label fw-semibold"></label>
                <input asp-for="ConfirmNewPassword" type="password" class="form-control" maxlength="50" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark px-4">Xác nhận đổi</button>
                <a asp-controller="Auth" asp-action="Profile" class="btn btn-outline-secondary px-4">Huỷ bỏ</a>
            </div>
        </form>
    </div>
</div>

<script>
    document.querySelector('.toggle-password-btn').addEventListener('click', function () {
        const input = document.querySelector('.toggle-password-input');
        const icon = this.querySelector('i');
        const isPassword = input.type === 'password';

        input.type = isPassword ? 'text' : 'password';
        icon.classList.toggle('bi-eye', !isPassword);
        icon.classList.toggle('bi-eye-slash', isPassword);
    });
</script>
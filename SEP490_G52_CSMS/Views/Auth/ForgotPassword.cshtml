@model SEP490_G52_CSMS.Controllers.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu - CSMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">

    <div class="card shadow-sm" style="max-width: 580px; width: 100%;">
        <div class="card-header text-center bg-white pt-4 pb-3">
            <div class="text-center mb-2">
                <a class="d-inline-flex align-items-center justify-content-center border rounded fw-bold h5 mb-0 px-3 py-2 text-decoration-none text-dark"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    SEP490_G52_CSMS
                </a>
            </div>
            <h3 class="fw-bold text-uppercase mb-0">Quên mật khẩu</h3>
        </div>

        <div class="card-body p-4">
            <div id="alertContainer"></div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3 mb-3 small">
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>
            }

            <form asp-controller="Auth" asp-action="ForgotPassword" method="post" id="forgotPasswordForm" novalidate>
                @Html.AntiForgeryToken()

                <!-- Email/Username Input and Send OTP Button -->
                <div class="mb-3">
                    <label asp-for="UsernameOrEmail" class="form-label fw-semibold">Nhập Email/Username để nhận OTP</label>
                    <div class="input-group">
                        <input asp-for="UsernameOrEmail" class="form-control" placeholder="Email hoặc Tên tài khoản" maxlength="100" required />
                        <button type="button" class="btn btn-outline-dark" id="btnSendOtp">Gửi mã OTP</button>
                    </div>
                    <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                </div>

                <!-- OTP Code Input -->
                <div class="mb-3">
                    <label asp-for="Otp" class="form-label fw-semibold">Nhập mã OTP gồm 6 số</label>
                    <input asp-for="Otp" class="form-control text-center" placeholder="******" maxlength="6" disabled required />
                    <span asp-validation-for="Otp" class="text-danger small"></span>
                </div>

                <!-- New Password -->
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold">Mật khẩu mới</label>
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="Nhập mật khẩu mới" maxlength="50" disabled required />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    <div class="form-text small text-muted">
                        Mật khẩu phải từ 8 ký tự, bao gồm chữ hoa, số và ký tự đặc biệt.
                    </div>
                </div>

                <!-- Confirm New Password -->
                <div class="mb-4">
                    <label asp-for="ConfirmNewPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                    <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" maxlength="50" disabled required />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>

                <!-- Bottom Buttons -->
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-controller="Auth" asp-action="Login" class="text-decoration-none text-secondary">
                        <i class="bi bi-chevron-left small"></i> Quay lại đăng nhập
                    </a>
                    <button type="submit" class="btn btn-dark px-4" id="btnSubmitReset" disabled>Đổi mật khẩu</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const btnSendOtp = document.getElementById('btnSendOtp');
            const usernameInput = document.getElementById('UsernameOrEmail');
            const otpInput = document.getElementById('Otp');
            const newPasswordInput = document.getElementById('NewPassword');
            const confirmPasswordInput = document.getElementById('ConfirmNewPassword');
            const btnSubmitReset = document.getElementById('btnSubmitReset');
            const alertContainer = document.getElementById('alertContainer');
            const form = document.getElementById('forgotPasswordForm');

            // BR-01 helper: Check if all fields are filled
            function checkMandatoryFields() {
                const usernameVal = usernameInput.value.trim();
                const otpVal = otpInput.value.trim();
                const newPasswordVal = newPasswordInput.value.trim();
                const confirmPasswordVal = confirmPasswordInput.value.trim();

                if (usernameVal && otpVal.length === 6 && newPasswordVal && confirmPasswordVal) {
                    btnSubmitReset.removeAttribute('disabled');
                } else {
                    btnSubmitReset.setAttribute('disabled', 'true');
                }
            }

            // Bind input change listeners to validate mandatory fields in real time
            [usernameInput, otpInput, newPasswordInput, confirmPasswordInput].forEach(input => {
                input.addEventListener('input', checkMandatoryFields);
            });

            // AJAX Send OTP handler
            btnSendOtp.addEventListener('click', async () => {
                const usernameOrEmail = usernameInput.value.trim();
                if (!usernameOrEmail) {
                    showAlert('Vui lòng nhập Email hoặc Tên tài khoản để nhận OTP.', 'danger');
                    return;
                }

                btnSendOtp.setAttribute('disabled', 'true');
                btnSendOtp.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang gửi...';
                showAlert('Đang gửi OTP...', 'info');

                try {
                    const response = await fetch('/Auth/SendOtp', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ UsernameOrEmail: usernameOrEmail })
                    });

                    const data = await response.json();
                    if (data.success) {
                        showAlert(data.message + ` (Đến email: ${data.email})`, 'success');
                        
                        // Enable fields
                        otpInput.removeAttribute('disabled');
                        newPasswordInput.removeAttribute('disabled');
                        confirmPasswordInput.removeAttribute('disabled');
                        otpInput.focus();
                    } else {
                        showAlert(data.message, 'danger');
                    }
                } catch (error) {
                    console.error('Error sending OTP:', error);
                    showAlert('Có lỗi xảy ra khi kết nối máy chủ. Vui lòng thử lại.', 'danger');
                } finally {
                    btnSendOtp.removeAttribute('disabled');
                    btnSendOtp.textContent = 'Gửi mã OTP';
                    checkMandatoryFields();
                }
            });

            function showAlert(message, type) {
                alertContainer.innerHTML = `
                    <div class="alert alert-${type} alert-dismissible fade show py-2 px-3 small d-flex align-items-center justify-content-between" role="alert">
                        <div>
                            <i class="bi ${type === 'success' ? 'bi-check-circle-fill' : type === 'danger' ? 'bi-exclamation-triangle-fill' : 'bi-info-circle-fill'} me-2"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="padding: 0.8rem 1rem;"></button>
                    </div>
                `;
            }

            // Restore form state if there are validation errors from model submit
            if (usernameInput.value.trim() !== '') {
                otpInput.removeAttribute('disabled');
                newPasswordInput.removeAttribute('disabled');
                confirmPasswordInput.removeAttribute('disabled');
                checkMandatoryFields();
            }
        });
    </script>
</body>
</html>

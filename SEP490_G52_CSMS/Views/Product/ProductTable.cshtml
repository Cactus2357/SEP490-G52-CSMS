@model SEP490_G52_CSMS.Models.ViewModels.Sales.Product.ProductIndexViewModel

<table class="table align-middle product-table">
    <thead class="table-light">
        <tr>
            <th style="width: 30%;">
                Tên Sản Phẩm
            </th>

            <th style="width: 25%;">
                Danh Mục
            </th>

            <th style="width: 20%;"
                class="text-center">
                Trạng Thái
            </th>

            <th style="width: 25%;"
                class="text-center">
                Sửa
            </th>
        </tr>
    </thead>

    <tbody>
        @if (Model.Products != null && Model.Products.Any())
        {
            @foreach (var item in Model.Products)
            {
                bool isActive = item.Status == "Active" || item.Status == "Hoạt động";
                string rowClass = isActive ? "" : "table-secondary text-muted";

                <tr class="@rowClass">
                    <td class="fw-semibold">
                        @item.ProductName
                    </td>

                    <td>
                        @item.CategoryName
                    </td>

                    <td class="text-center">
                        <form asp-controller="Product" asp-action="ToggleStatus" asp-route-id="@item.ProductId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm border-0 bg-transparent p-0" title="Click để thay đổi trạng thái sản phẩm">
                                <span class="badge @(isActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle") rounded-pill px-3 py-1.5">
                                    <i class="bi @(isActive ? "bi-check-circle-fill" : "bi-pause-circle-fill") me-1"></i>
                                    @(isActive ? "Đang hoạt động" : "Ngưng hoạt động")
                                </span>
                            </button>
                        </form>
                    </td>

                    <td class="text-center">
                        <a asp-controller="Product"
                           asp-action="Variants"
                           asp-route-id="@item.ProductId"
                           class="btn btn-sm btn-outline-primary me-1"
                           title="Quản lý biến thể">
                            <i class="bi bi-gear-fill"></i> Biến thể
                        </a>

                        <a asp-controller="Product"
                           asp-action="Edit"
                           asp-route-id="@item.ProductId"
                           class="btn btn-sm btn-outline-dark"
                           title="Sửa sản phẩm">
                            <i class="bi bi-pencil-square"></i> Sửa
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4"
                    class="text-center text-muted py-4">
                    Không có dữ liệu.
                </td>
            </tr>
        }
    </tbody>
</table>

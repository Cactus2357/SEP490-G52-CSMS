@model IEnumerable<SEP490_G52_CSMS.Models.ViewModels.OrderSummaryViewModel>

@{
    ViewData["Title"] = "Danh sách đơn pha chế";
}

<div class="container-fluid mt-3 px-4">
    <!-- Header Section -->
    <div class="card bg-body-tertiary border-0 rounded-3 mb-4 shadow-sm">
        <div class="card-body p-3 d-flex justify-content-between align-items-center">
            <div>
                <span class="text-muted small">Bartender / Pha chế</span>
                <h4 class="fw-bold m-0 text-dark">DANH SÁCH ĐƠN PHA CHẾ</h4>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div style="width: 280px;">
                    <input type="text" id="brewingSearch" class="form-control" placeholder="Tìm theo Mã đơn / Tên khách..." onkeyup="filterBrewingOrders()">
                </div>
            </div>
        </div>
    </div>

    <!-- Orders Master-Detail Table -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle m-0" id="brewingTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 5%;" class="ps-3"></th>
                            <th style="width: 18%;">Mã Đơn Hàng</th>
                            <th style="width: 22%;">Tên Khách Hàng</th>
                            <th style="width: 18%;">Thời Gian</th>
                            <th style="width: 15%;">Trạng Thái</th>
                            <th style="width: 22%;" class="text-center pe-3">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody id="brewingTableBody">
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-cup-hot fs-2 d-block mb-2 text-secondary-subtle"></i>
                                    Không có đơn hàng nào đang chờ pha chế.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int orderIdx = 0;
                            foreach (var o in Model)
                            {
                                bool isBrewing = o.BrewingStatus == "Brewing in Progress";
                                string rowClass = isBrewing ? "table-primary fw-semibold" : "table-warning fw-semibold";
                                string badgeClass = isBrewing ? "bg-primary text-white" : "bg-warning text-dark";
                                bool isExpanded = (orderIdx == 0);
                                orderIdx++;

                                <tr class="brewing-row @rowClass" data-name="@o.RecipientName.ToLower()" data-id="@o.OrderId.ToLower()" data-code="@o.OrderId">
                                    <td class="ps-3">
                                        <button type="button" class="btn btn-sm btn-link text-dark p-0 toggle-nested-btn" onclick="toggleNestedItems('@o.OrderId')">
                                            <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down")" id="chevron-@o.OrderId"></i>
                                        </button>
                                    </td>
                                    <td class="fw-bold text-primary">@o.OrderId</td>
                                    <td>@o.RecipientName</td>
                                    <td class="text-secondary">@o.OrderTime.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge @badgeClass rounded-pill px-3 py-1.5">
                                            @o.DisplayStatus
                                        </span>
                                    </td>
                                    <td class="text-center pe-3">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            @if (!isBrewing)
                                            {
                                                <button type="button" class="btn btn-sm btn-warning rounded-pill px-3 fw-bold shadow-sm" onclick="startBrewingOrder('@o.OrderId')">
                                                    <i class="bi bi-play-fill me-1"></i> Pha chế
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm" onclick="completeBrewingOrder('@o.OrderId')">
                                                    <i class="bi bi-check-lg me-1"></i> Hoàn thành
                                                </button>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1 fw-bold shadow-sm" onclick="openMissingModal('@o.OrderId')" title="Báo thiếu nguyên liệu cho đơn này">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Báo thiếu NL
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Nested Table Row -->
                                <tr class="nested-items-row" id="nested-row-@o.OrderId" style="@(isExpanded ? "" : "display: none;")">
                                    <td colspan="6" class="p-0 border-0">
                                        <div class="bg-body-tertiary p-3 border-bottom shadow-inner">
                                            <div class="table-responsive bg-white rounded border">
                                                <table class="table table-sm table-striped table-bordered m-0 align-middle">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th style="width: 10%;" class="ps-3 text-center">STT</th>
                                                            <th style="width: 50%;">Tên món</th>
                                                            <th style="width: 20%;" class="text-center">Size</th>
                                                            <th style="width: 20%;" class="text-center">Số lượng</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (o.Items != null && o.Items.Any())
                                                        {
                                                            for (int idx = 0; idx < o.Items.Count; idx++)
                                                            {
                                                                var item = o.Items[idx];
                                                                <tr>
                                                                    <td class="text-center ps-3 text-muted">@(idx + 1)</td>
                                                                    <td class="fw-bold text-dark">@item.ProductName</td>
                                                                    <td class="text-center"><span class="badge bg-secondary-subtle text-dark">@item.Size</span></td>
                                                                    <td class="text-center fw-bold text-primary">@item.Quantity</td>
                                                                </tr>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <tr>
                                                                <td colspan="4" class="text-center text-muted py-2">Không có dữ liệu chi tiết món.</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Báo Thiếu Nguyên Liệu -->
<div class="modal fade" id="missingIngredientsModal" tabindex="-1" aria-labelledby="missingIngredientsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white py-3">
                <h5 class="modal-title fw-bold" id="missingIngredientsModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>BÁO THIẾU NGUYÊN LIỆU PHA CHẾ
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-warning small mb-3">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Vui lòng chọn <strong>các món đồ uống bị thiếu nguyên liệu</strong>. Hệ thống sẽ chuyển đơn hàng về cho Thu ngân để xử lý hoàn tiền hoặc đổi món cho khách.
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small mb-1">Mã đơn hàng:</label>
                    <input type="text" id="modalMissingOrderId" class="form-control form-control-sm bg-light fw-bold text-primary" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark small mb-2">
                        Chọn món bị thiếu nguyên liệu: <span class="text-danger">*</span>
                    </label>
                    <div id="missingItemsListContainer" class="border rounded p-2.5 bg-light" style="max-height: 200px; overflow-y: auto;">
                        <div class="text-center text-muted py-3">
                            <span class="spinner-border spinner-border-sm me-1"></span> Đang tải danh sách món...
                        </div>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label fw-semibold text-secondary small mb-1">
                        Ghi chú lý do thiếu nguyên liệu <span class="text-muted fw-normal">(Tùy chọn)</span>:
                    </label>
                    <textarea id="modalMissingReason" class="form-control form-control-sm" rows="3" placeholder="Ví dụ: Hết sữa tươi thanh trùng, hết trân châu đen, thiếu siro đào..."></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light py-2.5">
                <button type="button" class="btn btn-secondary btn-sm fw-semibold px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger btn-sm fw-bold px-4 shadow-sm" onclick="submitMissingIngredientsReport()">
                    <i class="bi bi-send-fill me-1"></i> Gửi báo cáo cho Thu ngân
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const expandedOrderIds = new Set();
        let cachedOrdersData = {};
        let missingModalInstance = null;

        @if (Model.Any())
        {
            @:expandedOrderIds.add('@Model.First().OrderId');
        }

        // Cache initial Model items
        @foreach (var o in Model)
        {
            @:cachedOrdersData['@o.OrderId'] = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(o.Items.Select(i => new { variantId = i.VariantId, productName = i.ProductName, size = i.Size, quantity = i.Quantity, unitPrice = i.UnitPrice, amount = i.Amount })));
        }

        function toggleNestedItems(orderId) {
            let row = $(`#nested-row-${orderId}`);
            let chevron = $(`#chevron-${orderId}`);
            if (row.is(':visible')) {
                row.hide();
                chevron.removeClass('bi-chevron-up').addClass('bi-chevron-down');
                expandedOrderIds.delete(orderId);
            } else {
                row.show();
                chevron.removeClass('bi-chevron-down').addClass('bi-chevron-up');
                expandedOrderIds.add(orderId);
            }
        }

        function filterBrewingOrders() {
            let val = $('#brewingSearch').val().toLowerCase().trim();
            $('.brewing-row').each(function() {
                let name = $(this).data('name') || '';
                let code = $(this).data('code') ? $(this).data('code').toLowerCase() : '';
                let orderId = $(this).data('id') || '';

                if (!val || name.includes(val) || code.includes(val) || orderId.includes(val)) {
                    $(this).removeClass('d-none');
                    let id = $(this).data('code');
                    if (expandedOrderIds.has(id)) {
                        $(`#nested-row-${id}`).removeClass('d-none').show();
                    }
                } else {
                    $(this).addClass('d-none');
                    let id = $(this).data('code');
                    $(`#nested-row-${id}`).addClass('d-none').hide();
                }
            });
        }

        function startBrewingOrder(orderId) {
            showConfirmModal(
                'Xác nhận pha chế',
                `Bắt đầu chuyển trạng thái đơn hàng <strong>${orderId}</strong> sang <strong>Đang pha chế</strong>?`,
                function() {
                    $.ajax({
                        url: '/Brewing/StartBrewing',
                        type: 'POST',
                        data: { orderId: orderId },
                        success: function(res) {
                            showToast(`Đã nhận đơn hàng ${orderId} để pha chế.`, 'success');
                            fetchLiveOrders();
                        },
                        error: function(xhr) {
                            let msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Không thể cập nhật trạng thái đơn.';
                            showToast(msg, 'danger');
                        }
                    });
                }
            );
        }

        function completeBrewingOrder(orderId) {
            showConfirmModal(
                'Xác nhận hoàn thành',
                `Xác nhận đơn hàng <strong>${orderId}</strong> đã được pha chế <strong>Hoàn thành</strong>?`,
                function() {
                    $.ajax({
                        url: '/Brewing/CompleteBrewing',
                        type: 'POST',
                        data: { orderId: orderId },
                        success: function(res) {
                            showToast(`Đã hoàn thành đơn hàng ${orderId}.`, 'success');
                            fetchLiveOrders();
                        },
                        error: function(xhr) {
                            let msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Không thể hoàn thành đơn hàng.';
                            showToast(msg, 'danger');
                        }
                    });
                }
            );
        }

        function openMissingModal(orderId) {
            $('#modalMissingOrderId').val(orderId);
            $('#modalMissingReason').val('');

            let items = cachedOrdersData[orderId];
            if (!items || items.length === 0) {
                // Fallback: fetch live details
                $.ajax({
                    url: '/Brewing/GetLiveOrders',
                    type: 'GET',
                    success: function(orders) {
                        let ord = orders.find(o => o.orderId === orderId);
                        if (ord && ord.items) {
                            renderMissingItemsList(ord.items);
                        } else {
                            $('#missingItemsListContainer').html('<div class="text-danger small">Không tìm thấy danh sách món của đơn.</div>');
                        }
                    }
                });
            } else {
                renderMissingItemsList(items);
            }

            if (!missingModalInstance) {
                missingModalInstance = new bootstrap.Modal(document.getElementById('missingIngredientsModal'));
            }
            missingModalInstance.show();
        }

        function renderMissingItemsList(items) {
            let html = '';
            items.forEach((it, idx) => {
                let vId = it.variantId || idx;
                html += `
                    <div class="form-check p-2 mb-1 border-bottom bg-white rounded">
                        <input class="form-check-input missing-item-chk ms-0 me-2" type="checkbox" value="${vId}" id="chk_item_${vId}">
                        <label class="form-check-label w-100 cursor-pointer d-flex justify-content-between align-items-center" for="chk_item_${vId}">
                            <div>
                                <span class="fw-bold text-dark">${it.productName}</span>
                                <span class="badge bg-secondary-subtle text-dark ms-1">Size ${it.size}</span>
                                <span class="text-muted ms-1">x${it.quantity}</span>
                            </div>
                            <span class="fw-bold text-primary">${(it.amount || (it.quantity * it.unitPrice) || 0).toLocaleString('vi-VN')} đ</span>
                        </label>
                    </div>
                `;
            });
            $('#missingItemsListContainer').html(html);
        }

        function submitMissingIngredientsReport() {
            let orderId = $('#modalMissingOrderId').val();
            let reason = $('#modalMissingReason').val().trim();
            let selectedVariantIds = [];

            $('.missing-item-chk:checked').each(function() {
                let val = parseInt($(this).val());
                if (!isNaN(val)) {
                    selectedVariantIds.push(val);
                }
            });

            if (selectedVariantIds.length === 0) {
                showToast('Vui lòng tích chọn ít nhất 1 món bị thiếu nguyên liệu!', 'warning');
                return;
            }

            let confirmMsg = `Xác nhận gửi báo cáo <strong>thiếu nguyên liệu cho ${selectedVariantIds.length} món</strong> của đơn <strong>${orderId}</strong> tới Thu ngân để xử lý?`;

            showConfirmModal(
                'Xác nhận báo thiếu nguyên liệu',
                confirmMsg,
                function() {
                    $.ajax({
                        url: '/Brewing/ReportMissingIngredients',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            orderId: orderId,
                            missingVariantIds: selectedVariantIds,
                            reason: reason
                        }),
                        success: function(res) {
                            if (missingModalInstance) missingModalInstance.hide();
                            showToast(res.message || 'Đã gửi thông báo cho Thu ngân thành công.', 'success');
                            fetchLiveOrders();
                        },
                        error: function(xhr) {
                            let msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Lỗi khi gửi báo cáo thiếu nguyên liệu.';
                            showToast(msg, 'danger');
                        }
                    });
                }
            );
        }

        // Live Auto-Polling (every 5 seconds)
        function fetchLiveOrders() {
            $.ajax({
                url: '/Brewing/GetLiveOrders',
                type: 'GET',
                success: function(orders) {
                    if (!orders || orders.length === 0) {
                        expandedOrderIds.clear();
                        $('#brewingTableBody').html(`
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-cup-hot fs-2 d-block mb-2 text-secondary-subtle"></i>
                                    Không có đơn hàng nào đang chờ pha chế.
                                </td>
                            </tr>
                        `);
                        return;
                    }

                    // Update cached items
                    orders.forEach(o => {
                        cachedOrdersData[o.orderId] = o.items;
                    });

                    // Auto-expand the top order in the queue if no active order is currently expanded
                    let hasExpandedActiveOrder = orders.some(o => expandedOrderIds.has(o.orderId));
                    if (!hasExpandedActiveOrder && orders.length > 0) {
                        expandedOrderIds.add(orders[0].orderId);
                    }

                    let search = $('#brewingSearch').val().toLowerCase().trim();
                    let rowsHtml = '';

                    orders.forEach(o => {
                        let isBrewing = o.brewingStatus === 'Brewing in Progress';
                        let stringRowClass = isBrewing ? 'table-primary fw-semibold' : 'table-warning fw-semibold';
                        let badgeClass = isBrewing ? 'bg-primary text-white' : 'bg-warning text-dark';
                        let matchesSearch = !search || o.recipientName.toLowerCase().includes(search) || o.orderId.toLowerCase().includes(search);
                        let hiddenCls = matchesSearch ? '' : 'd-none';

                        let isExpanded = expandedOrderIds.has(o.orderId);
                        let displayStyle = isExpanded ? '' : 'display: none;';
                        let chevronClass = isExpanded ? 'bi-chevron-up' : 'bi-chevron-down';

                        rowsHtml += `
                            <tr class="brewing-row ${stringRowClass} ${hiddenCls}" data-name="${o.recipientName.toLowerCase()}" data-id="${o.orderId.toLowerCase()}" data-code="${o.orderId}">
                                <td class="ps-3">
                                    <button type="button" class="btn btn-sm btn-link text-dark p-0 toggle-nested-btn" onclick="toggleNestedItems('${o.orderId}')">
                                        <i class="bi ${chevronClass}" id="chevron-${o.orderId}"></i>
                                    </button>
                                </td>
                                <td class="fw-bold text-primary">${o.orderId}</td>
                                <td>${o.recipientName}</td>
                                <td class="text-secondary">${o.orderTime}</td>
                                <td>
                                    <span class="badge ${badgeClass} rounded-pill px-3 py-1.5">
                                        ${o.displayStatus}
                                    </span>
                                </td>
                                <td class="text-center pe-3">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        ${!isBrewing ? `
                                            <button type="button" class="btn btn-sm btn-warning rounded-pill px-3 fw-bold shadow-sm" onclick="startBrewingOrder('${o.orderId}')">
                                                <i class="bi bi-play-fill me-1"></i> Pha chế
                                            </button>
                                        ` : `
                                            <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm" onclick="completeBrewingOrder('${o.orderId}')">
                                                <i class="bi bi-check-lg me-1"></i> Hoàn thành
                                            </button>
                                        `}
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1 fw-bold shadow-sm" onclick="openMissingModal('${o.orderId}')" title="Báo thiếu nguyên liệu cho đơn này">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Báo thiếu NL
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <tr class="nested-items-row ${hiddenCls}" id="nested-row-${o.orderId}" style="${displayStyle}">
                                <td colspan="6" class="p-0 border-0">
                                    <div class="bg-body-tertiary p-3 border-bottom shadow-inner">
                                        <div class="table-responsive bg-white rounded border">
                                            <table class="table table-sm table-striped table-bordered m-0 align-middle">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width: 10%;" class="ps-3 text-center">STT</th>
                                                        <th style="width: 50%;">Tên món</th>
                                                        <th style="width: 20%;" class="text-center">Size</th>
                                                        <th style="width: 20%;" class="text-center">Số lượng</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    ${o.items && o.items.length ? o.items.map(item => `
                                                        <tr>
                                                            <td class="text-center ps-3 text-muted">${item.stt}</td>
                                                            <td class="fw-bold text-dark">${item.productName}</td>
                                                            <td class="text-center"><span class="badge bg-secondary-subtle text-dark">${item.size}</span></td>
                                                            <td class="text-center fw-bold text-primary">${item.quantity}</td>
                                                        </tr>
                                                    `).join('') : `
                                                        <tr>
                                                            <td colspan="4" class="text-center text-muted py-2">Không có dữ liệu chi tiết món.</td>
                                                        </tr>
                                                    `}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        `;
                    });

                    $('#brewingTableBody').html(rowsHtml);
                }
            });
        }

        $(document).ready(function() {
            // Poll every 5 seconds
            setInterval(fetchLiveOrders, 5000);
        });
    </script>
}

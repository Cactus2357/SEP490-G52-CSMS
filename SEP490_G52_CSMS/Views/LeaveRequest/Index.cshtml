@model SEP490_G52_CSMS.Models.ViewModels.LeaveRequestListViewModel
@{
    ViewData["Title"] = "Danh Sách Đơn Xin Nghỉ";
}

<div class="container-fluid px-4 pt-3">
    <!-- Tiêu đề -->
    <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
        <h3 class="fw-bold mb-0 text-uppercase text-dark">
            <i class="bi bi-calendar-x-fill text-danger me-2"></i>Danh Sách Đơn Xin Nghỉ
        </h3>
    </div>

    <!-- Thông tin nhân viên & Bộ lọc -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="fs-5 text-dark">
                Nhân viên: <span class="fw-bold text-primary">@Model.EmployeeName</span>
            </div>
            
            <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-3 m-0" id="filterForm">
                <div>
                    <select name="status" class="form-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="Tất cả" selected="@(Model.Status == "Tất cả")">Tất cả trạng thái</option>
                        <option value="Đã gửi" selected="@(Model.Status == "Đã gửi")">Đã gửi</option>
                        <option value="Đã duyệt" selected="@(Model.Status == "Đã duyệt")">Đã duyệt</option>
                        <option value="Từ chối" selected="@(Model.Status == "Từ chối")">Từ chối</option>
                        <option value="Đã hủy" selected="@(Model.Status == "Đã hủy")">Đã hủy</option>
                    </select>
                </div>
                
                <div class="d-flex align-items-center gap-2">
                    <input type="date" id="filterFromDate" name="fromDate" class="form-control"
                           value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" style="width: 145px;" onchange="validateFilterDates()" />
                    <span class="text-muted">đến</span>
                    <input type="date" id="filterToDate" name="toDate" class="form-control"
                           value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" style="width: 145px;" onchange="validateFilterDates()" />
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 25%;">Ngày Gửi Đơn</th>
                        <th style="width: 25%;">Thời Gian Xin Nghỉ</th>
                        <th style="width: 25%;">Trạng Thái</th>
                        <th class="pe-4 text-end" style="width: 25%;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr class="leave-row"
                                data-id="@item.ApplicationId"
                                data-employee="@Model.EmployeeName"
                                data-submitted="@item.SubmittedAt"
                                data-status="@item.Status"
                                data-start="@item.StartDate"
                                data-end="@item.EndDate"
                                data-shifts="@item.LeaveShifts"
                                data-reason="@item.Reason">
                                <td class="ps-4 fw-semibold text-secondary">@item.SubmittedAt</td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.StartDate</span>
                                    @if (item.StartDate != item.EndDate && !string.IsNullOrEmpty(item.EndDate))
                                    {
                                        <span class="text-muted small"> đến @item.EndDate</span>
                                    }
                                    <small class="d-block text-muted">(@item.LeaveShifts)</small>
                                </td>
                                <td>
                                    @if (item.Status == "Đã duyệt")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5">
                                            <i class="bi bi-check-circle-fill me-1"></i>Đã duyệt
                                        </span>
                                    }
                                    else if (item.Status == "Từ chối")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5">
                                            <i class="bi bi-x-circle-fill me-1"></i>Từ chối
                                        </span>
                                    }
                                    else if (item.Status == "Đã hủy")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1.5">
                                            <i class="bi bi-dash-circle-fill me-1"></i>Đã hủy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1.5">
                                            <i class="bi bi-send-fill me-1"></i>Đã gửi
                                        </span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <button type="button" class="btn btn-outline-primary btn-sm me-2" onclick="showLeaveDetailModal(this)">
                                        <i class="bi bi-eye me-1"></i>Chi tiết
                                    </button>
                                    @if (item.CanCancel)
                                    {
                                        <form asp-action="Cancel" method="post" class="d-inline" id="cancelLeaveForm_@item.ApplicationId">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="applicationId" value="@item.ApplicationId" />
                                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="confirmCancelLeave(@item.ApplicationId)">
                                                <i class="bi bi-x-circle me-1"></i>Hủy đơn
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-light text-muted" disabled>
                                            <i class="bi bi-slash-circle me-1"></i>Hủy đơn
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Không có đơn xin nghỉ phép nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Chú thích & Nút mở đơn xin nghỉ -->
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div class="card border-0 shadow-sm" style="max-width: 500px;">
            <div class="card-body py-2 px-3 bg-light rounded border">
                <span class="fw-semibold text-danger"><i class="bi bi-info-circle-fill me-1"></i>Lưu ý:</span>
                <span class="text-secondary small">Chỉ hủy đơn khi trạng thái là "Đã gửi" (trước khi quản lý duyệt đơn).</span>
            </div>
        </div>
        <button type="button" class="btn btn-primary fw-semibold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#createLeaveModal">
            <i class="bi bi-plus-lg me-1"></i>Đơn xin nghỉ
        </button>
    </div>
</div>

<!-- Modal Chi Tiết Đơn Xin Nghỉ (Dành Cho Nhân Viên) -->
<div class="modal fade" id="staffLeaveDetailModal" tabindex="-1" aria-labelledby="staffLeaveDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-light border-bottom py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-text text-primary fs-4"></i>
                    <h5 class="modal-title fw-bold text-dark m-0" id="staffLeaveDetailModalLabel">CHI TIẾT ĐƠN XIN NGHỈ</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="card border border-secondary-subtle rounded-3 p-3 mb-3 bg-light">
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary-subtle">
                        <span class="text-muted fw-semibold small">Nhân viên:</span>
                        <span class="fw-bold text-dark" id="modalDetailEmployee">@Model.EmployeeName</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary-subtle">
                        <span class="text-muted fw-semibold small">Trạng thái:</span>
                        <span id="modalDetailStatusBadge">–</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary-subtle">
                        <span class="text-muted fw-semibold small">Ngày gửi đơn:</span>
                        <span class="fw-semibold text-secondary" id="modalDetailSubmitted">–</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary-subtle">
                        <span class="text-muted fw-semibold small">Thời gian nghỉ:</span>
                        <span class="fw-bold text-primary" id="modalDetailTimeRange">–</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted fw-semibold small">Ca muốn nghỉ:</span>
                        <span class="fw-bold text-dark" id="modalDetailShifts">–</span>
                    </div>
                </div>

                <div class="mb-0">
                    <label class="form-label fw-semibold text-secondary small mb-1">Lý do nghỉ phép:</label>
                    <div class="p-3 border rounded bg-white small text-dark" id="modalDetailReason" style="min-height: 80px; white-space: pre-wrap;">
                        –
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2.5">
                <button type="button" class="btn btn-secondary btn-sm px-4 fw-semibold" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Đơn Xin Nghỉ Phép -->
<div class="modal fade" id="createLeaveModal" tabindex="-1" aria-labelledby="createLeaveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold text-uppercase" id="createLeaveModalLabel">
                    <i class="bi bi-file-earmark-plus me-2"></i>ĐƠN XIN NGHỈ PHÉP
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form asp-action="Create" method="post" id="createLeaveForm">
                <div class="modal-body p-4 row g-0">
                    <div class="col-md-8 pe-md-4 border-end">
                        <!-- Row 1: Họ tên & Chức vụ -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary">Họ &amp; Tên nhân viên</label>
                            <input type="text" class="form-control" value="@Model.EmployeeName" readonly />
                            <input type="hidden" name="EmployeeName" value="@Model.EmployeeName" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary">Chức vụ</label>
                            <select name="RoleName" class="form-select">
                                <option value="Thu ngân" selected>Thu ngân</option>
                                <option value="Quản lý">Quản lý</option>
                                <option value="Pha chế">Pha chế</option>
                            </select>
                        </div>

                        <!-- Row 2: Ngày xin nghỉ -->
                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold text-secondary">Nghỉ từ ngày</label>
                                <input type="date" id="modalStartDate" name="StartDate" class="form-control" 
                                       value="@(DateTime.Today.AddDays(1).ToString("yyyy-MM-dd"))" 
                                       min="@(DateTime.Today.AddDays(1).ToString("yyyy-MM-dd"))" required onchange="validateModalDates()" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold text-secondary">Đến ngày</label>
                                <input type="date" id="modalEndDate" name="EndDate" class="form-control" 
                                       value="@(DateTime.Today.AddDays(1).ToString("yyyy-MM-dd"))" 
                                       min="@(DateTime.Today.AddDays(1).ToString("yyyy-MM-dd"))" required onchange="validateModalDates()" />
                            </div>
                        </div>

                        <!-- Row 3: Ca muốn nghỉ -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary">Ca muốn nghỉ</label>
                            <input type="text" name="LeaveShifts" class="form-control" placeholder="VD: Ca 1, Ca 2" required />
                        </div>

                        <!-- Row 4: Lý do -->
                        <div class="mb-0">
                            <label class="form-label fw-semibold text-secondary">Lý do nghỉ phép</label>
                            <textarea name="Reason" class="form-control" rows="3" placeholder="Lý do chi tiết..." required></textarea>
                        </div>
                    </div>
                    
                    <div class="col-md-4 ps-md-4 d-flex flex-column justify-content-between mt-3 mt-md-0">
                        <div class="bg-light p-3 rounded border">
                            <div class="fw-bold text-danger mb-2 small"><i class="bi bi-exclamation-circle-fill me-1"></i>LƯU Ý QUAN TRỌNG:</div>
                            <ul class="small text-secondary ps-3 mb-0">
                                <li class="mb-1">Cần xin nghỉ trước ít nhất 1 ngày.</li>
                                <li class="mb-1">Đối với trường hợp khẩn cấp, ngoài việc gửi đơn trên hệ thống cần liên hệ trực tiếp với quản lý.</li>
                                <li class="fw-bold text-dark mt-2">Hotline: 039787961</li>
                            </ul>
                        </div>
                        
                        <div class="d-flex gap-2 justify-content-end mt-4">
                            <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-primary px-4">Gửi đơn</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var staffLeaveModalInstance = null;

        function showLeaveDetailModal(btn) {
            const row = btn.closest('tr');
            if (!row) return;

            const employee  = row.dataset.employee || '@Model.EmployeeName';
            const submitted = row.dataset.submitted || '–';
            const status    = row.dataset.status || 'Đã gửi';
            const startDate = row.dataset.start || '–';
            const endDate   = row.dataset.end || '–';
            const shifts    = row.dataset.shifts || 'Tất cả ca';
            const reason    = row.dataset.reason || '(Không có lý do)';

            document.getElementById('modalDetailEmployee').textContent = employee;
            document.getElementById('modalDetailSubmitted').textContent = submitted;
            document.getElementById('modalDetailShifts').textContent = shifts;
            document.getElementById('modalDetailReason').textContent = reason;

            if (startDate === endDate || !endDate || endDate === '–') {
                document.getElementById('modalDetailTimeRange').textContent = startDate;
            } else {
                document.getElementById('modalDetailTimeRange').textContent = `${startDate} đến ${endDate}`;
            }

            let badgeHtml = '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1"><i class="bi bi-send-fill me-1"></i>Đã gửi</span>';
            if (status === 'Đã duyệt') {
                badgeHtml = '<span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1"><i class="bi bi-check-circle-fill me-1"></i>Đã duyệt</span>';
            } else if (status === 'Từ chối') {
                badgeHtml = '<span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1"><i class="bi bi-x-circle-fill me-1"></i>Từ chối</span>';
            } else if (status === 'Đã hủy') {
                badgeHtml = '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1"><i class="bi bi-dash-circle-fill me-1"></i>Đã hủy</span>';
            }
            document.getElementById('modalDetailStatusBadge').innerHTML = badgeHtml;

            if (!staffLeaveModalInstance) {
                staffLeaveModalInstance = new bootstrap.Modal(document.getElementById('staffLeaveDetailModal'));
            }
            staffLeaveModalInstance.show();
        }

        function confirmCancelLeave(appId) {
            showConfirmModal(
                'Hủy đơn xin nghỉ',
                'Bạn có chắc chắn muốn hủy đơn xin nghỉ phép này?',
                function() {
                    const form = document.getElementById('cancelLeaveForm_' + appId);
                    if (form) {
                        form.submit();
                    }
                }
            );
        }

        $('#createLeaveForm').on('submit', function(e) {
            if ($(this).data('confirmed')) return true;
            e.preventDefault();
            const form = this;
            showConfirmModal(
                'Xác nhận gửi đơn xin nghỉ',
                'Bạn có chắc chắn muốn gửi đơn xin nghỉ phép này đến quản lý?',
                function() {
                    $(form).data('confirmed', true);
                    form.submit();
                }
            );
        });

        function validateFilterDates() {
            const fromDate = document.getElementById('filterFromDate').value;
            const textToDate = document.getElementById('filterToDate').value;

            if (fromDate && textToDate && fromDate > textToDate) {
                showToast('Từ ngày không được lớn hơn Đến ngày!', 'warning');
                return;
            }
            document.getElementById('filterForm').submit();
        }

        function validateModalDates() {
            const startDateInput = document.getElementById('modalStartDate');
            const endDateInput = document.getElementById('modalEndDate');
            
            if (startDateInput && endDateInput && startDateInput.value && endDateInput.value) {
                if (startDateInput.value > endDateInput.value) {
                    endDateInput.value = startDateInput.value;
                }
                endDateInput.min = startDateInput.value;
            }
        }
        
        const createLeaveModal = document.getElementById('createLeaveModal');
        if (createLeaveModal) {
            createLeaveModal.addEventListener('show.bs.modal', function () {
                validateModalDates();
            });
        }
    </script>
}

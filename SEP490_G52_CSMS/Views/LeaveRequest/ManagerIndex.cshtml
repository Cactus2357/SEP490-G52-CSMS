@model SEP490_G52_CSMS.Models.ViewModels.ManagerLeaveRequestListViewModel

@{
    ViewData["Title"] = "QUẢN LÝ NGHỈ PHÉP";
}

<div class="container-fluid mt-3 px-4 pb-5">
    <!-- Header Title -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark m-0">QUẢN LÝ NGHỈ PHÉP</h2>
    </div>

    <!-- Filter Card Container -->
    <div class="card shadow-sm border-0 rounded-3 mb-4 bg-body-tertiary">
        <div class="card-body p-4">
            <form method="get" asp-action="ManagerIndex" id="leaveManagerFilterForm">
                
                <!-- Search Employee Name Input -->
                <div class="mb-4">
                    <label for="searchNameInput" class="form-label fw-bold text-dark">Tìm kiếm theo tên nhân viên</label>
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute text-muted" style="left: 14px; top: 12px;"></i>
                        <input type="text" id="searchNameInput" name="searchName" value="@Model.SearchName" class="form-control rounded-pill ps-5 pe-5 py-2" placeholder="search" autocomplete="off" />
                        @if (!string.IsNullOrWhiteSpace(Model.SearchName))
                        {
                            <button type="button" class="btn btn-link text-muted position-absolute end-0 top-0 text-decoration-none pe-3 pt-2" onclick="clearSearchInput()">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>
                </div>

                <!-- Date Range & Status Filter Pills Block -->
                <div class="card border border-secondary-subtle rounded-3 p-3 bg-white shadow-sm">
                    <div class="fw-bold text-dark mb-3 fs-6">Lọc yêu cầu</div>

                    <div class="row g-3 align-items-center mb-3">
                        <div class="col-md-5 col-sm-6">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-event"></i></span>
                                <input type="date" id="fromDateInput" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control border-start-0" onchange="validateAndSubmitDates()" />
                            </div>
                        </div>
                        <div class="col-md-5 col-sm-6">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-event"></i></span>
                                <input type="date" id="toDateInput" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control border-start-0" onchange="validateAndSubmitDates()" />
                            </div>
                        </div>
                    </div>

                    <!-- Status Filter Radio Button Pills -->
                    <div class="d-flex flex-wrap gap-2 pt-2">
                        <input type="hidden" name="status" id="statusFilterValue" value="@Model.Status" />

                        <button type="button" class="btn btn-sm rounded-pill px-4 fw-bold @(Model.Status == "Tất cả" ? "btn-dark" : "btn-outline-secondary")" onclick="setStatusFilter('Tất cả')">
                            Tất cả
                        </button>
                        <button type="button" class="btn btn-sm rounded-pill px-4 fw-bold @(Model.Status == "Chờ duyệt" ? "btn-warning text-dark" : "btn-outline-secondary")" onclick="setStatusFilter('Chờ duyệt')">
                            Chờ duyệt
                        </button>
                        <button type="button" class="btn btn-sm rounded-pill px-4 fw-bold @(Model.Status == "Đã duyệt" ? "btn-success text-white" : "btn-outline-secondary")" onclick="setStatusFilter('Đã duyệt')">
                            Đã duyệt
                        </button>
                        <button type="button" class="btn btn-sm rounded-pill px-4 fw-bold @(Model.Status == "Từ chối" ? "btn-danger text-white" : "btn-outline-secondary")" onclick="setStatusFilter('Từ chối')">
                            Từ chối
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>

    <!-- Results Summary Count -->
    <div class="d-flex justify-content-between align-items-center mb-3 px-1">
        <span class="fw-bold text-dark fs-6">Kết quả · @Model.TotalCount yêu cầu</span>
    </div>

    <!-- Leave Request List Items (UC47 Mockup List Grid) -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            @if (!Model.Items.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary-subtle"></i>
                    <div>Không tìm thấy yêu cầu nghỉ phép nào phù hợp với bộ lọc.</div>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.Items)
                    {
                        <div class="list-group-item list-group-item-action p-3 d-flex align-items-center justify-content-between border-bottom cursor-pointer leave-request-row"
                             onclick="openLeaveDetailModal(@item.ApplicationId)">
                            
                            <div class="d-flex align-items-center gap-3">
                                <!-- Employee Initials Avatar -->
                                <div class="rounded-circle bg-dark text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm"
                                     style="width: 48px; height: 48px; font-size: 1.1rem; border: 2px solid #343a40;">
                                    @item.EmployeeInitials
                                </div>

                                <!-- Leave Details Text -->
                                <div>
                                    <div class="fw-bold text-dark fs-6">@item.EmployeeFullName</div>
                                    <div class="text-muted small mt-0.5">
                                        <span>@item.RequestDateStr</span> · <span>@item.ShiftName</span> · <span>@item.Reason</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Status Pill & Chevron -->
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge @item.StatusBadgeClass rounded-pill px-3 py-1.5 fs-7 fw-bold">
                                    @item.Status
                                </span>
                                <i class="bi bi-chevron-right text-secondary fs-5"></i>
                            </div>

                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Container for UC48 Detail & Decision View -->
<div id="leaveDetailModalContainer"></div>

@section Scripts {
    <script>
        function clearSearchInput() {
            document.getElementById('searchNameInput').value = '';
            document.getElementById('leaveManagerFilterForm').submit();
        }

        function setStatusFilter(statusVal) {
            document.getElementById('statusFilterValue').value = statusVal;
            document.getElementById('leaveManagerFilterForm').submit();
        }

        function validateAndSubmitDates() {
            var fromVal = document.getElementById('fromDateInput').value;
            var toVal = document.getElementById('toDateInput').value;

            if (fromVal && toVal && fromVal > toVal) {
                showToast("Ngày bắt đầu (Từ ngày) không được lớn hơn ngày kết thúc (Đến ngày).", "danger");
                return;
            }

            document.getElementById('leaveManagerFilterForm').submit();
        }

        function openLeaveDetailModal(applicationId) {
            $.ajax({
                url: '/LeaveRequest/GetDetailModal/' + applicationId,
                type: 'GET',
                success: function (htmlData) {
                    $('#leaveDetailModalContainer').html(htmlData);
                    var modalEl = document.getElementById('leaveDetailModal');
                    if (modalEl) {
                        var modal = new bootstrap.Modal(modalEl);
                        modal.show();
                    }
                },
                error: function (err) {
                    showToast("Không thể tải thông tin chi tiết đơn xin nghỉ.", "danger");
                }
            });
        }
    </script>
}

@model SEP490_G52_CSMS.Models.ViewModels.LeaveRequestDetailViewModel

<div class="modal fade" id="leaveDetailModal" tabindex="-1" aria-labelledby="leaveDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">
            
            <!-- Warehouse Template: Dark Header -->
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="leaveDetailModalLabel">
                    <i class="bi bi-calendar-check me-2"></i>ĐƠN XIN NGHỈ PHÉP - @Model.EmployeeFullName.ToUpper()
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                
                <!-- Employee Summary Card (Item 3 & 4) -->
                <div class="card border border-secondary-subtle rounded-3 p-3 mb-3 bg-white shadow-sm">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-dark text-white fw-bold d-flex align-items-center justify-content-center shadow-sm flex-shrink-0"
                                 style="width: 50px; height: 50px; font-size: 1.15rem; border: 2px solid #212529;">
                                @Model.EmployeeInitials
                            </div>
                            <div>
                                <div class="fw-bold text-dark fs-6">@Model.EmployeeFullName</div>
                                <div class="text-muted small">@Model.EmployeeRole · Tên đăng nhập: @Model.EmployeeUsername · Mã: NV#@Model.EmployeeId</div>
                            </div>
                        </div>
                        <span class="badge @Model.StatusBadgeClass rounded-pill px-3 py-1.5 fs-7 fw-bold">
                            @Model.Status
                        </span>
                    </div>
                </div>

                <!-- Request Core Details Block (Item 5, 6, 7, 8) -->
                <div class="card border border-secondary-subtle rounded-3 p-3 mb-3 bg-light shadow-sm" style="border-style: dashed !important; border-width: 2px !important;">
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary-subtle">
                        <span class="text-muted fw-semibold small">Ngày nghỉ</span>
                        <span class="fw-bold text-dark">@Model.RequestDateStr</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary-subtle">
                        <span class="text-muted fw-semibold small">Ca nghỉ</span>
                        <span class="fw-bold text-dark">@Model.ShiftDetails</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-start py-2 border-bottom border-secondary-subtle">
                        <span class="text-muted fw-semibold small me-3">Lý do nghỉ</span>
                        <span class="fw-semibold text-dark text-end">@Model.Reason</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted fw-semibold small">Thời gian gửi</span>
                        <span class="text-secondary small fw-bold">@Model.SubmittedAtStr</span>
                    </div>
                </div>

                <!-- Leave History Stats Container (Item 9) -->
                <div class="card border border-secondary-subtle rounded-3 p-3 mb-3 bg-white shadow-sm" style="border-style: dashed !important; border-width: 2px !important;">
                    <div class="fw-bold text-dark mb-2 fs-6"><i class="bi bi-clock-history me-1"></i>Lịch sử nghỉ phép (tháng @Model.CurrentMonth)</div>
                    
                    <div class="d-flex justify-content-between align-items-center py-1.5 border-bottom border-secondary-subtle">
                        <span class="text-muted small">Đã nghỉ</span>
                        <span class="fw-bold text-dark">@Model.TakenShiftsMonth ca</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-1.5 border-bottom border-secondary-subtle">
                        <span class="text-muted small">Đang chờ duyệt</span>
                        <span class="fw-bold text-warning-emphasis">@Model.PendingShiftsMonth ca</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-1.5 pt-2">
                        <span class="text-muted small">Tổng ca tháng</span>
                        <span class="fw-bold text-primary">@Model.TotalShiftsMonth ca</span>
                    </div>
                </div>

                <!-- Shift Warning Banner (Item 10) -->
                @if (Model.HasShiftWarning)
                {
                    <div class="alert alert-warning border border-warning-subtle rounded-3 p-3 mb-0 d-flex align-items-start gap-3 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-4 text-warning flex-shrink-0 mt-0.5"></i>
                        <div>
                            <div class="fw-bold text-dark fs-6">Lưu ý lịch ca</div>
                            <div class="small text-dark mt-0.5">@Model.ShiftWarningMessage</div>
                        </div>
                    </div>
                }

            </div>

            <!-- Warehouse Template: Action Footer -->
            <div class="modal-footer bg-light px-4 py-3">
                <button type="button" class="btn btn-secondary fw-bold px-3" data-bs-dismiss="modal">Đóng</button>
                @if (Model.CanProcess)
                {
                    <button type="button" class="btn btn-danger fw-bold px-4" onclick="processRejectLeave(@Model.ApplicationId)">
                        <i class="bi bi-x-circle me-1"></i>Từ chối
                    </button>
                    <button type="button" class="btn btn-primary fw-bold px-4" onclick="processApproveLeave(@Model.ApplicationId)">
                        <i class="bi bi-check-circle me-1"></i>Phê duyệt
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function processApproveLeave(appId) {
        showConfirmModal(
            'Phê duyệt đơn xin nghỉ',
            'Xác nhận <strong>Phê duyệt</strong> đơn xin nghỉ phép này? Ca làm việc tương ứng sẽ tự động bỏ phân công.',
            function() {
                $.ajax({
                    url: '/LeaveRequest/Approve/' + appId,
                    type: 'POST',
                    success: function(res) {
                        if (res.success) {
                            var modalEl = document.getElementById('leaveDetailModal');
                            var modal = bootstrap.Modal.getInstance(modalEl);
                            if (modal) modal.hide();
                            
                            showToast(res.message || 'Đã phê duyệt thành công!', 'success');
                            setTimeout(function() {
                                window.location.reload();
                            }, 800);
                        } else {
                            showToast(res.message || 'Thao tác không thành công.', 'danger');
                        }
                    },
                    error: function(err) {
                        showToast('Có lỗi xảy ra khi xử lý phê duyệt.', 'danger');
                    }
                });
            }
        );
    }

    function processRejectLeave(appId) {
        showConfirmModal(
            'Từ chối đơn xin nghỉ',
            'Xác nhận <strong>Từ chối</strong> đơn xin nghỉ phép này?',
            function() {
                $.ajax({
                    url: '/LeaveRequest/Reject/' + appId,
                    type: 'POST',
                    success: function(res) {
                        if (res.success) {
                            var modalEl = document.getElementById('leaveDetailModal');
                            var modal = bootstrap.Modal.getInstance(modalEl);
                            if (modal) modal.hide();

                            showToast(res.message || 'Đã từ chối đơn xin nghỉ phép.', 'warning');
                            setTimeout(function() {
                                window.location.reload();
                            }, 800);
                        } else {
                            showToast(res.message || 'Thao tác không thành công.', 'danger');
                        }
                    },
                    error: function(err) {
                        showToast('Có lỗi xảy ra khi xử lý từ chối.', 'danger');
                    }
                });
            }
        );
    }
</script>

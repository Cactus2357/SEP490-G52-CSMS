        function closeManagerUpdate() {
            if (updateModalInstance) {
                updateModalInstance.hide();
            }
        }

        /* ---------- Detail / Update helper functions ---------- */
        function dtlSwitchTab(panelName, btn) {
            document.querySelectorAll('.dtl-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.dtl-panel').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('dtl-panel-' + panelName).classList.add('active');
        }

        function updSwitchTab(panelName, btn) {
            document.querySelectorAll('.upd-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.upd-panel').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('upd-panel-' + panelName).classList.add('active');
        }

        const UPD_MAX_SIZE = 5 * 1024 * 1024; // 5 MB
        const UPD_IMG_EXTS = ['jpg', 'jpeg', 'png'];
        const UPD_ALLOWED  = ['jpg', 'jpeg', 'pdf'];

        function updHandleFile(input, key) {
            if (!input.files || !input.files[0]) return;
            const file = input.files[0];
            const ext  = file.name.split('.').pop().toLowerCase();

            if (!UPD_ALLOWED.includes(ext)) {
                showToast('File phải có định dạng .pdf hoặc .jpg', 'warning');
                input.value = '';
                return;
            }
            if (file.size > UPD_MAX_SIZE) {
                showToast('Dung lượng file không được vượt quá 5 MB', 'warning');
                input.value = '';
                return;
            }

            const isImage = UPD_IMG_EXTS.includes(ext);

            const oldBox     = document.getElementById(key + '-old-box');
            const newBox     = document.getElementById(key + '-new-box');
            const newContent = document.getElementById(key + '-new-content');
            const zoneWrap   = document.getElementById(key + '-zone');
            const previewRow = document.getElementById(key + '-preview-row');

            if (oldBox) {
                newBox.style.display = 'block';
                if (isImage) {
                    const reader = new FileReader();
                    reader.onload = e => {
                        newContent.innerHTML =
                            `<img src="${e.target.result}" alt="Ảnh mới"
                                  class="upd-preview-img"
                                  onclick="document.getElementById('update${cap(key)}File').click()"
                                  title="Nhấn để đổi lại" />`;
                    };
                    reader.readAsDataURL(file);
                } else {
                    newContent.innerHTML =
                        `<div class="upd-preview-pdf" onclick="document.getElementById('update${cap(key)}File').click()">
                            <i class="bi bi-file-earmark-pdf-fill"></i>
                            <span>${file.name}</span>
                         </div>`;
                }
            } else {
                if (zoneWrap) zoneWrap.style.display = 'none';
                previewRow.style.display = 'flex';
                if (isImage) {
                    const reader = new FileReader();
                    reader.onload = e => {
                        previewRow.innerHTML =
                            `<div class="upd-preview-box">
                                <div class="upd-preview-label">Đã tải lên</div>
                                <img src="${e.target.result}" alt="Ảnh mới"
                                     class="upd-preview-img"
                                     onclick="document.getElementById('update${cap(key)}File').click()"
                                     title="Nhấn để thay ảnh" />
                                <div class="upd-preview-change-hint">Nhấn vào ảnh để thay mới</div>
                             </div>`;
                    };
                    reader.readAsDataURL(file);
                } else {
                    previewRow.innerHTML =
                        `<div class="upd-preview-box">
                            <div class="upd-preview-label">Đã tải lên</div>
                            <div class="upd-preview-pdf" style="cursor:pointer;"
                                 onclick="document.getElementById('update${cap(key)}File').click()"
                                 title="Nhấn để thay file">
                                <i class="bi bi-file-earmark-pdf-fill"></i>
                                <span>${file.name}</span>
                            </div>
                            <div class="upd-preview-change-hint">Nhấn để thay file mới</div>
                         </div>`;
                }
            }
        }

        function cap(str) {
            return str.charAt(0).toUpperCase() + str.slice(1);
        }

        async function submitManagerUpdate(employeeId) {
            const form = document.getElementById('updateManagerForm');
            const errorAlert = document.getElementById('updateErrorAlert');
            if (errorAlert) errorAlert.style.display = 'none';

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            // Validations
            const fullName = document.getElementById('updateFullName').value.trim();
            if (!fullName) {
                showUpdateError(errorAlert, 'Họ và tên là bắt buộc.');
                return;
            }

            const email = document.getElementById('updateEmail').value.trim();
            if (!/\S+@@\S+\.\S+/.test(email)) {
                showUpdateError(errorAlert, 'Email không đúng định dạng.');
                return;
            }

            const phone = document.getElementById('updatePhoneNumber').value.trim();
            if (!phone) {
                showUpdateError(errorAlert, 'Số điện thoại là bắt buộc.');
                return;
            }

            const dob = document.getElementById('updateDateOfBirth').value;
            if (!dob) {
                showUpdateError(errorAlert, 'Ngày sinh là bắt buộc.');
                return;
            }

            const address = document.getElementById('updateAddress').value.trim();
            if (!address) {
                showUpdateError(errorAlert, 'Địa chỉ là bắt buộc.');
                return;
            }

            const citizenId = document.getElementById('updateCitizenId').value.trim();
            if (citizenId.length !== 12 || !/^\d+$/.test(citizenId)) {
                showUpdateError(errorAlert, 'Số CCCD phải chứa chính xác 12 chữ số.');
                return;
            }

            const branchId = document.getElementById('updateBranchId').value;
            if (!branchId) {
                showUpdateError(errorAlert, 'Chi nhánh là bắt buộc.');
                return;
            }

            const btnSubmit = document.getElementById('btnSubmitManagerUpdate');
            const spinner   = document.getElementById('updateManagerSpinner');
            btnSubmit.disabled = true;
            spinner.classList.remove('d-none');

            const formData = new FormData(form);

            try {
                const response = await fetch(`/BranchManager/Update/${employeeId}`, {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    closeManagerUpdate();
                    showSuccessToast('Cập nhật thông tin quản lý thành công!');
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    showUpdateError(errorAlert, result.errorMessage || 'Có lỗi xảy ra khi cập nhật thông tin.');
                }
            } catch (err) {
                console.error(err);
                showUpdateError(errorAlert, 'Không thể kết nối đến máy chủ. Vui lòng thử lại.');
            } finally {
                btnSubmit.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        function showUpdateError(alertEl, msg) {
            if (!alertEl) return;
            alertEl.textContent = msg;
            alertEl.style.display = 'block';
            alertEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function showSuccessToast(msg) {
            let toast = document.getElementById('csms-success-toast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'csms-success-toast';
                toast.style.cssText = `
                    position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%);
                    background: #111827; color: #fff; padding: 12px 28px;
                    border-radius: 10px; font-size: 0.9rem; font-weight: 600;
                    font-family: var(--bs-body-font-family); z-index: 99999;
                    box-shadow: 0 8px 24px rgba(0,0,0,0.22);
                    animation: fadeInUp 0.25s ease;
                `;
                const style = document.createElement('style');
                style.textContent = '@@keyframes fadeInUp { from { opacity:0; transform: translateX(-50%) translateY(12px); } to { opacity:1; transform: translateX(-50%) translateY(0); } }';
                document.head.appendChild(style);
                document.body.appendChild(toast);
            }
            toast.textContent = '✓  ' + msg;
            toast.style.display = 'block';
            setTimeout(() => { toast.style.display = 'none'; }, 2000);
        }

        /* ---------- Deactivation handling ---------- */
        let deactModalInstance = null;
        let currentDeactEmployeeId = null;

        async function triggerDeactivationCheck(employeeId) {
            currentDeactEmployeeId = employeeId;
            
            // Reset modal fields
            document.getElementById('deactBranchesWarning').classList.add('d-none');
            document.getElementById('deactWarningBanner').classList.add('d-none');
            document.getElementById('deactShiftsSection').classList.add('d-none');
            document.getElementById('deactReason').value = "";
            document.getElementById('deactNotes').value = "";
            document.getElementById('deactConfirmBtn').disabled = false;
            
            try {
                const response = await fetch(`/BranchManager/CheckDeactivation/${employeeId}`);
                if (!response.ok) {
                    showToast('Lỗi tải dữ liệu kiểm tra.', 'danger');
                    return;
                }
                
                const result = await response.json();
                if (!result.success) {
                    showToast(result.errorMessage, 'danger');
                    return;
                }
                
                // Set employee info
                document.getElementById('deactFullName').textContent = result.fullName;
                document.getElementById('deactUsername').textContent = '@@' + result.username;
                
                // Set avatar initials
                let initials = "BM";
                if (result.fullName) {
                    const parts = result.fullName.split(' ');
                    if (parts.length >= 2) initials = (parts[0][0] + parts[parts.length-1][0]).toUpperCase();
                    else if (parts.length === 1) initials = parts[0].substring(0, 2).toUpperCase();
                }
                document.getElementById('deactAvatar').textContent = initials;
                
                // Managed branches warning
                if (result.managedBranches && result.managedBranches.length > 0) {
                    document.getElementById('deactBranchesWarning').classList.remove('d-none');
                    document.getElementById('deactBranchesText').textContent = `Quản lý này đang phụ trách chi nhánh: ${result.managedBranches.join(', ')}`;
                }

                // Render warning & shifts if there are uncompleted shifts
                if (!result.canDeactivate && result.uncompletedShifts && result.uncompletedShifts.length > 0) {
                    document.getElementById('deactWarningBanner').classList.remove('d-none');
                    document.getElementById('deactWarningText').textContent = `Có ${result.uncompletedShifts.length} ca làm việc chưa hoàn thành. Cần hoàn tất trước khi ngừng hoạt động.`;
                    
                    const container = document.getElementById('deactShiftsContainer');
                    container.innerHTML = "";
                    result.uncompletedShifts.forEach(shift => {
                        const row = document.createElement('div');
                        row.className = "d-flex justify-content-between py-2 border-bottom";
                        row.style.borderBottomStyle = "dashed";
                        row.style.borderBottomWidth = "1px";
                        row.innerHTML = `
                            <div class="fw-bold">${shift.date} - ${shift.shiftName}</div>
                            <div class="text-danger fw-bold">${shift.status}</div>
                        `;
                        container.appendChild(row);
                    });
                    
                    // Remove last border bottom
                    if (container.lastChild) {
                        container.lastChild.style.borderBottom = "none";
                    }
                    
                    document.getElementById('deactShiftsSection').classList.remove('d-none');
                    // Lock / disable confirm button
                    document.getElementById('deactConfirmBtn').disabled = true;
                }
                
                // Show modal
                if (!deactModalInstance) {
                    deactModalInstance = new bootstrap.Modal(document.getElementById('deactivateManagerModal'));
                }
                deactModalInstance.show();
                
            } catch(err) {
                console.error(err);
                showToast('Không thể kết nối máy chủ.', 'danger');
            }
        }

        async function confirmDeactivation() {
            if (!currentDeactEmployeeId) return;
            
            const reason = document.getElementById('deactReason').value;
            const notes = document.getElementById('deactNotes').value.trim();
            
            if (!reason) {
                showToast('Vui lòng chọn lý do ngừng hoạt động.', 'warning');
                return;
            }
            
            const btn = document.getElementById('deactConfirmBtn');
            btn.disabled = true;
            
            try {
                const response = await fetch('/BranchManager/Deactivate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ employeeId: currentDeactEmployeeId, reason: reason, notes: notes })
                });
                const result = await response.json();
                
                if (response.ok && result.success) {
                    deactModalInstance.hide();
                    showSuccessToast('Đã chuyển tài khoản sang trạng thái ngừng hoạt động.');
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    showToast(result.errorMessage || 'Lỗi vô hiệu hóa tài khoản.', 'danger');
                    btn.disabled = false;
                }
            } catch(err) {
                console.error(err);
                showToast('Không thể kết nối máy chủ.', 'danger');
                btn.disabled = false;
            }
        }


        /* ================= Create Manager Modal (2-step wizard) ================= */
        let mgrCurrentStep = 1;

        function mgrResetModal() {
            mgrCurrentStep = 1;
            document.getElementById('mgrStep1').classList.add('active');
            document.getElementById('mgrStep2').classList.remove('active');
            document.getElementById('createManagerModalLabel').textContent = 'Thông tin quản lý';
            document.getElementById('mgrPrimaryBtn').textContent = 'Tạo tài khoản';
            document.getElementById('mgrFormAlert').classList.add('d-none');
            document.getElementById('mgrFullName').value = '';
            document.getElementById('mgrEmail').value = '';
            document.getElementById('mgrBranch').value = '';
            document.getElementById('mgrUsername').value = '';
            document.getElementById('mgrPassword').value = '';
            ['mgrFullNameError', 'mgrEmailError', 'mgrBranchError'].forEach(id => {
                document.getElementById(id).style.display = 'none';
            });
        }

        document.getElementById('createManagerModal').addEventListener('show.bs.modal', mgrResetModal);

        function mgrShowAlert(message) {
            const alertBox = document.getElementById('mgrFormAlert');
            alertBox.textContent = message;
            alertBox.classList.remove('d-none');
        }

        function mgrGoBack() {
            if (mgrCurrentStep === 2) {
                document.getElementById('mgrStep2').classList.remove('active');
                document.getElementById('mgrStep1').classList.add('active');
                document.getElementById('createManagerModalLabel').textContent = 'Thông tin quản lý';
                document.getElementById('mgrFormAlert').classList.add('d-none');
                mgrCurrentStep = 1;
            } else {
                bootstrap.Modal.getInstance(document.getElementById('createManagerModal')).hide();
            }
        }

        function mgrValidateStep1() {
            const fullName = document.getElementById('mgrFullName').value.trim();
            const email = document.getElementById('mgrEmail').value.trim();
            const branchId = document.getElementById('mgrBranch').value;
            let valid = true;

            document.getElementById('mgrFullNameError').style.display = fullName ? 'none' : 'block';
            document.getElementById('mgrEmailError').style.display = /\S+@@\S+\.\S+/.test(email) ? 'none' : 'block';
            document.getElementById('mgrBranchError').style.display = branchId ? 'none' : 'block';

            if (!fullName) valid = false;
            if (!/\S+@@\S+\.\S+/.test(email)) valid = false;
            if (!branchId) valid = false;

            return valid;
        }

        async function mgrPrimaryAction() {
            document.getElementById('mgrFormAlert').classList.add('d-none');

            if (mgrCurrentStep === 1) {
                if (!mgrValidateStep1()) return;

                const fullName = document.getElementById('mgrFullName').value.trim();
                const email = document.getElementById('mgrEmail').value.trim();
                const btn = document.getElementById('mgrPrimaryBtn');
                btn.disabled = true;

                try {
                    const response = await fetch('/BranchManager/GenerateAccount', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ fullName: fullName, email: email })
                    });
                    const result = await response.json();

                    if (!result.success) {
                        mgrShowAlert(result.errorMessage || 'Đã xảy ra lỗi. Vui lòng thử lại.');
                        btn.disabled = false;
                        return;
                    }

                    document.getElementById('mgrUsername').value = result.username;
                    document.getElementById('mgrPassword').value = result.password;

                    document.getElementById('mgrStep1').classList.remove('active');
                    document.getElementById('mgrStep2').classList.add('active');
                    document.getElementById('createManagerModalLabel').textContent = 'Tạo tài khoản quản lý';
                    mgrCurrentStep = 2;
                } catch (err) {
                    console.error(err);
                    mgrShowAlert('Không thể kết nối máy chủ.');
                } finally {
                    btn.disabled = false;
                }
            } else {
                const btn = document.getElementById('mgrPrimaryBtn');
                btn.disabled = true;

                const payload = {
                    fullName: document.getElementById('mgrFullName').value.trim(),
                    email: document.getElementById('mgrEmail').value.trim(),
                    branchId: document.getElementById('mgrBranch').value,
                    username: document.getElementById('mgrUsername').value,
                    password: document.getElementById('mgrPassword').value
                };

                try {
                    const response = await fetch('/BranchManager/CreateAccount', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const result = await response.json();

                    if (!result.success) {
                        mgrShowAlert(result.errorMessage || 'Đã xảy ra lỗi. Vui lòng thử lại.');
                        btn.disabled = false;
                        return;
                    }

                    bootstrap.Modal.getInstance(document.getElementById('createManagerModal')).hide();
                    window.location.reload();
                } catch (err) {
                    console.error(err);
                    mgrShowAlert('Không thể kết nối máy chủ.');
                    btn.disabled = false;
                }
            }
        }
    </script>
}

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Trang không tìm thấy";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card shadow-lg p-5 border-0 text-center" style="max-width: 480px; border-radius: 8px;">
        <div class="mb-4 text-warning">
            <i class="bi bi-exclamation-triangle" style="font-size: 4rem;"></i>
        </div>
        <h2 class="fw-bold text-dark mb-3">404 - KHÔNG TÌM THẤY</h2>
        <p class="text-secondary mb-4" style="line-height: 1.6;">
            Trang bạn đang tìm kiếm không tồn tại hoặc đã bị di chuyển.
        </p>
        <div class="d-grid gap-2">
            <a href="/" class="btn btn-outline-dark py-2" style="border-radius: 4px; font-weight: 600;">
                Quay lại trang chủ
            </a>
        </div>
    </div>
</div>

@model SEP490_G52_CSMS.Models.ViewModels.BranchDetailViewModel

@{
    ViewData["Title"] = "Chi tiết chi nhánh";
}

<div class="branch-page">
    <aside class="branch-sidebar">
        <div class="sidebar-brand">LOGO</div>
        <div class="sidebar-menu">
            <a class="sidebar-link" asp-controller="Branch" asp-action="Index">Quản lý chi nhánh</a>
            <a class="sidebar-link" href="#">Quản lý danh mục</a>
            <a class="sidebar-link" href="#">Quản lý sản phẩm</a>
            <a class="sidebar-link" href="#">Báo cáo doanh thu</a>
            <a class="sidebar-link" href="#">Xuất báo cáo</a>
        </div>
    </aside>

    <section class="branch-main">
        <div class="branch-header stretch">
            <div>
                <h2 class="page-title">CHI TIẾT CHI NHÁNH: @Model.BranchName</h2>
                <p class="text-muted">Mã chi nhánh: @Model.BranchId</p>
            </div>
            <div class="header-actions">
                <span class="status-chip @Model.Status.ToLower()">Trạng thái: @Model.Status</span>
                <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.BranchId">Sửa thông tin</a>
                <a class="btn btn-outline-secondary" asp-action="AssignManager" asp-route-id="@Model.BranchId">Thay đổi quản lý</a>
                <a class="btn btn-danger" asp-action="Deactivate" asp-route-id="@Model.BranchId">Ngừng hoạt động chi nhánh</a>
            </div>
        </div>

        <div class="card section-card mb-4">
            <div class="card-body">
                <div class="row gx-4 gy-3">
                    <div class="col-md-6">
                        <h5>Thông tin chung</h5>
                        <p><strong>Mã CB:</strong> @Model.BranchId</p>
                        <p><strong>Tên chi nhánh:</strong> @Model.BranchName</p>
                        <p><strong>Địa chỉ:</strong> @Model.Address</p>
                        <p><strong>Điện thoại:</strong> @Model.PhoneNumber</p>
                        <p><strong>Email:</strong> @Model.Email</p>
                    </div>
                    <div class="col-md-6">
                        <h5>Thông tin vận hành</h5>
                        <p><strong>Giờ mở cửa:</strong> @Model.OpeningTime</p>
                        <p><strong>Giờ đóng cửa:</strong> @Model.ClosingTime</p>
                        <div class="detail-manager-card mt-4 p-3 border rounded">
                            <h6>QUẢN LÝ CHI NHÁNH</h6>
                            <p><strong>Hiện tại:</strong> @Model.ManagerName (@Model.ManagerCode)</p>
                            <p><strong>Ngày bổ nhiệm:</strong> @Model.ManagerAssignedDate</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

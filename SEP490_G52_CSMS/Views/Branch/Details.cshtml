@model SEP490_G52_CSMS.Models.ViewModels.BranchDetailViewModel

@{
    ViewData["Title"] = "Chi tiết chi nhánh";
}

<div class="container-fluid px-4 pt-3">



    <section class="branch-main">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="page-title mb-0">CHI TIẾT CHI NHÁNH: @Model.BranchName.ToUpper()</h2>
            <span class="fs-5 fw-semibold">Trạng thái: @Model.Status</span>
        </div>

        <!-- Thông tin chi nhánh (dạng bảng như ảnh) -->
        <div class="border border-dark p-4 mb-4 bg-white" style="border-width: 2px !important;">
            <div class="row mb-3">
                <div class="col-4 fw-bold">MÃ CHI NHÁNH:</div>
                <div class="col-8">@Model.BranchId</div>
            </div>
            <div class="row mb-3">
                <div class="col-4 fw-bold">Địa chỉ:</div>
                <div class="col-8">@Model.Address</div>
            </div>
            <div class="row mb-3">
                <div class="col-4 fw-bold">Điện thoại:</div>
                <div class="col-4">@Model.PhoneNumber</div>
                <div class="col-2 fw-bold">Email:</div>
                <div class="col-2">@Model.Email</div>
            </div>
            <div class="row">
                <div class="col-4 fw-bold">Giờ mở cửa:</div>
                <div class="col-8">@Model.OpeningTime - @Model.ClosingTime hàng ngày</div>
            </div>
        </div>

        <!-- Quản lý chi nhánh -->
        <div class="border border-dark p-4 mb-4 bg-white" style="border-width: 2px !important;">
            <div class="fw-bold text-uppercase mb-3">— QUẢN LÝ CHI NHÁNH</div>
            <div class="row mb-2">
                <div class="col-4 fw-semibold">Hiện tại:</div>
                <div class="col-8">@Model.ManagerName (Mã NV: @Model.ManagerCode)</div>
            </div>
            <div class="row">
                <div class="col-4 fw-semibold">Ngày bổ nhiệm:</div>
                <div class="col-8">@Model.ManagerAssignedDate</div>
            </div>
        </div>

        <!-- Action buttons -->
        <div class="d-flex gap-3 flex-wrap">
            <a class="btn btn-outline-dark fw-bold px-4" style="border-width: 2px;"
               asp-action="Edit" asp-route-id="@Model.BranchId">Sửa thông tin</a>

            <button type="button" class="btn btn-outline-dark fw-bold px-4" style="border-width: 2px;"
                    data-bs-toggle="modal" data-bs-target="#assignManagerModal">Thay đổi quản lý</button>

            @if (Model.Status == "Active")
            {
                <button type="button" class="btn btn-outline-danger fw-bold px-4" style="border-width: 2px;"
                        data-bs-toggle="modal" data-bs-target="#deactivateModal">Ngừng hoạt động chi nhánh</button>
            }
            else
            {
                <form asp-action="ActivateConfirmed" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="branchId" value="@Model.BranchId" />
                    <button type="submit" class="btn btn-outline-success fw-bold px-4" style="border-width: 2px;">Kích hoạt chi nhánh</button>
                </form>
            }
        </div>
    </section>
</div>

<!-- ===== MODAL: Gán quản lý chi nhánh ===== -->
<div class="modal fade" id="assignManagerModal" tabindex="-1" aria-labelledby="assignManagerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border border-dark rounded-0" style="border-width: 2px !important;">
            <div class="modal-header border-bottom border-dark">
                <h5 class="modal-title fw-bold text-uppercase" id="assignManagerModalLabel">GÁN QUẢN LÝ CHI NHÁNH</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">Chi nhánh: @Model.BranchName (@Model.BranchId)</p>

                <label class="form-label fw-semibold">Tìm kiếm nhân viên hợp lệ</label>
                <input type="text" id="managerSearch" class="form-control mb-3"
                       placeholder="Nhập tên hoặc mã nhân viên..." oninput="filterManagers()" />

                <label class="form-label fw-semibold">Chọn từ danh sách đề xuất:</label>
                <form asp-action="AssignManager" method="post" id="assignManagerForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="BranchId" value="@Model.BranchId" />
                    <div id="managerList" class="border rounded p-2 mb-3" style="max-height: 200px; overflow-y: auto;">
                        @foreach (var m in Model.Managers)
                        {
                            var statusText = m.CurrentBranchName != null
                                ? $"Đang quản lý tại {m.CurrentBranchName}"
                                : "Đang rảnh (Chưa quản lý bên nào)";

                            <div class="manager-item d-flex align-items-center py-1 border-bottom"
                                 data-name="@m.ManagerName.ToLower()" data-code="@m.EmployeeCode.ToLower()">
                                <input type="radio" name="SelectedManagerId" value="@m.ManagerId"
                                       id="mgr_@m.ManagerId" class="form-check-input me-2 flex-shrink-0"
                                       @(m.ManagerId == Model.CurrentManagerId ? "checked" : "") />
                                <label for="mgr_@m.ManagerId" class="form-check-label mb-0" style="cursor:pointer;">
                                    @m.ManagerName (@m.EmployeeCode) - <span class="text-muted small">@statusText</span>
                                </label>
                            </div>
                        }
                        @if (!Model.Managers.Any())
                        {
                            <p class="text-muted text-center py-2 mb-0">Không có nhân viên quản lý nào.</p>
                        }
                    </div>
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-dark fw-bold px-4">Xác nhận gán</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ===== MODAL: Xác nhận ngừng hoạt động ===== -->
<div class="modal fade" id="deactivateModal" tabindex="-1" aria-labelledby="deactivateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border border-dark rounded-0" style="border-width: 2px !important;">
            <div class="modal-header border-bottom border-dark">
                <h5 class="modal-title fw-bold text-uppercase" id="deactivateModalLabel">XÁC NHẬN THAY ĐỔI TRẠNG THÁI</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-danger fw-bold">! CẢNH BÁO: Bạn đang yêu cầu NGỪNG HOẠT ĐỘNG chi nhánh:</p>
                <p class="fw-bold text-center fs-5">"@Model.BranchName (@Model.BranchId)"</p>
                <ul class="mt-3">
                    <li>Toàn bộ tài khoản nhân viên thuộc chi nhánh này sẽ không thể đăng nhập vào hệ thống POS/Bán hàng từ ngày mai.</li>
                    <li>Dữ liệu doanh thu cũ vẫn được bảo toàn.</li>
                </ul>
                <p class="mt-3">Bạn có chắc chắn muốn tiếp tục?</p>
            </div>
            <div class="modal-footer border-top border-dark">
                <form asp-action="DeactivateConfirmed" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="branchId" value="@Model.BranchId" />
                    <button type="submit" class="btn btn-danger fw-bold px-4">Đồng ý ngừng</button>
                </form>
                <button type="button" class="btn btn-outline-secondary fw-bold px-4" data-bs-dismiss="modal">Hủy bỏ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterManagers() {
            const query = document.getElementById('managerSearch').value.trim();
            document.querySelectorAll('.manager-item').forEach(item => {
                const name = item.dataset.name || '';
                const code = item.dataset.code || '';
                const matches = !query || (window.CSMSSearch ? window.CSMSSearch.fuzzyMatchAny(query, [name, code]) : (name.toLowerCase().includes(query.toLowerCase()) || code.toLowerCase().includes(query.toLowerCase())));
                item.style.display = matches ? '' : 'none';
            });
        }
    </script>
}

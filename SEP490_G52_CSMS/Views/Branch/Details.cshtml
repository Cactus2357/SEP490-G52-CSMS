@model SEP490_G52_CSMS.Models.ViewModels.BranchDetailViewModel

@{
    ViewData["Title"] = "Chi tiết chi nhánh";
}

<div class="branch-page">
    <aside class="branch-sidebar">
        <div class="sidebar-brand">LOGO</div>
        <div class="sidebar-menu">
            <a class="sidebar-link" asp-controller="Branch" asp-action="Index">Quản lý chi nhánh</a>
            <a class="sidebar-link" href="#">Quản lý danh mục</a>
            <a class="sidebar-link" href="#">Quản lý sản phẩm</a>
            <a class="sidebar-link" href="#">Báo cáo doanh thu</a>
            <a class="sidebar-link" href="#">Xuất báo cáo</a>
        </div>
    </aside>

    <section class="branch-main">
        <div class="branch-header stretch">
            <div>
                <h2 class="page-title">CHI TIẾT CHI NHÁNH: @Model.BranchName</h2>
                <p class="text-muted">Mã chi nhánh: @Model.BranchId</p>
            </div>
            <div class="header-actions">
                <span class="status-chip @Model.Status.ToLower()">Trạng thái: @Model.Status</span>
            </div>
        </div>

        <div class="card section-card mb-4">
            <div class="card-body">
                <div class="row gx-4 gy-3">
                    <div class="col-md-6">
                        <h5 class="section-title">Mã chi nhánh</h5>
                        <p class="mb-2"><strong>Chi nhánh:</strong> @Model.BranchId</p>
                        <h5 class="section-title mt-4">Địa chỉ</h5>
                        <p class="mb-2">@Model.Address</p>
                        <h5 class="section-title mt-4">Điện thoại</h5>
                        <p class="mb-2">@Model.PhoneNumber</p>
                        <h5 class="section-title mt-4">Email</h5>
                        <p class="mb-0">@Model.Email</p>
                    </div>
                    <div class="col-md-6">
                        <h5 class="section-title">Giờ mở cửa</h5>
                        <p class="mb-2">@Model.OpeningTime</p>
                        <h5 class="section-title mt-4">Giờ đóng cửa</h5>
                        <p class="mb-2">@Model.ClosingTime</p>
                        <div class="detail-manager-card mt-4 p-4 rounded">
                            <h6 class="manager-title">QUẢN LÝ CHI NHÁNH</h6>
                            <div class="detail-row">
                                <span>Hiện tại:</span>
                                <strong>@Model.ManagerName (@Model.ManagerCode)</strong>
                            </div>
                            <div class="detail-row">
                                <span>Ngày bổ nhiệm:</span>
                                <strong>@Model.ManagerAssignedDate</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="detail-actions mb-4">
            <a class="btn btn-secondary action-button" asp-action="Edit" asp-route-id="@Model.BranchId">Sửa thông tin</a>
            <a class="btn btn-outline-secondary action-button" asp-action="AssignManager" asp-route-id="@Model.BranchId">Thay đổi quản lý</a>
            <a class="btn btn-danger action-button" asp-action="Deactivate" asp-route-id="@Model.BranchId">Ngừng hoạt động chi nhánh</a>
        </div>
    </section>
</div>

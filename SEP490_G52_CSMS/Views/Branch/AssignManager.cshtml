@model SEP490_G52_CSMS.Models.ViewModels.BranchAssignManagerViewModel

@{
    ViewData["Title"] = "Gán quản lý chi nhánh";
}

<div class="container-fluid px-4 pt-3">
    <section class="branch-main">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="page-title">GÁN QUẢN LÝ CHI NHÁNH</h2>
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.BranchId">✕</a>
        </div>

        <div class="border border-dark p-4 bg-white mb-3" style="border-width: 2px !important; max-width: 520px;">
            <p class="fw-semibold mb-1">Chi nhánh: @Model.BranchName (@Model.BranchId)</p>
            <p class="text-muted small mb-0">Quản lý hiện tại: @Model.CurrentManagerName (@Model.CurrentManagerCode) — @Model.CurrentManagerAssignedDate</p>
        </div>

        <div class="border border-dark p-4 bg-white" style="border-width: 2px !important; max-width: 520px;">
            <label class="fw-semibold mb-2 d-block">Tìm kiếm nhân viên hợp lệ</label>
            <input type="text" id="managerSearch" class="form-control mb-3"
                   placeholder="Nhập tên hoặc mã nhân viên..." oninput="filterManagers()" />

            <label class="fw-semibold mb-2 d-block">Chọn từ danh sách đề xuất:</label>

            <form asp-action="AssignManager" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="BranchId" value="@Model.BranchId" />

                <div id="managerList" class="border border-secondary rounded p-2 mb-3"
                     style="max-height: 220px; overflow-y: auto;">
                    @foreach (var m in Model.Managers)
                    {
                        var statusText = m.CurrentBranchName != null
                            ? $"Đang quản lý tại {m.CurrentBranchName}"
                            : "Đang rảnh (Chưa quản lý bên nào)";

                        <div class="manager-item d-flex align-items-center py-1 border-bottom"
                             data-name="@m.ManagerName.ToLower()" data-code="@m.EmployeeCode.ToLower()">
                            <input type="radio" name="SelectedManagerId" value="@m.ManagerId"
                                   id="mgr_@m.ManagerId" class="form-check-input me-2 flex-shrink-0"
                                   @(m.ManagerId == Model.SelectedManagerId ? "checked" : "") />
                            <label for="mgr_@m.ManagerId" class="form-check-label mb-0" style="cursor:pointer;">
                                @m.ManagerName (@m.EmployeeCode) - <span class="text-muted small">@statusText</span>
                            </label>
                        </div>
                    }
                    @if (!Model.Managers.Any())
                    {
                        <p class="text-muted text-center py-2 mb-0">Không có nhân viên quản lý nào.</p>
                    }
                </div>

                <div class="d-flex gap-2 justify-content-end mt-2">
                    <a class="btn btn-outline-secondary px-4 fw-bold"
                       asp-action="Details" asp-route-id="@Model.BranchId">Hủy</a>
                    <button type="submit" class="btn btn-dark px-4 fw-bold">Xác nhận gán</button>
                </div>
            </form>
        </div>

    </section>
</div>

@section Scripts {
    <script>
        function filterManagers() {
            const query = document.getElementById('managerSearch').value.toLowerCase();
            document.querySelectorAll('.manager-item').forEach(item => {
                const name = item.dataset.name || '';
                const code = item.dataset.code || '';
                item.style.display = (name.includes(query) || code.includes(query)) ? '' : 'none';
            });
        }
    </script>
}

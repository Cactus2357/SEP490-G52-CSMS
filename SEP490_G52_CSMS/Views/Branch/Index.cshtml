@model SEP490_G52_CSMS.Models.ViewModels.BranchIndexViewModel

@{
    ViewData["Title"] = "Danh sách chi nhánh";
}

<div class="branch-page">
    <aside class="branch-sidebar">
        <div class="sidebar-brand">LOGO</div>
        <div class="sidebar-menu">
            <a class="sidebar-link active" asp-controller="Branch" asp-action="Index">Quản lý chi nhánh</a>
            <a class="sidebar-link" href="#">Quản lý danh mục</a>
            <a class="sidebar-link" href="#">Quản lý sản phẩm</a>
            <a class="sidebar-link" href="#">Báo cáo doanh thu</a>
            <a class="sidebar-link" href="#">Xuất báo cáo</a>
        </div>
    </aside>

    <section class="branch-main">
        <div class="branch-header stretch">
            <div>
                <h2 class="page-title">DANH SÁCH CÁC CHI NHÁNH</h2>
            </div>
            <div class="header-actions">
                <button class="btn btn-outline-secondary btn-icon" type="button">🔍</button>
                <button class="btn btn-outline-secondary btn-icon" type="button">🔔</button>
                <button class="btn btn-outline-secondary btn-icon" type="button">👤</button>
            </div>
        </div>

        <div class="branch-toolbar row gx-3 gy-3 align-items-center mb-4">
            <div class="col-md-6">
                <div class="input-group search-box">
                    <span class="input-group-text">🔎</span>
                    <input type="text" class="form-control" name="searchTerm" value="@Model.SearchTerm" form="searchForm" placeholder="Search: Tên, địa chỉ,..." />
                </div>
            </div>
            <div class="col-md-6 text-md-end">
                <a class="btn btn-primary" asp-controller="Branch" asp-action="Create">+ Thêm chi nhánh</a>
            </div>
        </div>

        <form id="searchForm" method="get" class="row gx-3 gy-3 mb-4 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Filter: Trạng thái</label>
                <select class="form-select" name="statusFilter">
                    @foreach (var option in Model.StatusOptions)
                    {
                        <option value="@option" selected="@(option == Model.StatusFilter)">@option</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Filter: Quản lý</label>
                <select class="form-select" name="managerId">
                    <option value="">Tất cả</option>
                    @foreach (var manager in Model.ManagerOptions)
                    {
                        <option value="@manager.ManagerId" selected="@(manager.ManagerId == Model.ManagerId)">@manager.ManagerName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-primary w-100" type="submit">Lọc</button>
            </div>
        </form>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <div class="summary-text mb-2">Đang hiển thị @Model.Branches.Count của @Model.TotalCount chi nhánh</div>

        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle branch-table">
                <thead class="table-light">
                    <tr>
                        <th>Mã CB</th>
                        <th>Tên chi nhánh</th>
                        <th>Địa chỉ</th>
                        <th>Quản lý</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Branches.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">Không có chi nhánh nào.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var branch in Model.Branches)
                        {
                            <tr>
                                <td>@branch.BranchId</td>
                                <td>@branch.BranchName</td>
                                <td>@branch.Address</td>
                                <td>@branch.ManagerName</td>
                                <td><span class="badge bg-@(branch.Status == "Active" ? "success" : "secondary")">@branch.Status</span></td>
                                <td class="text-end action-cell">
                                    <div class="action-buttons">
                                        <a class="btn btn-sm btn-outline-primary me-2" asp-action="Details" asp-route-id="@branch.BranchId">Chi tiết</a>
                                        <a class="btn btn-sm btn-outline-danger" asp-action="Deactivate" asp-route-id="@branch.BranchId">Ngừng hoạt động</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", "Branch", new { page = Model.PageIndex - 1, searchTerm = Model.SearchTerm, statusFilter = Model.StatusFilter, managerId = Model.ManagerId })">&lt; Trước</a>
                    </li>
                    @for (var pageIndex = 1; pageIndex <= Model.TotalPages; pageIndex++)
                    {
                        <li class="page-item @(pageIndex == Model.PageIndex ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Branch", new { page = pageIndex, searchTerm = Model.SearchTerm, statusFilter = Model.StatusFilter, managerId = Model.ManagerId })">@pageIndex</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", "Branch", new { page = Model.PageIndex + 1, searchTerm = Model.SearchTerm, statusFilter = Model.StatusFilter, managerId = Model.ManagerId })">Sau &gt;</a>
                    </li>
                </ul>
            </nav>
        }
    </section>
</div>

@model SEP490_G52_CSMS.Models.ViewModels.BranchIndexViewModel

@{
    ViewData["Title"] = "Danh sách chi nhánh";
    ViewData["ContainerClass"] = "container-fluid";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 small fw-semibold">
                    <i class="bi bi-geo-alt-fill me-1"></i>Hệ Thống Chi Nhánh
                </span>
            </div>
            <h3 class="fw-bold text-dark mb-0">DANH SÁCH CÁC CHI NHÁNH</h3>
        </div>
        <div>
            <a class="btn btn-primary px-3.5 py-2 fw-semibold rounded-3 shadow-sm d-inline-flex align-items-center gap-2" asp-controller="Branch" asp-action="Create">
                <i class="bi bi-plus-lg"></i> Thêm chi nhánh
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3 p-md-4">
            <form id="searchForm" method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small text-secondary fw-semibold mb-1">
                        <i class="bi bi-search me-1"></i>Tìm kiếm chi nhánh
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control bg-light border-start-0" name="searchTerm" value="@Model.SearchTerm" placeholder="Tìm theo tên, địa chỉ chi nhánh..." />
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a href="@Url.Action("Index", "Branch", new { statusFilter = Model.StatusFilter, managerId = Model.ManagerId })" class="btn btn-light border border-start-0 text-muted" title="Xóa tìm kiếm">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>

                <div class="col-md-3 col-sm-6">
                    <label class="form-label small text-secondary fw-semibold mb-1">
                        <i class="bi bi-funnel me-1"></i>Trạng thái
                    </label>
                    <select class="form-select bg-light border" name="statusFilter" onchange="document.getElementById('searchForm').submit()">
                        @foreach (var option in Model.StatusOptions)
                        {
                            <option value="@option" selected="@(option == Model.StatusFilter)">@option</option>
                        }
                    </select>
                </div>

                <div class="col-md-3 col-sm-6">
                    <label class="form-label small text-secondary fw-semibold mb-1">
                        <i class="bi bi-person-badge me-1"></i>Quản lý phụ trách
                    </label>
                    <select class="form-select bg-light border" name="managerId" onchange="document.getElementById('searchForm').submit()">
                        <option value="">Tất cả quản lý</option>
                        @foreach (var manager in Model.ManagerOptions)
                        {
                            <option value="@manager.ManagerId" selected="@(manager.ManagerId == Model.ManagerId)">@manager.ManagerName</option>
                        }
                    </select>
                </div>

                <div class="col-md-1 text-md-end">
                    <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold rounded-3" title="Lọc dữ liệu">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary -->
    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
        <span class="text-secondary small fw-medium">
            Đang hiển thị <strong class="text-dark">@Model.Branches.Count</strong> của <strong class="text-dark">@Model.TotalCount</strong> chi nhánh
        </span>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase fw-semibold border-bottom">
                    <tr>
                        <th class="ps-4 py-3" style="width: 10%;">Mã CB</th>
                        <th class="py-3" style="width: 24%;">Tên Chi Nhánh</th>
                        <th class="py-3" style="width: 26%;">Địa Chỉ</th>
                        <th class="py-3" style="width: 16%;">Quản Lý</th>
                        <th class="py-3 text-center" style="width: 10%;">Trạng Thái</th>
                        <th class="text-center py-3 pe-4" style="width: 14%; min-width: 250px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Branches.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                Không có chi nhánh nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var branch in Model.Branches)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-secondary-subtle text-dark font-monospace fw-bold px-2.5 py-1 rounded-2">
                                        @branch.BranchId
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@branch.BranchName</div>
                                </td>
                                <td>
                                    <div class="text-secondary small">
                                        <i class="bi bi-geo-alt me-1 text-danger"></i>@branch.Address
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(branch.ManagerName))
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-2.5 py-1 fw-medium">
                                            <i class="bi bi-person me-1"></i>@branch.ManagerName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic small">
                                            <i class="bi bi-dash me-1"></i>Chưa gán
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (branch.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-semibold">
                                            <i class="bi bi-check-circle-fill me-1 small"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 fw-semibold">
                                            <i class="bi bi-dash-circle-fill me-1 small"></i>Tạm dừng
                                        </span>
                                    }
                                </td>
                                <td class="pe-4">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a class="btn btn-sm btn-outline-info rounded-2 px-2 py-1" asp-action="Details" asp-route-id="@branch.BranchId" title="Chi tiết">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>
                                        <a class="btn btn-sm btn-outline-primary rounded-2 px-2 py-1" asp-action="Edit" asp-route-id="@branch.BranchId" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <a class="btn btn-sm btn-outline-warning text-dark rounded-2 px-2 py-1" asp-action="AssignManager" asp-route-id="@branch.BranchId" title="Gán quản lý">
                                            <i class="bi bi-person-gear"></i> Gán QL
                                        </a>
                                        @if (branch.Status == "Active")
                                        {
                                            <a class="btn btn-sm btn-outline-secondary rounded-2 px-2 py-1" asp-action="Deactivate" asp-route-id="@branch.BranchId" title="Ngừng hoạt động">
                                                <i class="bi bi-slash-circle"></i> Ngừng HĐ
                                            </a>
                                        }
                                        else
                                        {
                                            <form asp-action="ActivateConfirmed" method="post" class="d-inline" onsubmit="return confirmActivateBranch(this);">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="branchId" value="@branch.BranchId" />
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-2 px-2 py-1" title="Kích hoạt">
                                                    <i class="bi bi-check-circle"></i> Kích hoạt
                                                </button>
                                            </form>
                                        }
                                        <a class="btn btn-sm btn-outline-danger rounded-2 px-2 py-1" asp-action="Delete" asp-route-id="@branch.BranchId" title="Xóa">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @{
            var totalPages = Model.TotalPages == 0 ? 1 : Model.TotalPages;
            var currentPage = Model.PageIndex <= 0 ? 1 : Model.PageIndex;
            var prevPage = currentPage > 1 ? currentPage - 1 : 1;
            var nextPage = currentPage < totalPages ? currentPage + 1 : totalPages;
        }

        @if (totalPages > 1)
        {
            <div class="card-footer bg-light bg-opacity-50 py-3 border-top d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <span class="text-secondary small">Trang <strong class="text-dark">@currentPage</strong> / @totalPages</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link rounded-start-2" href="@Url.Action("Index", "Branch", new { page = prevPage, searchTerm = Model.SearchTerm, statusFilter = Model.StatusFilter, managerId = Model.ManagerId })">&laquo; Trước</a>
                        </li>
                        @for (var pageIndex = 1; pageIndex <= totalPages; pageIndex++)
                        {
                            <li class="page-item @(pageIndex == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", "Branch", new { page = pageIndex, searchTerm = Model.SearchTerm, statusFilter = Model.StatusFilter, managerId = Model.ManagerId })">@pageIndex</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link rounded-end-2" href="@Url.Action("Index", "Branch", new { page = nextPage, searchTerm = Model.SearchTerm, statusFilter = Model.StatusFilter, managerId = Model.ManagerId })">Sau &raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function confirmActivateBranch(form) {
            showConfirmModal(
                'Kích hoạt chi nhánh',
                'Bạn có chắc chắn muốn kích hoạt chi nhánh này hoạt động trở lại?',
                function() { form.submit(); }
            );
            return false;
        }
    </script>
}

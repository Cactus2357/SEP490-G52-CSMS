@model SEP490_G52_CSMS.Controllers.HandoverRowVM
@{
    var h = Model.Handover;
    var variance = h.ActualCash - h.TheoreticalCash;
    var hasVariance = variance != 0;
    var isEmergency = h.HandoverType == "Emergency";
}

<div class="modal-header bg-dark text-white px-4 py-3">
    <h5 class="modal-title fw-bold">
        <i class="bi bi-journal-text me-2"></i>CHI TIẾT PHIÊN BÀN GIAO CA #@h.HandoverId
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body p-4">
    <!-- Header thông tin phiên -->
    <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded-3 bg-light border">
        <div>
            <span class="badge @Model.HandoverTypeBadgeClass fs-6 px-3 py-2 me-2">
                @if (isEmergency)
                {
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                }
                @Model.HandoverTypeLabel
            </span>
            <span class="fw-bold text-dark fs-6">Ca làm việc: @(h.FixedShift?.ShiftName ?? "Ca ?")</span>
        </div>
        <span class="text-secondary small fw-semibold">
            <i class="bi bi-calendar3 me-1"></i>@h.HandoverDate.ToString("dd/MM/yyyy")
        </span>
    </div>

    @if (isEmergency)
    {
        <div class="alert alert-danger border-danger shadow-sm mb-3">
            <h6 class="fw-bold text-danger mb-1">
                <i class="bi bi-exclamation-octagon-fill me-1"></i>SỰ CỐ NGHỈ / BÀN GIAO ĐỘT XUẤT
            </h6>
            <div class="small">
                <strong>Lý do đột xuất:</strong> @(string.IsNullOrWhiteSpace(h.EmergencyReason) ? "Không có chi tiết lý do." : h.EmergencyReason)
            </div>
            @if (!string.IsNullOrWhiteSpace(h.DelivererName))
            {
                <div class="small mt-1 text-muted">
                    <strong>Người hỗ trợ bàn giao:</strong> @h.DelivererName
                </div>
            }
        </div>
    }

    <!-- Thông tin nhân viên bàn giao -->
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="p-3 border rounded bg-white shadow-xs">
                <small class="text-muted d-block fw-semibold mb-1">Thu ngân bàn giao (Người giao):</small>
                <strong class="text-dark fs-6"><i class="bi bi-person-circle me-1 text-primary"></i>@(h.OutgoingCashier?.FullName ?? "Chưa rõ")</strong>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 border rounded bg-white shadow-xs">
                <small class="text-muted d-block fw-semibold mb-1">Thu ngân tiếp nhận (Người nhận):</small>
                <strong class="text-dark fs-6"><i class="bi bi-person-check-fill me-1 text-success"></i>@(h.IncomingCashier?.FullName ?? "Chưa rõ")</strong>
            </div>
        </div>
    </div>

    <div class="mb-3 p-2.5 bg-light rounded border d-flex justify-content-between align-items-center">
        <small class="text-muted fw-semibold"><i class="bi bi-clock me-1 text-secondary"></i>Thời điểm thực hiện chốt ca:</small>
        <span class="fw-bold text-dark font-monospace">@((h.ClosedAt ?? h.OpenedAt).ToVietnamTimeString("HH:mm:ss - dd/MM/yyyy"))</span>
    </div>

    <!-- Chi tiết bảng đối soát két -->
    <h6 class="fw-bold text-primary mb-2"><i class="bi bi-calculator me-1"></i>Bảng đối soát dòng tiền két mặt</h6>
    <div class="table-responsive border rounded mb-3 bg-white">
        <table class="table table-sm table-borderless align-middle mb-0">
            <tbody>
                <tr class="border-bottom">
                    <td class="ps-3 py-2 text-muted small" style="width: 55%;">Tiền mặt đầu ca:</td>
                    <td class="pe-3 py-2 text-end fw-bold text-dark" style="width: 45%;">@h.InitialCash.ToString("N0") đ</td>
                </tr>
                <tr class="border-bottom">
                    <td class="ps-3 py-2 text-muted small">Doanh thu tiền mặt từ POS:</td>
                    <td class="pe-3 py-2 text-end fw-bold text-success">+@h.MachineCashRevenue.ToString("N0") đ</td>
                </tr>
                <tr class="border-bottom">
                    <td class="ps-3 py-2 text-muted small">Doanh thu CK (Không vào két):</td>
                    <td class="pe-3 py-2 text-end fw-bold text-secondary">@h.BankTransferRevenue.ToString("N0") đ</td>
                </tr>
                <tr class="table-primary border-top">
                    <td class="ps-3 py-2.5 fw-bold text-primary">☑ Tiền mặt lý thuyết trong két:</td>
                    <td class="pe-3 py-2.5 text-end fw-bold text-primary fs-6">@h.TheoreticalCash.ToString("N0") đ</td>
                </tr>
                <tr class="table-light border-top">
                    <td class="ps-3 py-2.5 fw-bold text-dark">☑ Tiền mặt thực tế kiểm kê:</td>
                    <td class="pe-3 py-2.5 text-end fw-bold text-dark fs-6">@h.ActualCash.ToString("N0") đ</td>
                </tr>
                <tr class="@(hasVariance ? "table-danger" : "table-success") border-top">
                    <td class="ps-3 py-2.5 fw-bold">Chênh lệch két tiền:</td>
                    <td class="pe-3 py-2.5 text-end fw-bold fs-6 @(hasVariance ? "text-danger" : "text-success")">
                        @(variance == 0 ? "0 đ (Khớp tiền)" : (variance > 0 ? "+" : "") + variance.ToString("N0") + " đ")
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="border rounded p-3 bg-light">
        <small class="text-muted fw-semibold d-block mb-1"><i class="bi bi-chat-left-text me-1"></i>Ghi chú &amp; Giải trình nhân viên:</small>
        <div class="text-dark small lh-base">@(string.IsNullOrWhiteSpace(h.Notes) ? "Không có ghi chú bổ sung." : h.Notes)</div>
    </div>
</div>
<div class="modal-footer border-top-0 pt-0 pe-4 pb-4">
    <button type="button" class="btn btn-secondary px-4 rounded-pill fw-semibold" data-bs-dismiss="modal">Đóng chi tiết</button>
</div>

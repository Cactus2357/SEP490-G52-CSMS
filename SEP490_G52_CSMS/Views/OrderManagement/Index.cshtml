@model SEP490_G52_CSMS.Models.ViewModels.OrderManagementListViewModel
@{
    ViewData["Title"] = "Quản lý Đơn Hàng";
}

<style>
    @@media print {
        body * {
            visibility: hidden !important;
        }
        #k80ReceiptContainer, #k80ReceiptContainer * {
            visibility: visible !important;
        }
        #k80ReceiptContainer {
            position: fixed !important;
            left: 0 !important;
            top: 0 !important;
            width: 76mm !important;
            margin: 0 !important;
            padding: 2mm 3mm !important;
            border: none !important;
            box-shadow: none !important;
            background: #fff !important;
            font-family: 'Courier New', Courier, monospace !important;
            font-size: 13px !important;
            line-height: 1.35 !important;
            color: #000 !important;
            z-index: 999999 !important;
        }
        @@page {
            size: 80mm auto;
            margin: 0;
        }
    }
</style>

<div class="container-fluid px-4 pt-3 pb-5">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
        <h3 class="fw-bold mb-0 text-uppercase text-dark">
            <i class="bi bi-cart-check-fill text-success me-2"></i>Quản lý Đơn Hàng
        </h3>
    </div>

    <!-- Bộ lọc & Tìm kiếm -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" id="filterForm" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-secondary">Tìm kiếm từ khóa</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-secondary"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchCashier" class="form-control" placeholder="Mã đơn, khách hàng, thu ngân, bàn..." value="@Model.SearchCashier">
                    </div>
                </div>
                
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary">Khoảng ngày</label>
                    <div class="d-flex align-items-center">
                        <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" placeholder="Từ ngày" />
                        <span class="text-muted small px-3">đến</span>
                        <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" placeholder="Đến ngày" />
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary">Trạng thái</label>
                    <select name="status" class="form-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="Tất cả" selected="@(Model.FilterStatus == "Tất cả")">Tất cả trạng thái</option>
                        <option value="Đang chờ pha chế" selected="@(Model.FilterStatus == "Đang chờ pha chế")">Đang chờ pha chế</option>
                        <option value="Đang pha chế" selected="@(Model.FilterStatus == "Đang pha chế")">Đang pha chế</option>
                        <option value="Đã pha chế xong" selected="@(Model.FilterStatus == "Đã pha chế xong")">Đã pha chế xong</option>
                        <option value="Đã giao hàng" selected="@(Model.FilterStatus == "Đã giao hàng" || Model.FilterStatus == "Hoàn thành" || Model.FilterStatus == "Đã hoàn thành")">Đã giao hàng</option>
                        <option value="Chờ thanh toán" selected="@(Model.FilterStatus == "Chờ thanh toán")">Chờ thanh toán</option>
                        <option value="Thanh toán 1 phần" selected="@(Model.FilterStatus == "Thanh toán 1 phần")">Thanh toán 1 phần</option>
                        <option value="Thiếu nguyên liệu" selected="@(Model.FilterStatus == "Thiếu nguyên liệu" || Model.FilterStatus == "Thiếu nguyên liệu / Chờ xử lý")">Thiếu nguyên liệu</option>
                        <option value="Đã hủy" selected="@(Model.FilterStatus == "Đã hủy" || Model.FilterStatus == "Đã hủy / Hoàn tiền")">Đã hủy</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <i class="bi bi-filter me-1"></i>Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 fw-semibold">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng Danh Sách Đơn Hàng -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-sm">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 15%;">Mã Đơn Hàng</th>
                        <th style="width: 25%;">Thông Tin Đơn Hàng</th>
                        <th style="width: 20%;">Thời Gian</th>
                        <th class="text-end" style="width: 13%;">Tổng Tiền</th>
                        <th class="text-center" style="width: 12%;">Trạng Thái</th>
                        <th class="text-center pe-4" style="width: 15%;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Không có đơn hàng nào khớp với tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">#@item.OrderId.Replace("ORD-", "").Replace("MH", "")</td>
                                <td>
                                    <div class="small text-muted">Thu ngân: <span class="fw-medium text-dark">@item.CashierName</span> &bull; @item.TotalItems món</div>
                                </td>
                                <td>
                                    <div class="small text-dark fw-medium">@item.CreatedAt.EnsureVietnamTimeString("dd/MM/yyyy HH:mm:ss")</div>
                                </td>
                                <td class="text-end fw-bold text-dark">
                                    @item.TotalAmount.ToString("N0")đ
                                </td>
                                <td class="text-center">
                                    @if (item.Status == "Đã giao hàng" || item.Status == "Hoàn thành" || item.Status == "Đã hoàn thành")
                                    {
                                        <span class="badge bg-success text-white px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-box-seam me-1"></i>Đã giao hàng
                                        </span>
                                    }
                                    else if (item.Status == "Đã pha chế xong")
                                    {
                                        <span class="badge bg-primary text-white px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-check2-circle me-1"></i>Đã pha chế xong
                                        </span>
                                    }
                                    else if (item.Status == "Đang pha chế")
                                    {
                                        <span class="badge bg-primary text-white px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-cup-hot-fill me-1"></i>Đang pha chế
                                        </span>
                                    }
                                    else if (item.Status == "Đang chờ pha chế")
                                    {
                                        <span class="badge bg-warning text-dark px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-clock-history me-1"></i>Đang chờ pha chế
                                        </span>
                                    }
                                    else if (item.Status == "Chờ thanh toán")
                                    {
                                        <span class="badge bg-secondary text-white px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-hourglass-split me-1"></i>Chờ thanh toán
                                        </span>
                                    }
                                    else if (item.Status == "Thanh toán 1 phần")
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-pie-chart-fill me-1"></i>Thanh toán 1 phần
                                        </span>
                                    }
                                    else if (item.Status == "Thiếu nguyên liệu")
                                    {
                                        <span class="badge bg-danger text-white px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-exclamation-octagon-fill me-1"></i>Thiếu nguyên liệu
                                        </span>
                                    }
                                    else if (item.Status == "Đã hủy")
                                    {
                                        <span class="badge bg-secondary text-white px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-x-circle-fill me-1"></i>Đã hủy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5 rounded-pill fw-semibold">
                                            @item.Status
                                        </span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <button type="button" class="btn btn-sm btn-link text-primary fw-bold text-decoration-none btn-view-detail" data-id="@item.OrderId">
                                        Chi tiết
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination Cursor-based -->
        <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
            <span class="small text-muted">
                Hiển thị các đơn hàng theo dòng thời gian
            </span>
            <div class="d-flex gap-2">
                @if (Model.HasPrev)
                {
                    <a href="@Url.Action("Index", new { fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), searchCashier = Model.SearchCashier, status = Model.FilterStatus, cursor = Model.PrevCursor, direction = "prev" })" class="btn btn-outline-secondary btn-sm fw-semibold">
                        <i class="bi bi-chevron-left me-1"></i>Đơn mới hơn
                    </a>
                }
                else
                {
                    <button class="btn btn-outline-secondary btn-sm fw-semibold" disabled>
                        <i class="bi bi-chevron-left me-1"></i>Đơn mới hơn
                    </button>
                }

                @if (Model.HasNext)
                {
                    <a href="@Url.Action("Index", new { fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), searchCashier = Model.SearchCashier, status = Model.FilterStatus, cursor = Model.NextCursor, direction = "next" })" class="btn btn-outline-secondary btn-sm fw-semibold">
                        Đơn cũ hơn<i class="bi bi-chevron-right ms-1"></i>
                    </a>
                }
                else
                {
                    <button class="btn btn-outline-secondary btn-sm fw-semibold" disabled>
                        Đơn cũ hơn<i class="bi bi-chevron-right ms-1"></i>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal Container -->
<div id="orderDetailModalContainer"></div>

<!-- Modal: Preview & In Hóa Đơn / Phiếu Giao K80 -->
<div class="modal fade" id="receiptPrintModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header py-2 bg-light border-bottom d-flex justify-content-between align-items-center">
                <h6 class="modal-title fw-bold text-dark mb-0">
                    <i class="bi bi-printer me-1 text-primary"></i>Hóa Đơn / Phiếu Đặt Đồ (K80)
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 bg-light d-flex flex-column align-items-center">
                <!-- Dual Mode Toggle -->
                <div class="btn-group btn-group-sm mb-3 w-100 shadow-sm" role="group">
                    <button type="button" class="btn btn-primary fw-semibold" id="btnModeReceipt" onclick="switchReceiptMode('receipt')">
                        <i class="bi bi-receipt me-1"></i>Hóa đơn thanh toán
                    </button>
                    <button type="button" class="btn btn-outline-primary fw-semibold" id="btnModeDelivery" onclick="switchReceiptMode('delivery')">
                        <i class="bi bi-ticket-detailed me-1"></i>Phiếu đặt đồ (kẹp khay)
                    </button>
                </div>

                <!-- Printable K80 Receipt Container -->
                <div id="k80ReceiptContainer" class="bg-white p-3 shadow-sm border border-secondary border-opacity-25" style="width: 320px; font-family: 'Courier New', Courier, monospace; font-size: 13px; line-height: 1.35; color: #000;">
                    <!-- Store Header -->
                    <div class="text-center pb-2 mb-2 border-bottom border-dark">
                        <div class="fw-bold text-uppercase fs-6">CSMS COFFEE</div>
                        <div id="recDocTitle" class="fw-bold text-uppercase mt-1" style="font-size: 14px; letter-spacing: 0.5px;">HÓA ĐƠN THANH TOÁN</div>
                        <div class="small mt-1">Chi nhánh: <span id="recBranchName">Hà Đông</span></div>
                        <div class="small">Địa chỉ: <span id="recBranchAddress">123 Nguyễn Trãi, Thanh Xuân, Hà Nội</span></div>
                        <div class="small">SĐT: <span id="recBranchPhone">0988.888.888</span></div>
                    </div>

                    <!-- Delivery Box (prominent for delivery slip mode) -->
                    <div id="recDeliveryBadgeBox" class="p-2 mb-2 text-center border border-2 border-dark rounded d-none" style="background-color: #f8f9fa;">
                        <div class="small text-uppercase fw-bold text-secondary" style="font-size: 11px;">VỊ TRÍ PHỤC VỤ</div>
                        <div id="recDeliveryTableBadge" class="fs-4 fw-bolder text-uppercase text-dark my-1">BÀN 05</div>
                        <div class="small text-muted" id="recDeliveryCustomerBadge">Khách: Anh Tuấn</div>
                    </div>

                    <!-- Order Info -->
                    <div class="pb-2 mb-2 border-bottom border-dark">
                        <div class="d-flex justify-content-between">
                            <span>Mã đơn: <strong id="recOrderId">MH260903-001</strong></span>
                            <span id="recOrderTime">03/09/2026 10:30</span>
                        </div>
                        <div class="mt-1" id="recStandardTableRow">
                            <strong>Vị trí / Bàn: <span id="recTableNumber" class="text-uppercase">Bàn 05</span></strong>
                        </div>
                        <div id="recStandardCustRow">Khách hàng: <span id="recCustomerName">Anh Tuấn</span></div>
                        <div id="recNotesRow" class="d-none mt-1 p-1 border border-secondary border-opacity-50 rounded" style="background: #fff8e1;">
                            <strong>Ghi chú:</strong> <em id="recOrderNotes">Ít ngọt</em>
                        </div>
                    </div>

                    <!-- Items Table -->
                    <table class="w-100 mb-2 border-bottom border-dark" style="font-size: 12px;">
                        <thead>
                            <tr class="border-bottom border-dark">
                                <th class="text-center py-1" style="width: 25px;">STT</th>
                                <th class="text-start py-1">Món</th>
                                <th class="text-center py-1" style="width: 32px;">SL</th>
                                <th class="text-end py-1 rec-price-col" style="width: 58px;">Đ.Giá</th>
                                <th class="text-end py-1 rec-price-col" style="width: 68px;">T.Tiền</th>
                            </tr>
                        </thead>
                        <tbody id="recItemsBody">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>

                    <!-- Financial Summary (Hidden in Delivery Mode) -->
                    <div class="pb-2 mb-2 border-bottom border-dark" id="recFinancialSection">
                        <div class="d-flex justify-content-between">
                            <span>Tạm tính:</span>
                            <span id="recSubtotal" class="font-monospace">140.000 đ</span>
                        </div>
                        <div class="d-flex justify-content-between text-danger d-none" id="recDiscountRow">
                            <span id="recDiscountLabel">Giảm giá:</span>
                            <span id="recDiscount" class="font-monospace">-0 đ</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold fs-6 mt-1 pt-1 border-top border-dark">
                            <span>TỔNG CỘNG:</span>
                            <span id="recTotal" class="font-monospace">140.000 đ</span>
                        </div>
                    </div>

                    <!-- Delivery Summary (Shown only in Delivery Mode) -->
                    <div id="recDeliveryTotalItemsBox" class="pb-2 mb-2 border-bottom border-dark d-none">
                        <div class="d-flex justify-content-between fw-bold">
                            <span>Tổng số món:</span>
                            <span id="recTotalItemsCount">0 món</span>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="text-center pt-1" id="recFooterText">
                        <div>Cảm ơn quý khách &amp; Hẹn gặp lại!</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2 bg-light d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-dark btn-sm fw-semibold" onclick="switchReceiptMode(currentReceiptMode === 'receipt' ? 'delivery' : 'receipt')">
                        <i class="bi bi-arrow-repeat me-1"></i><span id="btnToggleModeLabel">Đổi sang Phiếu đặt đồ</span>
                    </button>
                    <button type="button" class="btn btn-primary btn-sm px-3 fw-bold" onclick="window.print()">
                        <i class="bi bi-printer me-1"></i>In ngay (Print)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var currentReceiptMode = 'receipt';
        function switchReceiptMode(mode) {
            currentReceiptMode = mode;
            var btnRec = document.getElementById('btnModeReceipt');
            var btnDel = document.getElementById('btnModeDelivery');
            var toggleLabel = document.getElementById('btnToggleModeLabel');
            var docTitle = document.getElementById('recDocTitle');
            var badgeBox = document.getElementById('recDeliveryBadgeBox');
            var stdTableRow = document.getElementById('recStandardTableRow');
            var stdCustRow = document.getElementById('recStandardCustRow');
            var finSec = document.getElementById('recFinancialSection');
            var paySec = document.getElementById('recPaymentSection');
            var delTotalBox = document.getElementById('recDeliveryTotalItemsBox');
            var footerText = document.getElementById('recFooterText');
            var priceCols = document.querySelectorAll('.rec-price-col');

            if (mode === 'delivery') {
                if (btnRec) { btnRec.className = 'btn btn-outline-primary fw-semibold'; }
                if (btnDel) { btnDel.className = 'btn btn-primary fw-semibold'; }
                if (toggleLabel) { toggleLabel.innerText = 'Đổi sang Hóa đơn'; }
                if (docTitle) { docTitle.innerText = 'PHIẾU ĐẶT ĐỒ'; }
                if (badgeBox) { badgeBox.classList.remove('d-none'); }
                if (stdTableRow) { stdTableRow.classList.add('d-none'); }
                if (stdCustRow) { stdCustRow.classList.add('d-none'); }
                if (finSec) { finSec.classList.add('d-none'); }
                if (paySec) { paySec.classList.add('d-none'); }
                if (delTotalBox) { delTotalBox.classList.remove('d-none'); }
                if (footerText) { footerText.innerHTML = '<div>Powered by CSMS.vn</div>'; }
                priceCols.forEach(el => el.classList.add('d-none'));
            } else {
                if (btnRec) { btnRec.className = 'btn btn-primary fw-semibold'; }
                if (btnDel) { btnDel.className = 'btn btn-outline-primary fw-semibold'; }
                if (toggleLabel) { toggleLabel.innerText = 'Đổi sang Phiếu đặt đồ'; }
                if (docTitle) { docTitle.innerText = 'HÓA ĐƠN THANH TOÁN'; }
                if (badgeBox) { badgeBox.classList.add('d-none'); }
                if (stdTableRow) { stdTableRow.classList.remove('d-none'); }
                if (stdCustRow) { stdCustRow.classList.remove('d-none'); }
                if (finSec) { finSec.classList.remove('d-none'); }
                if (paySec) { paySec.classList.remove('d-none'); }
                if (delTotalBox) { delTotalBox.classList.add('d-none'); }
                if (footerText) { footerText.innerHTML = '<div>Cảm ơn quý khách &amp; Hẹn gặp lại!</div>'; }
                priceCols.forEach(el => el.classList.remove('d-none'));
            }
        }

        function printReceiptFromOrderMgmt(orderId) {
            if (!orderId) return;

            fetch('@Url.Action("GetReceiptData", "SaleManagement")?orderId=' + encodeURIComponent(orderId))
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        alert("Không thể tải thông tin hóa đơn: " + (data.message || 'Lỗi không xác định'));
                        return;
                    }

                    document.getElementById('recBranchName').innerText = data.branchName || 'CSMS';
                    document.getElementById('recBranchAddress').innerText = data.branchAddress || '';
                    document.getElementById('recBranchPhone').innerText = data.branchPhone || '';
                    document.getElementById('recOrderId').innerText = data.orderId;
                    document.getElementById('recOrderTime').innerText = data.orderTime;
                    document.getElementById('recTableNumber').innerText = data.tableNumber || 'Mang về';
                    document.getElementById('recCustomerName').innerText = data.customerName || 'Khách lẻ';

                    var delTableBadge = document.getElementById('recDeliveryTableBadge');
                    if (delTableBadge) {
                        delTableBadge.innerText = (data.tableNumber && data.tableNumber.trim() !== '') ? data.tableNumber : 'MANG VỀ';
                    }
                    var delCustBadge = document.getElementById('recDeliveryCustomerBadge');
                    if (delCustBadge) {
                        delCustBadge.innerText = 'Khách: ' + (data.customerName || 'Khách lẻ');
                    }

                    var notesRow = document.getElementById('recNotesRow');
                    if (data.orderNotes && data.orderNotes.trim() !== '') {
                        notesRow.classList.remove('d-none');
                        document.getElementById('recOrderNotes').innerText = data.orderNotes;
                    } else {
                        notesRow.classList.add('d-none');
                    }

                    var itemsHtml = '';
                    var totalItemsCount = 0;
                    (data.items || []).forEach((item, idx) => {
                        totalItemsCount += (item.quantity || 1);
                        itemsHtml += `
                            <tr>
                                <td class="text-center py-1 text-muted font-monospace">${idx + 1}</td>
                                <td class="py-1">
                                    <div class="fw-semibold">${item.productName}</div>
                                    <div class="small text-muted">Size: ${item.size}</div>
                                </td>
                                <td class="text-center py-1 font-monospace fw-bold">${item.quantity}</td>
                                <td class="text-end py-1 font-monospace rec-price-col">${item.unitPrice.toLocaleString('vi-VN')}</td>
                                <td class="text-end py-1 font-monospace rec-price-col">${item.amount.toLocaleString('vi-VN')}</td>
                            </tr>
                        `;
                    });
                    document.getElementById('recItemsBody').innerHTML = itemsHtml;

                    var totalItemsEl = document.getElementById('recTotalItemsCount');
                    if (totalItemsEl) {
                        totalItemsEl.innerText = totalItemsCount + ' món';
                    }

                    document.getElementById('recSubtotal').innerText = data.subtotalAmount.toLocaleString('vi-VN') + ' đ';

                    var discRow = document.getElementById('recDiscountRow');
                    if (data.discountAmount > 0) {
                        discRow.classList.remove('d-none');
                        var labelEl = document.getElementById('recDiscountLabel');
                        if (labelEl) {
                            labelEl.innerText = data.voucherCode ? `Giảm giá (${data.voucherCode}):` : 'Giảm giá:';
                        }
                        document.getElementById('recDiscount').innerText = '-' + data.discountAmount.toLocaleString('vi-VN') + ' đ';
                    } else {
                        discRow.classList.add('d-none');
                    }

                    document.getElementById('recTotal').innerText = data.totalAmount.toLocaleString('vi-VN') + ' đ';

                    // Payment Method (Tiền mặt, CK hoặc CK + Tiền mặt)
                    var payMethodEl = document.getElementById('recPaymentMethod');
                    if (payMethodEl) {
                        var pMethod = (data.paymentMethod || '').trim();
                        if (pMethod === 'Split' || (data.cashAmount > 0 && data.bankAmount > 0) || pMethod.indexOf('Thu thêm') !== -1 || pMethod.indexOf('+') !== -1) {
                            payMethodEl.innerText = 'CK + Tiền mặt';
                        } else if (pMethod === 'Bank Transfer' || pMethod === 'BankTransfer' || pMethod === 'Transfer' || pMethod === 'CK') {
                            payMethodEl.innerText = 'CK';
                        } else {
                            payMethodEl.innerText = 'Tiền mặt';
                        }
                    }

                    switchReceiptMode('receipt');

                    var modalEl = document.getElementById('receiptPrintModal');
                    if (modalEl) {
                        var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                        modal.show();
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert("Lỗi khi tải dữ liệu hóa đơn.");
                });
        }

        $(document).ready(function () {
            // Clicking "Chi tiết" button
            $("table tbody").on("click", ".btn-view-detail", function () {
                var orderId = $(this).data("id");
                showOrderDetailModal(orderId);
            });

            function showOrderDetailModal(orderId) {
                $.get('@Url.Action("Detail", "OrderManagement")?orderId=' + orderId + '&isInline=false', function (data) {
                    // Remove existing modal from DOM if any
                    $('#orderDetailModal').remove();
                    
                    // Append new modal HTML and show it
                    $("#orderDetailModalContainer").html(data);
                    var modalEl = document.getElementById('orderDetailModal');
                    var modal = new bootstrap.Modal(modalEl);
                    modal.show();
                }).fail(function () {
                    alert("Có lỗi xảy ra khi tải chi tiết đơn hàng.");
                });
            }
        });
    </script>
}

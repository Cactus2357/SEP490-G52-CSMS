@model SEP490_G52_CSMS.Models.ViewModels.OrderManagementListViewModel
@{
    ViewData["Title"] = "Quản lý Order";
    ViewData["ContainerClass"] = "container-fluid p-0";
}

<div class="container-fluid px-4 pt-3 pb-5">
    <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-dark pb-2" style="border-width: 2px !important;">
            <h2 class="fw-bold mb-0">Quản lý Order</h2>
            <div class="fs-4 fw-semibold text-primary">@Model.BranchName</div>
        </div>

        <!-- Filter Form -->
        <form method="get" asp-action="Index" class="mb-4">
            <div class="d-flex justify-content-between align-items-end">
                <div>
                    <label class="form-label fw-semibold">Tìm kiếm theo tên nhân viên</label>
                    <div class="input-group border border-dark rounded-0" style="width: 400px; border-width: 2px !important;">
                        <span class="input-group-text bg-white border-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchCashier" class="form-control border-0 shadow-none" placeholder="search" value="@Model.SearchCashier">
                    </div>
                </div>
                
                <div>
                    <select name="status" class="form-select border border-dark rounded-0 shadow-none" style="width: 180px; border-width: 2px !important;" onchange="this.form.submit()">
                        <option value="Tất cả" selected="@(Model.FilterStatus == "Tất cả")">Lọc trạng thái</option>
                        <option value="Hoàn thành" selected="@(Model.FilterStatus == "Hoàn thành")">Hoàn thành</option>
                        <option value="Đang xử lý" selected="@(Model.FilterStatus == "Đang xử lý")">Đang xử lý</option>
                        <option value="Đã hủy" selected="@(Model.FilterStatus == "Đã hủy")">Đã hủy</option>
                    </select>
                </div>
            </div>
            <!-- Ẩn nút submit, form sẽ submit khi nhấn enter trong text hoặc đổi select -->
            <button type="submit" class="d-none"></button>
        </form>

        <!-- Table -->
        <div class="border border-dark" style="border-width: 2px !important;">
            <table class="table table-bordered border-dark mb-0 table-hover align-middle">
                <thead class="table-light border-dark">
                    <tr>
                        <th class="border-dark text-center" style="width: 80px;">Mã số</th>
                        <th class="border-dark">Thông tin đơn hàng</th>
                        <th class="border-dark text-end" style="width: 150px;">Giá tiền</th>
                        <th class="border-dark text-center" style="width: 150px;">Trạng thái</th>
                        <th class="border-dark text-center" style="width: 150px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 fs-5 text-muted">Không có đơn hàng nào khớp với tìm kiếm.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="border-dark text-center">#@item.OrderId.Replace("ORD-", "")</td>
                                <td class="border-dark">
                                    <div class="fw-semibold">@item.OrderId</div>
                                    <div class="text-muted">Thu ngân: @item.CashierName - @item.TotalItems món</div>
                                </td>
                                <td class="border-dark text-end fw-semibold">
                                    @item.TotalAmount.ToString("N0") đ
                                </td>
                                <td class="border-dark text-center">
                                    @item.Status
                                </td>
                                <td class="border-dark text-center">
                                    <a href="javascript:void(0)" class="text-decoration-none text-primary fw-semibold btn-view-detail" data-id="@item.OrderId">Xem chi tiết</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
</div>

<!-- Modal Container -->
<div id="orderDetailModalContainer"></div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $(".btn-view-detail").click(function () {
                var orderId = $(this).data("id");
                $.get('@Url.Action("Detail", "OrderManagement")?orderId=' + orderId, function (data) {
                    $("#orderDetailModalContainer").html(data);
                    $("#orderDetailModal").modal("show");
                }).fail(function () {
                    alert("Có lỗi xảy ra khi tải chi tiết đơn hàng.");
                });
            });
        });
    </script>
}

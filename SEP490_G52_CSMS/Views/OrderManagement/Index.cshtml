@model SEP490_G52_CSMS.Models.ViewModels.OrderManagementListViewModel
@{
    ViewData["Title"] = "Quản lý Đơn Hàng";
}

<div class="container-fluid px-4 pt-3 pb-5">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
        <h3 class="fw-bold mb-0 text-uppercase text-dark">
            <i class="bi bi-cart-check-fill text-success me-2"></i>Quản lý Đơn Hàng
        </h3>
        <div class="fs-5 fw-semibold text-primary">
            <i class="bi bi-shop me-1"></i>@Model.BranchName
        </div>
    </div>

    <!-- Bộ lọc & Tìm kiếm -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" id="filterForm" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-secondary">Tìm kiếm nhân viên</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-secondary"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchCashier" class="form-control" placeholder="Tên thu ngân..." value="@Model.SearchCashier">
                    </div>
                </div>
                
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary">Khoảng ngày</label>
                    <div class="d-flex align-items-center">
                        <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" placeholder="Từ ngày" />
                        <span class="text-muted small px-3">đến</span>
                        <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" placeholder="Đến ngày" />
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary">Trạng thái</label>
                    <select name="status" class="form-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="Tất cả" selected="@(Model.FilterStatus == "Tất cả")">Tất cả trạng thái</option>
                        <option value="Đang chờ pha chế" selected="@(Model.FilterStatus == "Đang chờ pha chế")">Đang chờ pha chế</option>
                        <option value="Đang pha chế" selected="@(Model.FilterStatus == "Đang pha chế")">Đang pha chế</option>
                        <option value="Đã pha chế xong" selected="@(Model.FilterStatus == "Đã pha chế xong")">Đã pha chế xong</option>
                        <option value="Đã giao hàng" selected="@(Model.FilterStatus == "Đã giao hàng" || Model.FilterStatus == "Hoàn thành" || Model.FilterStatus == "Đã hoàn thành")">Đã giao hàng</option>
                        <option value="Chờ thanh toán" selected="@(Model.FilterStatus == "Chờ thanh toán")">Chờ thanh toán</option>
                        <option value="Thanh toán 1 phần" selected="@(Model.FilterStatus == "Thanh toán 1 phần")">Thanh toán 1 phần</option>
                        <option value="Thiếu nguyên liệu" selected="@(Model.FilterStatus == "Thiếu nguyên liệu" || Model.FilterStatus == "Thiếu nguyên liệu / Chờ xử lý")">Thiếu nguyên liệu</option>
                        <option value="Hoàn tiền 1 phần" selected="@(Model.FilterStatus == "Hoàn tiền 1 phần")">Hoàn tiền 1 phần</option>
                        <option value="Đã hủy" selected="@(Model.FilterStatus == "Đã hủy" || Model.FilterStatus == "Đã hủy / Hoàn tiền")">Đã hủy / Hoàn tiền</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <i class="bi bi-filter me-1"></i>Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 fw-semibold">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng Danh Sách Đơn Hàng -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-sm">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 15%;">Mã Đơn Hàng</th>
                        <th style="width: 25%;">Thông Tin Đơn Hàng</th>
                        <th style="width: 20%;">Thời Gian</th>
                        <th class="text-end" style="width: 13%;">Tổng Tiền</th>
                        <th class="text-center" style="width: 12%;">Trạng Thái</th>
                        <th class="text-center pe-4" style="width: 15%;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Không có đơn hàng nào khớp với tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">#@item.OrderId.Replace("ORD-", "").Replace("MH", "")</td>
                                <td>
                                    <div class="small text-muted">Thu ngân: <span class="fw-medium text-dark">@item.CashierName</span> &bull; @item.TotalItems món</div>
                                </td>
                                <td>
                                    <div class="small text-dark fw-medium">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</div>
                                </td>
                                <td class="text-end fw-bold text-dark">
                                    @item.TotalAmount.ToString("N0")đ
                                </td>
                                <td class="text-center">
                                    @if (item.Status == "Đã giao hàng" || item.Status == "Hoàn thành" || item.Status == "Đã hoàn thành")
                                    {
                                        <span class="badge bg-success text-white px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-box-seam me-1"></i>Đã giao hàng
                                        </span>
                                    }
                                    else if (item.Status == "Đã pha chế xong")
                                    {
                                        <span class="badge bg-primary text-white px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-check2-circle me-1"></i>Đã pha chế xong
                                        </span>
                                    }
                                    else if (item.Status == "Đang pha chế")
                                    {
                                        <span class="badge bg-primary text-white px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-cup-hot-fill me-1"></i>Đang pha chế
                                        </span>
                                    }
                                    else if (item.Status == "Đang chờ pha chế")
                                    {
                                        <span class="badge bg-warning text-dark px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-clock-history me-1"></i>Đang chờ pha chế
                                        </span>
                                    }
                                    else if (item.Status == "Chờ thanh toán")
                                    {
                                        <span class="badge bg-secondary text-white px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-hourglass-split me-1"></i>Chờ thanh toán
                                        </span>
                                    }
                                    else if (item.Status == "Thanh toán 1 phần")
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-pie-chart-fill me-1"></i>Thanh toán 1 phần
                                        </span>
                                    }
                                    else if (item.Status == "Thiếu nguyên liệu")
                                    {
                                        <span class="badge bg-danger text-white px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-exclamation-octagon-fill me-1"></i>Thiếu nguyên liệu
                                        </span>
                                    }
                                    else if (item.Status == "Hoàn tiền 1 phần")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i>Hoàn tiền 1 phần
                                        </span>
                                    }
                                    else if (item.Status == "Đã hủy")
                                    {
                                        <span class="badge bg-secondary text-white px-2.5 py-1.5 rounded-pill fw-semibold">
                                            <i class="bi bi-x-circle-fill me-1"></i>Đã hủy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5 rounded-pill fw-semibold">
                                            @item.Status
                                        </span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <button type="button" class="btn btn-sm btn-link text-primary fw-bold text-decoration-none btn-view-detail" data-id="@item.OrderId">
                                        Chi tiết
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination Cursor-based -->
        <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
            <span class="small text-muted">
                Hiển thị các đơn hàng theo dòng thời gian
            </span>
            <div class="d-flex gap-2">
                @if (Model.HasPrev)
                {
                    <a href="@Url.Action("Index", new { fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), searchCashier = Model.SearchCashier, status = Model.FilterStatus, cursor = Model.PrevCursor, direction = "prev" })" class="btn btn-outline-secondary btn-sm fw-semibold">
                        <i class="bi bi-chevron-left me-1"></i>Đơn mới hơn
                    </a>
                }
                else
                {
                    <button class="btn btn-outline-secondary btn-sm fw-semibold" disabled>
                        <i class="bi bi-chevron-left me-1"></i>Đơn mới hơn
                    </button>
                }

                @if (Model.HasNext)
                {
                    <a href="@Url.Action("Index", new { fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), searchCashier = Model.SearchCashier, status = Model.FilterStatus, cursor = Model.NextCursor, direction = "next" })" class="btn btn-outline-secondary btn-sm fw-semibold">
                        Đơn cũ hơn<i class="bi bi-chevron-right ms-1"></i>
                    </a>
                }
                else
                {
                    <button class="btn btn-outline-secondary btn-sm fw-semibold" disabled>
                        Đơn cũ hơn<i class="bi bi-chevron-right ms-1"></i>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal Container -->
<div id="orderDetailModalContainer"></div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Clicking "Chi tiết" button
            $("table tbody").on("click", ".btn-view-detail", function () {
                var orderId = $(this).data("id");
                showOrderDetailModal(orderId);
            });

            function showOrderDetailModal(orderId) {
                $.get('@Url.Action("Detail", "OrderManagement")?orderId=' + orderId + '&isInline=false', function (data) {
                    // Remove existing modal from DOM if any
                    $('#orderDetailModal').remove();
                    
                    // Append new modal HTML and show it
                    $("#orderDetailModalContainer").html(data);
                    var modalEl = document.getElementById('orderDetailModal');
                    var modal = new bootstrap.Modal(modalEl);
                    modal.show();
                }).fail(function () {
                    showToast("Có lỗi xảy ra khi tải chi tiết đơn hàng.", "danger");
                });
            }
        });
    </script>
}

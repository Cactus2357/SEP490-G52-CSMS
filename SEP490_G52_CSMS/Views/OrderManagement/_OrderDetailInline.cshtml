@model SEP490_G52_CSMS.Models.ViewModels.OrderDetailViewModel

<div class="p-3">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h4 class="fw-bold mb-0 text-dark">Chi tiết đặt hàng: @Model.OrderId</h4>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-primary btn-sm fw-bold shadow-sm" onclick="printReceiptFromOrderMgmt('@Model.OrderId')">
                <i class="bi bi-printer me-1"></i>In Hóa Đơn
            </button>
            <div class="badge bg-secondary-subtle text-secondary-emphasis border px-3 py-1.5 fw-semibold fs-6">
                Trạng thái: @Model.Status
            </div>
        </div>
    </div>

    <!-- Info Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border p-3 h-100 bg-light-subtle shadow-sm">
                <div class="fw-bold text-secondary mb-2">Thu ngân</div>
                <div class="d-flex align-items-center mt-2">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold me-3" style="width: 50px; height: 50px; font-size: 1.2rem;">
                        @{ 
                            var names = Model.CashierName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            var initials = names.Length > 1 ? (names[0][0].ToString() + names.Last()[0].ToString()).ToUpper() : Model.CashierName.Substring(0, 1).ToUpper();
                        }
                        @initials
                    </div>
                    <div>
                        <div class="fw-bold fs-5 text-dark">@Model.CashierName</div>
                        <div class="text-muted small">@Model.ShiftInfo</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border p-3 h-100 bg-light-subtle shadow-sm">
                <div class="fw-bold text-secondary mb-2">Thanh toán</div>
                <div class="mt-2">
                    <div class="fw-bold fs-5 text-dark">Phương thức: @Model.PaymentMethod</div>
                    <div class="text-muted small">Mã GD: @Model.TransactionId</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Item List -->
    <div class="card border p-3 mb-4 shadow-sm">
        <div class="fw-bold text-dark mb-3 border-bottom pb-2">Danh sách món - @Model.TotalItems món</div>
        
        <div class="order-items-scroll-wrapper" style="max-height: 220px; overflow-y: auto; padding-right: 5px; margin-bottom: 10px;">
            @foreach (var item in Model.Items)
            {
                <div class="d-flex justify-content-between align-items-center mb-2 py-1">
                    <div>
                        <div class="fw-semibold text-dark">@item.ProductName</div>
                        <div class="text-muted small">Size @item.Size x @item.Quantity</div>
                    </div>
                    <div class="fw-bold text-secondary">
                        @item.TotalPrice.ToString("N0") đ
                    </div>
                </div>
                <div class="border-bottom border-secondary border-dashed mb-2 opacity-25" style="border-style: dashed !important;"></div>
            }
        </div>

        <div class="d-flex justify-content-between mt-3 fw-bold fs-5 text-dark border-top pt-2">
            <div>Tổng cộng</div>
            <div class="text-success">@Model.TotalAmount.ToString("N0") đ</div>
        </div>
    </div>

    <!-- Timeline -->
    <div class="card border p-3 mb-2 shadow-sm">
        <div class="fw-bold text-dark mb-3">Dòng thời gian</div>
        <div class="position-relative d-flex justify-content-between px-3 mt-4 mb-2">
            <!-- Horizontal Line -->
            <div class="position-absolute border-top border-secondary opacity-50" style="top: 10px; left: 40px; right: 40px; border-width: 2px !important; z-index: 1;"></div>
            
            <!-- Point 1: Order tạo (Luôn có) -->
            <div class="text-center position-relative" style="z-index: 2;">
                <div class="rounded-circle bg-dark mx-auto border border-white" style="width: 20px; height: 20px; border-width: 3px !important; box-shadow: 0 0 5px rgba(0,0,0,0.2);"></div>
                <div class="mt-2 fw-semibold small text-dark">@Model.CreatedAtStr</div>
                <div class="text-muted small">Order tạo</div>
            </div>

            @if (Model.Status == "Đã hủy")
            {
                <!-- Point Hủy -->
                <div class="text-center position-relative" style="z-index: 2;">
                    <div class="rounded-circle bg-danger mx-auto border border-white" style="width: 20px; height: 20px; border-width: 3px !important; box-shadow: 0 0 5px rgba(0,0,0,0.2);"></div>
                    <div class="mt-2 fw-semibold text-danger small">@Model.PaidAtStr</div>
                    <div class="text-danger small fw-semibold">Đã hủy</div>
                </div>
            }
            else
            {
                bool isPaid = Model.PaymentMethod != "Cash" || Model.Status == "Hoàn thành";
                bool isDone = Model.Status == "Hoàn thành";

                <!-- Point 2: Thanh toán -->
                <div class="text-center position-relative" style="z-index: 2;">
                    <div class="rounded-circle @(isPaid ? "bg-success" : "bg-secondary") mx-auto border border-white" style="width: 20px; height: 20px; border-width: 3px !important; box-shadow: 0 0 5px rgba(0,0,0,0.2);"></div>
                    <div class="mt-2 fw-semibold small @(isPaid ? "text-success" : "text-muted")">@(isPaid ? Model.PaidAtStr : "--:--")</div>
                    <div class="text-muted small">Thanh toán</div>
                </div>

                <!-- Point 3: Hoàn thành -->
                <div class="text-center position-relative" style="z-index: 2;">
                    <div class="rounded-circle @(isDone ? "bg-success" : "bg-secondary") mx-auto border border-white" style="width: 20px; height: 20px; border-width: 3px !important; box-shadow: 0 0 5px rgba(0,0,0,0.2);"></div>
                    <div class="mt-2 fw-semibold small @(isDone ? "text-success" : "text-muted")">@(isDone ? Model.CompletedAtStr : "--:--")</div>
                    <div class="text-muted small">Hoàn thành</div>
                </div>
            }
        </div>
    </div>
</div>

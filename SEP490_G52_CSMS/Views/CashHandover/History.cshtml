@model SEP490_G52_CSMS.Models.ViewModels.HandoverHistoryViewModel
@{
    ViewData["Title"] = "Lịch Sử Giao Ca - Quản Lý Kết Tiền";
    var today = DateTime.Today;
    var weekAgo = today.AddDays(-6);
}

<div class="container-fluid px-4">

    @* Tiêu đề module *@
    <div class="d-flex align-items-center justify-content-between mb-3 pt-3">
        <h1 class="h3 fw-bold text-dark mb-0">QUẢN LÝ KẾT TIỀN &amp; GIAO CA</h1>
        <div class="d-flex gap-2">
            <a asp-action="OpenShift" class="btn btn-outline-secondary btn-sm">Mở ca</a>
            <a asp-action="Handover" class="btn btn-outline-secondary btn-sm">Giao &amp; Đóng ca</a>
            <a asp-action="History" asp-route-branchId="@Model.BranchId"
               class="btn btn-primary btn-sm">Lịch sử</a>
        </div>
    </div>

    @* Header biểu mẫu *@
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom border-dark pb-2">
        <h4 class="fw-bold mb-0 text-uppercase">LỊCH SỬ ĐÓNG/ MỞ/ BÀN GIAO CA</h4>
        <a asp-action="Index" class="btn btn-outline-dark fw-bold px-4" style="border-width: 2px;">Hủy</a>
    </div>

    @* Bộ lọc ngày và loại phiên *@
    <div class="mb-3 d-flex align-items-center gap-3">
        <div class="d-flex align-items-center border border-dark rounded px-2 bg-white" style="border-width: 2px !important; height: 38px;">
            <input type="date" id="filterDateFrom" class="form-control border-0 shadow-none p-0 mx-2"
                   value="@weekAgo.ToString("yyyy-MM-dd")" style="width: 110px;" />
            <span>-</span>
            <input type="date" id="filterDateTo" class="form-control border-0 shadow-none p-0 mx-2"
                   value="@today.ToString("yyyy-MM-dd")" style="width: 110px;" />
            <i class="bi bi-calendar-check ms-1 fs-5"></i>
        </div>
        <div class="border border-dark rounded bg-white" style="border-width: 2px !important; height: 38px;">
            <select id="filterSessionType" class="form-select border-0 shadow-none h-100" style="min-width: 150px; background-color: transparent;">
                <option value="">Loại phiên: Tất cả</option>
                <option value="mở ca">Mở ca</option>
                <option value="giao ca">Giao ca</option>
            </select>
        </div>
        <button class="btn btn-dark fw-bold px-3" onclick="applyFilter()" style="height: 38px;">Lọc</button>
        <span class="text-muted small ms-auto">Tổng: <strong>@Model.TotalCount</strong> bản ghi</span>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-1 text-muted opacity-50"></i>
            <p class="text-muted mt-3">Chưa có dữ liệu lịch sử giao ca.</p>
        </div>
    }
    else
    {
        @* Bảng lịch sử dạng gọn theo wireframe *@
        <div class="mb-3">
            <div class="table-responsive border border-dark rounded" style="border-width: 2px !important; max-height: 400px; overflow-y: auto;">
                <table class="table align-middle mb-0" id="historyTable" style="table-layout: fixed;">
                    <thead style="background-color: #e9ecef; position: sticky; top: 0; z-index: 1;">
                        <tr class="border-bottom border-dark">
                            <th class="ps-3 border-end border-dark" style="width: 15%;">Ngày</th>
                            <th class="border-end border-dark" style="width: 25%;">Loại Phiên</th>
                            <th class="border-end border-dark" style="width: 25%;">Ca Làm</th>
                            <th style="width: 35%;">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="history-row border-bottom border-dark"
                                data-id="@item.HandoverId"
                                data-date="@item.HandoverDate"
                                data-shift="@item.ShiftName"
                                data-session-type="@item.SessionType.ToLower()"
                                data-outgoing="@item.OutgoingCashierName"
                                data-incoming="@item.IncomingCashierName"
                                data-initial="@item.InitialCash"
                                data-revenue="@item.MachineCashRevenue"
                                data-theoretical="@item.TheoreticalCash"
                                data-actual="@item.ActualCash"
                                data-discrepancy="@item.Discrepancy"
                                data-deliverer="@(item.DelivererName ?? "")"
                                data-notes="@(item.Notes ?? "")">
                                <td class="ps-3 border-end border-dark">
                                    @{
                                        DateTime.TryParse(item.HandoverDate, out DateTime parsedDate);
                                        var displayDate = parsedDate != DateTime.MinValue ? parsedDate.ToString("dd-MM") : item.HandoverDate;
                                    }
                                    @displayDate
                                </td>
                                <td class="border-end border-dark">
                                    @item.SessionType
                                </td>
                                <td class="border-end border-dark">
                                    @item.ShiftName
                                </td>
                                <td>
                                    <a href="#detailPanel"
                                       class="text-primary fw-bold text-decoration-none view-btn"
                                       onclick="showDetail(this); return false;">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Panel chi tiết phiên (ẩn mặc định, hiện khi click "Xem") *@
        <div id="detailPanel" class="d-none mb-4 border border-dark rounded" style="border-width: 2px !important;">
            <div class="border-bottom border-dark p-2">
                <span class="fw-bold fs-5 text-uppercase" id="detailTitle">CHI TIẾT PHIÊN</span>
                <button type="button" class="btn-close float-end" onclick="hideDetail()"></button>
            </div>
            <div class="p-3">
                <div class="mb-3 d-flex flex-wrap gap-4">
                    <div>
                        <span class="text-muted">- Nhân viên bàn giao:</span>
                        <span class="fw-semibold ms-1" id="detailOutgoing">–</span>
                    </div>
                    <div>
                        <span class="text-muted">- Nhân viên nhận ca:</span>
                        <span class="fw-semibold ms-1" id="detailIncoming">–</span>
                    </div>
                    <div>
                        <span class="text-muted">- Người giao tiền:</span>
                        <span class="fw-semibold ms-1 text-primary" id="detailDeliverer">–</span>
                    </div>
                </div>
                <div class="row m-0 border border-dark" style="border-width: 2px !important;">
                    <div class="col-md-5 p-3 border-end border-dark" style="border-width: 2px !important;">
                        <div class="mb-2">
                            <span>- Tiền mặt đầu ca:</span>
                            <span id="detailInitial" class="fw-semibold text-dark">–</span>
                        </div>
                        <div class="mb-2">
                            <span>- Tiền mặt phát sinh trong ca:</span>
                            <span id="detailRevenue" class="fw-semibold text-dark">–</span>
                        </div>
                        <div class="mb-2">
                            <span>- Tổng lý thuyết:</span>
                            <span id="detailTheoretical" class="fw-semibold text-dark">–</span>
                        </div>
                        <div class="mb-2">
                            <span>- Tiền mặt thực tế cuối ca:</span>
                            <span id="detailActual" class="fw-semibold text-success">–</span>
                        </div>
                        <div>
                            <span>- Chênh lệch kết ca:</span>
                            <span id="detailDiscrepancy" class="fw-semibold">–</span>
                        </div>
                    </div>
                    <div class="col-md-7 p-3">
                        <label class="form-label">- Lý do nếu có:</label>
                        <div class="border border-dark p-2 h-75" id="detailNotes" style="min-height: 80px;"></div>
                    </div>
                </div>
            </div>
        </div>

        @* Phân trang *@
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Phân trang lịch sử giao ca">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="History"
                           asp-route-branchId="@Model.BranchId"
                           asp-route-page="@(Model.PageIndex - 1)">&laquo; Trước</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link"
                               asp-action="History"
                               asp-route-branchId="@Model.BranchId"
                               asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="History"
                           asp-route-branchId="@Model.BranchId"
                           asp-route-page="@(Model.PageIndex + 1)">Sau &raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@section Scripts {
    <script>
        // ── Hiển thị panel chi tiết khi click "Xem" ──
        function showDetail(btn) {
            const row = btn.closest('tr');
            const panel = document.getElementById('detailPanel');

            const sessionType = row.dataset.sessionType;  // vd: "mở ca"
            const date        = row.dataset.date;
            const shift       = row.dataset.shift;
            const outgoing    = row.dataset.outgoing;
            const incoming    = row.dataset.incoming;
            const initial     = row.dataset.initial;
            const revenue     = row.dataset.revenue;
            const theoretical = row.dataset.theoretical;
            const actual      = row.dataset.actual;
            const discrepancy = row.dataset.discrepancy;
            const deliverer   = row.dataset.deliverer;
            const notes       = row.dataset.notes;

            // Tiêu đề panel: "CHI TIẾT PHIÊN: GIAO CA - CA 2 - 15/06"
            document.getElementById('detailTitle').textContent =
                `CHI TIẾT PHIÊN: ${sessionType.toUpperCase()} - ${shift} - ${date}`;

            document.getElementById('detailOutgoing').textContent    = outgoing;
            document.getElementById('detailIncoming').textContent    = incoming;
            document.getElementById('detailDeliverer').textContent   = deliverer || '–';
            document.getElementById('detailInitial').textContent     = initial;
            document.getElementById('detailRevenue').textContent     = revenue;
            document.getElementById('detailTheoretical').textContent = theoretical;
            document.getElementById('detailActual').textContent      = actual;

            // Màu chênh lệch
            const discEl = document.getElementById('detailDiscrepancy');
            discEl.textContent = discrepancy;
            discEl.className = discrepancy.startsWith('-') ? 'text-danger' : 'text-success';

            document.getElementById('detailNotes').textContent = notes || '(không có lý do)';

            // Highlight dòng đang chọn
            document.querySelectorAll('.history-row').forEach(r => r.classList.remove('table-active'));
            row.classList.add('table-active');

            // Hiện panel và scroll đến
            panel.classList.remove('d-none');
            setTimeout(() => panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 50);
        }

        function hideDetail() {
            document.getElementById('detailPanel').classList.add('d-none');
            document.querySelectorAll('.history-row').forEach(r => r.classList.remove('table-active'));
        }

        // ── Lọc client-side theo loại phiên và khoảng ngày ──
        function applyFilter() {
            const sessionFilter = document.getElementById('filterSessionType').value.toLowerCase();
            const dateFrom = document.getElementById('filterDateFrom').value;   // yyyy-MM-dd
            const dateTo   = document.getElementById('filterDateTo').value;

            document.querySelectorAll('.history-row').forEach(row => {
                const rowType    = (row.dataset.sessionType || '').toLowerCase();
                const rawDate    = row.dataset.date;  // dd/MM/yyyy

                // Chuyển dd/MM/yyyy → Date
                let rowDate = null;
                if (rawDate) {
                    const parts = rawDate.split('/');
                    if (parts.length === 3)
                        rowDate = new Date(parts[2], parts[1] - 1, parts[0]);
                }

                const typeOk = !sessionFilter || rowType === sessionFilter;
                const fromOk = !dateFrom || !rowDate || rowDate >= new Date(dateFrom);
                const toOk   = !dateTo   || !rowDate || rowDate <= new Date(dateTo);

                row.style.display = (typeOk && fromOk && toOk) ? '' : 'none';
            });

            // Ẩn detail panel khi lọc lại
            hideDetail();
        }
    </script>
}

@model SEP490_G52_CSMS.Models.ViewModels.HandoverHistoryViewModel
@{
    ViewData["Title"] = "Lịch Sử Đóng / Mở / Bàn Giao Ca";
    var today = DateTime.Today;
    var weekAgo = today.AddDays(-6);
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-clock-history text-primary me-2"></i>LỊCH SỬ ĐÓNG / MỞ / BÀN GIAO CA
            </h1>
            <p class="text-muted small mb-0">Theo dõi chi tiết tất cả các phiên mở ca, bàn giao ca, chốt két cuối ngày và bàn giao đột xuất của chi nhánh.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="OpenShift" class="btn btn-outline-primary btn-sm fw-semibold">
                <i class="bi bi-door-open me-1"></i>Mở ca đầu ngày
            </a>
            <a asp-action="Handover" class="btn btn-outline-success btn-sm fw-semibold">
                <i class="bi bi-arrow-left-right me-1"></i>Bàn giao ca
            </a>
            <a asp-action="CloseShift" class="btn btn-outline-danger btn-sm fw-semibold">
                <i class="bi bi-door-closed me-1"></i>Đóng ca cuối ngày
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 py-2 px-3 mb-3 border-success-subtle rounded-3 shadow-sm" role="alert" style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #166534;">
            <i class="bi bi-check-circle-fill fs-5 text-success flex-shrink-0"></i>
            <span class="small fw-semibold flex-grow-1">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close" style="font-size: 0.75rem;"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mb-3 border-danger-subtle rounded-3 shadow-sm" role="alert" style="background-color: #fef2f2; border: 1px solid #fecaca; color: #991b1b;">
            <i class="bi bi-exclamation-circle-fill fs-5 text-danger flex-shrink-0"></i>
            <span class="small fw-semibold flex-grow-1">@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close" style="font-size: 0.75rem;"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border shadow-sm mb-3">
        <div class="card-body py-2.5 px-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small mb-1">Loại phiên làm việc</label>
                    <select id="filterSessionType" class="form-select form-select-sm" onchange="applyFilter()">
                        <option value="">Tất cả các phiên</option>
                        <option value="mở ca">Mở ca đầu ngày</option>
                        <option value="bàn giao ca">Bàn giao ca giữa ngày</option>
                        <option value="liên tiếp">Giao ca liên tiếp (Cùng NV)</option>
                        <option value="đột xuất">Bàn giao đột xuất</option>
                        <option value="đóng ca">Đóng ca cuối ngày</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-semibold text-secondary small mb-1">Khoảng thời gian</label>
                    <div class="d-flex align-items-center gap-1.5">
                        <input type="date" id="filterDateFrom" class="form-control form-control-sm" value="@weekAgo.ToString("yyyy-MM-dd")" onchange="applyFilter()" />
                        <span class="text-muted small">đến</span>
                        <input type="date" id="filterDateTo" class="form-control form-control-sm" value="@today.ToString("yyyy-MM-dd")" onchange="applyFilter()" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-secondary"><i class="bi bi-search"></i></span>
                        <input type="text" id="filterSearch" class="form-control" placeholder="Tìm theo tên nhân viên, ca trực..." oninput="applyFilter()" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle mb-0" id="historyTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 4%;">STT</th>
                        <th style="width: 14%;">Thời Gian Thực Hiện</th>
                        <th style="width: 16%;">Loại Phiên Làm Việc</th>
                        <th style="width: 8%;">Ca Trực</th>
                        <th style="width: 13%;">Người Bàn Giao</th>
                        <th style="width: 13%;">Người Nhận Ca</th>
                        <th style="width: 11%;" class="text-end">Tiền Thực Tế</th>
                        <th style="width: 9%;" class="text-end">Chênh Lệch</th>
                        <th style="width: 7%;">Trạng Thái</th>
                        <th style="width: 5%;" class="text-center">Chi Tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Chưa có dữ liệu lịch sử giao ca nào
                            </td>
                        </tr>
                    }
                    else
                    {
                        for (int i = 0; i < Model.Items.Count; i++)
                        {
                            var item = Model.Items[i];
                            var stt = (Model.PageIndex - 1) * Model.PageSize + i + 1;
                            bool isNegative = item.Discrepancy.StartsWith("-");
                            bool isPositive = item.Discrepancy.StartsWith("+");
                            string discClass = isNegative ? "text-danger" : (isPositive ? "text-success" : "text-muted");

                            <tr class="history-row"
                                data-id="@item.HandoverId"
                                data-date="@item.HandoverDate"
                                data-shift="@item.ShiftName"
                                data-session-type="@item.SessionType.ToLower()"
                                data-raw-session-type="@item.SessionType"
                                data-action-time="@item.ActionTime"
                                data-action-time-type="@item.ActionTimeType"
                                data-outgoing="@item.OutgoingCashierName"
                                data-has-outgoing="@(item.HasOutgoing ? "true" : "false")"
                                data-incoming="@item.IncomingCashierName"
                                data-has-incoming="@(item.HasIncoming ? "true" : "false")"
                                data-initial="@item.InitialCash"
                                data-revenue="@item.MachineCashRevenue"
                                data-bank="@item.BankTransferRevenue"
                                data-theoretical="@item.TheoreticalCash"
                                data-actual="@item.ActualCash"
                                data-discrepancy="@item.Discrepancy"
                                data-retained="@item.RetainedCash"
                                data-deposited="@item.DepositedCash"
                                data-deliverer="@(item.DelivererName ?? "")"
                                data-emergency-reason="@(item.EmergencyReason ?? "")"
                                data-notes="@(item.Notes ?? "")"
                                data-opened-at="@item.OpenedAt"
                                data-closed-at="@item.ClosedAt"
                                data-status="@item.Status">
                                <td class="ps-3 text-secondary">@stt</td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.ActionTime</span>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">@item.ActionTimeType</small>
                                </td>
                                <td>
                                    @if (item.SessionType.Contains("Mở ca"))
                                    {
                                        <span class="badge bg-primary px-2.5 py-1 rounded-pill">
                                            <i class="bi bi-door-open me-1"></i>@item.SessionType
                                        </span>
                                    }
                                    else if (item.SessionType.Contains("Đóng ca"))
                                    {
                                        <span class="badge bg-danger px-2.5 py-1 rounded-pill">
                                            <i class="bi bi-door-closed-fill me-1"></i>@item.SessionType
                                        </span>
                                    }
                                    else if (item.SessionType.Contains("đột xuất"))
                                    {
                                        <span class="badge bg-warning text-dark px-2.5 py-1 rounded-pill">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@item.SessionType
                                        </span>
                                    }
                                    else if (item.SessionType.Contains("liên tiếp"))
                                    {
                                        <span class="badge bg-info text-dark px-2.5 py-1 rounded-pill">
                                            <i class="bi bi-arrow-repeat me-1"></i>@item.SessionType
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success px-2.5 py-1 rounded-pill">
                                            <i class="bi bi-arrow-left-right me-1"></i>@item.SessionType
                                        </span>
                                    }
                                </td>
                                <td class="fw-semibold text-dark">@item.ShiftName</td>
                                <td>
                                    @if (item.HasOutgoing && item.OutgoingCashierName != "-")
                                    {
                                        <span class="fw-semibold text-primary">
                                            <i class="bi bi-person-badge me-1"></i>@item.OutgoingCashierName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fw-normal fst-italic">–</span>
                                    }
                                </td>
                                <td>
                                    @if (item.HasIncoming && item.IncomingCashierName != "-")
                                    {
                                        <span class="fw-semibold text-success">
                                            <i class="bi bi-person-check me-1"></i>@item.IncomingCashierName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fw-normal fst-italic">–</span>
                                    }
                                </td>
                                <td class="text-end fw-bold text-dark">@item.ActualCash</td>
                                <td class="text-end fw-bold @discClass">@item.Discrepancy</td>
                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5 rounded">Đang mở</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-0.5 rounded">Đã chốt</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-link text-primary text-decoration-none fw-bold p-0" onclick="showDetailModal(this)">
                                        <i class="bi bi-eye me-1"></i>Chi tiết
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="mt-3">
            <nav aria-label="Phân trang">
                <ul class="pagination pagination-sm justify-content-center m-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="History" asp-route-page="@(Model.PageIndex - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link @(i == Model.PageIndex ? "fw-bold" : "")" asp-action="History" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="History" asp-route-page="@(Model.PageIndex + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Modal Chi Tiết Phiên Giao Ca -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-text text-primary fs-4"></i>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="detailModalLabel">CHI TIẾT PHIÊN ĐỐI SOÁT &amp; BÀN GIAO CA</h5>
                        <small class="text-muted" id="detailSubTitle">–</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Thông tin nhân sự phân định rõ ràng -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 border rounded bg-light h-100">
                            <span class="text-muted small d-block mb-1"><i class="bi bi-person-badge me-1"></i>Thu ngân bàn giao ca:</span>
                            <strong id="modalOutgoing" class="fs-6 text-dark">–</strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 border rounded bg-light h-100">
                            <span class="text-muted small d-block mb-1"><i class="bi bi-person-check me-1"></i>Thu ngân nhận ca:</span>
                            <strong id="modalIncoming" class="fs-6 text-success">–</strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 border rounded bg-light h-100">
                            <span class="text-muted small d-block mb-1"><i class="bi bi-person-lines-fill me-1"></i>Người nhận tiền nộp / Đại diện:</span>
                            <strong id="modalDeliverer" class="fs-6 text-primary">–</strong>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Cột Trái: Bảng Dòng Tiền & Đối Soát -->
                    <div class="col-lg-7">
                        <div class="card border h-100">
                            <div class="card-header bg-white py-2.5">
                                <h6 class="fw-bold text-primary mb-0">
                                    <i class="bi bi-calculator me-1"></i>DÒNG TIỀN VÀ ĐỐI SOÁT KÉT THỰC TẾ
                                </h6>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-sm table-borderless align-middle mb-0">
                                    <tbody>
                                        <tr class="border-bottom">
                                             <td class="ps-3 py-2 text-muted fw-semibold">Tiền mặt đầu ca:</td>
                                            <td class="pe-3 py-2 text-end fw-bold text-dark fs-6" id="modalInitial">–</td>
                                        </tr>
                                        <tr class="border-bottom">
                                            <td class="ps-3 py-2 text-muted fw-semibold">Doanh thu tiền mặt từ POS:</td>
                                            <td class="pe-3 py-2 text-end fw-bold text-success fs-6" id="modalRevenue">–</td>
                                        </tr>
                                        <tr class="border-bottom">
                                            <td class="ps-3 py-2 text-muted fw-semibold">Doanh thu chuyển khoản (CK - Không vào két):</td>
                                            <td class="pe-3 py-2 text-end fw-bold text-secondary fs-6" id="modalBank">–</td>
                                        </tr>
                                        <tr class="table-primary border-bottom">
                                            <td class="ps-3 py-2.5 text-primary fw-bold">Tổng tiền mặt lý thuyết trong két:</td>
                                            <td class="pe-3 py-2.5 text-end fw-bold text-primary fs-5" id="modalTheoretical">–</td>
                                        </tr>
                                        <tr class="border-bottom">
                                            <td class="ps-3 py-2.5 text-dark fw-bold">Tiền mặt thực tế đếm được trong két:</td>
                                            <td class="pe-3 py-2.5 text-end fw-bold text-dark fs-5" id="modalActual">–</td>
                                        </tr>
                                        <tr class="bg-light">
                                            <td class="ps-3 py-2.5 fw-bold">Chênh lệch két (Thực tế - Lý thuyết):</td>
                                            <td class="pe-3 py-2.5 text-end fw-bold fs-5" id="modalDiscrepancy">–</td>
                                        </tr>
                                        <tr class="border-top d-none table-info" id="modalRetainedRow">
                                            <td class="ps-3 py-2 text-dark fw-semibold"><i class="bi bi-safe me-1"></i>Tiền giữ lại két cho sáng mai:</td>
                                            <td class="pe-3 py-2 text-end fw-bold text-dark fs-6" id="modalRetained">–</td>
                                        </tr>
                                        <tr class="border-top d-none table-warning" id="modalDepositedRow">
                                            <td class="ps-3 py-2 text-dark fw-semibold"><i class="bi bi-cash-stack me-1"></i>Số tiền chênh lệch:</td>
                                            <td class="pe-3 py-2 text-end fw-bold text-dark fs-6" id="modalDeposited">–</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Cột Phải: Ghi Chú, Lý Do Đột Xuất, Thời Gian -->
                    <div class="col-lg-5">
                        <div class="card border h-100 d-flex flex-column">
                            <div class="card-header bg-white py-2.5">
                                <h6 class="fw-bold text-dark mb-0">
                                    <i class="bi bi-chat-left-text me-1"></i>GHI CHÚ &amp; GIẢI TRÌNH PHIÊN
                                </h6>
                            </div>
                            <div class="card-body d-flex flex-column gap-3">
                                <div class="d-flex justify-content-between small text-muted border-bottom pb-2">
                                    <span>Mốc thời gian thực hiện:</span>
                                    <strong class="text-dark" id="modalActionTime">–</strong>
                                </div>
                                <div class="d-flex justify-content-between small text-muted border-bottom pb-2">
                                    <span>Thời điểm mở ca:</span>
                                    <strong class="text-dark" id="modalOpenedAt">–</strong>
                                </div>
                                <div class="d-flex justify-content-between small text-muted border-bottom pb-2">
                                    <span>Thời điểm đóng / chốt ca:</span>
                                    <strong class="text-dark" id="modalClosedAt">–</strong>
                                </div>

                                <div id="modalEmergencyWrapper" class="d-none">
                                    <label class="fw-semibold text-danger small mb-1">
                                        <i class="bi bi-exclamation-octagon-fill me-1"></i>Lý do bàn giao đột xuất:
                                    </label>
                                    <div class="p-2 border border-danger-subtle bg-danger-subtle text-danger rounded small fw-semibold" id="modalEmergencyReason">
                                        –
                                    </div>
                                </div>

                                <div class="flex-grow-1">
                                    <label class="fw-semibold text-muted small mb-1">Nội dung ghi chú / Giải trình chênh lệch:</label>
                                    <div class="p-3 border rounded bg-light small" id="modalNotes" style="min-height: 100px; white-space: pre-wrap;">
                                        –
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2.5">
                <button type="button" class="btn btn-secondary btn-sm fw-semibold px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var detailModalInstance = null;

        function showDetailModal(btn) {
            const row = btn.closest('tr');
            if (!row) return;

            const sessionType = row.dataset.rawSessionType || '';
            const date        = row.dataset.date || '';
            const shift       = row.dataset.shift || '';
            const actionTime  = row.dataset.actionTime || '–';
            const actionType  = row.dataset.actionTimeType || '–';
            const hasOutgoing = row.dataset.hasOutgoing === 'true';
            const hasIncoming = row.dataset.hasIncoming === 'true';
            const outgoing    = row.dataset.outgoing || '–';
            const incoming    = row.dataset.incoming || '–';
            const initial     = row.dataset.initial || '0 đ';
            const revenue     = row.dataset.revenue || '0 đ';
            const bank        = row.dataset.bank || '0 đ';
            const theoretical = row.dataset.theoretical || '0 đ';
            const actual      = row.dataset.actual || '0 đ';
            const discrepancy = row.dataset.discrepancy || '0 đ';
            const deliverer   = row.dataset.deliverer || '–';
            const emergency   = row.dataset.emergencyReason || '';
            const notes       = row.dataset.notes || '(Không có ghi chú)';
            const openedAt    = row.dataset.openedAt || '–';
            const closedAt    = row.dataset.closedAt || '–';

            document.getElementById('detailSubTitle').textContent = `Loại phiên: ${sessionType} • Ca làm: ${shift} • Ngày: ${date}`;
            
            document.getElementById('modalOutgoing').textContent = (hasOutgoing && outgoing !== '-') ? outgoing : '(Không áp dụng - Ca đầu ngày)';
            document.getElementById('modalIncoming').textContent = (hasIncoming && incoming !== '-') ? incoming : '(Không áp dụng - Khóa sổ két cuối ngày)';
            document.getElementById('modalDeliverer').textContent = deliverer || '–';
            
            document.getElementById('modalInitial').textContent = initial;
            document.getElementById('modalRevenue').textContent = (revenue.startsWith('+') || revenue.startsWith('-')) ? revenue : ('+' + revenue);
            document.getElementById('modalBank').textContent = bank;
            document.getElementById('modalTheoretical').textContent = theoretical;
            document.getElementById('modalActual').textContent = actual;
            document.getElementById('modalActionTime').textContent = `${actionTime} (${actionType})`;
            document.getElementById('modalOpenedAt').textContent = openedAt;
            document.getElementById('modalClosedAt').textContent = closedAt;

            const retained = row.dataset.retained || '0 đ';
            const deposited = row.dataset.deposited || '0 đ';
            const isClosing = sessionType.toLowerCase().includes('đóng ca');

            const retainedRow = document.getElementById('modalRetainedRow');
            const depositedRow = document.getElementById('modalDepositedRow');
            if (retainedRow && depositedRow) {
                if (isClosing) {
                    retainedRow.classList.remove('d-none');
                    depositedRow.classList.remove('d-none');
                    document.getElementById('modalRetained').textContent = retained;
                    document.getElementById('modalDeposited').textContent = deposited;
                } else {
                    retainedRow.classList.add('d-none');
                    depositedRow.classList.add('d-none');
                }
            }

            const discEl = document.getElementById('modalDiscrepancy');
            discEl.textContent = discrepancy;
            discEl.className = discrepancy.startsWith('-') ? 'pe-3 py-2.5 text-end fw-bold fs-5 text-danger' : 
                               (discrepancy.startsWith('+') ? 'pe-3 py-2.5 text-end fw-bold fs-5 text-success' : 'pe-3 py-2.5 text-end fw-bold fs-5 text-muted');

            const emergencyWrapper = document.getElementById('modalEmergencyWrapper');
            if (emergency && emergency.trim() !== '') {
                emergencyWrapper.classList.remove('d-none');
                document.getElementById('modalEmergencyReason').textContent = emergency;
            } else {
                emergencyWrapper.classList.add('d-none');
            }

            document.getElementById('modalNotes').textContent = notes;

            if (!detailModalInstance) {
                detailModalInstance = new bootstrap.Modal(document.getElementById('detailModal'));
            }
            detailModalInstance.show();
        }

        function applyFilter() {
            const sessionFilter = document.getElementById('filterSessionType').value.toLowerCase();
            const dateFrom = document.getElementById('filterDateFrom').value;
            const dateTo   = document.getElementById('filterDateTo').value;
            const searchKeyword = (document.getElementById('filterSearch').value || '').trim();

            document.querySelectorAll('.history-row').forEach(row => {
                const rowType = row.dataset.sessionType || '';
                const rawDate = row.dataset.date;
                const outgoing = row.dataset.outgoing || '';
                const incoming = row.dataset.incoming || '';
                const shift = row.dataset.shift || '';

                let rowDate = null;
                if (rawDate) {
                    const parts = rawDate.split('/');
                    if (parts.length === 3)
                        rowDate = new Date(parts[2], parts[1] - 1, parts[0]);
                }

                const typeOk = !sessionFilter || rowType.toLowerCase().includes(sessionFilter);
                const fromOk = !dateFrom || !rowDate || rowDate >= new Date(dateFrom);
                const toOk   = !dateTo   || !rowDate || rowDate <= new Date(dateTo);
                const searchOk = !searchKeyword || (window.CSMSSearch ? window.CSMSSearch.fuzzyMatchAny(searchKeyword, [outgoing, incoming, shift, rowType]) : (outgoing.toLowerCase().includes(searchKeyword.toLowerCase()) || incoming.toLowerCase().includes(searchKeyword.toLowerCase()) || shift.toLowerCase().includes(searchKeyword.toLowerCase()) || rowType.toLowerCase().includes(searchKeyword.toLowerCase())));

                row.style.display = (typeOk && fromOk && toOk && searchOk) ? '' : 'none';
            });
        }
    </script>
}

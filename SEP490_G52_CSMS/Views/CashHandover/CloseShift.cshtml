@model SEP490_G52_CSMS.Models.ViewModels.CloseShiftViewModel
@{
    ViewData["Title"] = "Đóng Ca Cuối Ngày - Quản Lý Kết Tiền";
}

<div class="container-fluid px-4">
    @* Tiêu đề module *@
    <div class="d-flex align-items-center justify-content-between mb-3 pt-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-0">ĐÓNG CA CUỐI NGÀY</h1>
            <p class="text-muted small mb-0">Ca làm việc: <strong>@Model.ShiftName (@Model.ShiftTimeRange)</strong> &bull; Chốt sổ doanh thu ngày: <strong>@Model.HandoverDate.ToString("dd/MM/yyyy")</strong></p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="EmergencyHandover"
               class="btn btn-warning text-dark btn-sm fw-bold">
                <i class="bi bi-exclamation-octagon me-1"></i>Bàn giao đột xuất
            </a>
            <a asp-action="History"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-clock-history me-1"></i>Lịch sử giao ca
            </a>
        </div>
    </div>

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>@TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <form asp-action="CloseShift" method="post" id="closeShiftForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="HandoverId" />
        <input type="hidden" asp-for="OutgoingCashierId" />
        <input type="hidden" asp-for="BranchId" />
        <input type="hidden" asp-for="InitialCash" id="initialCashHidden" />
        <input type="hidden" asp-for="MachineCashRevenue" id="machineRevenueHidden" />
        <input type="hidden" asp-for="CashRefundAmount" id="cashRefundHidden" />

        <div class="row g-3">
            <!-- CỘT TRÁI: DOANH THU & ĐỐI SOÁT CUỐI NGÀY -->
            <div class="col-md-6">
                <div class="card border shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3 text-primary">
                            <i class="bi bi-calculator me-1"></i>DOANH THU CA CUỐI NGÀY
                        </h6>

                        <!-- Bảng chi tiết doanh thu đối soát -->
                        <div class="table-responsive border rounded bg-white mb-3">
                            <table class="table table-sm table-borderless align-middle mb-0">
                                <tbody>
                                    <tr class="border-bottom">
                                        <td class="ps-3 py-2 text-muted fw-semibold" style="width: 58%;">Tiền mặt đầu ca:</td>
                                        <td class="pe-3 py-2 text-end fw-bold text-dark fs-6" style="width: 42%;">@Model.InitialCash.ToString("N0") đ</td>
                                    </tr>
                                    <tr class="border-bottom">
                                        <td class="ps-3 py-2 text-muted fw-semibold">Tiền mặt thu từ POS:</td>
                                        <td class="pe-3 py-2 text-end fw-bold text-success fs-6">+@Model.MachineCashRevenue.ToString("N0") đ</td>
                                    </tr>
                                    <tr class="border-bottom">
                                        <td class="ps-3 py-2 text-muted fw-semibold">Doanh thu CK (Không vào két):</td>
                                        <td class="pe-3 py-2 text-end fw-bold text-secondary fs-6">@Model.BankTransferRevenue.ToString("N0") đ</td>
                                    </tr>
                                    <tr class="table-primary border-top">
                                        <td class="ps-3 py-2.5 text-primary">
                                            <span class="fw-bold d-block">☑ Tổng tiền mặt lý thuyết trong két:</span>
                                            <small class="text-muted d-block font-monospace" style="font-size: 0.78rem;">(Đầu ca + Thu tiền mặt)</small>
                                        </td>
                                        <td class="pe-3 py-2.5 text-end fw-bold text-primary fs-5" id="displayTheoretical">
                                            @Model.TheoreticalCash.ToString("N0") đ
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <hr class="my-3" />

                        <h6 class="fw-bold mb-3 text-dark">
                            <i class="bi bi-cash-stack me-1"></i>KIỂM KÊ VÀ ĐỐI SOÁT CUỐI NGÀY
                        </h6>

                        <div class="mb-3">
                            <label asp-for="ActualCash" class="form-label fw-semibold small text-dark mb-1">
                                Tổng tiền mặt thực tế đếm trong két: <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="text" class="form-control form-control-lg fw-bold" id="actualCashDisplay"
                                       placeholder="Nhập tổng số tiền thực tế" value="@Model.ActualCash.ToString("N0")" inputmode="numeric" autocomplete="off" required />
                                <input asp-for="ActualCash" type="hidden" id="actualCashInput" value="@Model.ActualCash" />
                                <span class="input-group-text bg-light fw-bold">đ</span>
                            </div>
                            <span asp-validation-for="ActualCash" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1">Chênh lệch kết tiền cuối ngày:</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control bg-light fw-bold"
                                       id="discrepancyDisplay" readonly value="0 đ" />
                                <span class="input-group-text bg-light">đ</span>
                            </div>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Notes" class="form-label small text-muted mb-1" id="notesLabel">
                                Giải trình chênh lệch (nếu có):
                            </label>
                            <textarea asp-for="Notes" class="form-control form-control-sm" rows="3" id="notesInput"
                                      placeholder="Bắt buộc nhập nếu có chênh lệch tiền cuối ngày..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: PHÂN BỔ TIỀN VÀ XÁC NHẬN ĐÓNG CA -->
            <div class="col-md-6">
                <div class="card border shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3 text-danger">
                            <i class="bi bi-door-closed me-1"></i>PHÂN BỔ TIỀN VÀ ĐÓNG CA CUỐI NGÀY
                        </h6>

                        <div class="mb-3 p-3 bg-light rounded border">
                            <div class="row mb-2">
                                <div class="col-5 text-muted small">Thu ngân đóng ca:</div>
                                <div class="col-7 fw-bold text-dark">@Model.CashierName</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-5 text-muted small">Ca trực:</div>
                                <div class="col-7"><span class="badge bg-dark">@Model.ShiftName (Ca cuối ngày)</span></div>
                            </div>
                            <div class="row">
                                <div class="col-5 text-muted small">Thời điểm mở ca:</div>
                                <div class="col-7 small text-secondary">@Model.OpenedAt.ToString("HH:mm - dd/MM/yyyy")</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RetainedCashForTomorrow" class="form-label small fw-semibold text-dark mb-1">
                                Số tiền giữ lại trong két cho ca sáng mai:
                            </label>
                            <div class="input-group">
                                <input type="text" class="form-control fw-bold" id="retainedCashDisplay"
                                       placeholder="Số tiền để lại két..." value="@Model.RetainedCashForTomorrow.ToString("N0")" inputmode="numeric" autocomplete="off" />
                                <input asp-for="RetainedCashForTomorrow" type="hidden" id="retainedCashInput" value="@Model.RetainedCashForTomorrow" />
                                <span class="input-group-text bg-light">đ</span>
                            </div>
                            <span asp-validation-for="RetainedCashForTomorrow" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 p-3 bg-warning-subtle border border-warning rounded">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small fw-semibold text-dark">Số tiền nộp về két tổng / Chủ quán:</span>
                                <strong class="text-danger fs-6" id="depositedCashDisplay">0 đ</strong>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ReceiverName" class="form-label small fw-semibold text-dark mb-1">
                                Thông tin người nhận tiền nộp (Quản lý / Chủ quán / Két tổng): <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person-check text-secondary"></i></span>
                                <input asp-for="ReceiverName" class="form-control"
                                       placeholder="VD: Nguyễn Văn Quản Lý (hoặc Két tổng tầng 1)..." required />
                            </div>
                            <span asp-validation-for="ReceiverName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label small fw-semibold text-dark mb-1">
                                Mật khẩu của bạn để xác nhận đóng ca: <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="Password" type="password"
                                       class="form-control" id="passwordInput"
                                       placeholder="Nhập mật khẩu để ký xác nhận đóng ca" required />
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="togglePassword()" title="Hiện/Ẩn mật khẩu">
                                    <i class="bi bi-eye" id="eyeIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <a asp-controller="SaleManagement" asp-action="CreateOrder" class="btn btn-outline-secondary btn-lg flex-fill">
                                <i class="bi bi-x-circle me-2"></i>Hủy / Quay lại
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg flex-fill" id="submitCloseShiftBtn">
                                <i class="bi bi-lock-fill me-2"></i>Xác Nhận Đóng Ca Cuối Ngày
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const initialCash   = @Model.InitialCash;
        const machineRevenue = @Model.MachineCashRevenue;
        const theoretical   = initialCash + machineRevenue;

        const actualDisplay    = document.getElementById('actualCashDisplay');
        const actualInput      = document.getElementById('actualCashInput');
        const retainedDisplay  = document.getElementById('retainedCashDisplay');
        const retainedInput    = document.getElementById('retainedCashInput');
        const depositedDisplay = document.getElementById('depositedCashDisplay');
        const discDisplay      = document.getElementById('discrepancyDisplay');
        const notesLabel       = document.getElementById('notesLabel');
        const notesInput       = document.getElementById('notesInput');

        let currentDiff = 0;

        function updateCalculations() {
            const actual = parseFloat(actualInput.value) || 0;
            const retained = parseFloat(retainedInput.value) || 0;
            const deposited = Math.max(0, actual - retained);

            depositedDisplay.innerText = new Intl.NumberFormat('vi-VN').format(deposited) + ' đ';

            currentDiff = actual - theoretical;
            const fmt = new Intl.NumberFormat('vi-VN').format(Math.abs(currentDiff));

            if (currentDiff > 0) {
                discDisplay.value = '+' + fmt + ' đ';
                discDisplay.classList.remove('text-danger');
                discDisplay.classList.add('text-success');
                notesLabel.innerHTML = 'Giải trình chênh lệch <span class="text-danger fw-bold">* (Dư +' + fmt + 'đ - Bắt buộc nhập giải trình)</span>:';
                notesInput.required = true;
            } else if (currentDiff < 0) {
                discDisplay.value = '-' + fmt + ' đ';
                discDisplay.classList.remove('text-success');
                discDisplay.classList.add('text-danger');
                notesLabel.innerHTML = 'Giải trình chênh lệch <span class="text-danger fw-bold">* (Thiếu -' + fmt + 'đ - Bắt buộc nhập giải trình)</span>:';
                notesInput.required = true;
            } else {
                discDisplay.value = '0 đ';
                discDisplay.classList.remove('text-success', 'text-danger');
                notesLabel.innerHTML = 'Giải trình chênh lệch (không bắt buộc nếu khớp):';
                notesInput.required = false;
            }
        }

        if (actualDisplay) {
            actualDisplay.addEventListener('input', function () {
                const raw = this.value.replace(/\D/g, '');
                const num = parseInt(raw, 10) || 0;
                this.value = num > 0 ? new Intl.NumberFormat('vi-VN').format(num) : (raw === '0' ? '0' : '');
                actualInput.value = num;
                updateCalculations();
            });
        }

        if (retainedDisplay) {
            retainedDisplay.addEventListener('input', function () {
                const raw = this.value.replace(/\D/g, '');
                const num = parseInt(raw, 10) || 0;
                this.value = num > 0 ? new Intl.NumberFormat('vi-VN').format(num) : (raw === '0' ? '0' : '');
                retainedInput.value = num;
                updateCalculations();
            });
        }

        document.addEventListener('DOMContentLoaded', updateCalculations);
        updateCalculations();

        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon  = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }

        document.getElementById('closeShiftForm').addEventListener('submit', function (e) {
            if (this.dataset.confirmed === 'true') {
                if (this.dataset.submitting === 'true') {
                    e.preventDefault();
                    return false;
                }
                this.dataset.submitting = 'true';
                const btn = document.getElementById('submitCloseShiftBtn');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang xử lý...';
                }
                return true;
            }

            e.preventDefault();
            const form = this;
            showConfirmModal(
                'Xác nhận đóng ca',
                'Bạn có chắc chắn muốn xác nhận đóng ca và chốt két cuối ngày không?',
                function () {
                    form.dataset.confirmed = 'true';
                    $(form).submit();
                },
                'Đóng ca',
                'Hủy'
            );
        });
    </script>
}

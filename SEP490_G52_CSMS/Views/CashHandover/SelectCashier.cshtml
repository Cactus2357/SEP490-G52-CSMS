@model List<SEP490_G52_CSMS.Models.ViewModels.CashierSelectItemViewModel>
@{
    ViewData["Title"] = "Chọn Thu Ngân - Quản Lý Kết Tiền";
    string branchId = ViewBag.BranchId ?? "CN001";
}

<div class="container-fluid px-4">

    @* Tiêu đề *@
    <div class="d-flex align-items-center justify-content-between mb-3 pt-3">
        <h1 class="h3 fw-bold text-dark mb-0">QUẢN LÝ KẾT TIỀN &amp; GIAO CA</h1>
        <div class="d-flex gap-2">
            <a asp-action="OpenShift" class="btn btn-outline-secondary btn-sm">Mở ca</a>
            <a asp-action="Handover" class="btn btn-outline-secondary btn-sm">Giao &amp; Đóng ca</a>
            <a asp-action="History" class="btn btn-outline-secondary btn-sm">Lịch sử</a>
        </div>
    </div>

    @* Header *@
    <div class="d-flex align-items-center bg-light border rounded px-3 py-2 mb-4">
        <i class="bi bi-person-badge me-2 text-secondary"></i>
        <span class="fw-semibold text-uppercase text-secondary small">Chọn thu ngân thực hiện ca</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Chưa có thu ngân nào được phân công tại chi nhánh này.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var cashier in Model)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="card border h-100 @(cashier.HasActiveShift ? "border-success" : "border-secondary border-opacity-25") shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center me-3"
                                     style="width:48px; height:48px; flex-shrink:0">
                                    <i class="bi bi-person-fill text-primary fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">@cashier.CashierName</div>
                                    <div class="text-muted small">@@cashier.Username</div>
                                </div>
                            </div>

                            @if (cashier.HasActiveShift)
                            {
                                <div class="mb-3">
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                        <i class="bi bi-circle-fill me-1" style="font-size:8px"></i>
                                        Đang mở — @cashier.ActiveShiftName
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="mb-3">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">
                                        <i class="bi bi-circle me-1" style="font-size:8px"></i>
                                        Chưa mở ca hôm nay
                                    </span>
                                </div>
                            }

                            <div class="mt-auto d-grid gap-2">
                                @if (cashier.HasActiveShift)
                                {
                                    @* Ca đang mở → vào Giao ca *@
                                    <a asp-action="Handover" asp-route-cashierId="@cashier.CashierId"
                                       class="btn btn-success btn-sm">
                                        <i class="bi bi-arrow-left-right me-1"></i>Giao &amp; Đóng ca
                                    </a>
                                    <a asp-action="OpenShift" asp-route-cashierId="@cashier.CashierId"
                                       class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-eye me-1"></i>Xem mở ca
                                    </a>
                                }
                                else
                                {
                                    @* Chưa mở ca → vào Mở ca *@
                                    <a asp-action="OpenShift" asp-route-cashierId="@cashier.CashierId"
                                       class="btn btn-primary btn-sm">
                                        <i class="bi bi-door-open me-1"></i>Mở ca
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@model SEP490_G52_CSMS.Controllers.WarehouseImportHistoryViewModel

@{
    ViewData["Title"] = "Lịch Sử Nhập Hàng Từ Nhà Cung Cấp";
}

<div class="warehouse-page p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark m-0">LỊCH SỬ NHẬP HÀNG TỪ NHÀ CUNG CẤP</h2>
        <div class="d-flex gap-2">
            <a href="@Url.Action("CreateReceipt", "Warehouse")" class="btn btn-outline-dark fw-bold">
                <i class="bi bi-plus-lg me-2"></i> Lập phiếu mới
            </a>
            <a href="@Url.Action("ExportImportHistory", new { fromDate = Model.FromDate.ToString("yyyy-MM-dd"), toDate = Model.ToDate.ToString("yyyy-MM-dd") })" class="btn btn-outline-secondary fw-bold">
                <i class="bi bi-download me-2"></i> Tải xuống báo cáo
            </a>
        </div>
    </div>

    <!-- Error Alert -->
    @if (TempData["HistoryError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["HistoryError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Form -->
    <div class="card shadow-sm border-0 mb-4 rounded-3 bg-light">
        <div class="card-body py-3">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4 col-sm-6">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Từ ngày</label>
                    <input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                
                <div class="col-md-4 col-sm-6">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Đến ngày</label>
                    <input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>

                <div class="col-md-4 col-sm-12 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 py-2 fw-bold">Xem lịch sử</button>
                    <a asp-action="ImportHistory" class="btn btn-outline-secondary py-2"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- History Grid -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 15%;" class="ps-3">Mã phiếu</th>
                            <th style="width: 15%;">Ngày nhập</th>
                            <th style="width: 25%;">Nhà cung cấp</th>
                            <th style="width: 17%;">Nguyên liệu</th>
                            <th style="width: 10%;">Số lượng nhập</th>
                            <th style="width: 13%;">Thành tiền</th>
                            <th style="width: 15%;" class="text-center pe-3">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-primary">@item.WarehouseReceipt?.ReceiptCode</td>
                                    <td>@item.WarehouseReceipt?.ImportDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.WarehouseReceipt?.Supplier</td>
                                    <td class="fw-semibold">@item.Material?.MaterialName</td>
                                    <td>@item.Quantity.ToString("G29") @item.Material?.StorageUnit</td>
                                    <td class="fw-bold text-success">@item.Amount.ToString("N0") đ</td>
                                    <td class="text-center pe-3">
                                        <button type="button" class="btn btn-sm btn-link text-primary text-decoration-none fw-bold p-0" onclick="viewReceiptDetails('@item.WarehouseReceipt?.ReceiptCode')">
                                            Chi tiết
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary-subtle"></i>
                                    Không tìm thấy phiếu nhập phù hợp trong khoảng thời gian này.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white border-top py-3 d-flex justify-content-center">
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("ImportHistory", new { fromDate = Model.FromDate.ToString("yyyy-MM-dd"), toDate = Model.ToDate.ToString("yyyy-MM-dd"), page = Model.CurrentPage - 1 })">&laquo;</a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("ImportHistory", new { fromDate = Model.FromDate.ToString("yyyy-MM-dd"), toDate = Model.ToDate.ToString("yyyy-MM-dd"), page = p })">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("ImportHistory", new { fromDate = Model.FromDate.ToString("yyyy-MM-dd"), toDate = Model.ToDate.ToString("yyyy-MM-dd"), page = Model.CurrentPage + 1 })">&raquo;</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<!-- ==================== MODALS ==================== -->

<!-- Modal: Chi tiết phiếu nhập kho (UC60) -->
<div class="modal fade" id="receiptDetailModal" tabindex="-1" aria-labelledby="receiptDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="receiptDetailModalLabel">CHI TIẾT PHIẾU NHẬP KHO</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="card bg-light border-0 mb-4 rounded-3">
                    <div class="card-body p-3 fs-6">
                        <div class="row g-2">
                            <div class="col-md-4"><strong>Họ & Tên Người giao:</strong> <span id="dtDeliverer" class="fw-semibold text-dark"></span></div>
                            <div class="col-md-4"><strong>Số điện thoại:</strong> <span id="dtPhone" class="fw-semibold text-dark"></span></div>
                            <div class="col-md-4"><strong>Thời gian nhập kho:</strong> <span id="dtTime" class="fw-semibold text-dark"></span></div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Tên NgL</th>
                                <th>Kiểu NgL</th>
                                <th>Loại NgL</th>
                                <th>Đơn vị</th>
                                <th>NCC</th>
                                <th>Giá hàng</th>
                                <th>Số lượng</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody id="dtTableBody">
                            <!-- Loaded dynamically -->
                        </tbody>
                    </table>
                </div>

                <div class="p-3 bg-light-subtle rounded mt-3 border-top">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-5 fw-bold">Tổng tiền thanh toán:</span>
                        <span class="fs-4 fw-bold text-success" id="dtTotal"></span>
                    </div>
                    <div class="row g-2 small text-muted pt-2 border-top">
                        <div class="col-md-6"><strong>Người lập phiếu (Quản Kho):</strong> <span id="dtCreator" class="text-dark fw-semibold"></span></div>
                        <div class="col-md-6"><strong>Người nhận hàng:</strong> <span id="dtReceiver" class="text-dark fw-semibold"></span></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary fw-bold px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<style>
    .warehouse-page {
        background-color: #f8f9fa;
        min-height: calc(100vh - 70px);
    }
    .table th {
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        color: #495057;
    }
    .btn-outline-secondary {
        border-color: #dee2e6;
        color: #495057;
    }
    .btn-outline-secondary:hover {
        background-color: #f8f9fa;
        color: #212529;
        border-color: #adb5bd;
    }
</style>

@section Scripts {
    <script>
        function viewReceiptDetails(code) {
            $.ajax({
                url: '/Warehouse/GetReceiptDetails',
                type: 'GET',
                data: { code: code },
                success: function(r) {
                    $('#dtDeliverer').text(r.delivererName);
                    $('#dtPhone').text(r.delivererPhone);
                    $('#dtTime').text(r.importDate);
                    $('#dtTotal').text(r.totalAmount);
                    $('#dtCreator').text(r.createdBy);
                    $('#dtReceiver').text(r.receiverName);

                    let rows = "";
                    r.items.forEach(item => {
                        rows += `
                            <tr>
                                <td class="fw-bold text-dark">${item.materialName}</td>
                                <td>${item.materialKind}</td>
                                <td>${item.category}</td>
                                <td>${item.storageUnit}</td>
                                <td>${item.supplier}</td>
                                <td>${item.unitPrice}</td>
                                <td>${item.quantity}</td>
                                <td class="text-end fw-bold text-dark">${item.amount}</td>
                            </tr>
                        `;
                    });

                    $('#dtTableBody').html(rows);
                    $('#receiptDetailModal').modal('show');
                },
                error: function() {
                    showToast('Không thể tải chi tiết phiếu nhập. Vui lòng thử lại.', 'danger');
                }
            });
        }
    </script>
}

@model SEP490_G52_CSMS.Controllers.ExportRequestsViewModel

@{
    ViewData["Title"] = "Danh Sách Đơn Yêu Cầu Xuất Kho";
}

<div class="warehouse-page p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark m-0">DANH SÁCH ĐƠN YÊU CẦU XUẤT KHO (TỪ CHI NHÁNH)</h2>
        <div>
            <a href="@Url.Action("ExportRequestsCsv", new { fromDate = Model.FromDate.ToString("yyyy-MM-dd"), toDate = Model.ToDate.ToString("yyyy-MM-dd"), status = Model.SelectedStatus })" class="btn btn-outline-dark fw-bold">
                <i class="bi bi-download me-2"></i> Tải xuống báo cáo
            </a>
        </div>
    </div>

    <!-- Error Alert -->
    @if (TempData["ExportError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ExportError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Form -->
    <div class="card shadow-sm border-0 mb-4 rounded-3 bg-light">
        <div class="card-body py-3">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Từ ngày</label>
                    <input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Đến ngày</label>
                    <input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>

                <div class="col-md-3 col-sm-6">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Trạng thái</label>
                    <select name="status" class="form-select">
                        <option value="Tất cả" selected="@(Model.SelectedStatus == "Tất cả")">Tất cả</option>
                        <option value="Chờ duyệt" selected="@(Model.SelectedStatus == "Chờ duyệt")">Chờ duyệt</option>
                        <option value="Đang chuẩn bị xuất" selected="@(Model.SelectedStatus == "Đang chuẩn bị xuất")">Đang chuẩn bị xuất</option>
                        <option value="Đã xuất kho" selected="@(Model.SelectedStatus == "Đã xuất kho")">Đã xuất kho</option>
                        <option value="Đã hoàn thành" selected="@(Model.SelectedStatus == "Đã hoàn thành")">Đã hoàn thành</option>
                        <option value="Từ chối" selected="@(Model.SelectedStatus == "Từ chối")">Từ chối</option>
                        <option value="Đã hủy" selected="@(Model.SelectedStatus == "Đã hủy")">Đã hủy</option>
                    </select>
                </div>

                <div class="col-md-3 col-sm-12 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 py-2 fw-bold">Xem yêu cầu</button>
                    <a asp-action="ExportRequests" class="btn btn-outline-secondary py-2"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Requests Grid -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle m-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 15%;" class="ps-3">Mã đơn</th>
                            <th style="width: 20%;">Ngày yêu cầu</th>
                            <th style="width: 25%;">Chi nhánh</th>
                            <th style="width: 20%;">Trạng thái</th>
                            <th style="width: 20%;" class="text-center pe-3">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Requests != null && Model.Requests.Any())
                        {
                            foreach (var item in Model.Requests)
                            {
                                string badgeClass = item.Status == "Chờ duyệt" ? "bg-warning text-dark" :
                                                   item.Status == "Đang chuẩn bị xuất" ? "bg-primary text-white" :
                                                   item.Status == "Đã xuất kho" ? "bg-info text-dark" :
                                                   item.Status == "Đã hoàn thành" ? "bg-success text-white" :
                                                   item.Status == "Từ chối" ? "bg-danger text-white" : "bg-secondary text-white";

                                string rowStyle = item.Status == "Chờ duyệt" ? "table-warning fw-semibold" :
                                                   item.Status == "Đang chuẩn bị xuất" ? "table-primary fw-semibold" :
                                                   item.Status == "Đã xuất kho" ? "table-info fw-semibold" :
                                                   item.Status == "Đã hoàn thành" ? "table-success" :
                                                   item.Status == "Từ chối" ? "table-danger" : "table-secondary";

                                <tr class="@rowStyle" data-code="@item.RequestCode">
                                    <td class="ps-3 fw-bold">@item.RequestCode</td>
                                    <td>@item.RequestDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.Branch?.BranchName</td>
                                    <td class="status-cell"><span class="badge @badgeClass rounded-pill px-3 py-2">@item.Status</span></td>
                                    <td class="text-center pe-3">
                                        <button type="button" class="btn btn-sm btn-link text-decoration-none fw-bold" onclick="viewExportRequestDetails('@item.RequestCode')">
                                            [Chi tiết]
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary-subtle"></i>
                                    Không tìm thấy đơn yêu cầu xuất kho nào phù hợp.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white border-top py-3 d-flex justify-content-center">
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("ExportRequests", new { fromDate = Model.FromDate.ToString("yyyy-MM-dd"), toDate = Model.ToDate.ToString("yyyy-MM-dd"), status = Model.SelectedStatus, page = Model.CurrentPage - 1 })">&laquo;</a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("ExportRequests", new { fromDate = Model.FromDate.ToString("yyyy-MM-dd"), toDate = Model.ToDate.ToString("yyyy-MM-dd"), status = Model.SelectedStatus, page = p })">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("ExportRequests", new { fromDate = Model.FromDate.ToString("yyyy-MM-dd"), toDate = Model.ToDate.ToString("yyyy-MM-dd"), status = Model.SelectedStatus, page = Model.CurrentPage + 1 })">&raquo;</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<!-- ==================== MODALS ==================== -->

<!-- ==================== MODALS ==================== -->

<!-- Modal: Đơn duyệt (UC66 / UC67) -->
<div class="modal fade" id="requestProcessModal" tabindex="-1" aria-labelledby="requestProcessModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="requestProcessModalLabel">Chi tiết đơn yêu cầu xuất kho</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Step 1: Process Details Form (Screen A for "Chờ duyệt") -->
                <div id="processScreenA">
                    <!-- Info Header -->
                    <div class="card bg-light border-0 mb-4 rounded-3">
                        <div class="card-body py-3 small text-dark fs-6">
                            <div class="row g-2">
                                <div class="col-md-4"><strong>Mã đơn:</strong> <span id="hdrCodeA" class="fw-bold text-primary"></span></div>
                                <div class="col-md-4"><strong>Chi nhánh:</strong> <span id="hdrBranch" class="fw-semibold"></span></div>
                                <div class="col-md-4"><strong>Trạng thái đơn:</strong> <span id="hdrStatusA"></span></div>
                                <div class="col-md-4"><strong>Người tạo đơn:</strong> <span id="hdrCreator" class="fw-semibold"></span></div>
                                <div class="col-md-4"><strong>SĐT:</strong> <span id="hdrPhone" class="fw-semibold"></span></div>
                                <div class="col-md-4"><strong>Ngày yêu cầu:</strong> <span id="hdrDate" class="fw-semibold"></span></div>
                            </div>
                        </div>
                    </div>

                    <!-- Items Table -->
                    <h6 class="fw-bold mb-2">Chi tiết nguyên vật liệu yêu cầu</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên NgL</th>
                                    <th>Loại NgL</th>
                                    <th>Yêu cầu</th>
                                    <th>Tồn kho (Tổng)</th>
                                    <th>Trạng thái tồn kho</th>
                                    <th style="width: 15%;">Số lượng thực xuất</th>
                                    <th class="text-center">Hành động</th>
                                </tr>
                            </thead>
                            <tbody id="releasedItemsTableBody">
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Note input -->
                    <div class="mb-3 mt-3">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">Ghi chú tổng kho</label>
                        <input type="text" id="warehouseNoteInput" class="form-control" placeholder="Nhập ghi chú cho chi nhánh (nếu có)..." maxlength="200" />
                    </div>

                    <!-- Hint note -->
                    <div class="mt-4 bg-light p-3 rounded border border-light-subtle">
                        <p class="m-0 text-danger small"><i class="bi-exclamation-triangle-fill me-1"></i> <strong>Lưu ý:</strong> Khi chọn so sánh sẽ tự động kiểm tra số lượng tồn kho, so sánh số lượng yêu cầu và số lượng có trong kho từ đó đưa ra trạng thái <strong>'Đủ'</strong> và <strong>'Thiếu'</strong>. Quản lý phải tự nhập số lượng thực xuất theo trạng thái tồn kho.</p>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 border-top pt-3">
                        <button type="button" class="btn btn-outline-secondary px-4 fw-bold" onclick="runStockComparison()">So sánh</button>
                        <button type="button" class="btn btn-outline-dark px-4 fw-bold" onclick="updateReleasedQuantities()">Cập nhật SL thực xuất</button>
                        <button type="button" class="btn btn-success px-4 fw-bold" onclick="approveAndPrepare()">Duyệt đơn & Chuẩn bị xuất</button>
                    </div>
                </div>

                <!-- Step 2: Preparing Shipment Form (Screen B for "Đang chuẩn bị xuất") -->
                <div id="processScreenB" class="d-none">
                    <div class="card bg-light border-0 mb-4 rounded-3">
                        <div class="card-body py-3 small text-dark fs-6">
                            <div class="row g-2">
                                <div class="col-md-4"><strong>Mã đơn:</strong> <span id="hdrCodeB" class="fw-bold text-primary"></span></div>
                                <div class="col-md-4"><strong>Chi nhánh:</strong> <span id="hdrBranchB" class="fw-semibold"></span></div>
                                <div class="col-md-4"><strong>Trạng thái đơn:</strong> <span id="hdrStatusB"></span></div>
                                <div class="col-md-4"><strong>Người tạo đơn:</strong> <span id="hdrCreatorB" class="fw-semibold"></span></div>
                                <div class="col-md-4"><strong>Ngày yêu cầu:</strong> <span id="hdrDateB" class="fw-semibold"></span></div>
                                <div class="col-md-4"><strong>Người duyệt:</strong> <span id="hdrApproverB" class="fw-semibold text-primary"></span></div>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-2">Chi tiết nguyên vật liệu chuẩn bị xuất kho</h6>
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên NgL</th>
                                    <th>Loại NgL</th>
                                    <th>Yêu cầu</th>
                                    <th>Số lượng thực xuất đã duyệt</th>
                                </tr>
                            </thead>
                            <tbody id="pbItemsTableBody">
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>

                    <div class="text-center py-3 bg-light rounded border p-3">
                        <i class="bi bi-box-seam text-primary fs-3 mb-2 d-block"></i>
                        <p class="text-secondary small mb-3">Vui lòng kiểm tra và đóng gói nguyên liệu theo danh sách trên trước khi xác nhận xuất kho.</p>
                        <button type="button" class="btn btn-success px-5 py-2 fw-bold" onclick="confirmShipment()">
                            <i class="bi bi-check-circle me-1"></i> Xác nhận Đã xuất kho
                        </button>
                    </div>
                </div>

                <!-- Step 3: Release Form / Complete Read-Only (UC67 & Screen C) -->
                <div id="processScreenC" class="d-none">
                    <div class="card bg-light border-0 mb-4 rounded-3">
                        <div class="card-body py-3 small text-dark fs-6">
                            <div class="row g-2">
                                <div class="col-md-4"><strong>Mã đơn:</strong> <span id="roCode" class="fw-bold text-primary"></span></div>
                                <div class="col-md-4"><strong>Chi nhánh:</strong> <span id="roBranch" class="fw-semibold"></span></div>
                                <div class="col-md-4"><strong>Trạng thái đơn:</strong> <span id="roStatus"></span></div>
                                <div class="col-md-4"><strong>Người tạo đơn:</strong> <span id="roCreator" class="fw-semibold"></span></div>
                                <div class="col-md-4"><strong>Ngày yêu cầu:</strong> <span id="roDate" class="fw-semibold"></span></div>
                                <div class="col-md-4"><strong>Người duyệt:</strong> <span id="roApprovedBy" class="fw-semibold"></span></div>
                                <div class="col-md-6"><strong>Người giao / SĐT:</strong> <span id="roDeliverer" class="fw-semibold text-primary"></span></div>
                                <div class="col-md-6"><strong>Ghi chú tổng kho:</strong> <span id="roNote" class="fw-semibold"></span></div>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-2">Chi tiết nguyên vật liệu</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên NgL</th>
                                    <th>Loại NgL</th>
                                    <th>Yêu cầu</th>
                                    <th>Số lượng thực xuất</th>
                                    <th class="text-center">Hành động</th>
                                </tr>
                            </thead>
                            <tbody id="roItemsTableBody">
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <div class="modal-footer bg-light" id="generalModalFooter">
                <button type="button" class="btn btn-secondary fw-bold px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<style>
    .warehouse-page {
        background-color: #f8f9fa;
        min-height: calc(100vh - 70px);
    }
    .table th {
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        color: #495057;
    }
    .btn-outline-secondary {
        border-color: #dee2e6;
        color: #495057;
    }
    .btn-outline-secondary:hover {
        background-color: #f8f9fa;
        color: #212529;
        border-color: #adb5bd;
    }
</style>

@section Scripts {
    <script>
        let currentRequestCode = null;
        let requestDetails = null;

        function getStatusBadgeHtml(status) {
            let badgeClass = "bg-secondary text-white";
            if (status === "Chờ duyệt") badgeClass = "bg-warning text-dark";
            else if (status === "Đang chuẩn bị xuất") badgeClass = "bg-primary text-white";
            else if (status === "Đã xuất kho") badgeClass = "bg-info text-dark";
            else if (status === "Đã hoàn thành") badgeClass = "bg-success text-white";
            else if (status === "Từ chối") badgeClass = "bg-danger text-white";
            else if (status === "Đã hủy") badgeClass = "bg-secondary text-white";
            return `<span class="badge ${badgeClass} rounded-pill px-3 py-2">${status}</span>`;
        }

        // --- 1. DETAILS LOADER ---
        function viewExportRequestDetails(code) {
            currentRequestCode = code;

            // Reset modal screen views
            $('#processScreenA').addClass('d-none');
            $('#processScreenB').addClass('d-none');
            $('#processScreenC').addClass('d-none');
            $('#generalModalFooter').removeClass('d-none');

            $.ajax({
                url: '/Warehouse/GetBranchRequestDetails',
                type: 'GET',
                data: { code: code },
                success: function(r) {
                    requestDetails = r;
                    $('#requestProcessModalLabel').text('Chi tiết đơn yêu cầu xuất kho: ' + r.requestCode);

                    if (r.status === "Chờ duyệt") {
                        // Render Screen A
                        $('#hdrCodeA').text(r.requestCode);
                        $('#hdrBranch').text(r.branchName);
                        $('#hdrStatusA').html(getStatusBadgeHtml(r.status));
                        $('#hdrCreator').text(r.creatorName);
                        $('#hdrPhone').text(r.creatorPhone);
                        $('#hdrDate').text(r.requestDate);
                        $('#warehouseNoteInput').val(r.warehouseNote);

                        let rows = "";
                        r.items.forEach(item => {
                            let stock = parseFloat(item.centralStock) || 0;
                            let requested = parseFloat(item.quantityRequested) || 0;
                            let initialReleased = item.quantityReleased !== "" ? item.quantityReleased : Math.min(requested, stock);
                            let catText = item.category ? item.category : (item.materialKind || '');
                            if (item.category && item.materialKind) catText = `${item.category} (${item.materialKind})`;

                            rows += `
                                <tr class="item-row" data-id="${item.materialId}" data-requested="${item.quantityRequested}" data-stock="${item.centralStock}">
                                    <td class="fw-bold">${item.materialName}</td>
                                    <td>${catText}</td>
                                    <td class="fw-semibold">${item.quantityRequested} ${item.storageUnit}</td>
                                    <td class="text-secondary">${item.centralStock} ${item.storageUnit}</td>
                                    <td class="comparison-status text-muted">Chưa so sánh</td>
                                    <td>
                                        <div class="input-group input-group-sm" style="max-width: 140px;">
                                            <span class="input-group-text">[</span>
                                            <input type="number" class="form-control released-input" value="${initialReleased}" min="0" step="any" />
                                            <span class="input-group-text">] ${item.storageUnit}</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-link text-primary p-0" onclick="drilldownLineTrace('${item.materialName}')">
                                            [Chi tiết]
                                        </button>
                                    </td>
                                </tr>
                            `;
                        });

                        $('#releasedItemsTableBody').html(rows);
                        $('#processScreenA').removeClass('d-none');
                        $('#generalModalFooter').addClass('d-none'); // custom footer in Screen A is used instead

                    } else if (r.status === "Đang chuẩn bị xuất") {
                        // Render Screen B
                        $('#hdrCodeB').text(r.requestCode);
                        $('#hdrBranchB').text(r.branchName);
                        $('#hdrStatusB').html(getStatusBadgeHtml(r.status));
                        $('#hdrCreatorB').text(r.creatorName);
                        $('#hdrDateB').text(r.requestDate);
                        $('#hdrApproverB').text(r.approvedBy || 'Warehouse Manager');

                        let pbRows = "";
                        r.items.forEach(item => {
                            let releasedQty = item.quantityReleased !== "" ? item.quantityReleased : item.quantityRequested;
                            let catText = item.category ? item.category : (item.materialKind || '');
                            if (item.category && item.materialKind) catText = `${item.category} (${item.materialKind})`;

                            pbRows += `
                                <tr>
                                    <td class="fw-bold text-dark">${item.materialName}</td>
                                    <td>${catText}</td>
                                    <td>${item.quantityRequested} ${item.storageUnit}</td>
                                    <td class="fw-bold text-success">[${releasedQty}] ${item.storageUnit}</td>
                                </tr>
                            `;
                        });
                        $('#pbItemsTableBody').html(pbRows);

                        $('#processScreenB').removeClass('d-none');
                        $('#generalModalFooter').removeClass('d-none');

                    } else {
                        // Render Screen C (Completed, Shipped, Rejected, Cancelled)
                        $('#roCode').text(r.requestCode);
                        $('#roBranch').text(r.branchName);
                        $('#roStatus').html(getStatusBadgeHtml(r.status));

                        $('#roCreator').text(r.creatorName);
                        $('#roDate').text(r.requestDate);
                        $('#roApprovedBy').text(r.approvedBy || 'Chưa duyệt');
                        
                        let delivererText = "Không có";
                        if (r.delivererName) {
                            delivererText = `${r.delivererName} / Sđt: ${r.delivererPhone || 'Không có'}`;
                        }
                        $('#roDeliverer').text(delivererText);
                        $('#roNote').text(r.warehouseNote || 'Không có');

                        let rows = "";
                        r.items.forEach(item => {
                            let releasedQty = "-";
                            if (r.status === "Đã xuất kho" || r.status === "Đã hoàn thành") {
                                releasedQty = item.quantityReleased !== "" ? `[${item.quantityReleased}] ${item.storageUnit}` : `[0] ${item.storageUnit}`;
                            }
                            let catText = item.category ? item.category : (item.materialKind || '');
                            if (item.category && item.materialKind) catText = `${item.category} (${item.materialKind})`;

                            rows += `
                                <tr>
                                    <td class="fw-bold text-dark">${item.materialName}</td>
                                    <td>${catText}</td>
                                    <td>${item.quantityRequested} ${item.storageUnit}</td>
                                    <td class="fw-bold ${r.status === "Từ chối" || r.status === "Đã hủy" ? "text-muted" : "text-success"}">${releasedQty}</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-link text-primary p-0" onclick="drilldownLineTrace('${item.materialName}')">
                                            [Chi tiết]
                                        </button>
                                    </td>
                                </tr>
                            `;
                        });

                        $('#roItemsTableBody').html(rows);
                        $('#processScreenC').removeClass('d-none');
                        $('#generalModalFooter').removeClass('d-none');
                    }

                    $('#requestProcessModal').modal('show');
                },
                error: function() {
                    showToast('Không thể tải chi tiết phiếu yêu cầu.', 'danger');
                }
            });
        }

        // --- 2. TRACE DRILLDOWN ---
        function drilldownLineTrace(name) {
            showToast(`[Chi tiết] Nguồn gốc xuất xứ lô hàng của "${name}": Được phân tách tự động theo các lô nhập seeded của NCC Trung Nguyên và Vinamilk.`, 'success');
        }

        // --- 3. STOCK COMPARISON ---
        function runStockComparison() {
            $('#releasedItemsTableBody tr').each(function() {
                let requested = parseFloat($(this).attr('data-requested'));
                let stock = parseFloat($(this).attr('data-stock'));
                
                let isEnough = stock >= requested;
                let statusCell = $(this).find('.comparison-status');

                if (isEnough) {
                    statusCell.html('<span class="badge bg-success-subtle text-success">Đủ</span>');
                } else {
                    statusCell.html('<span class="badge bg-danger-subtle text-danger">Thiếu</span>');
                    let input = $(this).find('.released-input');
                    if (parseFloat(input.val()) > stock) {
                        input.val(stock);
                    }
                }
            });
        }

        // --- 4. UPDATE DRAFT RELEASED QUANTITIES ---
        function updateReleasedQuantities() {
            if (!currentRequestCode) return;

            let itemsPayload = [];
            let isValid = true;

            $('#releasedItemsTableBody tr').each(function() {
                let matId = parseInt($(this).attr('data-id'));
                let stock = parseFloat($(this).attr('data-stock'));
                let val = parseFloat($(this).find('.released-input').val());

                if (isNaN(val) || val < 0) {
                    showToast('Số lượng thực xuất phải lớn hơn hoặc bằng 0.', 'warning');
                    isValid = false;
                    return false;
                }

                // BR03: released quantity cannot exceed central stock
                if (val > stock) {
                    let name = $(this).find('td:first').text();
                    showToast(`Số lượng thực xuất của "${name}" vượt quá tồn kho hiện có (${stock}).`, 'warning');
                    isValid = false;
                    return false;
                }

                itemsPayload.push({
                    materialId: matId,
                    quantityReleased: val
                });
            });

            if (!isValid) return;

            let payload = {
                requestCode: currentRequestCode,
                warehouseNote: $('#warehouseNoteInput').val().trim(),
                items: itemsPayload
            };

            $.ajax({
                url: '/Warehouse/UpdateReleasedQuantities',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    if (res.success) {
                        showToast(res.message, 'success');
                    } else {
                        showToast(res.message, 'danger');
                    }
                },
                error: function() {
                    showToast('Lỗi kết nối máy chủ khi cập nhật số lượng.', 'danger');
                }
            });
        }

        // --- 5. APPROVE & PREPARE ---
        function approveAndPrepare() {
            if (!currentRequestCode) return;

            // Ensure quantities are updated first
            let itemsPayload = [];
            let isValid = true;

            $('#releasedItemsTableBody tr').each(function() {
                let matId = parseInt($(this).attr('data-id'));
                let stock = parseFloat($(this).attr('data-stock'));
                let val = parseFloat($(this).find('.released-input').val());

                if (isNaN(val) || val < 0) {
                    showToast('Số lượng thực xuất phải lớn hơn hoặc bằng 0.', 'warning');
                    isValid = false;
                    return false;
                }

                if (val > stock) {
                    let name = $(this).find('td:first').text();
                    showToast(`Số lượng thực xuất của "${name}" vượt quá tồn kho hiện có (${stock}).`, 'warning');
                    isValid = false;
                    return false;
                }

                itemsPayload.push({
                    materialId: matId,
                    quantityReleased: val
                });
            });

            if (!isValid) return;

            let payload = {
                requestCode: currentRequestCode,
                warehouseNote: $('#warehouseNoteInput').val().trim(),
                items: itemsPayload
            };

            // Save values then transition
            $.ajax({
                url: '/Warehouse/UpdateReleasedQuantities',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    if (res.success) {
                        // Trigger Approve transition
                        $.ajax({
                            url: '/Warehouse/ApproveRequestAndPrepare',
                            type: 'POST',
                            data: { code: currentRequestCode },
                            success: function(approveRes) {
                                if (approveRes.success) {
                                    showToast(approveRes.message, 'success');
                                    // Update table row in main table DOM immediately
                                    let targetRow = $(`tr[data-code='${currentRequestCode}']`);
                                    if (targetRow.length) {
                                        targetRow.find('.status-cell').html(getStatusBadgeHtml('Đang chuẩn bị xuất'));
                                        targetRow.removeClass('table-warning fw-bold border-warning-subtle');
                                    }

                                    // Re-fetch details to cleanly populate Screen B
                                    viewExportRequestDetails(currentRequestCode);
                                } else {
                                    showToast(approveRes.message, 'danger');
                                }
                            }
                        });
                    } else {
                        showToast(res.message, 'danger');
                    }
                }
            });
        }

        // --- 6. CONFIRM SHIPMENT ---
        function confirmShipment() {
            if (!currentRequestCode) return;

            $.ajax({
                url: '/Warehouse/ConfirmShipment',
                type: 'POST',
                data: { code: currentRequestCode },
                success: function(res) {
                    if (res.success) {
                        $('#requestProcessModal').modal('hide');
                        showToast(res.message, 'success');
                        setTimeout(function() {
                            location.reload();
                        }, 1500);
                    } else {
                        showToast(res.message, 'danger');
                    }
                },
                error: function() {
                    showToast('Lỗi kết nối máy chủ khi xuất kho.', 'danger');
                }
            });
        }
    </script>
}

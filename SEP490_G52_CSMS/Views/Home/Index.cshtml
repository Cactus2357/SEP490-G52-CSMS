@{
    ViewData["Title"] = "Bảng điều khiển Nhân viên";
    string role = ViewBag.EmployeeRole as string ?? "Cashier";
    string empName = ViewBag.EmployeeName as string ?? "Nhân viên";
    string branchName = ViewBag.BranchName as string ?? "Chi nhánh CSMS";
    string managerName = ViewBag.BranchManagerName as string ?? "Quản lý Chi Nhánh";
    string managerPhone = ViewBag.BranchManagerPhone as string ?? "0988888888";
    string managerEmail = ViewBag.BranchManagerEmail as string ?? "manager@csms.com";
}

<div class="container-fluid mt-4 pb-5">
    
    <!-- Welcome Header Banner -->
    <div class="card border-0 text-white shadow-sm mb-4" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); border-radius: 16px;">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-warning text-dark font-monospace fs-6 px-3 py-2 fw-bold">@role.ToUpper()</span>
                        <span class="text-white-50"><i class="bi bi-geo-alt-fill me-1"></i>@branchName</span>
                    </div>
                    <h2 class="fw-bold display-6 mb-2 text-white">Xin chào, @empName! 👋</h2>
                    <p class="mb-0 text-white-50 fs-5">Chúc bạn một ngày làm việc hiệu quả và mang lại trải nghiệm tuyệt vời nhất cho khách hàng.</p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <div class="bg-white bg-opacity-10 p-3 rounded-3 d-inline-block text-start border border-white border-opacity-10">
                        <small class="text-white-50 d-block mb-1"><i class="bi bi-clock me-1"></i>Thời gian hiện tại</small>
                        <h4 class="fw-bold mb-0 text-warning" id="homeLiveClock">--:--:--</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Role-Specific Action Links & User Guides -->
        <div class="col-lg-8">
            
            @if (role.Equals("Cashier", StringComparison.OrdinalIgnoreCase))
            {
                <!-- ================= CASHIER DASHBOARD ================= -->
                <div class="card border shadow-sm mb-4 rounded-3 bg-white">
                    <div class="card-header bg-light py-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-lightning-charge-fill me-2 text-warning"></i>CÁC CÔNG VIỆC THU NGÂN (QUICK ACTIONS)</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <a href="@Url.Action("CreateOrder", "SaleManagement")" class="card card-hover border bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle bg-primary text-white rounded-circle me-3 fs-4" style="width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-cart-plus-fill"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Tạo Đơn Bán Hàng (POS)</h6>
                                            <small class="text-secondary">Bán hàng, tạo order và nhận thanh toán</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("OrderHistory", "SaleManagement")" class="card card-hover border bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle bg-info text-white rounded-circle me-3 fs-4" style="width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-receipt-cutoff"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Lịch Sử Đơn Hàng</h6>
                                            <small class="text-secondary">Tra cứu hóa đơn và trạng thái thanh toán</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "CashHandover")" class="card card-hover border bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle bg-success text-white rounded-circle me-3 fs-4" style="width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-clock-history"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Đóng, Mở / Bàn Giao Ca</h6>
                                            <small class="text-secondary">Mở két, kiểm kê tiền mặt & đóng ca làm việc</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("EmployeeIndex", "WorkSchedule")" class="card card-hover border bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle bg-warning text-dark rounded-circle me-3 fs-4" style="width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-calendar3"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Lịch Làm Việc Cá Nhân</h6>
                                            <small class="text-secondary">Xem phân công ca làm việc hàng tuần</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "LeaveRequest")" class="card card-hover border bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle bg-danger text-white rounded-circle me-3 fs-4" style="width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-calendar-x"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Xin Nghỉ Phép</h6>
                                            <small class="text-secondary">Tạo đơn xin nghỉ phép gửi Quản lý</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("EmployeeIndex", "ShiftChange")" class="card card-hover border bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle bg-secondary text-white rounded-circle me-3 fs-4" style="width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-arrow-left-right"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Xin Chuyển Ca</h6>
                                            <small class="text-secondary">Gửi yêu cầu đổi ca trực với đồng nghiệp</small>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cashier Guide -->
                <div class="card border shadow-sm rounded-3 mb-4 bg-white">
                    <div class="card-header bg-light py-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-journal-text me-2 text-primary"></i>HƯỚNG DẪN QUY TRÌNH CHO THU NGÂN</h5>
                    </div>
                    <div class="card-body p-4">
                        <ol class="list-group list-group-numbered list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3 bg-transparent">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Kiểm tra ca làm & Mở ca bán hàng</div>
                                    <span class="text-secondary small">Kiểm tra ca làm việc tại Navbar, mở trang Bàn giao ca để Mở két tiền ban đầu.</span>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3 bg-transparent">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Tạo Order & Nhận Thanh Toán</div>
                                    <span class="text-secondary small">Thêm món vào giỏ, chọn phương thức thanh toán Tiền mặt hoặc Chuyển khoản VietQR SePay.</span>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3 bg-transparent">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Kết ca & Bàn giao ca</div>
                                    <span class="text-secondary small">Cuối ca làm việc, thực hiện kiểm đếm tiền mặt két thực tế và xác nhận bàn giao ca.</span>
                                </div>
                            </li>
                        </ol>
                    </div>
                </div>
            }
            else if (role.Equals("Bartender", StringComparison.OrdinalIgnoreCase))
            {
                <!-- ================= BARTENDER DASHBOARD ================= -->
                <div class="card border shadow-sm mb-4 rounded-3 bg-white">
                    <div class="card-header bg-light py-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-cup-hot-fill me-2 text-danger"></i>CÁC CÔNG VIỆC PHA CHẾ (QUICK ACTIONS)</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "Brewing")" class="card card-hover border bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle bg-danger text-white rounded-circle me-3 fs-4" style="width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-cup-straw"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Màn Hình Đơn Hàng Pha Chế</h6>
                                            <small class="text-secondary">Theo dõi đơn hàng chờ pha và hoàn tất</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("EmployeeIndex", "WorkSchedule")" class="card card-hover border bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle bg-warning text-dark rounded-circle me-3 fs-4" style="width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-calendar3"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Lịch Làm Việc Cá Nhân</h6>
                                            <small class="text-secondary">Xem ca trực pha chế cá nhân</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "LeaveRequest")" class="card card-hover border bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle bg-primary text-white rounded-circle me-3 fs-4" style="width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-calendar-x"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Xin Nghỉ Phép</h6>
                                            <small class="text-secondary">Tạo đơn xin nghỉ phép gửi Quản lý</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("EmployeeIndex", "ShiftChange")" class="card card-hover border bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle bg-secondary text-white rounded-circle me-3 fs-4" style="width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-arrow-left-right"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Xin Chuyển Ca</h6>
                                            <small class="text-secondary">Yêu cầu đổi ca trực với nhân viên khác</small>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bartender Guide -->
                <div class="card border shadow-sm rounded-3 mb-4 bg-white">
                    <div class="card-header bg-light py-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-journal-text me-2 text-danger"></i>HƯỚNG DẪN QUY TRÌNH CHO PHA CHẾ</h5>
                    </div>
                    <div class="card-body p-4">
                        <ol class="list-group list-group-numbered list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3 bg-transparent">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Tiếp nhận đơn pha chế mới</div>
                                    <span class="text-secondary small">Mở màn hình Pha chế để nhận đơn hàng vừa được Thu ngân chốt thanh toán.</span>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3 bg-transparent">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Bắt đầu & Chuẩn bị thức uống</div>
                                    <span class="text-secondary small">Bấm "Bắt đầu pha chế", chuẩn bị đúng định lượng công thức, đúng size và ghi chú đường/đá.</span>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3 bg-transparent">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Xác nhận hoàn thành pha chế</div>
                                    <span class="text-secondary small">Bấm "Hoàn tất pha chế" để hệ thống tự động cập nhật đơn và trừ tồn kho nguyên liệu.</span>
                                </div>
                            </li>
                        </ol>
                    </div>
                </div>
            }
            else
            {
                <!-- ================= BUSSER / STAFF DASHBOARD ================= -->
                <div class="card border shadow-sm mb-4 rounded-3 bg-white">
                    <div class="card-header bg-light py-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-person-workspace me-2 text-success"></i>CÁC CÔNG VIỆC PHỤC VỤ (QUICK ACTIONS)</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <a href="@Url.Action("EmployeeIndex", "WorkSchedule")" class="card card-hover border bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle bg-warning text-dark rounded-circle me-3 fs-4" style="width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-calendar3"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Lịch Làm Việc Cá Nhân</h6>
                                            <small class="text-secondary">Theo dõi ca làm việc cá nhân tuần này</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "LeaveRequest")" class="card card-hover border bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle bg-primary text-white rounded-circle me-3 fs-4" style="width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-calendar-x"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Xin Nghỉ Phép</h6>
                                            <small class="text-secondary">Tạo đơn xin nghỉ phép gửi Quản lý</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("EmployeeIndex", "ShiftChange")" class="card card-hover border bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle bg-secondary text-white rounded-circle me-3 fs-4" style="width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-arrow-left-right"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Xin Chuyển Ca</h6>
                                            <small class="text-secondary">Gửi yêu cầu đổi ca trực với đồng nghiệp</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("CustomerMonitor", "SaleManagement")" target="_blank" class="card card-hover border bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle bg-dark text-white rounded-circle me-3 fs-4" style="width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-display-fill"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Màn Hình Khách Hàng (Monitor)</h6>
                                            <small class="text-secondary">Mở màn hình phụ hiển thị đơn cho khách</small>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Busser Guide -->
                <div class="card border shadow-sm rounded-3 mb-4 bg-white">
                    <div class="card-header bg-light py-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-journal-text me-2 text-success"></i>HƯỚNG DẪN QUY TRÌNH PHỤC VỤ & DỌN DẸP</h5>
                    </div>
                    <div class="card-body p-4">
                        <ol class="list-group list-group-numbered list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3 bg-transparent">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Chuẩn bị đầu ca & Điểm danh</div>
                                    <span class="text-secondary small">Có mặt đúng giờ ca trực, vệ sinh sạch sẽ khu vực bàn ghế và dụng cụ phục vụ.</span>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3 bg-transparent">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Phục vụ đồ uống & Hỗ trợ khách hàng</div>
                                    <span class="text-secondary small">Nhận đồ uống hoàn thành từ quầy Pha chế, mang tới đúng bàn cho khách với thái độ lịch sự.</span>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3 bg-transparent">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Dọn dẹp bàn & Hỗ trợ quầy</div>
                                    <span class="text-secondary small">Thu gom cốc đĩa bẩn sau khi khách rời đi, lau bàn sạch sẽ và sẵn sàng đón lượt khách mới.</span>
                                </div>
                            </li>
                        </ol>
                    </div>
                </div>
            }

        </div>

        <!-- Right Column: Branch Manager Contact Info Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white overflow-hidden">
                <div class="card-header bg-primary text-white p-3 border-0 d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold mb-0 text-uppercase text-white"><i class="bi bi-person-badge-fill me-2"></i>Quản Lý Chi Nhánh</h6>
                    <span class="badge bg-white text-primary fw-bold">Contact Info</span>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-3">
                        <div class="avatar-circle bg-primary-subtle text-primary fw-bold fs-2 d-inline-flex align-items-center justify-content-center mb-2" style="width: 70px; height: 70px; border-radius: 50%;">
                            @managerName.Substring(0, Math.Min(1, managerName.Length)).ToUpper()
                        </div>
                        <h5 class="fw-bold text-dark mb-1">@managerName</h5>
                        <p class="text-muted small mb-0"><i class="bi bi-building me-1"></i>Chi Nhánh Manager</p>
                    </div>

                    <div class="bg-light p-3 rounded-3 mb-3 border">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-telephone-fill text-primary fs-5 me-3"></i>
                            <div>
                                <small class="text-secondary d-block">Số điện thoại liên hệ:</small>
                                <a href="tel:@managerPhone" class="fw-bold text-dark text-decoration-none fs-6">@managerPhone</a>
                            </div>
                        </div>
                        <hr class="my-2 border-secondary-subtle" />
                        <div class="d-flex align-items-center">
                            <i class="bi bi-envelope-fill text-primary fs-5 me-3"></i>
                            <div>
                                <small class="text-secondary d-block">Email công việc:</small>
                                <a href="mailto:@managerEmail" class="fw-bold text-dark text-decoration-none text-break fs-6">@managerEmail</a>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <a href="tel:@managerPhone" class="btn btn-outline-primary fw-bold py-2">
                            <i class="bi bi-telephone-outbound me-2"></i>Gọi Ngay Khi Cần Hỗ Trợ
                        </a>
                    </div>
                </div>
            </div>

            <!-- Quick Notice Box -->
            <div class="card border border-warning-subtle bg-warning-subtle shadow-sm rounded-3">
                <div class="card-body p-3">
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Lưu ý ca làm việc</h6>
                    <p class="small text-secondary mb-0">Vui lòng kiểm tra kỹ lịch làm việc và thực hiện điểm danh Check-in trước khi bắt đầu ca trực để đảm bảo dữ liệu chấm công chính xác.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 15px rgba(0,0,0,0.08);
    }
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
</style>

@section Scripts {
    <script>
        function updateHomeClock() {
            var now = new Date();
            var hours = String(now.getHours()).padStart(2, '0');
            var minutes = String(now.getMinutes()).padStart(2, '0');
            var seconds = String(now.getSeconds()).padStart(2, '0');
            var clockElem = document.getElementById('homeLiveClock');
            if (clockElem) {
                clockElem.innerText = hours + ':' + minutes + ':' + seconds;
            }
        }
        setInterval(updateHomeClock, 1000);
        updateHomeClock();
    </script>
}

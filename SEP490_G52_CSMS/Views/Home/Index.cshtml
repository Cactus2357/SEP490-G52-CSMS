@{
    ViewData["Title"] = "Bảng điều khiển Nhân viên";
    string role = ViewBag.EmployeeRole as string ?? "Cashier";
    string empName = ViewBag.EmployeeName as string ?? "Nhân viên";
    string branchName = ViewBag.BranchName as string ?? "Chi nhánh CSMS";
    string managerName = ViewBag.BranchManagerName as string ?? "Quản lý Chi Nhánh";
    string managerPhone = ViewBag.BranchManagerPhone as string ?? "0988888888";
    string managerEmail = ViewBag.BranchManagerEmail as string ?? "manager@csms.com";
}

<div class="container-fluid mt-4 pb-5">
    
    <!-- Welcome Header Banner -->
    <div class="card border-0 bg-gradient text-white shadow-sm mb-4" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); border-radius: 16px;">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-warning text-dark font-monospace fs-6 px-3 py-2 fw-bold">@role.ToUpper()</span>
                        <span class="text-white-50"><i class="bi bi-geo-alt-fill me-1"></i>@branchName</span>
                    </div>
                    <h2 class="fw-bold display-6 mb-2">Xin chào, @empName! 👋</h2>
                    <p class="mb-0 text-white-50 fs-5">Chúc bạn một ngày làm việc hiệu quả và tạo ra trải nghiệm tuyệt vời cho khách hàng.</p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <div class="bg-white bg-opacity-10 p-3 rounded-3 d-inline-block text-start border border-white border-opacity-10">
                        <small class="text-white-50 d-block mb-1"><i class="bi bi-clock me-1"></i>Thời gian hiện tại</small>
                        <h4 class="fw-bold mb-0 text-warning" id="homeLiveClock">--:--:--</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Role-Specific Action Links & User Guides -->
        <div class="col-lg-8">
            
            @if (role.Equals("Cashier", StringComparison.OrdinalIgnoreCase))
            {
                <!-- ================= CASHIER DASHBOARD ================= -->
                <div class="card border shadow-sm mb-4 rounded-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-lightning-charge-fill me-2 text-warning"></i>CÁC CÔNG VIỆC THU NGÂN (QUICK ACTIONS)</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <a href="@Url.Action("CreateOrder", "SaleManagement")" class="card card-hover border-2 border-primary bg-primary-subtle text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle p-3 me-3 fs-3">
                                            <i class="bi bi-cart-plus-fill"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-primary mb-1">Tạo Đơn Bán Hàng (POS)</h6>
                                            <small class="text-muted">Bán hàng, tạo order và nhận thanh toán</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("OrderHistory", "SaleManagement")" class="card card-hover border-2 border-info bg-info-subtle text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-info text-white rounded-circle p-3 me-3 fs-3">
                                            <i class="bi bi-receipt-cutoff"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-info-emphasis mb-1">Lịch Sử Đơn Hàng</h6>
                                            <small class="text-muted">Tra cứu hóa đơn và trạng thái thanh toán</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("HandoverHistory", "CashHandover")" class="card card-hover border-2 border-success bg-success-subtle text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-success text-white rounded-circle p-3 me-3 fs-3">
                                            <i class="bi bi-cash-stack"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-success-emphasis mb-1">Bàn Giao Ca Bán Hàng</h6>
                                            <small class="text-muted">Kết ca, kiểm kê tiền mặt két thu ngân</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "ShiftRoster")" class="card card-hover border-2 border-secondary bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-secondary text-white rounded-circle p-3 me-3 fs-3">
                                            <i class="bi bi-calendar-week"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Lịch Phân Ca & Chấm Công</h6>
                                            <small class="text-muted">Xem ca làm việc cá nhân hàng tuần</small>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cashier Guide -->
                <div class="card border shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-journal-text me-2 text-primary"></i>HƯỚNG DẪN QUY TRÌNH CHO THU NGÂN</h5>
                    </div>
                    <div class="card-body p-4">
                        <ol class="list-group list-group-numbered list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Kiểm tra ca làm & Mở ca bán hàng</div>
                                    <span class="text-muted small">Kiểm tra ca làm việc tại thông tin Navbar, thực hiện Mở ca và khai báo số tiền két ban đầu.</span>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Tạo Order & Nhận Thanh Toán</div>
                                    <span class="text-muted small">Thêm món vào giỏ, chọn phương thức thanh toán Tiền mặt hoặc Quét mã Chuyển khoản VietQR SePay.</span>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Bàn giao ca làm việc</div>
                                    <span class="text-muted small">Cuối ca làm việc, thực hiện kiểm kê tổng tiền mặt thực tế và tạo phiếu bàn giao ca cho nhân viên tiếp theo.</span>
                                </div>
                            </li>
                        </ol>
                    </div>
                </div>
            }
            else if (role.Equals("Bartender", StringComparison.OrdinalIgnoreCase))
            {
                <!-- ================= BARTENDER DASHBOARD ================= -->
                <div class="card border shadow-sm mb-4 rounded-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-cup-hot-fill me-2 text-danger"></i>CÁC CÔNG VIỆC PHA CHẾ (QUICK ACTIONS)</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "Brewing")" class="card card-hover border-2 border-danger bg-danger-subtle text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-danger text-white rounded-circle p-3 me-3 fs-3">
                                            <i class="bi bi-cup-straw"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-danger-emphasis mb-1">Màn Hình Mới Pha Chế (Brewing)</h6>
                                            <small class="text-muted">Theo dõi đơn hàng chờ pha và hoàn tất</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "OrderManagement")" class="card card-hover border-2 border-primary bg-primary-subtle text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle p-3 me-3 fs-3">
                                            <i class="bi bi-list-check"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-primary mb-1">Quản Lý Danh Sách Đơn Hàng</h6>
                                            <small class="text-muted">Xem chi tiết topping, đường đá đơn hàng</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "BranchInventory")" class="card card-hover border-2 border-warning bg-warning-subtle text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-warning text-dark rounded-circle p-3 me-3 fs-3">
                                            <i class="bi bi-box-seam-fill"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Kho Nguyên Liệu Chi Nhánh</h6>
                                            <small class="text-muted">Kiểm tra tồn kho cà phê, sữa, đường...</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "ShiftRoster")" class="card card-hover border-2 border-secondary bg-light text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-secondary text-white rounded-circle p-3 me-3 fs-3">
                                            <i class="bi bi-calendar-week"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Lịch Phân Ca Làm Việc</h6>
                                            <small class="text-muted">Xem ca trực pha chế cá nhân</small>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bartender Guide -->
                <div class="card border shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-journal-text me-2 text-danger"></i>HƯỚNG DẪN QUY TRÌNH CHO PHA CHẾ</h5>
                    </div>
                    <div class="card-body p-4">
                        <ol class="list-group list-group-numbered list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Tiếp nhận đơn pha chế mới</div>
                                    <span class="text-muted small">Truy cập màn hình Pha chế để nhận đơn hàng vừa được Thu ngân chốt thanh toán.</span>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Bắt đầu & Chuẩn bị thức uống</div>
                                    <span class="text-muted small">Bấm "Bắt đầu pha chế", pha chế đúng định lượng công thức, chọn đúng size và ghi chú đường/đá.</span>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Xác nhận hoàn thành pha chế</div>
                                    <span class="text-muted small">Bấm "Hoàn tất pha chế" để hệ thống tự động trừ tồn kho nguyên liệu tương ứng trong CSDL.</span>
                                </div>
                            </li>
                        </ol>
                    </div>
                </div>
            }
            else
            {
                <!-- ================= BUSSER / STAFF DASHBOARD ================= -->
                <div class="card border shadow-sm mb-4 rounded-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-person-workspace me-2 text-success"></i>CÁC CÔNG VIỆC PHỤC VỤ (QUICK ACTIONS)</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "ShiftRoster")" class="card card-hover border-2 border-primary bg-primary-subtle text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle p-3 me-3 fs-3">
                                            <i class="bi bi-calendar-event"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-primary mb-1">Lịch Phân Ca Làm Việc</h6>
                                            <small class="text-muted">Theo dõi ca làm việc cá nhân tuần này</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "AttendanceLog")" class="card card-hover border-2 border-success bg-success-subtle text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-success text-white rounded-circle p-3 me-3 fs-3">
                                            <i class="bi bi-person-check-fill"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-success-emphasis mb-1">Lịch Sử Điểm Danh & Chấm Công</h6>
                                            <small class="text-muted">Xem trạng thái Check-in / Check-out</small>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-6">
                                <a href="@Url.Action("CustomerMonitor", "SaleManagement")" target="_blank" class="card card-hover border-2 border-dark bg-dark-subtle text-decoration-none h-100 p-3 rounded-3 transition-all">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-dark text-white rounded-circle p-3 me-3 fs-3">
                                            <i class="bi bi-display-fill"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">Màn Hình Khách Hàng (Monitor)</h6>
                                            <small class="text-muted">Mở màn hình phụ hiển thị đơn hàng cho khách</small>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Busser Guide -->
                <div class="card border shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-journal-text me-2 text-success"></i>HƯỚNG DẪN QUY TRÌNH PHỤC VỤ & DỌN DẸP</h5>
                    </div>
                    <div class="card-body p-4">
                        <ol class="list-group list-group-numbered list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Chuẩn bị đầu ca & Chấm công</div>
                                    <span class="text-muted small">Có mặt đúng giờ, chấm công Check-in và vệ sinh khu vực sảnh / bàn ghế được phân công.</span>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Phục vụ đồ uống & Hỗ trợ khách hàng</div>
                                    <span class="text-muted small">Nhận đồ uống hoàn thành từ quầy Pha chế, mang tới đúng bàn cho khách với thái độ lịch sự.</span>
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold text-dark">Dọn dẹp bàn & Hỗ trợ quầy</div>
                                    <span class="text-muted small">Thu gom cốc đĩa bẩn sau khi khách rời đi, lau bàn sạch sẽ và sẵn sàng đón lượt khách mới.</span>
                                </div>
                            </li>
                        </ol>
                    </div>
                </div>
            }

        </div>

        <!-- Right Column: Branch Manager Contact Info Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white overflow-hidden">
                <div class="card-header bg-primary text-white p-3 border-0 d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold mb-0 text-uppercase"><i class="bi bi-person-badge-fill me-2"></i>Quản Lý Chi Nhánh</h6>
                    <span class="badge bg-white text-primary fw-bold">Contact Info</span>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-3">
                        <div class="avatar-circle bg-primary-subtle text-primary fw-bold fs-2 d-inline-flex align-items-center justify-content-center mb-2" style="width: 70px; height: 70px; border-radius: 50%;">
                            @managerName.Substring(0, Math.Min(1, managerName.Length)).ToUpper()
                        </div>
                        <h5 class="fw-bold text-dark mb-1">@managerName</h5>
                        <p class="text-muted small mb-0"><i class="bi bi-building me-1"></i>Chi Nhánh Manager</p>
                    </div>

                    <div class="bg-light p-3 rounded-3 mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-telephone-fill text-primary fs-5 me-3"></i>
                            <div>
                                <small class="text-muted d-block">Số điện thoại liên hệ:</small>
                                <a href="tel:@managerPhone" class="fw-bold text-dark text-decoration-none">@managerPhone</a>
                            </div>
                        </div>
                        <hr class="my-2 border-secondary-subtle" />
                        <div class="d-flex align-items-center">
                            <i class="bi bi-envelope-fill text-primary fs-5 me-3"></i>
                            <div>
                                <small class="text-muted d-block">Email công việc:</small>
                                <a href="mailto:@managerEmail" class="fw-bold text-dark text-decoration-none text-break">@managerEmail</a>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <a href="tel:@managerPhone" class="btn btn-outline-primary fw-bold py-2">
                            <i class="bi bi-telephone-outbound me-2"></i>Gọi Ngay Khi Cần Hỗ Trợ
                        </a>
                    </div>
                </div>
            </div>

            <!-- Quick Notice Box -->
            <div class="card border border-warning-subtle bg-warning-subtle shadow-sm rounded-3">
                <div class="card-body p-3">
                    <h6 class="fw-bold text-warning-emphasis mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Lưu ý ca làm việc</h6>
                    <p class="small text-muted mb-0">Vui lòng kiểm tra kỹ lịch làm việc và thực hiện điểm danh Check-in trước khi bắt đầu ca trực để đảm bảo dữ liệu chấm công chính xác.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 15px rgba(0,0,0,0.08);
    }
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
</style>

@section Scripts {
    <script>
        function updateHomeClock() {
            var now = new Date();
            var hours = String(now.getHours()).padStart(2, '0');
            var minutes = String(now.getMinutes()).padStart(2, '0');
            var seconds = String(now.getSeconds()).padStart(2, '0');
            var clockElem = document.getElementById('homeLiveClock');
            if (clockElem) {
                clockElem.innerText = hours + ':' + minutes + ':' + seconds;
            }
        }
        setInterval(updateHomeClock, 1000);
        updateHomeClock();
    </script>
}

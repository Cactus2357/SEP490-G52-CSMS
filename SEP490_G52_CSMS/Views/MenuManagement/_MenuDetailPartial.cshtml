@model SEP490_G52_CSMS.Models.ViewModels.MenuEditViewModel

<div class="modal-header border-bottom py-3 px-4 bg-light bg-opacity-50">
    <div class="d-flex align-items-center gap-2">
        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
            <i class="bi bi-journal-text fs-5"></i>
        </div>
        <div>
            <div class="d-flex align-items-center gap-2">
                <h5 class="modal-title fw-bold text-dark mb-0">@Model.MenuName</h5>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 small">
                    @(Model.Products?.Count ?? 0) món
                </span>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small">
                        <i class="bi bi-check-circle-fill me-1"></i>Đang áp dụng
                    </span>
                }
            </div>
            <small class="text-muted">Chi tiết danh sách món ăn và đồ uống thuộc thực đơn</small>
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body p-4" style="max-height: 520px; overflow-y: auto;">
    @if (Model.Products == null || !Model.Products.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary-subtle"></i>
            <div>Thực đơn này hiện chưa được cấu hình món nào.</div>
            <a asp-action="Edit" asp-route-id="@Model.MenuId" class="btn btn-primary btn-sm rounded-pill mt-3 px-3">
                <i class="bi bi-plus-lg me-1"></i>Thêm món vào thực đơn
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small">
                    <tr>
                        <th style="width: 8%;" class="ps-3 py-2.5 text-uppercase fw-semibold">STT</th>
                        <th class="py-2.5 text-uppercase fw-semibold">Tên món</th>
                        <th class="py-2.5 text-uppercase fw-semibold">Danh mục</th>
                        <th class="py-2.5 text-uppercase fw-semibold">Kích cỡ & Giá bán</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Products.Count; i++)
                    {
                        var p = Model.Products[i];
                        <tr>
                            <td class="ps-3 text-secondary small fw-semibold">@(i + 1)</td>
                            <td>
                                <span class="fw-bold text-dark">@p.ProductName</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border rounded-pill px-2.5 py-1 small">
                                    @p.CategoryName
                                </span>
                            </td>
                            <td>
                                <span class="text-secondary small fw-semibold">
                                    <i class="bi bi-tag me-1 text-muted"></i>@p.SizeAndPrice
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal-footer border-top py-2.5 px-4 bg-light bg-opacity-25 d-flex justify-content-between align-items-center">
    <span class="text-muted small">
        <i class="bi bi-info-circle me-1"></i>Để bật/tắt phục vụ từng món tạm hết nguyên liệu, truy cập <a asp-controller="Brewing" asp-action="ProductAvailability" class="text-primary text-decoration-none fw-semibold">Quản lý sản phẩm</a>.
    </span>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Edit" asp-route-id="@Model.MenuId" class="btn btn-outline-primary rounded-pill px-3 py-1.5 small fw-semibold">
            <i class="bi bi-pencil me-1"></i>Chỉnh sửa thực đơn
        </a>
        <button type="button" class="btn btn-secondary rounded-pill px-3 py-1.5 small fw-semibold" data-bs-dismiss="modal">Đóng</button>
    </div>
</div>

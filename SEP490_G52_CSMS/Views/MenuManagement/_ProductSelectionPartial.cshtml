@model IEnumerable<SEP490_G52_CSMS.Models.ViewModels.ProductSelectionViewModel>

<div class="table-responsive">
    <table class="table table-hover table-sm align-middle mb-0" id="modalProductTable">
        <thead class="table-light">
            <tr>
                <th class="ps-3">Tên Sản Phẩm</th>
                <th>Thể Loại</th>
                <th class="text-center pe-3">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">Không có sản phẩm nào thuộc thể loại này.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr data-category-id="@item.CategoryId" data-product-id="@item.ProductId" data-product-name="@item.ProductName" data-category-name="@item.CategoryName" data-size-price="@item.SizeAndPrice">
                        <td class="ps-3 fw-bold text-dark">@item.ProductName</td>
                        <td><span class="badge bg-secondary-subtle text-dark border">@item.CategoryName</span></td>
                        <td class="text-center pe-3">
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold" onclick="addProductToStaging(this)">
                                <i class="bi bi-plus-lg me-1"></i>Thêm
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

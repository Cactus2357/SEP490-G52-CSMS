@{
    ViewData["Title"] = "Thêm thực đơn mới";
}

<div class="container-fluid mt-3 px-4 pb-5">
    <!-- Header Section -->
    <div class="card bg-body-tertiary border-0 rounded-3 mb-4 shadow-sm">
        <div class="card-body p-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center p-0" style="width: 38px; height: 38px;">
                    <i class="bi bi-arrow-left fs-5"></i>
                </a>
                <div>
                    <span class="text-muted small">Chi nhánh / Thực đơn / Tạo mới</span>
                    <h4 class="fw-bold m-0 text-dark">THÊM THỰC ĐƠN MỚI</h4>
                </div>
            </div>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @Html.ValidationSummary(false, "", new { @class = "text-danger mb-0" })
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Create" method="post" id="createForm">
        
        <!-- Menu Name Card -->
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-body p-4">
                <label for="MenuName" class="form-label fw-bold text-dark">Tên thực đơn <span class="text-danger">*</span></label>
                <div class="row">
                    <div class="col-md-6">
                        <input type="text" id="MenuName" name="MenuName" class="form-control rounded-3 py-2" placeholder="Nhập tên thực đơn (VD: Thực đơn mùa hè)..." required />
                    </div>
                </div>
            </div>
        </div>

        <!-- 2 Columns Product Selection Grid -->
        <div class="row g-4 mb-4">
            <!-- Left Column: Available Products -->
            <div class="col-md-6">
                <div class="card shadow-sm border-0 rounded-3 h-100">
                    <div class="card-header bg-body-tertiary py-3 border-0 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold m-0 text-dark"><i class="bi bi-grid-fill me-2 text-primary"></i>Danh sách sản phẩm</h6>
                    </div>
                    <div class="card-body p-3">
                        
                        <!-- Category Filter -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Lọc theo thể loại</label>
                            <select id="categoryFilter" class="form-select rounded-3" onchange="loadProducts()">
                                <option value="">Tất cả thể loại sản phẩm</option>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in ViewBag.Categories)
                                    {
                                        <option value="@cat.CategoryId">@cat.CategoryName</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Products Table Container -->
                        <div id="productsContainer" style="max-height: 420px; overflow-y: auto;">
                            <!-- Loaded via AJAX -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Staging Selected Products -->
            <div class="col-md-6">
                <div class="card shadow-sm border-0 rounded-3 h-100 bg-body-tertiary">
                    <div class="card-header bg-secondary-subtle py-3 border-0 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold m-0 text-dark"><i class="bi bi-check-circle-fill me-2 text-success"></i>Sản phẩm đã chọn vào thực đơn</h6>
                    </div>
                    <div class="card-body p-3">
                        <div id="stagingContainer" style="max-height: 420px; overflow-y: auto;">
                            <div class="text-center py-5 text-muted" id="emptyStagingMsg">
                                <i class="bi bi-bag-plus fs-1 d-block mb-2 text-secondary-subtle"></i>
                                Chưa có sản phẩm nào được chọn. Chọn sản phẩm ở cột bên trái để thêm vào thực đơn.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Form Actions Bottom Bar -->
        <div class="d-flex justify-content-end gap-3 pt-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">Hủy</a>
            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-save me-1"></i>Lưu thực đơn
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        var selectedProductIds = [];
        
        document.addEventListener('DOMContentLoaded', function() {
            loadProducts();
        });

        function loadProducts() {
            var catId = document.getElementById("categoryFilter").value;
            var url = '@Url.Action("GetProductsPartial", "MenuManagement")';
            if (catId) url += "?categoryId=" + catId;

            fetch(url)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('productsContainer').innerHTML = html;
                });
        }

        function addProductToStaging(btn) {
            var tr = btn.closest('tr');
            var pId = tr.getAttribute('data-product-id');
            var pName = tr.getAttribute('data-product-name');
            var cName = tr.getAttribute('data-category-name');

            if (selectedProductIds.includes(pId.toString())) {
                showToast('Sản phẩm này đã được chọn trong thực đơn!', 'warning');
                return;
            }

            selectedProductIds.push(pId.toString());

            var emptyMsg = document.getElementById('emptyStagingMsg');
            if (emptyMsg) emptyMsg.style.display = 'none';

            var div = document.createElement('div');
            div.className = 'card border-0 shadow-sm rounded-3 mb-2 p-3 d-flex flex-row justify-content-between align-items-center bg-white';
            div.id = 'staged_' + pId;
            div.innerHTML = `
                <div>
                    <div class="fw-bold text-dark">${pName}</div>
                    <span class="badge bg-secondary-subtle text-dark border mt-1">${cName}</span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold" onclick="removeStaging('${pId}')">
                    <i class="bi bi-trash me-1"></i>Loại bỏ
                </button>
                <input type="hidden" name="SelectedProductIds" value="${pId}" />
            `;

            document.getElementById('stagingContainer').appendChild(div);
            showToast(`Đã thêm "${pName}" vào thực đơn.`, 'success');
        }

        function removeStaging(pId) {
            var el = document.getElementById('staged_' + pId);
            if (el) {
                el.remove();
                selectedProductIds = selectedProductIds.filter(id => id !== pId.toString());
            }

            var stagingContainer = document.getElementById('stagingContainer');
            if (stagingContainer.querySelectorAll('div[id^="staged_"]').length === 0) {
                var emptyMsg = document.getElementById('emptyStagingMsg');
                if (emptyMsg) emptyMsg.style.display = 'block';
            }
        }
    </script>
}

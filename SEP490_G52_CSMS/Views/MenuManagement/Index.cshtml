@model IEnumerable<SEP490_G52_CSMS.Models.ViewModels.MenuListViewModel>

@{
    ViewData["Title"] = "Quản lý thực đơn";
    var menuList = Model?.ToList() ?? new List<SEP490_G52_CSMS.Models.ViewModels.MenuListViewModel>();
    int totalCount = menuList.Count;
    int activeCount = menuList.Count(m => m.IsActive);
    int inactiveCount = totalCount - activeCount;
}

<style>
    .kpi-card {
        border-radius: 12px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        border: 1px solid rgba(0,0,0,0.08);
    }
    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0,0,0,0.06);
    }
    .filter-pill {
        border-radius: 50rem;
        padding: 0.35rem 1rem;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        border: 1px solid #dee2e6;
        background-color: #fff;
        color: #495057;
        transition: all 0.15s ease;
    }
    .filter-pill:hover {
        background-color: #f8f9fa;
        border-color: #ced4da;
    }
    .filter-pill.active {
        background-color: #0d6efd !important;
        color: #fff !important;
        border-color: #0d6efd !important;
    }
    .menu-active-row {
        background-color: rgba(25, 135, 84, 0.03) !important;
    }
    .menu-active-row td {
        background-color: transparent !important;
    }
    .action-btn-sm {
        padding: 0.28rem 0.65rem;
        font-size: 0.82rem;
        border-radius: 50rem;
    }
</style>

<div class="container-fluid px-4 pt-3 pb-5">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h3 class="fw-bold text-dark mb-0">
                    <i class="bi bi-journal-text text-primary me-2"></i>Quản lý thực đơn
                </h3>
            </div>
            <p class="text-muted small mb-0 mt-1">Cấu hình danh sách thực đơn áp dụng tại chi nhánh và quản lý trạng thái mở bán</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Link to Product Availability (Requested) -->
            <a asp-controller="Brewing" asp-action="ProductAvailability" class="btn btn-outline-primary rounded-pill px-3 py-1.5 shadow-sm small fw-semibold">
                <i class="bi bi-box-seam me-1.5"></i>Quản lý sản phẩm (Bật/Tắt món)
            </a>
            <!-- Create New Menu -->
            <a asp-action="Create" class="btn btn-primary rounded-pill px-3 py-1.5 shadow-sm small fw-bold">
                <i class="bi bi-plus-lg me-1"></i>Thêm thực đơn mới
            </a>
        </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4 col-12">
            <div class="card kpi-card bg-white p-3 h-100 shadow-sm">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Tổng số thực đơn</span>
                        <h2 class="fw-bold text-dark mb-0 mt-1" id="kpiTotal">@totalCount</h2>
                        <span class="text-muted" style="font-size: 0.78rem;">Toàn bộ thực đơn đã tạo</span>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-journal-album text-primary fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-12">
            <div class="card kpi-card bg-white p-3 h-100 shadow-sm">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Thực đơn đang áp dụng</span>
                        <h2 class="fw-bold text-success mb-0 mt-1" id="kpiActive">@activeCount</h2>
                        <span class="text-success" style="font-size: 0.78rem;"><i class="bi bi-check-circle-fill me-1"></i>Đang phục vụ tại POS</span>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-check2-circle text-success fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-12">
            <div class="card kpi-card bg-white p-3 h-100 shadow-sm">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Ngừng hoạt động</span>
                        <h2 class="fw-bold text-secondary mb-0 mt-1" id="kpiInactive">@inactiveCount</h2>
                        <span class="text-muted" style="font-size: 0.78rem;">Lưu trữ / Chưa kích hoạt</span>
                    </div>
                    <div class="rounded-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-dash-circle text-secondary fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="card border shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <!-- Status Pills -->
                <div class="d-flex align-items-center gap-2 flex-wrap" id="statusFilterGroup">
                    <button type="button" class="filter-pill active" data-status="all" onclick="setStatusFilter('all', this)">
                        Tất cả <span class="badge rounded-pill bg-light text-dark ms-1">@totalCount</span>
                    </button>
                    <button type="button" class="filter-pill" data-status="active" onclick="setStatusFilter('active', this)">
                        <i class="bi bi-check-circle me-1"></i>Đang áp dụng <span class="badge rounded-pill bg-success-subtle text-success ms-1">@activeCount</span>
                    </button>
                    <button type="button" class="filter-pill" data-status="inactive" onclick="setStatusFilter('inactive', this)">
                        <i class="bi bi-dash-circle me-1"></i>Ngừng hoạt động <span class="badge rounded-pill bg-secondary-subtle text-secondary ms-1">@inactiveCount</span>
                    </button>
                </div>

                <!-- Search Input -->
                <div style="min-width: 260px; max-width: 360px;" class="flex-grow-1 flex-md-grow-0">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Tìm tên thực đơn..." oninput="filterTable()">
                        <button class="btn btn-outline-secondary border-start-0" type="button" onclick="clearSearch()" id="btnClearSearch" style="display: none;">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Menu Table Card -->
    <div class="card border shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="menuTable">
                <thead class="table-light text-secondary" style="font-size: 0.82rem;">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase fw-semibold" style="width: 40%;">Tên thực đơn</th>
                        <th class="py-3 text-uppercase fw-semibold" style="width: 20%;">Trạng thái</th>
                        <th class="py-3 text-uppercase fw-semibold" style="width: 20%;">Ngày sửa đổi</th>
                        <th class="py-3 text-uppercase fw-semibold text-end pe-4" style="width: 20%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!menuList.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary-subtle"></i>
                                Chưa có thực đơn nào được tạo tại chi nhánh này.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in menuList)
                        {
                            string rowClass = item.IsActive ? "menu-active-row" : "";
                            string statusValue = item.IsActive ? "active" : "inactive";

                            <tr class="@rowClass menu-row" data-status="@statusValue" data-name="@item.MenuName.ToLower()">
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle @(item.IsActive ? "bg-success text-white" : "bg-light text-secondary") d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                                            <i class="bi @(item.IsActive ? "bi-journal-check" : "bi-journal")"></i>
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">@item.MenuName</span>
                                            @if (item.IsActive)
                                            {
                                                <small class="text-success fw-semibold" style="font-size: 0.72rem;">
                                                    <i class="bi bi-broadcast me-1"></i>Đang hiển thị tại màn hình bán hàng (POS)
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold">
                                            <i class="bi bi-check-circle-fill me-1"></i>Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1.5 fw-semibold">
                                            <i class="bi bi-dash-circle me-1"></i>Ngừng hoạt động
                                        </span>
                                    }
                                </td>
                                <td class="py-3 text-secondary small">
                                    <i class="bi bi-clock-history me-1 text-muted"></i>
                                    @(item.UpdatedAt.HasValue ? item.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                                </td>
                                <td class="py-3 text-end pe-4">
                                    <div class="d-inline-flex align-items-center gap-1.5">
                                        <!-- Xem chi tiết -->
                                        <button type="button" class="btn btn-outline-primary action-btn-sm fw-semibold" onclick="openMenuDetailModal(@item.MenuId)" title="Xem chi tiết danh sách món">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </button>

                                        <!-- Chỉnh sửa -->
                                        <a asp-action="Edit" asp-route-id="@item.MenuId" class="btn btn-outline-secondary action-btn-sm fw-semibold" title="Chỉnh sửa thực đơn">
                                            <i class="bi bi-pencil me-1"></i>Sửa
                                        </a>

                                        <!-- Toggle Status Form -->
                                        <form asp-action="ToggleStatus" asp-route-id="@item.MenuId" method="post" class="d-inline" onsubmit="return confirmToggleMenu(this, '@(item.IsActive.ToString().ToLower())', '@item.MenuName');">
                                            @if (item.IsActive)
                                            {
                                                <button type="submit" class="btn btn-outline-danger action-btn-sm fw-semibold" title="Ngừng hoạt động thực đơn">
                                                    <i class="bi bi-pause-circle me-1"></i>Ngừng
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-success action-btn-sm text-white fw-semibold" title="Kích hoạt thực đơn này">
                                                    <i class="bi bi-check-lg me-1"></i>Kích hoạt
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal View Menu Content -->
<div class="modal fade" id="menuDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
            <!-- Loaded by JS -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentStatusFilter = 'all';

        function setStatusFilter(status, btn) {
            currentStatusFilter = status;
            document.querySelectorAll('#statusFilterGroup .filter-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            filterTable();
        }

        function filterTable() {
            const searchInput = document.getElementById("searchInput");
            const searchVal = searchInput.value.trim().toLowerCase();
            const btnClear = document.getElementById("btnClearSearch");
            if (btnClear) {
                btnClear.style.display = searchVal ? "inline-block" : "none";
            }

            const rows = document.querySelectorAll('#menuTable tbody tr.menu-row');
            rows.forEach(row => {
                const name = row.getAttribute('data-name') || '';
                const status = row.getAttribute('data-status') || '';

                const matchesSearch = !searchVal || (window.CSMSSearch ? window.CSMSSearch.fuzzyMatch(name, searchVal) : name.includes(searchVal));
                const matchesStatus = (currentStatusFilter === 'all') || (status === currentStatusFilter);

                row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
            });
        }

        function clearSearch() {
            const searchInput = document.getElementById("searchInput");
            searchInput.value = '';
            filterTable();
            searchInput.focus();
        }

        function openMenuDetailModal(menuId) {
            var modalEl = document.getElementById('menuDetailModal');
            var modalContent = modalEl.querySelector('.modal-content');
            modalContent.innerHTML = `
                <div class="modal-body text-center py-5 text-primary">
                    <div class="spinner-border spinner-border-sm mb-2" role="status"></div>
                    <div class="small fw-semibold">Đang tải danh sách món của thực đơn...</div>
                </div>
            `;
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            fetch('@Url.Action("GetMenuDetails", "MenuManagement")?id=' + menuId)
                .then(res => {
                    if (!res.ok) throw new Error('Không tìm thấy chi tiết thực đơn.');
                    return res.text();
                })
                .then(html => {
                    modalContent.innerHTML = html;
                })
                .catch(err => {
                    modalContent.innerHTML = `
                        <div class="modal-header border-bottom">
                            <h5 class="modal-title text-danger fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Lỗi</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body text-center py-4 text-danger">
                            <div>${err.message}</div>
                        </div>
                    `;
                });
        }

        function confirmToggleMenu(form, isActiveStr, menuName) {
            const isActive = (isActiveStr === 'true');
            const actionText = isActive ? 'ngừng hoạt động' : 'kích hoạt';
            const actionPrompt = isActive 
                ? `Bạn có chắc chắn muốn <strong>ngừng hoạt động</strong> thực đơn <strong>"${menuName}"</strong> không?<br><span class="text-danger small">Món ăn trong thực đơn này sẽ tạm dừng phục vụ tại quầy bán hàng POS.</span>`
                : `Bạn có chắc chắn muốn <strong>kích hoạt</strong> thực đơn <strong>"${menuName}"</strong> không?<br><span class="text-success small">Thực đơn này sẽ trở thành thực đơn chính thức áp dụng tại quầy bán hàng POS.</span>`;

            showConfirmModal(
                'Xác nhận ' + actionText + ' thực đơn',
                actionPrompt,
                function() { form.submit(); }
            );
            return false;
        }
    </script>
}

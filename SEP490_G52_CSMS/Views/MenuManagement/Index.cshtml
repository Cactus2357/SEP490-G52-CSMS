@model IEnumerable<SEP490_G52_CSMS.Models.ViewModels.MenuListViewModel>

@{
    ViewData["Title"] = "Quản Lý Thực Đơn";
    // Using a default Layout if none specified, it should inherit from _ViewStart
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>QUẢN LÝ THỰC ĐƠN</h2>
        <div>
            <span class="mr-3 font-weight-bold">Chi nhánh 1</span>
        </div>
    </div>

    <div class="d-flex justify-content-between mb-3">
        <div class="w-50">
            <input type="text" id="searchInput" class="form-control" placeholder="Search..." onkeyup="filterTable()">
        </div>
        <div>
            <button class="btn btn-outline-primary mr-2" id="btnViewDetails" onclick="viewDetailsSelected()" disabled>
                <i class="bi bi-eye me-1"></i>Xem chi tiết
            </button>
            <button class="btn btn-outline-secondary mr-2" id="btnEdit" onclick="editSelected()" disabled>+ Sửa thực đơn</button>
            <a asp-action="Create" class="btn btn-outline-dark">+ Thêm thực đơn mới</a>
        </div>
    </div>

    <table class="table table-bordered table-hover" id="menuTable">
        <thead class="thead-light">
            <tr>
                <th>Danh Sách Các Thực Đơn</th>
                <th>Ngày Sửa Đổi</th>
                <th>Trạng Thái</th>
                <th>Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr onclick="selectRow(this, @item.MenuId)" style="cursor: pointer;">
                    <td>@item.MenuName</td>
                    <td>@(item.UpdatedAt.HasValue ? item.UpdatedAt.Value.ToString("dd/MM/yyyy") : "")</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="text-success">Đang hoạt động</span>
                        }
                        else
                        {
                            <span class="text-secondary">Ngừng hoạt động</span>
                        }
                    </td>
                    <td>
                        <form asp-action="ToggleStatus" asp-route-id="@item.MenuId" method="post" class="d-inline">
                            @if (item.IsActive)
                            {
                                <button type="submit" class="btn btn-link p-0 text-primary">Ngừng hoạt động</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-link p-0 text-primary">Kích hoạt</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal View Menu Content -->
<div class="modal fade" id="menuDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <!-- Loaded by JS -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedMenuId = null;

        function selectRow(row, menuId) {
            // Remove active class from all rows
            document.querySelectorAll('#menuTable tbody tr').forEach(r => r.classList.remove('table-active'));
            // Add active class to clicked row
            row.classList.add('table-active');
            
            selectedMenuId = menuId;
            document.getElementById('btnEdit').disabled = false;
            document.getElementById('btnViewDetails').disabled = false;
        }

        function editSelected() {
            if (selectedMenuId) {
                window.location.href = '@Url.Action("Edit", "MenuManagement")/' + selectedMenuId;
            }
        }

        function viewDetailsSelected() {
            if (selectedMenuId) {
                var modalEl = document.getElementById('menuDetailModal');
                var modalContent = modalEl.querySelector('.modal-content');
                modalContent.innerHTML = `
                    <div class="modal-body text-center py-5 text-primary">
                        <div class="spinner-border spinner-border-sm mb-2" role="status"></div>
                        <div class="small fw-semibold">Đang tải danh sách món...</div>
                    </div>
                `;
                var modal = new bootstrap.Modal(modalEl);
                modal.show();

                fetch('@Url.Action("GetMenuDetails", "MenuManagement")?id=' + selectedMenuId)
                    .then(res => {
                        if (!res.ok) throw new Error('Không tìm thấy chi tiết thực đơn');
                        return res.text();
                    })
                    .then(html => {
                        modalContent.innerHTML = html;
                    })
                    .catch(err => {
                        modalContent.innerHTML = `
                            <div class="modal-header border-bottom">
                                <h5 class="modal-title text-danger">Lỗi</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body text-center py-4 text-danger">
                                <i class="bi bi-exclamation-triangle fs-2 d-block mb-2"></i>
                                <div>${err.message}</div>
                            </div>
                        `;
                    });
            }
        }

        function filterTable() {
            var input, filter, table, tr, td, i, txtValue;
            input = document.getElementById("searchInput");
            filter = input.value.toUpperCase();
            table = document.getElementById("menuTable");
            tr = table.getElementsByTagName("tr");
            for (i = 1; i < tr.length; i++) {
                td = tr[i].getElementsByTagName("td")[0];
                if (td) {
                    txtValue = td.textContent || td.innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }
    </script>
}

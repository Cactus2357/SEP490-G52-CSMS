@model IEnumerable<SEP490_G52_CSMS.Models.ViewModels.MenuListViewModel>

@{
    ViewData["Title"] = "Quản Lý Thực Đơn";
}

<div class="container-fluid mt-3 px-4">
    <!-- Header Section -->
    <div class="card bg-body-tertiary border-0 rounded-3 mb-4 shadow-sm">
        <div class="card-body p-3 d-flex justify-content-between align-items-center">
            <div>
                <span class="text-muted small">Chi nhánh / Thực đơn</span>
                <h4 class="fw-bold m-0 text-dark">QUẢN LÝ THỰC ĐƠN</h4>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Create" class="btn btn-primary rounded-pill px-3 fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i>Thêm thực đơn mới
                </a>
            </div>
        </div>
    </div>

    <!-- Filter & Data Card -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-3">
            <div class="row g-3 mb-3 align-items-center">
                <div class="col-md-5">
                    <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm thực đơn..." onkeyup="filterTable()">
                </div>
                <div class="col-md-7 text-end">
                    <button class="btn btn-outline-primary me-2 rounded-pill px-3" id="btnViewDetails" onclick="viewDetailsSelected()" disabled>
                        <i class="bi bi-eye me-1"></i>Xem chi tiết
                    </button>
                    <button class="btn btn-outline-secondary rounded-pill px-3" id="btnEdit" onclick="editSelected()" disabled>
                        <i class="bi bi-pencil me-1"></i>Sửa thực đơn
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0" id="menuTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Danh Sách Thực Đơn</th>
                            <th>Ngày Sửa Đổi</th>
                            <th>Trạng Thái</th>
                            <th class="text-center pe-3">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string rowClass = item.IsActive ? "table-success" : "";

                            <tr class="@rowClass" onclick="selectRow(this, @item.MenuId)" style="cursor: pointer;">
                                <td class="ps-3 fw-semibold text-dark">@item.MenuName</td>
                                <td>@(item.UpdatedAt.HasValue ? item.UpdatedAt.Value.ToString("dd/MM/yyyy") : "-")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1.5">Ngừng hoạt động</span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <button type="button" class="btn btn-sm btn-link text-primary text-decoration-none fw-bold p-0 me-2" onclick="openMenuDetailModal(@item.MenuId)">
                                        Chi tiết
                                    </button>
                                    <form asp-action="ToggleStatus" asp-route-id="@item.MenuId" method="post" class="d-inline" onsubmit="return confirmToggleMenu(this, @item.IsActive.ToString().ToLower());">
                                        @if (item.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-link text-danger fw-bold text-decoration-none p-0">Ngừng hoạt động</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-link text-success fw-bold text-decoration-none p-0">Kích hoạt</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal View Menu Content -->
<div class="modal fade" id="menuDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <!-- Loaded by JS -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedMenuId = null;

        function selectRow(row, menuId) {
            document.querySelectorAll('#menuTable tbody tr').forEach(r => r.classList.remove('table-active'));
            row.classList.add('table-active');
            
            selectedMenuId = menuId;
            document.getElementById('btnEdit').disabled = false;
            document.getElementById('btnViewDetails').disabled = false;
        }

        function editSelected() {
            if (selectedMenuId) {
                window.location.href = '@Url.Action("Edit", "MenuManagement")/' + selectedMenuId;
            }
        }

        function openMenuDetailModal(menuId) {
            selectedMenuId = menuId;
            viewDetailsSelected();
        }

        function viewDetailsSelected() {
            if (selectedMenuId) {
                var modalEl = document.getElementById('menuDetailModal');
                var modalContent = modalEl.querySelector('.modal-content');
                modalContent.innerHTML = `
                    <div class="modal-body text-center py-5 text-primary">
                        <div class="spinner-border spinner-border-sm mb-2" role="status"></div>
                        <div class="small fw-semibold">Đang tải danh sách món...</div>
                    </div>
                `;
                var modal = new bootstrap.Modal(modalEl);
                modal.show();

                fetch('@Url.Action("GetMenuDetails", "MenuManagement")?id=' + selectedMenuId)
                    .then(res => {
                        if (!res.ok) throw new Error('Không tìm thấy chi tiết thực đơn');
                        return res.text();
                    })
                    .then(html => {
                        modalContent.innerHTML = html;
                    })
                    .catch(err => {
                        modalContent.innerHTML = `
                            <div class="modal-header border-bottom">
                                <h5 class="modal-title text-danger">Lỗi</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body text-center py-4 text-danger">
                                <i class="bi bi-exclamation-triangle fs-2 d-block mb-2"></i>
                                <div>${err.message}</div>
                            </div>
                        `;
                    });
            }
        }

        function filterTable() {
            var input = document.getElementById("searchInput");
            var filter = input.value.toUpperCase();
            var table = document.getElementById("menuTable");
            var tr = table.getElementsByTagName("tr");
            for (var i = 1; i < tr.length; i++) {
                var td = tr[i].getElementsByTagName("td")[0];
                if (td) {
                    var txtValue = td.textContent || td.innerText;
                    tr[i].style.display = (txtValue.toUpperCase().indexOf(filter) > -1) ? "" : "none";
                }
            }
        }

        function confirmToggleMenu(form, isActive) {
            const actionText = isActive ? 'ngừng hoạt động' : 'kích hoạt';
            showConfirmModal(
                'Xác nhận ' + actionText + ' thực đơn',
                'Bạn có chắc chắn muốn ' + actionText + ' thực đơn này không?',
                function() { form.submit(); }
            );
            return false;
        }
    </script>
}

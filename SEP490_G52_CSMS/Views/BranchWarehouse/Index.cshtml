@model SEP490_G52_CSMS.Models.ViewModels.BranchInventoryIndexViewModel

@{
    ViewData["Title"] = "Quản Lý Tồn Kho Chi Nhánh";
}

<div class="warehouse-page p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">QUẢN LÝ TỒN KHO CHI NHÁNH</h2>
            <span class="text-secondary fw-semibold fs-5"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Chi nhánh: @ViewBag.BranchName</span>
        </div>
        <div class="header-actions d-flex gap-2">
            <a href="@Url.Action("CreateRequest", "BranchWarehouse")" class="btn btn-outline-secondary">
                <i class="bi bi-box-arrow-in-right"></i> Tạo đơn nhập
            </a>
            <button type="button" class="btn btn-outline-dark fw-bold" data-bs-toggle="modal" data-bs-target="#addMaterialModal" onclick="prepareAddMaterialModal()">
                <i class="bi bi-plus-lg"></i> Nguyên liệu mới
            </button>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card shadow-sm border-0 mb-4 rounded-3 bg-light">
        <div class="card-body py-3">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-md-4 col-sm-12">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@Model.SearchString" class="form-control border-start-0" placeholder="Tìm kiếm theo tên nguyên liệu..." />
                    </div>
                </div>
                
                <div class="col-md-3 col-sm-6">
                    <select name="selectedCategory" class="form-select">
                        <option value="">-- Loại nguyên liệu --</option>
                        @foreach (var cat in Model.Categories)
                        {
                            if (cat == Model.SelectedCategory)
                            {
                                <option value="@cat" selected>@cat</option>
                            }
                            else
                            {
                                <option value="@cat">@cat</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3 col-sm-6">
                    <select name="selectedKind" class="form-select">
                        <option value="">-- Kiểu nguyên liệu --</option>
                        @foreach (var kind in Model.Kinds)
                        {
                            if (kind == Model.SelectedKind)
                            {
                                <option value="@kind" selected>@kind</option>
                            }
                            else
                            {
                                <option value="@kind">@kind</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2 col-sm-12 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100">Tìm kiếm</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Main side-by-side content -->
    <div class="row">
        <!-- Left Panel: Branch Inventory Grid -->
        <div class="col-lg-8 col-md-12 mb-4 mb-lg-0">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle m-0 table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 8%;" class="ps-3">STT</th>
                                    <th style="width: 15%;">Mã NgL</th>
                                    <th style="width: 27%;">Tên nguyên liệu</th>
                                    <th style="width: 15%;">Kiểu NgL</th>
                                    <th style="width: 10%;">Loại NgL</th>
                                    <th style="width: 12%;">Tồn kho</th>
                                    <th style="width: 13%;" class="text-center pe-3">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Items != null && Model.Items.Any())
                                {
                                    int sttOffset = (Model.CurrentPage - 1) * 10;
                                    for (int i = 0; i < Model.Items.Count; i++)
                                    {
                                        var item = Model.Items[i];
                                        bool isLow = item.StockQuantity <= item.LowStockThreshold;
                                        <tr>
                                            <td class="ps-3">@(sttOffset + i + 1)</td>
                                            <td class="fw-bold">@item.Material?.MaterialCode</td>
                                            <td>@item.Material?.MaterialName</td>
                                            <td>@item.Material?.MaterialKind</td>
                                            <td>@item.Material?.Category</td>
                                            <td class="fw-semibold">
                                                @item.StockQuantity.ToString("G29") @item.Material?.StorageUnit
                                                @if (isLow)
                                                {
                                                    if (item.StockQuantity == 0)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger ms-1">Hết hàng</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning-emphasis ms-1">Sắp hết</span>
                                                    }
                                                }
                                            </td>
                                            <td class="text-center pe-3">
                                                <button type="button" class="btn btn-sm btn-link text-primary fw-bold text-decoration-none" onclick="loadInventoryDetails(@item.InventoryId)">
                                                    Chi tiết
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">Không tìm thấy nguyên liệu phù hợp.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <div class="card-footer bg-white border-top py-3 d-flex justify-content-center">
                            <nav aria-label="Page navigation">
                                <ul class="pagination pagination-sm m-0">
                                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { searchString = Model.SearchString, selectedCategory = Model.SelectedCategory, selectedKind = Model.SelectedKind, page = Model.CurrentPage - 1 })">&laquo;</a>
                                    </li>
                                    @for (int p = 1; p <= Model.TotalPages; p++)
                                    {
                                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("Index", new { searchString = Model.SearchString, selectedCategory = Model.SelectedCategory, selectedKind = Model.SelectedKind, page = p })">@p</a>
                                        </li>
                                    }
                                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { searchString = Model.SearchString, selectedCategory = Model.SelectedCategory, selectedKind = Model.SelectedKind, page = Model.CurrentPage + 1 })">&raquo;</a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Panel: Side Detail Panel -->
        <div class="col-lg-4 col-md-12">
            <div class="card shadow-sm border-0 rounded-3 sticky-lg-top" style="top: 24px; z-index: 100;">
                <div class="card-header bg-dark text-white py-3 rounded-top-3">
                    <h5 class="m-0 fw-bold"><i class="bi bi-info-circle me-2 text-warning"></i>Chi tiết tồn chi nhánh</h5>
                </div>
                <div class="card-body p-4" id="detailPanelBody">
                    <div class="text-center text-muted py-5" id="detailPlaceholder">
                        <i class="bi bi-box fs-1 mb-3 d-block text-secondary-subtle"></i>
                        <span>Chọn nguyên liệu muốn xem từ bảng</span>
                    </div>
                    
                    <div class="d-none" id="detailContent">
                        <div class="mb-3 border-bottom pb-2">
                            <label class="text-muted small fw-bold text-uppercase d-block mb-1">Mã nguyên liệu</label>
                            <span class="fs-5 fw-bold text-dark" id="lblCode"></span>
                        </div>
                        <div class="mb-3 border-bottom pb-2">
                            <label class="text-muted small fw-bold text-uppercase d-block mb-1">Tên nguyên liệu</label>
                            <span class="fs-6 fw-bold text-dark" id="lblName"></span>
                        </div>
                        <div class="row mb-3">
                            <div class="col border-end pb-2">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-1">Kiểu NgL</label>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-2" id="lblKind"></span>
                            </div>
                            <div class="col pb-2 ps-3">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-1">Loại NgL</label>
                                <span class="fw-semibold text-dark" id="lblCategory"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col border-end pb-2">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-1">Trạng thái vật lý</label>
                                <span class="fw-semibold text-dark" id="lblState"></span>
                            </div>
                            <div class="col pb-2 ps-3">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-1">Đơn vị</label>
                                <span class="fw-semibold text-dark" id="lblUnit"></span>
                            </div>
                        </div>
                        <div class="mb-3 border-bottom pb-2">
                            <label class="text-muted small fw-bold text-uppercase d-block mb-1">Nhà cung cấp chính</label>
                            <span class="text-dark" id="lblSupplier"></span>
                        </div>
                        <div class="mb-3 border-bottom pb-2">
                            <label class="text-muted small fw-bold text-uppercase d-block mb-1">Xuất xứ</label>
                            <span class="text-dark" id="lblOrigin"></span>
                        </div>
                        <div class="row mb-2">
                            <div class="col border-end pb-2">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-1">Tồn kho chi nhánh</label>
                                <span class="fs-4 fw-bold text-primary" id="lblStock"></span>
                            </div>
                            <div class="col pb-2 ps-3">
                                <label class="text-muted small fw-bold text-uppercase d-block mb-1">Ngưỡng cảnh báo</label>
                                <span class="fs-4 fw-bold text-danger" id="lblThreshold"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================== MODALS ==================== -->

<!-- Modal: Thêm nguyên liệu (Screen B) -->
<div class="modal fade" id="addMaterialModal" tabindex="-1" aria-labelledby="addMaterialModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="addMaterialModalLabel">Thêm nguyên liệu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3 position-relative">
                    <label class="form-label small fw-bold mb-1">Tên nguyên liệu <span class="text-danger">*</span></label>
                    <input type="text" id="addMatName" class="form-control" placeholder="Nhập/ Tìm kiếm tên ngl..." autocomplete="off" oninput="searchCatalogSuggestions(this.value)" />
                    <div id="autocompleteResults" class="list-group position-absolute w-100 mt-1 shadow-sm d-none" style="z-index: 1050; max-height: 200px; overflow-y: auto;">
                        <!-- Autocomplete items -->
                    </div>
                    <div class="invalid-feedback" id="valAddMatName"></div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold mb-1">Loại nguyên liệu</label>
                        <select id="addMatCategory" class="form-select bg-light" disabled>
                            <option value="">-- Tự động điền --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold mb-1">Kiểu nguyên liệu</label>
                        <input type="text" id="addMatKind" class="form-control bg-light" placeholder="Tự động điền..." readonly />
                    </div>
                </div>

                <div class="mt-4 p-3 bg-light rounded border border-light-subtle">
                    <p class="m-0 text-danger small"><i class="bi bi-exclamation-triangle-fill me-1"></i> Tên nguyên liệu phải khớp với tên nguyên liệu tạo từ kho tổng, có thể chọn hoặc tự nhập.</p>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4 fw-bold" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-dark px-4 fw-bold" onclick="addMaterialSubmit()">Thêm nguyên liệu</button>
            </div>
        </div>
    </div>
</div>

<style>
    .warehouse-page {
        background-color: #f8f9fa;
        min-height: calc(100vh - 70px);
    }
    .table th {
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        color: #495057;
    }
    .btn-outline-secondary {
        border-color: #dee2e6;
        color: #495057;
    }
    .btn-outline-secondary:hover {
        background-color: #f8f9fa;
        color: #212529;
        border-color: #adb5bd;
    }
</style>

@section Scripts {
    <script>
        function triggerAction(actionName) {
            showToast(`Tính năng "${actionName}" (UC62) đang được phát triển.`, 'warning');
        }

        // --- 1. VIEW DETAILS ---
        function loadInventoryDetails(id) {
            $('#detailPlaceholder').addClass('d-none');
            $('#detailContent').addClass('d-none');

            $.ajax({
                url: '/BranchWarehouse/GetInventoryDetails',
                type: 'GET',
                data: { id: id },
                success: function(m) {
                    $('#lblCode').text(m.materialCode);
                    $('#lblName').text(m.materialName);
                    $('#lblKind').text(m.materialKind);
                    $('#lblCategory').text(m.category);
                    $('#lblState').text(m.physicalState);
                    $('#lblUnit').text(m.storageUnit);
                    $('#lblSupplier').text(m.supplier);
                    $('#lblOrigin').text(m.origin);
                    $('#lblStock').text(m.stockQuantity);
                    $('#lblThreshold').text(m.lowStockThreshold);

                    $('#detailContent').removeClass('d-none');
                },
                error: function() {
                    showToast('Lỗi tải thông tin chi tiết tồn kho.', 'danger');
                    $('#detailPlaceholder').removeClass('d-none');
                }
            });
        }

        // --- 2. AUTOCOMPLETE SUGGESTIONS ---
        let catalogList = [];

        function prepareAddMaterialModal() {
            $('#addMatName').val('').removeClass('is-invalid');
            $('#addMatCategory').html('<option value="">-- Tự động điền --</option>').val('');
            $('#addMatKind').val('');
            $('#autocompleteResults').addClass('d-none').html('');
        }

        function searchCatalogSuggestions(term) {
            if (!term.trim()) {
                $('#autocompleteResults').addClass('d-none').html('');
                return;
            }

            $.ajax({
                url: '/BranchWarehouse/SearchCentralCatalog',
                type: 'GET',
                data: { term: term },
                success: function(list) {
                    catalogList = list;
                    let items = "";
                    list.forEach((item, index) => {
                        items += `
                            <button type="button" class="list-group-item list-group-item-action py-2" onclick="selectSuggestion(${index})">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="text-dark">${item.materialName}</strong>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill">${item.category}</span>
                                </div>
                            </button>
                        `;
                    });
                    if (list.length === 0) {
                        items = '<div class="list-group-item text-muted small">Không tìm thấy nguyên liệu phù hợp trong kho tổng.</div>';
                    }
                    $('#autocompleteResults').removeClass('d-none').html(items);
                }
            });
        }

        function selectSuggestion(index) {
            let item = catalogList[index];
            $('#addMatName').val(item.materialName);
            
            // Auto fill category and kind
            let catOpt = `<option value="${item.category}" selected>${item.category}</option>`;
            $('#addMatCategory').html(catOpt);
            $('#addMatKind').val(item.materialKind);

            $('#autocompleteResults').addClass('d-none').html('');
        }

        // Close suggestion list on clicking outside
        $(document).on('click', function(e) {
            if (!$(e.target).closest('#addMatName, #autocompleteResults').length) {
                $('#autocompleteResults').addClass('d-none');
            }
        });

        // --- 3. REGISTER MATERIAL SUBMIT ---
        function addMaterialSubmit() {
            let name = $('#addMatName').val().trim();
            $('#addMatName').removeClass('is-invalid');

            if (!name) {
                $('#addMatName').addClass('is-invalid');
                $('#valAddMatName').text('Tên nguyên liệu là bắt buộc.');
                return;
            }

            $.ajax({
                url: '/BranchWarehouse/RegisterBranchMaterial',
                type: 'POST',
                data: { materialName: name },
                success: function(res) {
                    if (res.success) {
                        $('#addMaterialModal').modal('hide');
                        showToast(res.message, 'success');
                        location.reload();
                    } else {
                        $('#addMatName').addClass('is-invalid');
                        $('#valAddMatName').text(res.message);
                    }
                },
                error: function() {
                    showToast('Lỗi kết nối máy chủ.', 'danger');
                }
            });
        }
    </script>
}

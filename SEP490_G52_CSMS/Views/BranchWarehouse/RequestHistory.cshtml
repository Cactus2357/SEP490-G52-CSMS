@model SEP490_G52_CSMS.Controllers.BranchSupplyRequestHistoryViewModel

@{
    ViewData["Title"] = "Lịch Sử Đơn Yêu Cầu Nhập Kho";
}

<div class="warehouse-page p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">LỊCH SỬ ĐƠN YÊU CẦU NHẬP KHO</h2>
            <span class="text-secondary fw-semibold fs-5"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Chi nhánh: @ViewBag.BranchName</span>
        </div>
        <div>
            <a href="@Url.Action("CreateRequest", "BranchWarehouse")" class="btn btn-outline-dark fw-bold">
                <i class="bi bi-plus-lg me-2"></i> Tạo đơn nhập
            </a>
        </div>
    </div>

    <!-- Error Alert -->
    @if (TempData["HistoryError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["HistoryError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Form -->
    <div class="card shadow-sm border-0 mb-4 rounded-3 bg-light">
        <div class="card-body py-3">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Từ ngày</label>
                    <input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Đến ngày</label>
                    <input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>

                <div class="col-md-3 col-sm-6">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Trạng thái</label>
                    <select name="status" class="form-select">
                        <option value="Tất cả" selected="@(Model.SelectedStatus == "Tất cả")">Tất cả</option>
                        <option value="Chờ duyệt" selected="@(Model.SelectedStatus == "Chờ duyệt")">Chờ duyệt</option>
                        <option value="Đang chuẩn bị xuất" selected="@(Model.SelectedStatus == "Đang chuẩn bị xuất")">Đang chuẩn bị xuất</option>
                        <option value="Đã xuất kho" selected="@(Model.SelectedStatus == "Đã xuất kho")">Đã xuất kho</option>
                        <option value="Đã hoàn thành" selected="@(Model.SelectedStatus == "Đã hoàn thành")">Đã hoàn thành</option>
                        <option value="Từ chối" selected="@(Model.SelectedStatus == "Từ chối")">Từ chối</option>
                        <option value="Đã hủy" selected="@(Model.SelectedStatus == "Đã hủy")">Đã hủy</option>
                    </select>
                </div>

                <div class="col-md-3 col-sm-12 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 py-2 fw-bold">Tìm kiếm</button>
                    <a asp-action="RequestHistory" class="btn btn-outline-secondary py-2"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Requests History Grid -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0 table-sm">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 15%;" class="ps-3">Mã đơn</th>
                            <th style="width: 20%;">Ngày gửi</th>
                            <th style="width: 20%;">Trạng thái</th>
                            <th style="width: 30%;">Ghi chú từ tổng kho</th>
                            <th style="width: 15%;" class="text-center pe-3">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Requests != null && Model.Requests.Any())
                        {
                            foreach (var item in Model.Requests)
                            {
                                string badgeClass = item.Status == "Chờ duyệt" ? "bg-warning text-dark" :
                                                   item.Status == "Đang chuẩn bị xuất" ? "bg-primary text-white" :
                                                   item.Status == "Đã xuất kho" ? "bg-info text-dark" :
                                                   item.Status == "Đã hoàn thành" ? "bg-success text-white" :
                                                   item.Status == "Từ chối" ? "bg-danger text-white" : "bg-secondary text-white";

                                string rowStyle = item.Status == "Chờ duyệt" ? "table-warning" :
                                                   item.Status == "Đang chuẩn bị xuất" ? "table-primary" :
                                                   item.Status == "Đã xuất kho" ? "table-info" :
                                                   item.Status == "Đã hoàn thành" ? "table-success" :
                                                   item.Status == "Từ chối" ? "table-danger" : "";

                                <tr class="@rowStyle">
                                    <td class="ps-3 fw-bold text-dark">@item.RequestCode</td>
                                    <td>@item.RequestDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="badge @badgeClass rounded-pill px-3 py-2">@item.Status</span></td>
                                    <td class="text-secondary small">@item.WarehouseNote</td>
                                    <td class="text-center pe-3">
                                        <button type="button" class="btn btn-sm btn-link text-primary text-decoration-none fw-bold p-0" onclick="viewRequestDetails('@item.RequestCode')">
                                            Chi tiết
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary-subtle"></i>
                                    Không tìm thấy đơn yêu cầu phù hợp.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white border-top py-3 d-flex justify-content-center">
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("RequestHistory", new { fromDate = Model.FromDate.ToString("yyyy-MM-dd"), toDate = Model.ToDate.ToString("yyyy-MM-dd"), status = Model.SelectedStatus, page = Model.CurrentPage - 1 })">&laquo;</a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("RequestHistory", new { fromDate = Model.FromDate.ToString("yyyy-MM-dd"), toDate = Model.ToDate.ToString("yyyy-MM-dd"), status = Model.SelectedStatus, page = p })">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("RequestHistory", new { fromDate = Model.FromDate.ToString("yyyy-MM-dd"), toDate = Model.ToDate.ToString("yyyy-MM-dd"), status = Model.SelectedStatus, page = Model.CurrentPage + 1 })">&raquo;</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<!-- ==================== MODALS ==================== -->

<!-- Modal: Chi tiết đơn yêu cầu (UC64) -->
<div class="modal fade" id="requestDetailModal" tabindex="-1" aria-labelledby="requestDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="requestDetailModalLabel">Chi tiết đơn yêu cầu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Status Banner -->
                <div class="mb-4 bg-light p-3 rounded d-flex justify-content-between align-items-center">
                    <div>
                        <strong class="text-secondary small d-block text-uppercase">Mã đơn đặt hàng</strong>
                        <span class="fs-5 fw-bold text-dark" id="lblDetailCode"></span>
                    </div>
                    <div>
                        <strong class="text-secondary small d-block text-uppercase text-end">Trạng thái</strong>
                        <span class="badge fs-6 rounded-pill px-3" id="lblDetailStatus"></span>
                    </div>
                </div>

                <!-- Warehouse Note if any -->
                <div class="mb-3 d-none" id="detailNoteContainer">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Ghi chú từ tổng kho</label>
                    <div class="alert alert-info py-2" id="lblDetailNote"></div>
                </div>

                <!-- Line Items Table -->
                <h6 class="fw-bold mb-2">Nguyên vật liệu chi tiết</h6>
                <div class="table-responsive mb-4">
                    <table class="table table-bordered table-sm align-middle">
                        <thead class="table-light">
                            <tr id="tableHeaderRow">
                                <th>Tên NgL</th>
                                <th>Loại NgL</th>
                                <th>Yêu cầu</th>
                                <th class="d-none" id="thReleased">Số lượng thực xuất</th>
                            </tr>
                        </thead>
                        <tbody id="detailTableBody">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>
                </div>

                <!-- Confirm Delivery Form (State 2: Đang giao hàng) -->
                <div class="card d-none mb-3" id="confirmDeliveryPanel">
                    <div class="card-header py-2 fw-bold text-dark bg-light">Xác nhận nhận hàng từ tổng kho</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold mb-1">Người giao hàng <span class="text-danger">*</span></label>
                                <input type="text" id="deliveryGuy" class="form-control form-control-sm" placeholder="Họ tên người giao hàng..." required />
                                <div class="invalid-feedback" id="valDeliveryGuy">Vui lòng nhập tên người giao hàng.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold mb-1">Số điện thoại</label>
                                <input type="text" id="deliveryGuyPhone" class="form-control form-control-sm" placeholder="Số điện thoại..." />
                            </div>
                        </div>
                        <div class="mt-3 small text-muted">
                            <i class="bi bi-info-circle-fill text-primary"></i> Đảm bảo bạn đã kiểm đếm đầy đủ số lượng thực tế nhận được trước khi nhấn xác nhận.
                        </div>
                    </div>
                </div>

                <!-- Completed Audit Section (State 3: Đã hoàn thành) -->
                <div class="card d-none mb-3" id="auditDeliveryPanel">
                    <div class="card-header py-2 fw-bold text-success bg-success-subtle border-success-subtle">Thông tin giao nhận hàng</div>
                    <div class="card-body py-3 small text-dark fs-6">
                        <div class="row g-2">
                            <div class="col-md-6"><strong>Người duyệt đơn:</strong> <span id="auditApprover"></span></div>
                            <div class="col-md-6"><strong>Ngày giao hàng:</strong> <span id="auditReceivedDate"></span></div>
                            <div class="col-md-6"><strong>Người giao:</strong> <span id="auditDeliverer"></span></div>
                            <div class="col-md-6"><strong>Số điện thoại:</strong> <span id="auditPhone"></span></div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="modal-footer bg-light d-flex justify-content-between">
                <div>
                    <!-- Cancel Request Button (State 1: Chờ duyệt) -->
                    <button type="button" class="btn btn-danger fw-bold d-none" id="btnCancelRequest" onclick="submitCancelRequest()">Hủy đơn</button>
                    
                    <!-- Confirm Receipt Button (State 2: Đang giao hàng) -->
                    <button type="button" class="btn btn-success fw-bold d-none" id="btnConfirmReceipt" onclick="submitConfirmReceipt()">Đã nhận được hàng</button>
                </div>
                <button type="button" class="btn btn-secondary fw-bold px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<style>
    .warehouse-page {
        background-color: #f8f9fa;
        min-height: calc(100vh - 70px);
    }
    .table th {
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        color: #495057;
    }
    .btn-outline-secondary {
        border-color: #dee2e6;
        color: #495057;
    }
    .btn-outline-secondary:hover {
        background-color: #f8f9fa;
        color: #212529;
        border-color: #adb5bd;
    }
</style>

@section Scripts {
    <script>
        let activeRequestCode = null;

        // --- 1. LOAD DETAILS ---
        function viewRequestDetails(code) {
            activeRequestCode = code;

            // Reset panel display states
            $('#thReleased').addClass('d-none');
            $('#confirmDeliveryPanel').addClass('d-none');
            $('#auditDeliveryPanel').addClass('d-none');
            $('#btnCancelRequest').addClass('d-none');
            $('#btnConfirmReceipt').addClass('d-none');
            $('#detailNoteContainer').addClass('d-none');
            $('#deliveryGuy').val('').removeClass('is-invalid');
            $('#deliveryGuyPhone').val('');

            $.ajax({
                url: '/BranchWarehouse/GetRequestDetails',
                type: 'GET',
                data: { code: code },
                success: function(r) {
                    $('#lblDetailCode').text(r.requestCode);
                    $('#lblDetailStatus').text(r.status);
                    
                    // Style status badge
                    let badgeClass = "bg-secondary text-white";
                    if (r.status === "Chờ duyệt") badgeClass = "bg-warning text-dark";
                    else if (r.status === "Đang chuẩn bị xuất") badgeClass = "bg-primary text-white";
                    else if (r.status === "Đã xuất kho") badgeClass = "bg-info text-dark";
                    else if (r.status === "Đã hoàn thành") badgeClass = "bg-success text-white";
                    else if (r.status === "Từ chối") badgeClass = "bg-danger text-white";
                    $('#lblDetailStatus').removeClass().addClass(`badge fs-6 rounded-pill px-3 ${badgeClass}`);

                    // Show warehouse note if any
                    if (r.warehouseNote) {
                        $('#lblDetailNote').text(r.warehouseNote);
                        $('#detailNoteContainer').removeClass('d-none');
                    }

                    // Render lines
                    let rows = "";
                    let hasReleased = (r.status === "Đã xuất kho" || r.status === "Đã hoàn thành");
                    if (hasReleased) $('#thReleased').removeClass('d-none');

                    r.items.forEach(item => {
                        let releasedCol = "";
                        if (hasReleased) {
                            let qty = item.quantityReleased !== null ? item.quantityReleased : "0";
                            releasedCol = `<td class="fw-bold text-success">[${qty}] ${item.storageUnit}</td>`;
                        }

                        rows += `
                            <tr>
                                <td class="fw-bold text-dark">${item.materialName}</td>
                                <td>${item.category}</td>
                                <td>${item.quantityRequested} ${item.storageUnit}</td>
                                ${releasedCol}
                            </tr>
                        `;
                    });
                    $('#detailTableBody').html(rows);

                    // Contextual controls
                    if (r.status === "Chờ duyệt") {
                        $('#btnCancelRequest').removeClass('d-none');
                    } else if (r.status === "Đã xuất kho") {
                        $('#confirmDeliveryPanel').removeClass('d-none');
                        $('#btnConfirmReceipt').removeClass('d-none');
                    } else if (r.status === "Đã hoàn thành") {
                        $('#auditApprover').text(r.approvedBy);
                        $('#auditReceivedDate').text(r.receivedDate);
                        $('#auditDeliverer').text(r.delivererName);
                        $('#auditPhone').text(r.delivererPhone || 'Không có');
                        
                        $('#auditDeliveryPanel').removeClass('d-none');
                    }

                    $('#requestDetailModal').modal('show');
                },
                error: function() {
                    showToast('Không thể tải chi tiết đơn yêu cầu. Vui lòng thử lại.', 'danger');
                }
            });
        }

        // --- 2. CANCEL REQUEST ---
        function submitCancelRequest() {
            if (!activeRequestCode) return;
            showConfirmModal(
                'Hủy đơn yêu cầu',
                'Bạn có chắc chắn muốn hủy đơn yêu cầu nhập kho này?',
                function() {
                    $.ajax({
                        url: '/BranchWarehouse/CancelRequest',
                        type: 'POST',
                        data: { code: activeRequestCode },
                        success: function(res) {
                            if (res.success) {
                                $('#requestDetailModal').modal('hide');
                                showToast(res.message, 'success');
                                setTimeout(function() {
                                    location.reload();
                                }, 1000);
                            } else {
                                showToast(res.message, 'danger');
                            }
                        },
                        error: function() {
                            showToast('Lỗi kết nối máy chủ khi hủy đơn.', 'danger');
                        }
                    });
                }
            );
        }

        // --- 3. CONFIRM RECEIPT ---
        function submitConfirmReceipt() {
            if (!activeRequestCode) return;
            $('#deliveryGuy').removeClass('is-invalid');

            let name = $('#deliveryGuy').val().trim();
            let phone = $('#deliveryGuyPhone').val().trim();

            if (!name) {
                $('#deliveryGuy').addClass('is-invalid');
                return;
            }

            showConfirmModal(
                'Xác nhận nhập hàng',
                'Xác nhận chi nhánh đã nhận đủ hàng và cập nhật số lượng tồn kho?',
                function() {
                    $.ajax({
                        url: '/BranchWarehouse/ConfirmReceipt',
                        type: 'POST',
                        data: { code: activeRequestCode, delivererName: name, delivererPhone: phone },
                        success: function(res) {
                            if (res.success) {
                                $('#requestDetailModal').modal('hide');
                                showToast(res.message, 'success');
                                setTimeout(function() {
                                    location.reload();
                                }, 1500);
                            } else {
                                showToast(res.message, 'danger');
                            }
                        },
                        error: function() {
                            showToast('Lỗi kết nối máy chủ khi xác nhận nhận hàng.', 'danger');
                        }
                    });
                }
            );
        }
    </script>
}

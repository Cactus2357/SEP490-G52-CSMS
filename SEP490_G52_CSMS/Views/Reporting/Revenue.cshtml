@model SEP490_G52_CSMS.Models.ViewModels.RevenueReportViewModel

@{
    ViewData["Title"] = "BÁO CÁO DOANH THU & THỐNG KÊ TOÀN CHUỖI";
}

<div class="container-fluid mt-3 px-4 pb-5">

    <!-- Top Dashboard Header & Filters -->
    <div class="card bg-body-tertiary border-0 rounded-3 mb-4 shadow-sm">
        <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="bi bi-graph-up-arrow fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small">Báo cáo hệ thống / Quản lý doanh thu</span>
                    <h4 class="fw-bold m-0 text-dark">BÁO CÁO DOANH THU & THỐNG KÊ TOÀN CHUỖI</h4>
                </div>
            </div>

            <!-- Toolbar Filters -->
            <form method="get" id="filterForm" class="d-flex flex-wrap align-items-center gap-3 m-0">
                <!-- Branch Selector -->
                <div class="input-group" style="width: auto;">
                    <span class="input-group-text bg-white text-secondary"><i class="bi bi-shop"></i></span>
                    <select id="branchId" name="branchId" class="form-select fw-semibold"
                            asp-for="SelectedBranchId" asp-items="Model.BranchList" onchange="document.getElementById('filterForm').submit();">
                    </select>
                </div>

                <!-- Month Pager -->
                <div class="input-group" style="width: auto;">
                    <button type="button" class="btn btn-outline-secondary" onclick="changeMonth(-1)"><i class="bi bi-chevron-left"></i></button>
                    <span class="input-group-text bg-white fw-bold text-primary px-3">
                        Tháng: @Model.SelectedMonth
                    </span>
                    <button type="button" class="btn btn-outline-secondary" onclick="changeMonth(1)"><i class="bi bi-chevron-right"></i></button>
                    <input type="hidden" id="dateRange" name="dateRange" value="@Model.SelectedMonth" />
                </div>
            </form>
        </div>
    </div>

    <!-- Executive KPI Metric Summary Cards -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Total Revenue -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Tổng Doanh Thu</div>
                        <h4 class="fw-bold text-success m-0">@Model.TotalRevenue.ToString("N0") đ</h4>
                    </div>
                    <div class="bg-success-subtle text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-currency-dollar fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Total Orders -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Số Đơn Hàng Bán</div>
                        <h4 class="fw-bold text-primary m-0">@Model.TotalOrders.ToString("N0") đơn</h4>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-receipt fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Total Products Sold -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Sản Phẩm Đã Bán</div>
                        <h4 class="fw-bold text-info m-0">@Model.TotalQuantitySold.ToString("N0") ly/món</h4>
                    </div>
                    <div class="bg-info-subtle text-info rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-cup-hot fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Warehouse Import Cost -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Chi Phí Nhập Nguyên Liệu</div>
                        <h4 class="fw-bold text-warning-emphasis m-0">@Model.TotalMaterialImportsAmount.ToString("N0") đ</h4>
                    </div>
                    <div class="bg-warning-subtle text-warning-emphasis rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-box-seam fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 1: Daily Revenue Line Chart -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-body-tertiary border-0 py-3 d-flex align-items-center justify-content-between">
            <h6 class="fw-bold m-0 text-dark">
                <i class="bi bi-activity text-primary me-2"></i>BIỂU ĐỒ XU HƯỚNG DOANH THU THEO NGÀY THÁNG @Model.SelectedMonth
            </h6>
        </div>
        <div class="card-body p-4">
            <div style="position: relative; height: 350px; width: 100%;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Section 2: Category Breakdown (Doughnut) & Branch Revenue Table Grid -->
    <div class="row g-4 mb-4">
        <!-- Category Breakdown Doughnut Chart -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-body-tertiary border-0 py-3">
                    <h6 class="fw-bold m-0 text-dark">
                        <i class="bi bi-pie-chart-fill text-success me-2"></i>CƠ CẤU DOANH THU THEO DANH MỤC SẢN PHẨM
                    </h6>
                </div>
                <div class="card-body p-4 d-flex align-items-center justify-content-center">
                    <div style="position: relative; height: 290px; width: 100%;">
                        <canvas id="categoryDoughnutChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Branch Revenue Overview Table -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-body-tertiary border-0 py-3 d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold m-0 text-dark">
                        <i class="bi bi-table text-info me-2"></i>CHI TIẾT DOANH THU THEO CHI NHÁNH
                    </h6>
                    <span class="badge bg-secondary-subtle text-dark border">Tháng @Model.SelectedMonth</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3" style="width: 8%;">STT</th>
                                    <th>Tên Chi Nhánh</th>
                                    <th class="text-center">Số Đơn</th>
                                    <th>Doanh Thu Tiền Mặt</th>
                                    <th>Doanh Thu Chuyển Khoản</th>
                                    <th class="pe-3 text-end">Tổng Doanh Thu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int index = 1;
                                    foreach (var row in Model.TableData)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-bold text-secondary">@index</td>
                                            <td class="fw-bold text-dark">@row.BranchName</td>
                                            <td class="text-center"><span class="badge bg-light text-dark border">@row.OrderCount</span></td>
                                            <td class="text-secondary">@row.CashRevenue.ToString("N0") đ</td>
                                            <td class="text-secondary">@row.TransferRevenue.ToString("N0") đ</td>
                                            <td class="pe-3 text-end fw-bold text-success">@row.TotalRevenue.ToString("N0") đ</td>
                                        </tr>
                                        index++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 3: Product Sales Quantity (Bar Chart) & Top Selling Products per Branch -->
    <div class="row g-4 mb-4">
        <!-- Top Sold Products Bar Chart -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-body-tertiary border-0 py-3">
                    <h6 class="fw-bold m-0 text-dark">
                        <i class="bi bi-bar-chart-fill text-warning me-2"></i>THỐNG KÊ SỐ LƯỢNG SẢN PHẨM ĐÃ BÁN (TOP 10)
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div style="position: relative; height: 320px; width: 100%;">
                        <canvas id="productSalesBarChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Selling Products by Branch Grid -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-body-tertiary border-0 py-3">
                    <h6 class="fw-bold m-0 text-dark">
                        <i class="bi bi-trophy-fill text-danger me-2"></i>SẢN PHẨM BÁN CHẠY NHẤT TỪNG CHI NHÁNH
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="d-flex flex-column gap-3">
                        @if (!Model.BranchTopProducts.Any())
                        {
                            <div class="text-center text-muted py-4">Chưa có dữ liệu bán hàng.</div>
                        }
                        else
                        {
                            foreach (var top in Model.BranchTopProducts)
                            {
                                <div class="card border-0 shadow-sm bg-body-tertiary rounded-3 p-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge bg-primary-subtle text-primary border mb-1">@top.BranchName</span>
                                            <h6 class="fw-bold text-dark m-0">@top.ProductName</h6>
                                        </div>
                                        <div class="text-end">
                                            <div class="fw-bold text-success">@top.QuantitySold.ToString("N0") món</div>
                                            <small class="text-muted">(@top.TotalRevenue.ToString("N0") đ)</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 4: Material Inventory Supply Imports & Exports Statistics Chart -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-body-tertiary border-0 py-3">
            <h6 class="fw-bold m-0 text-dark">
                <i class="bi bi-box-seam-fill text-secondary me-2"></i>THỐNG KÊ XUẤT - NHẬP NGUYÊN LIỆU (KHO TỔNG & CHI NHÁNH)
            </h6>
        </div>
        <div class="card-body p-4">
            <div style="position: relative; height: 350px; width: 100%;">
                <canvas id="materialSupplyChart"></canvas>
            </div>
        </div>
    </div>

</div>

<!-- Nhúng Chart.js (tải cục bộ từ lib) -->
<script src="~/lib/chartjs/chart.umd.js"></script>
<script>
    function changeMonth(offset) {
        let currentMonthStr = document.getElementById('dateRange').value;
        let date = new Date(currentMonthStr + "-01");
        date.setMonth(date.getMonth() + offset);
        
        let newMonth = date.getFullYear() + "-" + String(date.getMonth() + 1).padStart(2, '0');
        document.getElementById('dateRange').value = newMonth;
        document.getElementById('filterForm').submit();
    }

    document.addEventListener('DOMContentLoaded', function () {
        // --- 1. Line Chart: Doanh thu theo thời gian ---
        const ctxRevenue = document.getElementById('revenueChart').getContext('2d');
        const chartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels));
        const chartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData));

        new Chart(ctxRevenue, {
            type: 'line',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Doanh thu (đ)',
                    data: chartData,
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                    borderWidth: 3,
                    tension: 0.3,
                    fill: true,
                    pointBackgroundColor: '#0d6efd',
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return ' Doanh thu: ' + context.parsed.y.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(val) {
                                return val.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    }
                }
            }
        });

        // --- 2. Doughnut Chart: Cơ cấu Danh mục ---
        const ctxCategory = document.getElementById('categoryDoughnutChart').getContext('2d');
        const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryLabels));
        const catRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryRevenueData));

        new Chart(ctxCategory, {
            type: 'doughnut',
            data: {
                labels: catLabels,
                datasets: [{
                    data: catRevenues,
                    backgroundColor: [
                        '#0d6efd', '#198754', '#ffc107', '#0dcaf0', '#d63384', '#6610f2', '#fd7e14'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right' },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ' ' + ctx.label + ': ' + ctx.parsed.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    }
                }
            }
        });

        // --- 3. Bar Chart: Top 10 Sản phẩm Bán chạy ---
        const ctxProdSales = document.getElementById('productSalesBarChart').getContext('2d');
        const prodLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProductSalesLabels));
        const prodQtyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProductSalesQuantityData));

        new Chart(ctxProdSales, {
            type: 'bar',
            data: {
                labels: prodLabels,
                datasets: [{
                    label: 'Số lượng đã bán',
                    data: prodQtyData,
                    backgroundColor: 'rgba(255, 193, 7, 0.85)',
                    borderColor: '#ffc107',
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y', // Horizontal Bar Chart
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ' Đã bán: ' + ctx.parsed.x + ' món';
                            }
                        }
                    }
                },
                scales: {
                    x: { beginAtZero: true }
                }
            }
        });

        // --- 4. Grouped Bar Chart: Thống kê Xuất - Nhập Nguyên vật liệu ---
        const ctxMaterial = document.getElementById('materialSupplyChart').getContext('2d');
        const matLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MaterialStatLabels));
        const whImportData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WarehouseImportData));
        const whExportData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WarehouseExportData));
        const branchReqData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BranchImportRequestData));

        new Chart(ctxMaterial, {
            type: 'bar',
            data: {
                labels: matLabels,
                datasets: [
                    {
                        label: 'Nhập vào Kho Tổng (NCC)',
                        data: whImportData,
                        backgroundColor: '#0d6efd',
                        borderRadius: 4
                    },
                    {
                        label: 'Xuất từ Kho Tổng (Cho CN)',
                        data: whExportData,
                        backgroundColor: '#0dcaf0',
                        borderRadius: 4
                    },
                    {
                        label: 'Chi Nhánh Đã Nhận',
                        data: branchReqData,
                        backgroundColor: '#198754',
                        borderRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top' }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true }
                }
            }
        });
    });
</script>

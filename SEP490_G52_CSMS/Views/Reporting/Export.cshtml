<script>
    function showAlert(message) {
        const container = document.getElementById('alertContainer');
        container.innerHTML = `
            <div class="alert alert-danger border-0 shadow-sm rounded-3 alert-dismissible fade show" role="alert">
                <strong><i class="bi bi-exclamation-triangle-fill me-1"></i> Lỗi:</strong> ${message}
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function downloadFile(url) {
        try {
            const response = await fetch(url, { method: 'GET' });
            
            if (!response.ok) {
                const errorMsg = await response.text();
                showAlert(errorMsg || "Đã xảy ra lỗi khi tải file!");
                return;
            }

            let filename = "export.csv";
            const disposition = response.headers.get('Content-Disposition');
            if (disposition && disposition.indexOf('attachment') !== -1) {
                const filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                const matches = filenameRegex.exec(disposition);
                if (matches != null && matches[1]) {
                    filename = matches[1].replace(/['"]/g, '');
                }
            }

            const blob = await response.blob();
            const downloadUrl = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.style.display = 'none';
            a.href = downloadUrl;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(downloadUrl);
        } catch (error) {
            showAlert("Không thể kết nối đến máy chủ.");
        }
    }

    function getBranchId() {
        return document.getElementById('globalBranchId').value;
    }

    function exportRevenue() {
        const branchId = getBranchId();
        const fromDate = document.getElementById('revFromDate').value;
        const toDate = document.getElementById('revToDate').value;
        
        if (new Date(toDate) < new Date(fromDate)) {
            showAlert("Khoảng thời gian không hợp lệ. Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu!");
            return;
        }

        const url = `/Reporting/ExportRevenue?branchId=${branchId}&fromDate=${fromDate}&toDate=${toDate}`;
        downloadFile(url);
    }

    function exportTimesheet() {
        const branchId = getBranchId();
        const fromDate = document.getElementById('tsFromDate').value;
        const toDate = document.getElementById('tsToDate').value;
        
        if (new Date(toDate) < new Date(fromDate)) {
            showAlert("Khoảng thời gian không hợp lệ. Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu!");
            return;
        }

        const url = `/Reporting/ExportTimesheet?branchId=${branchId}&fromDate=${fromDate}&toDate=${toDate}`;
        downloadFile(url);
    }

    function exportMenu() {
        const branchId = getBranchId();
        const url = `/Reporting/ExportMenu?branchId=${branchId}`;
        downloadFile(url);
    }

    function exportWarehouseImports() {
        const fromDate = document.getElementById('whImpFromDate').value;
        const toDate = document.getElementById('whImpToDate').value;
        
        if (new Date(toDate) < new Date(fromDate)) {
            showAlert("Khoảng thời gian không hợp lệ. Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu!");
            return;
        }

        const url = `/Reporting/ExportWarehouseImports?fromDate=${fromDate}&toDate=${toDate}`;
        downloadFile(url);
    }

    function exportWarehouseExports() {
        const branchId = getBranchId();
        const fromDate = document.getElementById('whExpFromDate').value;
        const toDate = document.getElementById('whExpToDate').value;
        
        if (new Date(toDate) < new Date(fromDate)) {
            showAlert("Khoảng thời gian không hợp lệ. Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu!");
            return;
        }

        const url = `/Reporting/ExportWarehouseExports?branchId=${branchId}&fromDate=${fromDate}&toDate=${toDate}`;
        downloadFile(url);
    }

    function exportInventory() {
        const branchId = getBranchId();
        const url = `/Reporting/ExportInventory?branchId=${branchId}`;
        downloadFile(url);
    }

    function exportCashHandover() {
        const branchId = getBranchId();
        const fromDate = document.getElementById('hoFromDate').value;
        const toDate = document.getElementById('hoToDate').value;
        
        if (new Date(toDate) < new Date(fromDate)) {
            showAlert("Khoảng thời gian không hợp lệ. Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu!");
            return;
        }

        const url = `/Reporting/ExportCashHandover?branchId=${branchId}&fromDate=${fromDate}&toDate=${toDate}`;
        downloadFile(url);
    }
</script>

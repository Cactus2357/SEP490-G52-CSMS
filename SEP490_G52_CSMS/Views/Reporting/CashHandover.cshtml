@model SEP490_G52_CSMS.Models.ViewModels.CashHandoverReportViewModel

@{
    ViewData["Title"] = "BÁO CÁO BÀN GIAO CA & ĐỐI SOÁT KÉT TIỀN TOÀN CHUỖI";
}

<div class="container-fluid mt-3 px-4 pb-5">

    <!-- Top Dashboard Header & Actions -->
    <div class="card bg-body-tertiary border-0 rounded-3 mb-4 shadow-sm">
        <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-success text-white rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="bi bi-cash-coin fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small">Báo cáo hệ thống / Tài chính thu ngân</span>
                    <h4 class="fw-bold m-0 text-dark">BÁO CÁO BÀN GIAO CA & ĐỐI SOÁT KÉT TIỀN TOÀN CHUỖI</h4>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Reporting" asp-action="Export" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-file-earmark-arrow-down-fill"></i> Xuất file bàn giao ca
                </a>
            </div>
        </div>
    </div>

    <!-- Filter Bar Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" id="handoverFilterForm" class="row g-3 align-items-end">
                <!-- Branch Selector -->
                <div class="col-xl-3 col-md-6">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <i class="bi bi-shop text-success me-1"></i>Chi nhánh:
                    </label>
                    <select id="branchId" name="branchId" class="form-select fw-semibold"
                            asp-for="SelectedBranchId" asp-items="Model.BranchList" onchange="document.getElementById('handoverFilterForm').submit();">
                    </select>
                </div>

                <!-- Handover Type -->
                <div class="col-xl-2 col-md-6">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <i class="bi bi-tag text-success me-1"></i>Loại bàn giao:
                    </label>
                    <select id="handoverType" name="handoverType" class="form-select fw-semibold"
                            asp-for="SelectedHandoverType" asp-items="Model.HandoverTypeList" onchange="document.getElementById('handoverFilterForm').submit();">
                    </select>
                </div>

                <!-- Discrepancy Status -->
                <div class="col-xl-2 col-md-6">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <i class="bi bi-shield-exclamation text-success me-1"></i>Chênh lệch tiền:
                    </label>
                    <select id="discrepancyStatus" name="discrepancyStatus" class="form-select fw-semibold" onchange="document.getElementById('handoverFilterForm').submit();">
                        <option value="all" selected="@(Model.SelectedDiscrepancyStatus == "all")">Tất cả</option>
                        <option value="balanced" selected="@(Model.SelectedDiscrepancyStatus == "balanced")">Khớp 100%</option>
                        <option value="surplus" selected="@(Model.SelectedDiscrepancyStatus == "surplus")">Thừa tiền (+)</option>
                        <option value="shortage" selected="@(Model.SelectedDiscrepancyStatus == "shortage")">Thiếu tiền (-)</option>
                    </select>
                </div>

                <!-- From Date -->
                <div class="col-xl-2 col-md-3 col-sm-6">
                    <label class="form-label small fw-semibold text-secondary mb-1">Từ ngày:</label>
                    <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                </div>

                <!-- To Date -->
                <div class="col-xl-2 col-md-3 col-sm-6">
                    <label class="form-label small fw-semibold text-secondary mb-1">Đến ngày:</label>
                    <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                </div>

                <!-- Submit Button -->
                <div class="col-xl-1 col-md-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-success w-100 fw-semibold">
                        <i class="bi bi-filter"></i> Lọc
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Executive KPI Metric Summary Cards -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Total Cash Revenue -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Doanh Thu Tiền Mặt Máy</div>
                        <h4 class="fw-bold text-success m-0">@Model.TotalMachineCashRevenue.ToString("N0") đ</h4>
                        <small class="text-secondary">@Model.TotalHandoversCount phiên giao ca</small>
                    </div>
                    <div class="bg-success-subtle text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-cash-stack fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Total Bank Transfer Revenue -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Doanh Thu Chuyển Khoản</div>
                        <h4 class="fw-bold text-primary m-0">@Model.TotalBankTransferRevenue.ToString("N0") đ</h4>
                        <small class="text-secondary">Thu qua ngân hàng / QR</small>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-qr-code fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Deposited Cash -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Tiền Nộp Két Tổng / Chủ</div>
                        <h4 class="fw-bold text-info m-0">@Model.TotalDepositedCash.ToString("N0") đ</h4>
                        <small class="text-secondary">Đã kết chuyển cuối ngày</small>
                    </div>
                    <div class="bg-info-subtle text-info rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-safe2 fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Discrepancy Amount & Alert -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold text-muted mb-1">Chênh Lệch Két Tiền</div>
                        <h4 class="fw-bold @(Model.TotalDiscrepancy < 0 ? "text-danger" : (Model.TotalDiscrepancy > 0 ? "text-primary" : "text-success")) m-0">
                            @(Model.TotalDiscrepancy > 0 ? "+" : "")@Model.TotalDiscrepancy.ToString("N0") đ
                        </h4>
                        <small class="text-secondary">
                            @if (Model.DiscrepancyIncidentsCount > 0)
                            {
                                <span class="text-danger fw-semibold">@Model.DiscrepancyIncidentsCount ca có chênh lệch</span>
                            }
                            else
                            {
                                <span class="text-success fw-semibold">100% khớp sổ sách</span>
                            }
                        </small>
                    </div>
                    <div class="@(Model.DiscrepancyIncidentsCount > 0 ? "bg-warning-subtle text-warning-emphasis" : "bg-success-subtle text-success") rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi @(Model.DiscrepancyIncidentsCount > 0 ? "bi-exclamation-triangle" : "bi-check2-circle") fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table Data Grid -->
    <div class="card border-0 shadow-sm rounded-3 bg-white">
        <div class="card-header bg-body-tertiary border-0 py-3 d-flex align-items-center justify-content-between">
            <h6 class="fw-bold m-0 text-dark">
                <i class="bi bi-table text-success me-2"></i>DANH SÁCH BÀN GIAO CA & ĐỐI SOÁT KÉT TIỀN (@Model.Handovers.Count phiên)
            </h6>
            <span class="badge bg-secondary-subtle text-dark border">
                @Model.FromDate.ToString("dd/MM/yyyy") - @Model.ToDate.ToString("dd/MM/yyyy")
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 540px; overflow-y: auto;">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th class="ps-3">Chi nhánh</th>
                            <th>Ngày ca</th>
                            <th>Tên ca / Khung giờ</th>
                            <th>Loại bàn giao</th>
                            <th>Thu ngân giao</th>
                            <th>Thu ngân nhận</th>
                            <th class="text-end">Đầu ca</th>
                            <th class="text-end">Tiền mặt bán</th>
                            <th class="text-end">Chuyển khoản</th>
                            <th class="text-end">Lý thuyết</th>
                            <th class="text-end">Thực tế</th>
                            <th class="text-end">Chênh lệch</th>
                            <th class="text-end">Nộp két tổng</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="pe-3 text-center">Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Handovers.Any())
                        {
                            <tr>
                                <td colspan="15" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                    Không tìm thấy dữ liệu bàn giao ca nào phù hợp với bộ lọc đã chọn.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var h in Model.Handovers)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-primary">@h.BranchName</td>
                                    <td>@h.HandoverDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="fw-semibold text-dark">@h.ShiftName</span>
                                        <small class="text-muted d-block">@h.ShiftTime</small>
                                    </td>
                                    <td>
                                        @{
                                            string typeBadge = h.HandoverType switch
                                            {
                                                "Emergency" => "bg-danger-subtle text-danger border-danger-subtle",
                                                "FirstShift" => "bg-primary-subtle text-primary border-primary-subtle",
                                                "LastShift" => "bg-dark-subtle text-dark border-dark-subtle",
                                                _ => "bg-info-subtle text-info border-info-subtle"
                                            };
                                            string typeText = h.HandoverType switch
                                            {
                                                "Emergency" => "Đột xuất",
                                                "FirstShift" => "Đầu ca",
                                                "MidShift" => "Giữa ca",
                                                "LastShift" => "Cuối ngày",
                                                _ => h.HandoverType
                                            };
                                        }
                                        <span class="badge @typeBadge border px-2 py-1 rounded-pill">@typeText</span>
                                    </td>
                                    <td>@h.OutgoingCashierName</td>
                                    <td>@h.IncomingCashierName</td>
                                    <td class="text-end text-secondary">@h.InitialCash.ToString("N0") đ</td>
                                    <td class="text-end fw-semibold text-success">@h.MachineCashRevenue.ToString("N0") đ</td>
                                    <td class="text-end text-primary">@h.BankTransferRevenue.ToString("N0") đ</td>
                                    <td class="text-end text-secondary">@h.TheoreticalCash.ToString("N0") đ</td>
                                    <td class="text-end fw-bold text-dark">@h.ActualCash.ToString("N0") đ</td>
                                    <td class="text-end">
                                        @if (h.DiscrepancyAmount == 0)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">Khớp</span>
                                        }
                                        else if (h.DiscrepancyAmount > 0)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">
                                                +@h.DiscrepancyAmount.ToString("N0") đ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-white px-2 py-1 rounded-pill">
                                                @h.DiscrepancyAmount.ToString("N0") đ
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold text-info">@h.DepositedCash.ToString("N0") đ</td>
                                    <td class="text-center">
                                        <span class="badge @(h.Status == "Closed" ? "bg-secondary-subtle text-dark" : "bg-success text-white") rounded-pill px-2.5 py-1">
                                            @(h.Status == "Closed" ? "Đã đóng" : "Đang mở")
                                        </span>
                                    </td>
                                    <td class="pe-3 text-center">
                                        @if (!string.IsNullOrEmpty(h.EmergencyReason) || !string.IsNullOrEmpty(h.Notes))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle" data-bs-toggle="tooltip" data-bs-placement="left"
                                                    title="@(!string.IsNullOrEmpty(h.EmergencyReason) ? $"Lý do đột xuất: {h.EmergencyReason}. " : "")@(!string.IsNullOrEmpty(h.Notes) ? $"Ghi chú: {h.Notes}" : "")">
                                                <i class="bi bi-info-circle"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}
